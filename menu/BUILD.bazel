genrule(
    name = "ram-push-installer-object",
    srcs = [
        "ram_push_abi.h",
        "ram_push_installer.c",
    ],
    outs = ["ram_push_installer.o"],
    cmd = "NIX_HARDENING_ENABLE= clang --target=armv7r-none-eabi -march=armv7-r -marm -mfloat-abi=soft -ffreestanding -fno-builtin -fno-stack-protector -fno-unwind-tables -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections -Os -Wall -Wextra -Werror -c $(location ram_push_installer.c) -o $@",
    local = True,
    visibility = ["//visibility:public"],
)

genrule(
    name = "ram-push-bootstrap",
    srcs = [
        "ram_push_bootstrap.S",
        "ram_push_bootstrap.ld",
    ],
    outs = [
        "ram_push_bootstrap.bin",
        "ram_push_bootstrap.elf",
    ],
    cmd = "NIX_HARDENING_ENABLE= clang --target=armv7r-none-eabi -march=armv7-r -marm -nostdlib -static -fuse-ld=lld -Wl,--no-dynamic-linker -Wl,--build-id=none -Wl,-e,ram_push_bootstrap -Wl,-T,$(location ram_push_bootstrap.ld) $(location ram_push_bootstrap.S) -o $(location ram_push_bootstrap.elf) && llvm-objcopy -O binary $(location ram_push_bootstrap.elf) $(location ram_push_bootstrap.bin)",
    local = True,
    visibility = ["//visibility:public"],
)

