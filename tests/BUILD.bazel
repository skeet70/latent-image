load("@rules_shell//shell:sh_test.bzl", "sh_test")

sh_test(
    name = "research-contracts",
    size = "small",
    srcs = ["research-contracts.sh"],
    args = [
        "$(location @lab_jsonschema//:bin/check-jsonschema)",
        "$(location @lab_jq//:bin/jq)",
        "$(location @lab_git//:bin/git)",
    ],
    data = [
        "//docs:evidence.jsonl",
        "//manifests:initial",
        "//schemas:all",
        "@lab_git//:bin/git",
        "@lab_jq//:bin/jq",
        "@lab_jsonschema//:bin/check-jsonschema",
    ],
    # The citation check greps the checkout, which Bazel does not track as an input.
    tags = [
        "external",
        "local",
    ],
)
