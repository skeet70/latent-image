load("@rules_shell//shell:sh_test.bzl", "sh_test")

sh_test(
    name = "research-contracts",
    size = "medium",
    srcs = ["research-contracts.sh"],
    args = [
        "$(location @lab_jsonschema//:bin/check-jsonschema)",
        "$(location @lab_jq//:bin/jq)",
        "$(location @lab_git//:bin/git)",
    ],
    data = [
        "//docs:evidence.jsonl",
        "//manifests:initial",
        "//schemas:all",
        "@lab_git//:bin/git",
        "@lab_jq//:bin/jq",
        "@lab_jsonschema//:bin/check-jsonschema",
    ],
    # The citation check greps the checkout, which Bazel does not track as an input.
    tags = [
        "external",
        "local",
    ],
)

sh_test(
    name = "ledger-apply",
    size = "small",
    srcs = ["ledger-apply.sh"],
    args = [
        "$(location @lab_jq//:bin/jq)",
        "$(location //build-support:ledger-apply.sh)",
    ],
    data = [
        "//build-support:ledger-apply.sh",
        "@lab_jq//:bin/jq",
    ],
)

sh_test(
    name = "xm1-decomp",
    size = "small",
    srcs = ["xm1-decomp.sh"],
    args = [
        "$(rootpath //build-support:xm1-decomp)",
        "$(rootpath @lab_git//:bin/git)",
    ],
    data = [
        "//build-support:xm1-decomp",
        "@lab_git//:bin/git",
    ],
)
