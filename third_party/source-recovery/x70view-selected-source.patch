+    """The bounded, observed stock REC → shooting menu → SETUP button path."""
+    board = session.board
+    board.run(65_002_000, pause_after=65_000_000)
+    require_running(session.sample())
+    enter_shooting_menu(session)
+    for key in ('left', 'down', 'down', 'down', 'down', 'down'):
+        require_running(session.key({'key': key}))
+    for _ in range(12):
+        state = require_running(session.run({'limit': 15_000_000}))
+        ui = state['ui']
+        if ui['mode'] != 5 or ui['pending'] or ui['busy']:
+            continue
+        menu = state['navigation']['current_menu']
+        if menu['pointer'] != 0xa9018c:
+            raise RuntimeError('Unexpected stock SETUP tab descriptor')
+        # UI mode changes before the tab's filtered list is rebuilt. Sending
+        # RIGHT to the earlier five-row shooting list only focuses a tab.
+        if menu.get('visible_count') != 3 or menu.get('cursor') != 8:
+            continue
+        state = require_running(session.key({'key': 'right', 'render': True}))
+        if state['navigation']['render_settle']['status'] != 'render-batch-published-candidate':
+            raise RuntimeError('Stock SETUP root draw did not complete')
+        menu = state['navigation']['current_menu']
+        if menu['pointer'] != 0xa93fe0 or menu.get('cursor') != 0:
+            raise RuntimeError('Unexpected stock SETUP root descriptor')
+        return state
+    raise RuntimeError('Stock SETUP transition exceeded its bounded boot budget')
