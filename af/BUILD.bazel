load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

_COPTS = [
    "-std=c11",
    "-Wall",
    "-Wextra",
    "-Werror",
    "-Wconversion",
    "-Wshadow",
]

cc_library(
    name = "kernel",
    srcs = ["af_kernel.c"],
    hdrs = ["af_kernel.h"],
    copts = _COPTS,
)

cc_binary(
    name = "decision-stdio",
    srcs = ["decision_stdio.c"],
    copts = _COPTS,
    deps = [":kernel"],
)

cc_test(
    name = "kernel-tests",
    size = "small",
    srcs = ["kernel_test.c"],
    copts = _COPTS,
    deps = [":kernel"],
)

sh_binary(
    name = "simulate",
    srcs = ["simulate.sh"],
    args = [
        "$(location :simulate-hs)",
        "$(location :decision-stdio)",
        "$(location @lab_jsonschema//:bin/check-jsonschema)",
    ],
    data = [
        ":decision-stdio",
        ":simulate-hs",
        "//schemas:all",
        "@lab_jsonschema//:bin/check-jsonschema",
    ] + glob(["fixtures/*.json"]),
)

sh_test(
    name = "simulation-tests",
    size = "small",
    srcs = ["simulation-tests.sh"],
    args = [
        "$(location :simulation-tests-hs)",
        "$(location :decision-stdio)",
        "$(location @lab_jsonschema//:bin/check-jsonschema)",
        "$(location :simulate-hs)",
    ],
    data = [
        ":decision-stdio",
        ":simulate-hs",
        ":simulation-tests-hs",
        "//schemas:all",
        "@lab_jsonschema//:bin/check-jsonschema",
    ] + glob(["fixtures/*.json"]),
)

haskell_library(
    name = "simulation",
    srcs = ["AF/Simulation.hs"],
    ghcopts = ["-XGHC2021"],
    deps = [
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:host-support",
        "//host:json",
        "//host:process",
        "//host:unix",
    ],
)

haskell_binary(
    name = "simulate-hs",
    srcs = ["SimulateMain.hs"],
    ghcopts = [
        "-XGHC2021",
        "-threaded",
    ],
    deps = [
        ":simulation",
        "//host:base",
        "//host:filepath",
        "//host:host-support",
    ],
)

haskell_binary(
    name = "simulation-tests-hs",
    srcs = ["SimulationTests.hs"],
    ghcopts = [
        "-XGHC2021",
        "-threaded",
    ],
    deps = [
        ":simulation",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
        "//host:json",
        "//host:unix",
    ],
)

genrule(
    name = "candidate-controller",
    srcs = ["candidates/controller.rs", "candidates/structural.rs", "candidates/libcamera.rs"],
    outs = ["libaf_candidates.rlib"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --crate-name af_candidates --crate-type rlib -C opt-level=2 $(location candidates/controller.rs) -o $@",
    tools = ["@lab_rustc//:bin/rustc"],
)

genrule(
    name = "candidate-decision",
    srcs = ["candidates/stdio.rs", ":candidate-controller"],
    outs = ["candidate-decision-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 -C opt-level=2 -C linker=$(location @lab_clang//:bin/clang) --extern af_candidates=$(location :candidate-controller) $(location candidates/stdio.rs) -o $@",
    executable = True,
    tools = ["@lab_rustc//:bin/rustc", "@lab_clang//:bin/clang"],
)

genrule(
    name = "candidate-replay-test-bin",
    srcs = ["candidates/replay_tests.rs", "candidates/libcamera_tests.rs", ":candidate-controller"] + glob(["candidates/fixtures/*.curve"]),
    outs = ["candidate-replay-tests-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --test -C linker=$(location @lab_clang//:bin/clang) --extern af_candidates=$(location :candidate-controller) $(location candidates/replay_tests.rs) -o $@",
    executable = True,
    tools = ["@lab_rustc//:bin/rustc", "@lab_clang//:bin/clang"],
)

sh_test(
    name = "candidate-replay-tests",
    size = "small",
    srcs = ["candidate-replay-tests.sh"],
    args = ["$(location :candidate-replay-test-bin)"],
    data = [":candidate-replay-test-bin"],
)

haskell_binary(
    name = "candidate-compare-hs",
    srcs = ["CandidatesMain.hs"],
    ghcopts = ["-XGHC2021", "-threaded"],
    deps = ["//host:base", "//host:bytestring", "//host:host-support", "//host:process"],
)

sh_binary(
    name = "candidate-compare",
    srcs = ["candidate-compare.sh"],
    args = [
        "$(location :candidate-compare-hs)",
        "$(location :candidate-decision)",
    ],
    data = [":candidate-compare-hs", ":candidate-decision"] + glob(["candidates/fixtures/*.curve"]),
)

haskell_binary(
    name = "candidate-compare-tests-hs",
    srcs = ["CandidateCompareTests.hs"],
    ghcopts = ["-XGHC2021", "-threaded"],
    deps = ["//host:base", "//host:process"],
)

sh_test(
    name = "candidate-compare-tests",
    size = "small",
    srcs = ["candidate-replay-tests.sh"],
    args = [
        "$(location :candidate-compare-tests-hs)",
        "$(location :candidate-compare-hs)",
        "$(location :candidate-decision)",
        "$(location candidates/fixtures/single-peak.curve)",
        "$(location candidates/fixtures/two-depths.curve)",
        "$(location candidates/fixtures/edge-peak.curve)",
        "$(location candidates/fixtures/noisy-peak.curve)",
        "$(location candidates/fixtures/flat.curve)",
    ],
    data = [
        ":candidate-compare-tests-hs",
        ":candidate-compare-hs",
        ":candidate-decision",
    ] + glob(["candidates/fixtures/*.curve"]),
)
