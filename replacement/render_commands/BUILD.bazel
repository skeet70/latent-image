load("//build-support:rust_source_boundary.bzl", "rust_source_boundary_test")

load("//replacement/toolchain:rust.bzl", "xm1_rust_rlib")

filegroup(
    name = "module",
    srcs = glob(["src/*.rs"]) + ["//replacement/develop:portable-font-module"],
    visibility = ["//visibility:public"],
)

# Bare rustc leaves libm's arch_enabled and intrinsics_enabled cfgs unset.
genrule(
    name = "libm-host",
    srcs = ["@lab_libm_source//:source", "@lab_libm_source//:src/lib.rs"],
    outs = ["liblibm-host.rlib"],
    cmd = "$(location @lab_rustc//:bin/rustc) --crate-name=libm --edition=2021 --crate-type=rlib -C opt-level=z -C debuginfo=0 $(location @lab_libm_source//:src/lib.rs) -o $@",
    tools = ["@lab_rustc//:bin/rustc"],
    visibility = ["//visibility:public"],
)

xm1_rust_rlib(
    name = "libm-arm",
    src = "@lab_libm_source//:src/lib.rs",
    crate_name = "libm",
    out = "liblibm-arm.rlib",
    data = ["@lab_libm_source//:source"],
    visibility = ["//visibility:public"],
)

xm1_rust_rlib(
    name = "runtime-arm",
    src = "src/lib.rs",
    crate_name = "render_commands",
    out = "librender_commands.rlib",
    data = [":module"],
    rlib_deps = {"libm": ":libm-arm"},
    visibility = ["//visibility:public"],
)

# Checks the renderer on original assets read from a RAM dump given at run time.
genrule(
    name = "guest-assets-check-build",
    srcs = [":module", "tests/guest_assets_check.rs", ":libm-host"],
    outs = ["guest-assets-check"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 -C opt-level=2 -C linker=$(location @lab_clang//:bin/clang) --extern libm=$(location :libm-host) $(location tests/guest_assets_check.rs) -o $@",
    executable = True,
    tools = ["@lab_rustc//:bin/rustc", "@lab_clang//:bin/clang"],
)

# Renders a RAM dump's VGLIB scene with the owned renderer and compares it with the dump's OSD front buffer.
genrule(
    name = "scene-check-build",
    srcs = [":module", "tests/scene_check.rs", ":libm-host"],
    outs = ["scene-check"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 -C opt-level=2 -C linker=$(location @lab_clang//:bin/clang) --extern libm=$(location :libm-host) $(location tests/scene_check.rs) -o $@",
    executable = True,
    tools = ["@lab_rustc//:bin/rustc", "@lab_clang//:bin/clang"],
)

# Exports the rasterizer identity frame_pixel_check.rs records: rustc version, host triple and the SHA-256 of the
# sorted `sha256sum` lines of :module.
FRAME_PIXEL_CHECK_IDENTITY = """
rustc=$(location @lab_rustc//:bin/rustc)
export FRAME_PIXEL_CHECK_RUSTC_VERSION="$$($$rustc --version)"
FRAME_PIXEL_CHECK_HOST_TRIPLE=
while read -r key value; do if [ "$$key" = host: ]; then FRAME_PIXEL_CHECK_HOST_TRIPLE=$$value; fi; done < <($$rustc -vV)
export FRAME_PIXEL_CHECK_HOST_TRIPLE
module=$$($(location @lab_coreutils//:bin/sha256sum) $(locations :module) | LC_ALL=C $(location @lab_coreutils//:bin/sort) -k2 | $(location @lab_coreutils//:bin/sha256sum))
export FRAME_PIXEL_CHECK_MODULE_SHA256=$${module%% *}
"""

FRAME_PIXEL_CHECK_TOOLS = ["@lab_rustc//:bin/rustc", "@lab_clang//:bin/clang", "@lab_coreutils//:bin/sha256sum", "@lab_coreutils//:bin/sort"]

# Compares the decoded VGLIB scenes of a stock and an owned guest RAM image and the owned published OSD buffer with
# the host render of the owned scene.
genrule(
    name = "frame-pixel-check-build",
    srcs = [":module", "tests/frame_pixel_check.rs", ":libm-host"],
    outs = ["frame-pixel-check"],
    cmd = FRAME_PIXEL_CHECK_IDENTITY + "$$rustc --edition=2021 -C opt-level=2 -C linker=$(location @lab_clang//:bin/clang) --extern libm=$(location :libm-host) $(location tests/frame_pixel_check.rs) -o $@",
    executable = True,
    tools = FRAME_PIXEL_CHECK_TOOLS,
)

genrule(
    name = "frame-pixel-check-tests-build",
    srcs = [":module", "tests/frame_pixel_check.rs", ":libm-host"],
    outs = ["frame-pixel-check-tests-bin"],
    cmd = FRAME_PIXEL_CHECK_IDENTITY + "$$rustc --edition=2021 --test -C opt-level=2 -C linker=$(location @lab_clang//:bin/clang) --extern libm=$(location :libm-host) $(location tests/frame_pixel_check.rs) -o $@",
    executable = True,
    testonly = True,
    tools = FRAME_PIXEL_CHECK_TOOLS,
)

sh_test(
    name = "frame-pixel-check-tests",
    size = "medium",
    srcs = ["tests/run.sh"],
    args = ["$(location :frame-pixel-check-tests-build)"],
    data = [":frame-pixel-check-tests-build"],
)

rust_source_boundary_test(
    name = "unsafe-boundary-check",
    declaration = "unsafe-boundary.json",
    srcs = glob(["src/**/*.rs"]),
)

filegroup(
    name = "shim-catalog-data",
    srcs = glob(["shims.json", "**/*.json", "**/*.ld"]) + ["BUILD.bazel"],
    visibility = ["//replacement/shim_check:__pkg__"],
)
