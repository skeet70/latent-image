load("//replacement/toolchain:rust.bzl", "xm1_rust_host_rlib", "xm1_rust_host_test", "xm1_rust_rlib")

package(default_visibility = ["//visibility:public"])

_SOURCES = glob(["src/*.rs"], exclude = ["src/lib.rs", "src/tests.rs"])
_HOST_DEPS = {
    "xm1_focus_measurement_round": "//replacement/focus_measurement/round:host",
    "xm1_saclac_calc": "//replacement/saclac/calc:host",
    "xm1_saclac_config": "//replacement/saclac/config:host",
    "xm1_saclac_controllers": "//replacement/saclac/controllers:host",
    "xm1_saclac_focus_search": "//replacement/saclac/focus_search:host",
    "xm1_saclac_interface": "//replacement/saclac_interface:host",
    "xm1_saclac_profile_records": "//replacement/saclac/profile_records:host",
    "xm1_saclac_shared": "//replacement/saclac/shared:host",
}

xm1_rust_host_rlib(
    name = "host",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_search_bindings",
    data = _SOURCES,
    rlib_deps = _HOST_DEPS,
)

xm1_rust_host_test(
    name = "host-tests",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_search_bindings_tests",
    data = _SOURCES + ["src/tests.rs"],
    rlib_deps = dict(
        _HOST_DEPS,
        xm1_kernel = "//replacement/kernel:host",
        xm1_saclac_peers = "//replacement/saclac/peers:host",
    ),
)

xm1_rust_rlib(
    name = "bindings",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_search_bindings",
    out = "arm/libxm1_saclac_search_bindings.rlib",
    data = _SOURCES,
    rlib_deps = {
        "xm1_focus_measurement_round": "//replacement/focus_measurement/round:round",
        "xm1_saclac_calc": "//replacement/saclac/calc:calc",
        "xm1_saclac_config": "//replacement/saclac/config:config",
        "xm1_saclac_controllers": "//replacement/saclac/controllers:controllers",
        "xm1_saclac_focus_search": "//replacement/saclac/focus_search:focus-search",
        "xm1_saclac_interface": "//replacement/saclac_interface:saclac-interface",
        "xm1_saclac_profile_records": "//replacement/saclac/profile_records:profile_records",
        "xm1_saclac_shared": "//replacement/saclac/shared:shared",
    },
)
