load("//replacement/toolchain:rust.bzl", "xm1_rust_host_rlib", "xm1_rust_host_test", "xm1_rust_rlib")

package(default_visibility = ["//visibility:public"])

_SOURCES = glob(["src/*.rs", "src/stock/*.rs"], exclude = ["src/lib.rs", "src/*_tests.rs", "src/fake.rs"])

xm1_rust_rlib(
    name = "root",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_root",
    out = "arm/libxm1_saclac_root.rlib",
    data = _SOURCES,
    rlib_deps = {
        "xm1_saclac_search_bindings": "//replacement/saclac/root/search_bindings:bindings",
        "xm1_saclac_focus_search": "//replacement/saclac/focus_search:focus-search",
        "display_scanout_panel": "//replacement/display_scanout:libdisplay_scanout_panel",
        "calibration_liveview": "//replacement/calibration_liveview:libcalibration_liveview",
        "xm1_focus_measurement_round": "//replacement/focus_measurement/round:round",
        "xm1_kernel": "//replacement/kernel:arm",
        "xm1_saclac_calc": "//replacement/saclac/calc:calc",
        "xm1_saclac_config": "//replacement/saclac/config:config",
        "xm1_saclac_controllers": "//replacement/saclac/controllers:controllers",
        "xm1_saclac_interface": "//replacement/saclac_interface:saclac-interface",
        "xm1_saclac_imaging": "//replacement/saclac/imaging:imaging",
        "xm1_saclac_lens_drive": "//replacement/saclac/lens_drive:lens-drive",
        "xm1_saclac_peers": "//replacement/saclac/peers:peers",
        "xm1_saclac_profile_geometry": "//replacement/saclac/profile_geometry:profile_geometry",
        "xm1_saclac_profile_records": "//replacement/saclac/profile_records:profile_records",
        "xm1_saclac_shared": "//replacement/saclac/shared:shared",
    },
)

xm1_rust_host_test(
    name = "host-tests",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_root_tests",
    data = glob(["src/*.rs", "src/stock/*.rs"], exclude = ["src/lib.rs"]),
    rlib_deps = {
        "xm1_saclac_search_bindings": "//replacement/saclac/root/search_bindings:host",
        "xm1_saclac_focus_search": "//replacement/saclac/focus_search:host",
        "xm1_focus_measurement_round": "//replacement/focus_measurement/round:host",
        "xm1_kernel": "//replacement/kernel:host",
        "xm1_saclac_calc": "//replacement/saclac/calc:host",
        "xm1_saclac_config": "//replacement/saclac/config:host",
        "xm1_saclac_controllers": "//replacement/saclac/controllers:host",
        "xm1_saclac_interface": "//replacement/saclac_interface:host",
        "xm1_saclac_imaging": "//replacement/saclac/imaging:host",
        "xm1_saclac_lens_drive": "//replacement/saclac/lens_drive:host",
        "xm1_saclac_peers": "//replacement/saclac/peers:host",
        "xm1_saclac_profile_geometry": "//replacement/saclac/profile_geometry:host",
        "xm1_saclac_profile_records": "//replacement/saclac/profile_records:host",
        "xm1_saclac_shared": "//replacement/saclac/shared:host",
    },
)

xm1_rust_host_rlib(
    name = "host",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_root",
    data = _SOURCES,
    rlib_deps = {
        "xm1_saclac_search_bindings": "//replacement/saclac/root/search_bindings:host",
        "xm1_saclac_focus_search": "//replacement/saclac/focus_search:host",
        "xm1_focus_measurement_round": "//replacement/focus_measurement/round:host",
        "xm1_kernel": "//replacement/kernel:host",
        "xm1_saclac_calc": "//replacement/saclac/calc:host",
        "xm1_saclac_config": "//replacement/saclac/config:host",
        "xm1_saclac_controllers": "//replacement/saclac/controllers:host",
        "xm1_saclac_interface": "//replacement/saclac_interface:host",
        "xm1_saclac_imaging": "//replacement/saclac/imaging:host",
        "xm1_saclac_lens_drive": "//replacement/saclac/lens_drive:host",
        "xm1_saclac_peers": "//replacement/saclac/peers:host",
        "xm1_saclac_profile_geometry": "//replacement/saclac/profile_geometry:host",
        "xm1_saclac_profile_records": "//replacement/saclac/profile_records:host",
        "xm1_saclac_shared": "//replacement/saclac/shared:host",
    },
)
