        "//replacement/shot_sequence:shot-sequence",
    ],
)

# The comparison's wrong wake-publication control: `publish_history` advances the
# area-statistics descriptor by two slots instead of one (still modulo five). The production
# graph is unaffected; only the wrong variant compiles this cfg.
xm1_rust_rlib(
    name = "root-wrong-wake-publication",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_root",
    out = "arm/libxm1_saclac_root_wrong_wake_publication.rlib",
    rustc_flags = ["--cfg", "saclac_wrong_wake_publication"],
    data = _SOURCES,
    rlib_search_deps = _ARM_SEARCH_DEPS,
    dependency_archives = ["//replacement/vendor_protocol:arm/wireless-crypto-deps.tar"],
    rlib_deps = {
