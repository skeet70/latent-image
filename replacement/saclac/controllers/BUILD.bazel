load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_rlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_rlib(
    name = "controllers",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_controllers",
    data = ["src/lifecycle.rs", "src/adjustment.rs", "src/statistics.rs", "src/stock.rs"],
)

genrule(
    name = "host-tests-build",
    srcs = glob(["src/*.rs"]),
    tools = ["@lab_xm1_rust//:bin/rustc", "@lab_clang//:bin/clang"],
    outs = ["host-tests-bin"],
    executable = True,
    cmd = "$(location @lab_xm1_rust//:bin/rustc) --edition=2021 --test -C linker=$(location @lab_clang//:bin/clang) $(location src/lib.rs) -o $@",
)

sh_test(
    name = "host-tests",
    size = "small",
    srcs = ["host-test.sh"],
    args = ["$(location :host-tests-build)"],
    data = [":host-tests-build"],
)
