load("//replacement/toolchain:rust.bzl", "xm1_rust_rlib", "xm1_rust_host_test")

package(default_visibility = ["//visibility:public"])

xm1_rust_rlib(
    name = "controllers",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_controllers",
    out = "arm/libxm1_saclac_controllers.rlib",
    data = ["src/lifecycle.rs", "src/adjustment.rs", "src/statistics.rs", "src/stock.rs", "src/replies.rs", "src/children.rs", "src/synchronous.rs", "src/search.rs", "src/records.rs", "src/capture.rs"],
    rlib_deps = {"xm1_saclac_interface": "//replacement/saclac_interface:saclac-interface"},
)

xm1_rust_host_test(
    name = "host-tests",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_controllers_tests",
    data = glob(["src/*.rs"], exclude = ["src/lib.rs"]),
    rlib_deps = {"xm1_saclac_interface": "//replacement/saclac_interface:host"},
)

