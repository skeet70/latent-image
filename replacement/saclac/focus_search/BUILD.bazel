load("//replacement/toolchain:rust.bzl", "xm1_rust_host_rlib", "xm1_rust_host_test", "xm1_rust_rlib")

package(default_visibility = ["//visibility:public"])

_SOURCES = glob(["src/*.rs"], exclude = ["src/lib.rs", "src/*_tests.rs"])

_HOST_DEPS = {
    "xm1_saclac_controllers": "//replacement/saclac/controllers:host",
    "xm1_saclac_interface": "//replacement/saclac_interface:host",
}

xm1_rust_rlib(
    name = "focus-search",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_focus_search",
    out = "arm/libxm1_saclac_focus_search.rlib",
    data = _SOURCES,
    rlib_deps = {
        "xm1_saclac_controllers": "//replacement/saclac/controllers:controllers",
        "xm1_saclac_interface": "//replacement/saclac_interface:saclac-interface",
    },
)

xm1_rust_host_rlib(
    name = "host",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_focus_search",
    data = _SOURCES,
    rlib_deps = _HOST_DEPS,
)

xm1_rust_host_test(
    name = "host-tests",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_focus_search_tests",
    data = glob(["src/*.rs"], exclude = ["src/lib.rs"]),
    rlib_deps = _HOST_DEPS,
)
