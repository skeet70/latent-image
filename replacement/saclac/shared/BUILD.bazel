load("//replacement/toolchain:rust.bzl", "xm1_rust_host_rlib", "xm1_rust_host_test", "xm1_rust_rlib")

package(default_visibility = ["//visibility:public"])

_SOURCES = [
    "src/commands.rs",
    "src/display.rs",
    "src/image_registers.rs",
    "src/lens.rs",
    "src/lens_com.rs",
    "src/settings.rs",
    "src/sort.rs",
    "src/stock.rs",
]

xm1_rust_rlib(
    name = "shared",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_shared",
    out = "arm/libxm1_saclac_shared.rlib",
    data = _SOURCES,
    rlib_deps = {"xm1_saclac_interface": "//replacement/saclac_interface:saclac-interface"},
)

xm1_rust_host_rlib(
    name = "host",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_shared",
    data = _SOURCES,
    rlib_deps = {"xm1_saclac_interface": "//replacement/saclac_interface:host"},
)

xm1_rust_host_test(
    name = "host-tests",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_shared_tests",
    data = glob(["src/*.rs"], exclude = ["src/lib.rs"]),
    rlib_deps = {"xm1_saclac_interface": "//replacement/saclac_interface:host"},
)
