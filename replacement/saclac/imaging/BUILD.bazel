load("//replacement/toolchain:rust.bzl", "xm1_rust_host_rlib", "xm1_rust_host_test", "xm1_rust_rlib")

package(default_visibility = ["//visibility:public"])

_SOURCES = glob(["src/**/*.rs"], exclude = ["src/lib.rs", "src/**/*_tests.rs", "src/**/fake.rs"])

xm1_rust_rlib(
    name = "imaging",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_imaging",
    out = "arm/libxm1_saclac_imaging.rlib",
    data = _SOURCES,
)

xm1_rust_host_rlib(
    name = "host",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_imaging",
    data = _SOURCES,
)

xm1_rust_host_test(
    name = "host-tests",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_imaging_tests",
    data = glob(["src/**/*.rs"], exclude = ["src/lib.rs"]),
)
