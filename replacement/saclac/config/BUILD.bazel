load("//replacement/toolchain:rust.bzl", "xm1_rust_host_rlib", "xm1_rust_host_test", "xm1_rust_rlib")

package(default_visibility = ["//visibility:public"])

_SOURCES = glob(
    ["src/*.rs", "src/**/*.rs"],
    exclude = ["src/lib.rs", "src/*_tests.rs", "src/fake.rs"],
)

xm1_rust_rlib(
    name = "config",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_config",
    out = "arm/libxm1_saclac_config.rlib",
    data = _SOURCES,
    rlib_deps = {
        "xm1_saclac_interface": "//replacement/saclac_interface:saclac-interface",
        "xm1_saclac_shared": "//replacement/saclac/shared",
    },
)

xm1_rust_host_rlib(
    name = "host",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_config",
    data = _SOURCES,
    rlib_deps = {
        "xm1_saclac_interface": "//replacement/saclac_interface:host",
        "xm1_saclac_shared": "//replacement/saclac/shared:host",
    },
)

xm1_rust_host_test(
    name = "host-tests",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_config_tests",
    data = glob(["src/*.rs", "src/**/*.rs"], exclude = ["src/lib.rs"]),
    rlib_deps = {
        "xm1_saclac_interface": "//replacement/saclac_interface:host",
        "xm1_saclac_shared": "//replacement/saclac/shared:host",
    },
)
