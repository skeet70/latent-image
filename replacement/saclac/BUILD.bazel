# The unit's rlib: the engine and machine 0's router, joined into the owned image later.
xm1_rust_rlib(
    name = "saclac",
    src = "src/lib.rs",
    crate_name = "xm1_saclac",
    out = "arm/libxm1_saclac.rlib",
    rustc_flags = ["-C", "jump-tables=no"],
    data = _SOURCES,
    rlib_deps = _ARM_DEPS,
    rlib_search_deps = _ARM_SEARCH_DEPS,
    dependency_archives = ["//replacement/vendor_protocol:arm/wireless-crypto-deps.tar"],
)

# The bank root archive inherits record_store's one guest panic handler.
[
    xm1_rust_staticlib(
        name = "saclac-rust" + suffix,
        src = "src/lib.rs",
        crate_name = "xm1_saclac",
        rustc_flags = ["-C", "jump-tables=no"] + [flag for cfg in variant.cfgs for flag in ["--cfg", cfg]],
        data = _SOURCES,
        rlib_deps = dict(_ARM_DEPS.items() + variant.deps.items()),
        rlib_search_deps = _ARM_SEARCH_DEPS,
        dependency_archives = ["//replacement/vendor_protocol:arm/wireless-crypto-deps.tar"],
        testonly = variant.testonly,
    )
    for suffix, variant in BANK_VARIANTS.items()
]

[
    xm1_rust_elf(
        name = "saclac-image" + suffix,
        rust_staticlib = ":saclac-rust" + suffix,
        asm_srcs = ["entry.S"],
        entry = variant.entry,
        link_script = ":saclac.ld",
        link_includes = _BANK_LINK_INCLUDES,
        extra_ldflags = ["-Wl,--gc-sections", "-Wl,--emit-relocs", "-Wl,--error-limit=0"],
        testonly = variant.testonly,
    )
    for suffix, variant in BANK_VARIANTS.items()
]

[
    genrule(
        name = "saclac-image%s-sections" % suffix,
        srcs = [":saclac-image%s.elf" % suffix],
        outs = ["saclac-image%s.sections" % suffix],
        cmd = "$(location @lab_llvm//:bin/llvm-readelf) -S $(location :saclac-image%s.elf) > $@" % suffix,
        tools = ["@lab_llvm//:bin/llvm-readelf"],
        testonly = variant.testonly,
    )
    for suffix, variant in BANK_VARIANTS.items()
]

# The same production graph with a link script that keeps DWARF. Build it with
# `--define=xm1_rust_debuginfo=2 --platform_suffix=xm1-debuginfo`; its .bin and
# .symbols are the production bytes while its ELF carries the layout evidence.
[
    xm1_rust_elf(
        name = "saclac-image%s-debug" % suffix,
        rust_staticlib = ":saclac-rust" + suffix,
        asm_srcs = ["entry.S"],
        entry = BANK_VARIANTS[suffix].entry,
        link_script = ":saclac-debug.ld",
        link_includes = _BANK_LINK_INCLUDES,
        extra_ldflags = ["-Wl,--gc-sections", "-Wl,--emit-relocs", "-Wl,--error-limit=0"],
        testonly = True,
        tags = ["qualification"],
    )
    for suffix in ["", "-wrong-driver-store", "-wrong-wake-publication"]
]

