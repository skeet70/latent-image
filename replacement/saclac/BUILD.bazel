# The two extents are typed once, in Replacement.Saclac.Artifact; this emits the
# linker script and the census sites file from them.
haskell_library(
    name = "saclac-placement",
    srcs = ["Replacement/Saclac/Placement.hs"],
    src_strip_prefix = ".",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":saclac-artifact",
        "//replacement/fixed_image:contract",
        "//host:aeson",
        "//host:base",
        "//host:first-stage",
        "//host:text",
    ],
)

haskell_binary(
    name = "saclac-extents",
    srcs = ["ExtentsMain.hs"],
    main_file = "ExtentsMain.hs",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":saclac-artifact",
        ":saclac-placement",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:host-support",
    ],
)

genrule(
    name = "saclac-linker-script",
    outs = ["saclac.ld"],
    cmd = "$(location :saclac-extents) linker-script > $@",
    tools = [":saclac-extents"],
)

# One owned post, owned callback and client call entry per compared Root image variant, bound from
# each link, so a single sites file observes the candidate and its wrong-driver-store control
# through every relink. Owned callbacks come from the payload contract's declared identities.
_CENSUS_IMAGES = ["saclac-image", "saclac-image-wrong-driver-store"]

_CENSUS_IMAGE_FILES = [
    ":" + image + suffix
    for image in _CENSUS_IMAGES
    for suffix in [".elf", ".bin", ".symbols", ".disasm", ".sections"]
]

genrule(
    name = "saclac-census-sites",
    srcs = ["//emulation:saclac-census-sites", "payload-fields.json"] + _CENSUS_IMAGE_FILES,
    outs = ["saclac-census-sites.json"],
    cmd = "$(location :saclac-extents) census-sites $(location //emulation:saclac-census-sites) $(location payload-fields.json) $@ " + " ".join(["$(location " + label + ")" for label in _CENSUS_IMAGE_FILES]),
    tools = [":saclac-extents"],
)

