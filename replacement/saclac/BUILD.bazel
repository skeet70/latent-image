# One owned post, owned callback and client call entry per compared Root image variant, bound from
# each link, so a single sites file observes the candidate and its wrong-driver-store control
# through every relink. Owned callbacks come from the payload contract's declared identities.
_CENSUS_IMAGES = ["saclac-image", "saclac-image-wrong-driver-store", "saclac-image-wrong-wake-publication"]

_CENSUS_IMAGE_FILES = [
    ":" + image + suffix
    for image in _CENSUS_IMAGES
    for suffix in [".elf", ".bin", ".symbols", ".disasm", ".sections"]
]

genrule(
    name = "saclac-census-sites",
    srcs = ["//emulation:saclac-census-sites", "payload-fields.json", "//replacement/rtos_platform:carriers.json"] + _CENSUS_IMAGE_FILES,
    outs = ["saclac-census-sites.json"],
    cmd = "$(location :saclac-extents) census-sites $(location //emulation:saclac-census-sites) $(location payload-fields.json) $@ $(location //replacement/rtos_platform:carriers.json) " + " ".join(["$(location " + label + ")" for label in _CENSUS_IMAGE_FILES]),
    tools = [":saclac-extents"],
)

