load("//replacement/toolchain:rust.bzl", "xm1_rust_host_rlib", "xm1_rust_host_test", "xm1_rust_rlib")

package(default_visibility = ["//visibility:public"])

_SOURCES = ["src/bring_up.rs", "src/children.rs", "src/live.rs", "src/ports.rs", "src/s1.rs", "src/stock.rs"]

_HOST_DEPS = {
    "xm1_saclac_controllers": "//replacement/saclac/controllers:host",
    "xm1_saclac_interface": "//replacement/saclac_interface:host",
}

xm1_rust_rlib(
    name = "lens-drive",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_lens_drive",
    out = "arm/libxm1_saclac_lens_drive.rlib",
    data = _SOURCES,
    rlib_deps = {
        "xm1_saclac_controllers": "//replacement/saclac/controllers:controllers",
        "xm1_saclac_interface": "//replacement/saclac_interface:saclac-interface",
    },
)

xm1_rust_host_rlib(
    name = "host",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_lens_drive",
    data = _SOURCES,
    rlib_deps = _HOST_DEPS,
)

xm1_rust_host_test(
    name = "host-tests",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_lens_drive_tests",
    data = glob(["src/*.rs"], exclude = ["src/lib.rs"]),
    rlib_deps = _HOST_DEPS,
)
