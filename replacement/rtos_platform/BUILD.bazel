        "--cfg",
        "'feature=\"component\"'",
    ],
)

[
    xm1_rust_elf(
        name = "platform-%s" % domain,
        rust_staticlib = ":platform-root",
        rust_components = [
            ":scheduler-%s-rlib" % domain,
            ":scheduler-s2-%s-rlib" % domain,
            ":scheduler-s3c-%s-rlib" % domain,
            ":own-first-%s-rlib" % domain,
            ":semaphore-%s-rlib" % domain,
            ":fixed-pool-%s-rlib" % domain,
            ":task-records-%s-rlib" % domain,
            ":global-lock-rlib",
        ],
        asm_srcs = [
            "veneer-%s.S" % domain,
            "//replacement/rtos_fixed_pool:stage/entries.S",
        ],
        link_script = "platform-%s.ld" % domain,
        entry = "xm1_platform_veneer_s1_acquire",
        extra_ldflags = [
            "-Wl,--gc-sections",
            "-Wl,--orphan-handling=error",
            "-Wl,--enable-non-contiguous-regions",
        ],
        tags = ["manual"],
    )
    for domain in ["a", "b"]
]

haskell_library(
    name = "platform-artifact",
    srcs = [
        "stage/Replacement/RtosPlatform/Artifact.hs",
        "stage/Replacement/RtosPlatform/Place.hs",
        "stage/Replacement/RtosPlatform/Union.hs",
    ],
    src_strip_prefix = "stage",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//emulation:case-sha256",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:first-stage",
        "//host:text",
        "//host:update-container",
        "//replacement/rtos_own_first/stage:own-first-artifact",
    ],
)

haskell_binary(
    name = "stage-platform",
    srcs = ["stage/StageMain.hs"],
    main_file = "stage/StageMain.hs",
    data = ["carriers.json"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":platform-artifact",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
        "//replacement/rtos_own_first/stage:own-first-artifact",
    ],
)

haskell_binary(
    name = "place-platform",
    srcs = ["stage/PlaceMain.hs"],
    main_file = "stage/PlaceMain.hs",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":platform-artifact",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//replacement/rtos_own_first/stage:own-first-artifact",
    ],
)

