load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_rlib", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

exports_files([
    "carriers.json",
    "platform-a.ld",
    "platform-b.ld",
    "veneer-a.S",
    "veneer-b.S",
])

xm1_rust_staticlib(
    name = "platform-root",
    src = "src/lib.rs",
    crate_name = "xm1_rtos_platform",
)

[
    xm1_rust_rlib(
        name = "scheduler-%s-rlib" % domain,
        src = "//replacement/rtos_scheduler:src/lib.rs",
        crate_name = "xm1_rtos_scheduler",
        data = [
            "//replacement/rtos_scheduler:src/entries.rs",
            "//replacement/rtos_scheduler:src/s3a.rs",
            "//replacement/rtos_scheduler:src/s3b.rs",
            "//replacement/rtos_layout:src/lib.rs",
            "//replacement/rtos_reservation:src/lib.rs",
        ],
        rustc_flags = [
            "--cfg",
            "'feature=\"domain-%s\"'" % domain,
            "--cfg",
            "'feature=\"s3a\"'",
            "--cfg",
            "'feature=\"component\"'",
        ],
    )
    for domain in ["a", "b"]
]

[
    xm1_rust_rlib(
        name = "scheduler-s2-%s-rlib" % domain,
        src = "//replacement/rtos_scheduler:src/s2.rs",
