xm1_rust_rlib(
    name = "global-lock-rlib",
    src = "//replacement/rtos_global_lock:stage/abi.rs",
    crate_name = "xm1_rtos_global_lock_abi",
    data = [
        "//replacement/rtos_global_lock:src/lib.rs",
        "//replacement/rtos_layout:src/lib.rs",
        "//replacement/rtos_reservation:src/lib.rs",
    ],
    rustc_flags = [
        "--cfg",
