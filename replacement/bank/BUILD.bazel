load("//build-support:rust_source_boundary.bzl", "rust_source_boundary_test")

load("//replacement/toolchain:rust.bzl", "xm1_rust_staticlib")

_RLIB_DEPS = {
    "capture": "//replacement/capture:arm",
    "media_permit": "//replacement/media_permit:arm",
    "menu_engine": "//replacement/menu_engine:arm",
    "modal_runtime": "//replacement/modal_runtime:arm",
    "owned_menu": "//replacement/owned_menu:arm",
    "recipe_ui": "//replacement/recipe_ui:arm",
    "save": "//replacement/save:arm",
    "service": "//replacement/service:arm",
}

# The RAM-push review record pins this archive's bytes
# (`rust_object_replacement_bank` in transport/ram-push-review.json) and
# //transport:ram-push-link-digests pins its linked images at both reference
# bases. Opted out until that image is requalified, at the latest in the runner
# requalification.
xm1_rust_staticlib(
    name = "bank",
    src = "lib.rs",
    crate_name = "bank",
    strict_align = False,
    rlib_deps = _RLIB_DEPS,
    visibility = [
        "//emulation:__pkg__",
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

# The full modal75,menu-engine,render link unit. Every subsystem and adapter is
# an rlib; the generated tables are declared inputs of //replacement/bank/tables.
_ENGINE_RLIB_DEPS = {
    "capture": "//replacement/capture:arm",
    "libm": "//replacement/render_commands:libm-arm",
    "menu_engine": "//replacement/menu_engine:arm",
    "menu_engine_adapter": "//replacement/menu_engine:adapter-arm",
    "menu_widgets": "//replacement/menu_widgets:arm",
    "modal_runtime": "//replacement/modal_runtime:arm-modal75",
    "owned_menu": "//replacement/owned_menu:arm",
    "recipe_ui": "//replacement/recipe_ui:arm",
    "render_adapter": "//replacement/render_adapter:arm",
    "render_commands": "//replacement/render_commands:runtime-arm",
    "service": "//replacement/service:arm",
    "xm1_kernel": "//replacement/kernel:arm",
    "xm1_property_service": "//replacement/property_service:property-service-arm",
    "xm1_settings_storage_core": "//replacement/settings_storage:property-core-arm",
}

_ENGINE_FLAGS = [
    "--cfg",
    "rb_modal_scoped",
    "--cfg",
    "rb_modal75_owned",
    "--cfg",
    "rb_menu_engine_owned",
    "--cfg",
    "rb_render_owned",
    "-C",
    "target-feature=+strict-align",
    "-C",
    "llvm-args=-min-jump-table-entries=4096",
]

xm1_rust_staticlib(
    name = "bank-modal75-engine-render",
    src = "lib.rs",
    crate_name = "bank",
    rustc_flags = _ENGINE_FLAGS,
    rlib_deps = _ENGINE_RLIB_DEPS,
    visibility = [
        "//emulation:__pkg__",
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

# The 225-publication modal75,menu-engine link unit: the full engine unit
# without the render rlibs and cfg, so drawing stays stock.
_ENGINE_STOCK_DRAW_RLIB_DEPS = {
    crate: label
    for crate, label in _ENGINE_RLIB_DEPS.items()
    if crate not in ("libm", "menu_widgets", "render_adapter", "render_commands")
}

_ENGINE_STOCK_DRAW_FLAGS = [
    "--cfg",
    "rb_modal_scoped",
    "--cfg",
    "rb_modal75_owned",
    "--cfg",
    "rb_menu_engine_owned",
    "-C",
    "target-feature=+strict-align",
    "-C",
    "llvm-args=-min-jump-table-entries=4096",
]

xm1_rust_staticlib(
    name = "bank-modal75-engine",
    src = "lib.rs",
    crate_name = "bank",
    rustc_flags = _ENGINE_STOCK_DRAW_FLAGS,
    rlib_deps = _ENGINE_STOCK_DRAW_RLIB_DEPS,
    visibility = [
        "//emulation:__pkg__",
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

# The same link unit with the owned value transaction seam.
_ENGINE_VALUE_RLIB_DEPS = dict(_ENGINE_RLIB_DEPS)
_ENGINE_VALUE_RLIB_DEPS.update({
    "menu_engine_adapter": "//replacement/menu_engine:adapter-value-arm",
    "menu_value": "//replacement/menu_value:arm-owned",
    "render_adapter": "//replacement/render_adapter:arm-value",
})

xm1_rust_staticlib(
    name = "bank-modal75-engine-render-value",
    src = "lib.rs",
    crate_name = "bank",
    rustc_flags = _ENGINE_FLAGS + ["--cfg", "rb_menu_value_owned"],
    rlib_deps = _ENGINE_VALUE_RLIB_DEPS,
    visibility = [
        "//emulation:__pkg__",
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

xm1_rust_staticlib(
    name = "bank-modal",
    src = "lib.rs",
    crate_name = "bank",
    rustc_flags = ["--cfg", "rb_modal_scoped"],
    rlib_deps = _RLIB_DEPS,
    visibility = [
        "//emulation:__pkg__",
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

xm1_rust_staticlib(
    name = "bank-lifecycle",
    src = "lib.rs",
    crate_name = "bank",
    rustc_flags = ["--cfg", "rb_lifecycle_scoped"],
    rlib_deps = _RLIB_DEPS,
    visibility = [
        "//emulation:__pkg__",
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

xm1_rust_staticlib(
    name = "bank-modal-lifecycle",
    src = "lib.rs",
    crate_name = "bank",
    rustc_flags = ["--cfg", "rb_modal_scoped", "--cfg", "rb_lifecycle_scoped"],
    rlib_deps = _RLIB_DEPS,
    visibility = [
        "//emulation:__pkg__",
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

genrule(
    name = "build-facts",
    srcs = ["@lab_xm1_rust//:share/xm1-rust/build-facts.txt"],
    outs = ["build-facts.txt"],
    cmd = "cp $(location @lab_xm1_rust//:share/xm1-rust/build-facts.txt) $@",
    visibility = [
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

filegroup(
    name = "relink-sources",
    srcs = [
        "lib.rs",
        "//build-support:bank-source-guard-sources",
        "//replacement/capture:relink-sources",
        "//replacement/menu_engine:module",
        "//replacement/menu_value:module",
        "//replacement/owned_menu:module",
        "//replacement/recipe_ui:module",
        "//replacement/service:relink-sources",
    ],
    visibility = [
        "//host/firmware:__pkg__",
        "//menu:__pkg__",
        "//transport:__pkg__",
    ],
)

filegroup(
    name = "modal-relink-sources",
    srcs = [
        ":relink-sources",
        "//replacement/modal_runtime:relink-sources",
    ],
    visibility = [
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

filegroup(
    name = "modal-engine-relink-sources",
    srcs = [
        ":modal-relink-sources",
        "//replacement/menu_engine:adapter-sources",
        "//replacement/menu_value:adapter-sources",
    ],
    visibility = [
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

filegroup(
    name = "modal-render-relink-sources",
    srcs = [
        ":modal-engine-relink-sources",
        "//replacement/modal_runtime:modal75-owned-sources",
        "//replacement/menu_widgets:module",
        "//replacement/render_adapter:module",
        "//replacement/render_adapter:build.sh",
        "//replacement/render_commands:module",
    ],
    visibility = ["//emulation:__pkg__", "//host/firmware:__pkg__", "//transport:__pkg__"],
)

filegroup(
    name = "lifecycle-relink-sources",
    srcs = [
        ":relink-sources",
        "//replacement/media_permit:relink-sources",
        "//replacement/save:relink-sources",
        "//menu:recipe_bank_allowlist.lifecycle.json",
    ],
    visibility = [
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

filegroup(
    name = "modal-lifecycle-relink-sources",
    srcs = [
        ":lifecycle-relink-sources",
        "//replacement/modal_runtime:relink-sources",
    ],
    visibility = [
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

rust_source_boundary_test(
    name = "unsafe-boundary-check",
    declaration = "unsafe-boundary.json",
    srcs = glob(["*.rs"]),
)
