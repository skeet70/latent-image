xm1_rust_staticlib(
    name = "bank-modal-lifecycle",
    src = "lib.rs",
    crate_name = "bank",
    rustc_flags = ["--cfg", "rb_modal_scoped", "--cfg", "rb_lifecycle_scoped"],
