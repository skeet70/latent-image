/* Link-only trial layout; not an X-M1 placement. */
MEMORY {
    TRIAL_TEXT : ORIGIN = 0x00000000, LENGTH = 1M
    TRIAL_RAM : ORIGIN = 0x00100000, LENGTH = 1M
}

REGION_ALIAS("VECTORS", TRIAL_TEXT);
REGION_ALIAS("CODE", TRIAL_TEXT);
REGION_ALIAS("DATA", TRIAL_RAM);
REGION_ALIAS("STACKS", TRIAL_RAM);
