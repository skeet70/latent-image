load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "application-pump-rust",
    src = "src.rs",
    crate_name = "xm1_application_pump",
)

xm1_rust_elf(
    name = "application-pump-image",
    rust_staticlib = ":application-pump-rust",
    asm_srcs = ["entry.S"],
    entry = "xm1_application_pump",
    link_script = "application-pump.ld",
    extra_ldflags = ["-Wl,--gc-sections", "-Wl,--orphan-handling=error"],
)

haskell_library(
    name = "application-pump-artifact",
    srcs = [
        "Replacement/ApplicationPump/Admission.hs",
        "Replacement/ApplicationPump/Artifact.hs",
        "Replacement/ApplicationPump/Staging.hs",
    ],
    src_strip_prefix = ".",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//emulation:case-sha256",
        "//emulation:image4-staging-lib",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:directory",
        "//host:filepath",
        "//host:first-stage",
        "//host:host-support",
        "//host:update-container",
        "//host/firmware:bank-allowlist",
        "//replacement/record5_staging:record5-staging",
    ],
)

haskell_binary(
    name = "stage-application-pump",
    srcs = ["StageMain.hs"],
    args = [
        "$(rootpath //lz:lz-encode)",
        "$(rootpath //host/firmware:rebuild-update)",
        "$(rootpath //lz:fflzd)",
    ],
    data = ["//lz:lz-encode", "//host/firmware:rebuild-update", "//lz:fflzd"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":application-pump-artifact",
        "//emulation:image4-staging-lib",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
    ],
)

haskell_test(
    name = "application-pump-tests",
    srcs = ["Tests.hs", "Fixtures.hs"],
    main_file = "Tests.hs",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":application-pump-artifact",
        "//host:base",
        "//host:bytestring",
        "//host:update-container",
    ],
)

haskell_test(
    name = "application-pump-artifact-tests",
    srcs = ["Tests.hs", "Fixtures.hs"],
    main_file = "Tests.hs",
    args = [
        "$(rootpath :application-pump-image.bin)",
        "$(rootpath :application-pump-image.symbols)",
    ],
    data = [":application-pump-image.bin", ":application-pump-image.symbols"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":application-pump-artifact",
        "//host:base",
        "//host:bytestring",
        "//host:update-container",
    ],
)

haskell_binary(
    name = "application-pump-source-fixtures",
    srcs = ["Tests.hs", "Fixtures.hs"],
    main_file = "Tests.hs",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":application-pump-artifact",
        "//host:base",
        "//host:bytestring",
        "//host:update-container",
    ],
)
