load("//replacement/toolchain:rust.bzl", "xm1_rust_staticlib")

xm1_rust_staticlib(
    name = "rb_service",
    src = "lib.rs",
    crate_name = "rb_service",
    visibility = [
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

genrule(
    name = "build-facts",
    srcs = ["@lab_xm1_rust//:share/xm1-rust/build-facts.txt"],
    outs = ["build-facts.txt"],
    cmd = "cp $(location @lab_xm1_rust//:share/xm1-rust/build-facts.txt) $@",
    visibility = [
        "//host/firmware:__pkg__",
        "//transport:__pkg__",
    ],
)

filegroup(
    name = "relink-sources",
    srcs = [
        "lib.rs",
        "rb_service.h",
        "rb_service_stock.S",
    ],
    visibility = [
        "//host/firmware:__pkg__",
        "//menu:__pkg__",
        "//transport:__pkg__",
    ],
)
