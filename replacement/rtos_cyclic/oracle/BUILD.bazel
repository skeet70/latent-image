load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "layout-facts-build",
    srcs = [
        "layout-facts.rs",
        "//replacement/rtos_layout:src/lib.rs",
        "//replacement/rtos_reservation:src/lib.rs",
    ],
    outs = ["layout-facts-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 -A dead_code -C linker=$(location @lab_clang//:bin/clang) $(location layout-facts.rs) -o $@",
    executable = True,
    tools = [
        "@lab_clang//:bin/clang",
        "@lab_rustc//:bin/rustc",
    ],
)

genrule(
    name = "layout",
    outs = ["layout.json"],
    cmd = "$(location :layout-facts-build) > $@",
    tools = [":layout-facts-build"],
)

_GHCOPTS = ["-XGHC2021", "-Wall", "-Werror", "-O2"]

haskell_library(
    name = "cyclic-oracle-lib",
    srcs = [
        "Replacement/RtosCyclic/Aggregate.hs",
        "Replacement/RtosCyclic/Layout.hs",
        "Replacement/RtosCyclic/Suite.hs",
    ],
    src_strip_prefix = ".",
    ghcopts = _GHCOPTS,
    deps = [
        "//emulation:cached-native-batch",
        "//emulation:native-adapter",
        "//emulation:native-observation",
        "//emulation:owned-case",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:filepath",
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//replacement/rtos_platform:aggregate",
        "//replacement/rtos_platform:platform-artifact",
    ],
)

haskell_library(
    name = "app-suite",
    srcs = ["Replacement/RtosCyclic/AppSuite.hs"],
    src_strip_prefix = ".",
    ghcopts = _GHCOPTS,
    deps = [
        "//emulation:cached-native-batch",
        "//emulation:native-observation",
        "//emulation:owned-case",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:filepath",
    ],
)

haskell_binary(
    name = "app-callback-oracle",
    srcs = ["AppMain.hs"],
    main_file = "AppMain.hs",
    args = [
        "--runner",
        "$(rootpath //emulation:native-runner)",
        "--owned-bin",
        "$(rootpath //replacement/rtos_cyclic:app-callback.bin)",
        "--owned-symbols",
        "$(rootpath //replacement/rtos_cyclic:app-callback.symbols)",
    ],
    data = [
        "//emulation:native-runner",
        "//replacement/rtos_cyclic:app-callback.bin",
        "//replacement/rtos_cyclic:app-callback.symbols",
    ],
    ghcopts = _GHCOPTS,
    tags = ["manual"],
    deps = [
        ":app-suite",
        "//emulation:case-sha256",
        "//emulation:owned-case",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
        "//host:storage-budget",
    ],
)

haskell_library(
    name = "join-suite",
    srcs = ["Replacement/RtosCyclic/JoinSuite.hs"],
    src_strip_prefix = ".",
    ghcopts = _GHCOPTS,
    deps = [
        ":app-suite",
        ":cyclic-oracle-lib",
        "//emulation:cached-native-batch",
        "//emulation:native-adapter",
        "//emulation:native-observation",
        "//emulation:owned-case",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:filepath",
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//replacement/rtos_timer/oracle:timer-oracle-lib",
    ],
)

haskell_binary(
    name = "join-oracle",
    srcs = ["JoinMain.hs"],
    main_file = "JoinMain.hs",
    args = [
        "--runner",
        "$(rootpath //emulation:native-runner)",
        "--app-bin",
        "$(rootpath //replacement/rtos_cyclic:app-callback.bin)",
        "--app-symbols",
        "$(rootpath //replacement/rtos_cyclic:app-callback.symbols)",
        "--cyclic-bin",
        "$(rootpath //replacement/rtos_cyclic:cyclic-a.bin)",
        "--cyclic-symbols",
        "$(rootpath //replacement/rtos_cyclic:cyclic-a.symbols)",
        "--timer-bin",
        "$(rootpath //replacement/rtos_timer:timer-a.bin)",
        "--timer-symbols",
        "$(rootpath //replacement/rtos_timer:timer-a.symbols)",
    ],
    data = [
        "//emulation:native-runner",
        "//replacement/rtos_cyclic:app-callback.bin",
        "//replacement/rtos_cyclic:app-callback.symbols",
        "//replacement/rtos_cyclic:cyclic-a.bin",
        "//replacement/rtos_cyclic:cyclic-a.symbols",
        "//replacement/rtos_timer:timer-a.bin",
        "//replacement/rtos_timer:timer-a.symbols",
    ],
    tags = ["manual"],
    ghcopts = _GHCOPTS,
    deps = [
        ":app-suite",
        ":cyclic-oracle-lib",
        ":join-suite",
        "//emulation:case-sha256",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
        "//host:storage-budget",
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//replacement/rtos_timer/oracle:timer-oracle-lib",
    ],
)

_INPUTS = [
    ":layout.json",
    "//emulation:native-runner",
    "//replacement/rtos_cyclic:cyclic-a.bin",
    "//replacement/rtos_cyclic:cyclic-a.symbols",
    "//replacement/rtos_cyclic:cyclic-b.bin",
    "//replacement/rtos_cyclic:cyclic-b.symbols",
    "//replacement/rtos_timer:timer-a.bin",
    "//replacement/rtos_timer:timer-a.symbols",
    "//replacement/rtos_timer:timer-b.bin",
    "//replacement/rtos_timer:timer-b.symbols",
]

haskell_binary(
    name = "cyclic-oracle",
    srcs = ["CyclicMain.hs"],
    main_file = "CyclicMain.hs",
    args = [
        "--runner",
        "$(rootpath //emulation:native-runner)",
        "--layout",
        "$(rootpath :layout.json)",
        "--owned-a-bin",
        "$(rootpath //replacement/rtos_cyclic:cyclic-a.bin)",
        "--owned-a-symbols",
        "$(rootpath //replacement/rtos_cyclic:cyclic-a.symbols)",
        "--owned-b-bin",
        "$(rootpath //replacement/rtos_cyclic:cyclic-b.bin)",
        "--owned-b-symbols",
        "$(rootpath //replacement/rtos_cyclic:cyclic-b.symbols)",
        "--timer-a-bin",
        "$(rootpath //replacement/rtos_timer:timer-a.bin)",
        "--timer-a-symbols",
        "$(rootpath //replacement/rtos_timer:timer-a.symbols)",
        "--timer-b-bin",
        "$(rootpath //replacement/rtos_timer:timer-b.bin)",
        "--timer-b-symbols",
        "$(rootpath //replacement/rtos_timer:timer-b.symbols)",
    ],
    data = _INPUTS,
    ghcopts = _GHCOPTS,
    deps = [
        ":cyclic-oracle-lib",
        "//emulation:case-sha256",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
        "//host:json",
        "//host:storage-budget",
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//replacement/rtos_platform:aggregate",
        "//replacement/rtos_platform:platform-artifact",
    ],
)
