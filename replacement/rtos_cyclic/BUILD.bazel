load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "cyclic-rust",
    src = "src/lib.rs",
    crate_name = "xm1_rtos_cyclic",
    data = [
        "src/id.rs",
        "src/machine.rs",
        "src/ops.rs",
        "src/status.rs",
        "src/tests.rs",
        "src/types.rs",
        "//replacement/rtos_layout:src/lib.rs",
        "//replacement/rtos_reservation:src/lib.rs",
    ],
)

[
    xm1_rust_staticlib(
        name = "cyclic-abi-%s-rust" % domain,
        src = "src/lib.rs",
        crate_name = "xm1_rtos_cyclic_abi",
        data = [
            "src/id.rs",
            "src/machine.rs",
            "src/ops.rs",
            "src/status.rs",
            "src/types.rs",
            "stage/abi.rs",
            "//replacement/rtos_layout:src/lib.rs",
            "//replacement/rtos_reservation:src/lib.rs",
        ],
        rustc_flags = [
            "--cfg",
            "'feature=\"domain-%s\"'" % domain,
            "--cfg",
            "'feature=\"stage\"'",
        ],
    )
    for domain in ["a", "b"]
]

[
    xm1_rust_elf(
        name = "cyclic-%s" % domain,
        rust_staticlib = ":cyclic-abi-%s-rust" % domain,
        entry = "xm1_rtos_cyclic_start",
        extra_ldflags = [
            "-Wl,--gc-sections",
            "-Wl,--orphan-handling=error",
        ],
        link_script = "cyclic-%s.ld" % domain,
    )
    for domain in ["a", "b"]
]

genrule(
    name = "timer-host-rlib",
    srcs = [
        "//replacement/rtos_layout:src/lib.rs",
        "//replacement/rtos_reservation:src/lib.rs",
        "//replacement/rtos_timer:src/lib.rs",
    ],
    outs = ["libxm1_rtos_timer_host.rlib"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --crate-name=xm1_rtos_timer_host --crate-type=rlib -C linker=$(location @lab_clang//:bin/clang) $(location //replacement/rtos_timer:src/lib.rs) -o $@",
    tools = [
        "@lab_clang//:bin/clang",
        "@lab_rustc//:bin/rustc",
    ],
)

genrule(
    name = "cyclic-host-tests-build",
    srcs = [
        "src/id.rs",
        "src/lib.rs",
        "src/machine.rs",
        "src/ops.rs",
        "src/status.rs",
        "src/tests.rs",
        "src/types.rs",
        "//replacement/rtos_layout:src/lib.rs",
        "//replacement/rtos_reservation:src/lib.rs",
        ":timer-host-rlib",
    ],
    outs = ["cyclic-host-tests-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --test -C linker=$(location @lab_clang//:bin/clang) --extern xm1_rtos_timer_host=$(location :timer-host-rlib) $(location src/lib.rs) -o $@",
    executable = True,
    tools = [
        "@lab_clang//:bin/clang",
        "@lab_rustc//:bin/rustc",
    ],
)

sh_test(
    name = "cyclic-host-tests",
    size = "small",
    srcs = ["//emulation:recovery-task-state-tests.sh"],
    args = ["$(location :cyclic-host-tests-build)"],
    data = [":cyclic-host-tests-build"],
)
