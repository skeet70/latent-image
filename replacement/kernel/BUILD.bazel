load("//replacement/toolchain:rust.bzl", "xm1_rust_rlib")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "host",
    srcs = ["src/lib.rs", "src/fake.rs", "src/slot_table.rs"],
    outs = ["host/libxm1_kernel.rlib"],
    cmd = "$(location @lab_xm1_rust//:bin/rustc) --edition=2021 --crate-type=rlib --crate-name=xm1_kernel $(location src/lib.rs) -o $@",
    tools = ["@lab_xm1_rust//:bin/rustc"],
)

xm1_rust_rlib(
    name = "arm",
    src = "src/lib.rs",
    data = ["src/fake.rs", "src/slot_table.rs"],
    crate_name = "xm1_kernel",
    out = "arm/libxm1_kernel.rlib",
    rustc_flags = ["-C", "jump-tables=no"],
)

genrule(
    name = "host-test-binary",
    srcs = ["src/lib.rs", "src/fake.rs", "src/slot_table.rs", "src/host_tests.rs", "src/slot_table_tests.rs"],
    outs = ["kernel-host-tests-bin"],
    cmd = "$(location @lab_xm1_rust//:bin/rustc) --edition=2021 --test --crate-name=xm1_kernel $(location src/lib.rs) -o $@",
    executable = True,
    tools = ["@lab_xm1_rust//:bin/rustc"],
)

sh_test(
    name = "host-tests",
    size = "small",
    srcs = ["host-test.sh"],
    args = ["$(location :host-test-binary)"],
    data = [":host-test-binary"],
)
