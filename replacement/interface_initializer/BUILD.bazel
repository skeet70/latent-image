load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "interface-initializer-rust",
    src = "src.rs",
    crate_name = "xm1_interface_initializer",
    data = [
        "//replacement/loader_prefix:adapter.rs",
        "//replacement/loader_prefix:src.rs",
        "//replacement/secondary_stage:adapter.rs",
        "//replacement/secondary_stage:src.rs",
    ],
)

xm1_rust_elf(
    name = "interface-initializer-image",
    asm_srcs = [
        "//replacement/secondary_stage:entry.S",
        "//replacement/loader_prefix:entry.S",
        "entry.S",
    ],
    entry = "xm1_secondary_entry",
    link_includes = ["//replacement/secondary_stage:secondary-stage.ld"],
    link_script = "//replacement/loader_prefix:loader-prefix.ld",
    rust_staticlib = ":interface-initializer-rust",
)
