load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "plain-load-rust",
    src = "src.rs",
    crate_name = "xm1_plain_load",
)

xm1_rust_elf(
    name = "plain-load-image",
    rust_staticlib = ":plain-load-rust",
    asm_srcs = ["entry.S"],
    entry = "xm1_plain_load_entry",
    link_script = "plain-load.ld",
    extra_ldflags = ["-Wl,--gc-sections"],
)

haskell_library(
    name = "plain-load-artifact",
    srcs = [
        "Replacement/PlainLoad/Admission.hs",
        "Replacement/PlainLoad/Artifact.hs",
    ],
    src_strip_prefix = ".",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//emulation:case-sha256",
        "//emulation:image4-staging-lib",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:first-stage",
        "//host:update-container",
        "//host/firmware:bank-allowlist",
    ],
)

haskell_binary(
    name = "stage-plain-load",
    srcs = ["StageMain.hs"],
    args = [
        "$(rootpath //lz:lz-encode)",
        "$(rootpath //host/firmware:rebuild-update)",
        "$(rootpath //lz:fflzd)",
    ],
    data = ["//lz:lz-encode", "//host/firmware:rebuild-update", "//lz:fflzd"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":plain-load-artifact",
        "//emulation:image4-staging-lib",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:host-support",
    ],
)

haskell_test(
    name = "plain-load-tests",
    srcs = ["Tests.hs", "Fixtures.hs"],
    main_file = "Tests.hs",
    args = [
        "$(rootpath :plain-load-image.bin)",
        "$(rootpath :plain-load-image.symbols)",
    ],
    data = [":plain-load-image.bin", ":plain-load-image.symbols"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":plain-load-artifact",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:first-stage",
        "//host:update-container",
    ],
)

haskell_test(
    name = "plain-load-artifact-tests",
    srcs = ["ArtifactTests.hs"],
    args = [
        "$(rootpath :plain-load-image.bin)",
        "$(rootpath :plain-load-image.symbols)",
    ],
    data = [":plain-load-image.bin", ":plain-load-image.symbols"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":plain-load-artifact",
        "//host:base",
        "//host:bytestring",
    ],
)

haskell_binary(
    name = "stock-read-failures",
    srcs = ["StockFailures.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//emulation:owned-case",
        "//emulation:native-observation",
        "//emulation:case-sha256",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:json",
    ],
)
