load("//replacement/toolchain:rust.bzl", "xm1_rust_host_rlib", "xm1_rust_rlib")

package(default_visibility = ["//visibility:public"])

exports_files([
    "src/lib.rs",
    "src/boot_skip.rs",
    "src/physical.rs",
    "src/events.rs",
    "src/memory.rs",
    "src/memory_tests.rs",
    "src/dma_read.rs",
    "src/dma_read_tests.rs",
    "src/dma_native.rs",
])

filegroup(
    name = "sources",
    srcs = [
        "src/lib.rs",
        "src/boot_skip.rs",
        "src/physical.rs",
        "src/events.rs",
        "src/memory.rs",
        "src/dma_read.rs",
        "src/dma_native.rs",
        "//replacement/first_stage:format.rs",
        "//replacement/embassy_platform:src/clock.rs",
    ],

)

genrule(
    name = "host-tests",
    testonly = True,
    srcs = [
        "src/lib.rs",
        "src/boot_skip.rs",
        "src/physical.rs",
        "src/events.rs",
        "src/memory.rs",
        "src/memory_tests.rs",
        "src/dma_read.rs",
        "src/dma_read_tests.rs",
        "//replacement/first_stage:format.rs",
    ],
    outs = ["application-nand-host-tests-bin", "application-nand-host-tests.passed"],
    tools = ["@lab_rustc//:bin/rustc", "@lab_clang//:bin/clang"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --test --cfg xm1_application_nand_host_tests -C linker=$(location @lab_clang//:bin/clang) $(location src/lib.rs) -o $(@D)/application-nand-host-tests-bin && $(@D)/application-nand-host-tests-bin && touch $(@D)/application-nand-host-tests.passed",
)

xm1_rust_host_rlib(
    name = "host",
    src = "src/lib.rs",
    crate_name = "xm1_application_nand",
    data = [
        "src/boot_skip.rs",
        "src/physical.rs",
        "src/events.rs",
        "src/memory.rs",
        "src/dma_read.rs",
        "//replacement/first_stage:format.rs",
    ],
)

xm1_rust_rlib(
    name = "arm",
    src = "src/lib.rs",
    crate_name = "xm1_application_nand",
    out = "arm/libxm1_application_nand.rlib",
    data = [
        "src/boot_skip.rs",
        "src/physical.rs",
        "src/events.rs",
        "src/memory.rs",
        "src/dma_read.rs",
        "src/dma_native.rs",
        "//replacement/first_stage:format.rs",
        "//replacement/embassy_platform:src/clock.rs",
    ],
)

filegroup(
    name = "shim-catalog-data",
    srcs = glob(["shims.json", "**/*.json", "**/*.ld"]) + ["BUILD.bazel"],
    visibility = ["//replacement/shim_check:__pkg__"],
)
