load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")

package(default_visibility = ["//visibility:public"])

_LINKED = [
    "//replacement/rtos_own_first:regions.json",
    "//replacement/rtos_own_first:own-first-a.bin",
    "//replacement/rtos_own_first:own-first-a.symbols",
    "//replacement/rtos_own_first:own-first-b.bin",
    "//replacement/rtos_own_first:own-first-b.symbols",
]

haskell_library(
    name = "own-first-oracle-lib",
    srcs = [
        "Replacement/RtosOwnFirst/Assembly.hs",
        "Replacement/RtosOwnFirst/Command.hs",
        "Replacement/RtosOwnFirst/Controls.hs",
        "Replacement/RtosOwnFirst/Generate.hs",
        "Replacement/RtosOwnFirst/Generated.hs",
        "Replacement/RtosOwnFirst/Oracle.hs",
        "Replacement/RtosOwnFirst/Replay.hs",
        "Replacement/RtosOwnFirst/Shrink.hs",
        "Replacement/RtosOwnFirst/Verdict.hs",
    ],
    src_strip_prefix = ".",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//emulation:case-sha256",
        "//emulation:native-adapter",
        "//emulation:native-observation",
        "//emulation:owned-case",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:directory",
        "//host:filepath",
        "//host:first-stage",
        "//host:host-support",
        "//host:json",
        "//host:text",
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//replacement/rtos_platform:aggregate",
        "//replacement/rtos_platform:platform-artifact",
    ],
)

# The stock loaders come from private-data:
# bazel run //replacement/rtos_own_first/oracle:own-first-oracle -- --loader-a LOADER_A --loader-b LOADER_B --work NEW_DIRECTORY --summary NEW_JSON
# Aggregate mode takes complete effective carrier slices from staged loaders through --aggregate-a-bin
# and --aggregate-b-bin, with --aggregate-a-symbols/--aggregate-b-symbols and --placements-a/--placements-b.
# Direct invocation accepts --carriers for the matching emitted union metadata.
haskell_binary(
    name = "own-first-oracle",
    srcs = ["OracleMain.hs"],
    main_file = "OracleMain.hs",
    args = [
        "--runner",
        "$(rootpath //emulation:native-runner)",
        "--regions",
        "$(rootpath //replacement/rtos_own_first:regions.json)",
        "--carriers",
        "$(rootpath //replacement/rtos_platform:carriers.json)",
        "--owned-a-bin",
        "$(rootpath //replacement/rtos_own_first:own-first-a.bin)",
        "--owned-a-symbols",
        "$(rootpath //replacement/rtos_own_first:own-first-a.symbols)",
        "--owned-b-bin",
        "$(rootpath //replacement/rtos_own_first:own-first-b.bin)",
        "--owned-b-symbols",
        "$(rootpath //replacement/rtos_own_first:own-first-b.symbols)",
    ],
    data = _LINKED + ["//emulation:native-runner", "//replacement/rtos_platform:carriers.json"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":own-first-oracle-lib",
        "//emulation:case-sha256",
        "//emulation:emulator-slot-lib",
        "//emulation:native-adapter",
        "//emulation:owned-case",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
        "//host:json",
        "//replacement/rtos_own_first/stage:own-first-artifact",
    ],
)

_TEST_DEPS = [
    ":own-first-oracle-lib",
    "//emulation:case-sha256",
    "//emulation:owned-case",
    "//emulation:native-adapter",
    "//emulation:native-observation",
    "//host:aeson",
    "//host:base",
    "//host:bytestring",
    "//host:containers",
    "//host:directory",
    "//host:filepath",
    "//host:host-support",
    "//replacement/rtos_own_first/stage:own-first-artifact",
]

[
    haskell_test(
        name = name,
        size = size,
        srcs = ["OracleTests.hs"],
        main_file = "OracleTests.hs",
        args = [scope, "$(rootpath //emulation:native-runner)"] + ["$(rootpath %s)" % linked for linked in _LINKED],
        data = _LINKED + ["//emulation:native-runner"],
        ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
        tags = tags,
        deps = _TEST_DEPS,
    )
    for name, size, scope, tags in [
        ("own-first-oracle-tests", "medium", "sample", []),
        # Every grid row of every slot; about ten minutes.
        ("own-first-oracle-full-tests", "large", "full", ["manual"]),
    ]
]
