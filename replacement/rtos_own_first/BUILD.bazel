load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_rlib", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

exports_files([
    "check-bin-digests.sh",
    "regions.json",
])

genrule(
    name = "host-core",
    srcs = [
        "src/lib.rs",
        "//replacement/rtos_layout:src/lib.rs",
        "//replacement/rtos_reservation:src/lib.rs",
    ],
    outs = ["host/libxm1_rtos_own_first.rlib"],
    cmd = "$(location @lab_xm1_rust//:bin/rustc) --edition=2021 --crate-name=xm1_rtos_own_first --crate-type=rlib --cfg 'feature=\"library\"' -C metadata=library $(location src/lib.rs) -o $@",
    tools = ["@lab_xm1_rust//:bin/rustc"],
)

xm1_rust_rlib(
    name = "libxm1_rtos_own_first",
    src = "src/lib.rs",
    crate_name = "xm1_rtos_own_first",
    data = [
        "//replacement/rtos_layout:src/lib.rs",
        "//replacement/rtos_reservation:src/lib.rs",
    ],
    rustc_flags = ["--cfg", "'feature=\"library\"'", "-C", "metadata=library"],
)

[
    xm1_rust_staticlib(
        name = "own-first-%s-rust" % domain,
        src = "src/lib.rs",
        crate_name = "xm1_rtos_own_first",
        data = [
            "src/entries.rs",
            "//replacement/rtos_layout:src/lib.rs", "//replacement/rtos_reservation:src/lib.rs",
        ],
        rustc_flags = ["--cfg", "'feature=\"domain-%s\"'" % domain],
    )
    for domain in ["a", "b"]
]

[
    xm1_rust_elf(
        name = "own-first-%s" % domain,
        rust_staticlib = ":own-first-%s-rust" % domain,
        entry = "xm1_rtos_own_first_slot_60",
        extra_ldflags = [
            "-Wl,--gc-sections",
            "-Wl,--orphan-handling=error",
        ],
        link_script = "own-first-%s.ld" % domain,
    )
    for domain in ["a", "b"]
]

genrule(
    name = "own-first-host-tests-build",
    srcs = [
        "src/lib.rs",
        "src/tests.rs",
        "//replacement/rtos_layout:src/lib.rs", "//replacement/rtos_reservation:src/lib.rs",
    ],
    outs = ["own-first-host-tests-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --test -C linker=$(location @lab_clang//:bin/clang) $(location src/lib.rs) -o $@",
    executable = True,
    tools = [
        "@lab_clang//:bin/clang",
        "@lab_rustc//:bin/rustc",
    ],
)

sh_test(
    name = "own-first-host-tests",
    size = "small",
    srcs = ["//emulation:recovery-task-state-tests.sh"],
    args = ["$(location :own-first-host-tests-build)"],
    data = [":own-first-host-tests-build"],
)

sh_test(
    name = "own-first-regions-tests",
    size = "small",
    srcs = ["check-regions.sh"],
    args = [
        "$(location @lab_jq//:bin/jq)",
        "$(location regions.json)",
        "$(location :own-first-a.symbols)",
        "$(location :own-first-b.symbols)",
    ],
    data = [
        "regions.json",
        ":own-first-a.symbols",
        ":own-first-b.symbols",
        "@lab_jq//:bin/jq",
    ],
)

sh_test(
    name = "own-first-bin-digests-tests",
    size = "small",
    srcs = ["check-bin-digests.sh"],
    args = [
        "$(location @lab_coreutils//:bin/sha256sum)",
        "7bef1d63ecb5fe177d313114fd63cbfbced9dca77311f5461520d42a3a643da0",
        "$(location :own-first-a.bin)",
        "91802f2998b8247e42cc22591fb1ac5222caccc68dd57d4be00ecef69e979149",
        "$(location :own-first-b.bin)",
    ],
    data = [
        ":own-first-a.bin",
        ":own-first-b.bin",
        "@lab_coreutils//:bin/sha256sum",
    ],
)
