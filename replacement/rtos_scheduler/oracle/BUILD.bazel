        "//replacement/rtos_platform:platform-a.symbols",
        "//replacement/rtos_platform:platform-b.symbols",
    ],
    ghcopts = _GHCOPTS,
    deps = [
        ":scheduler-oracle-lib",
        "//emulation:case-sha256",
        "//emulation:native-observation",
        "//emulation:owned-case",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
        "//host:json",
        "//replacement/rtos_own_first/stage:own-first-artifact",
    ],
