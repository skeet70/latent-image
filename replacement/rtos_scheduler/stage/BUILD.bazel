load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")

package(default_visibility = ["//visibility:public"])

haskell_library(
    name = "scheduler-artifact",
    srcs = [
        "Replacement/RtosScheduler/Artifact.hs",
        "Replacement/RtosScheduler/Cutover.hs",
        "Replacement/RtosScheduler/CutoverPins.hs",
        "Replacement/RtosScheduler/Family.hs",
        "Replacement/RtosScheduler/Semantic.hs",
    ],
    src_strip_prefix = ".",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//emulation:case-sha256",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:first-stage",
        "//host:text",
        "//host:update-container",
        "//host/firmware:bank-allowlist",
    ],
)

_LINKED = [
    "//replacement/rtos_scheduler:regions.json",
    "//replacement/rtos_scheduler:scheduler-a.bin",
    "//replacement/rtos_scheduler:scheduler-a.symbols",
    "//replacement/rtos_scheduler:scheduler-b.bin",
    "//replacement/rtos_scheduler:scheduler-b.symbols",
]

haskell_binary(
    name = "stage-scheduler",
    srcs = ["StageMain.hs"],
    main_file = "StageMain.hs",
    args = ["$(rootpath %s)" % linked for linked in _LINKED],
    data = _LINKED,
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":scheduler-artifact",
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
    ],
)

haskell_test(
    name = "scheduler-stage-tests",
    size = "small",
    srcs = ["Tests.hs", "//replacement/startup_artifact:Fixtures.hs"],
    main_file = "Tests.hs",
    args = ["$(rootpath %s)" % linked for linked in _LINKED],
    data = _LINKED,
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":scheduler-artifact",
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//host:base",
        "//host:bytestring",
        "//host:first-stage",
        "//host:update-container",
    ],
)

_CUTOVER = _LINKED + [
    "//replacement/rtos_scheduler:" + name
    for metadata, binary in [
        ("regions-s2.json", "scheduler-s2"),
        ("regions-s3a.json", "s3a"),
        ("regions-s3b.json", "s3b"),
        ("regions-s3c.json", "s3c"),
    ]
    for name in [metadata, binary + "-a.bin", binary + "-a.symbols", binary + "-b.bin", binary + "-b.symbols"]
] + [
    "//replacement/rtos_own_first:" + name
    for name in ["regions.json", "own-first-a.bin", "own-first-a.symbols", "own-first-b.bin", "own-first-b.symbols"]
]

haskell_binary(
    name = "stage-cutover",
    srcs = ["CutoverMain.hs"],
    main_file = "CutoverMain.hs",
    args = ["$(rootpath %s)" % linked for linked in _CUTOVER],
    data = _CUTOVER,
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":scheduler-artifact",
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
    ],
)

haskell_test(
    name = "cutover-stage-tests",
    size = "small",
    srcs = ["CutoverTests.hs", "//replacement/startup_artifact:Fixtures.hs"],
    main_file = "CutoverTests.hs",
    args = ["$(rootpath %s)" % linked for linked in _CUTOVER],
    data = _CUTOVER,
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":scheduler-artifact",
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:first-stage",
        "//host:update-container",
    ],
)

_FAMILY = [
    "//replacement/rtos_objects:objects-family-stage-%s.%s" % (domain, suffix)
    for domain in ["a", "b"]
    for suffix in ["bin", "symbols"]
]

haskell_binary(
    name = "family-cutover",
    srcs = ["FamilyMain.hs"],
    main_file = "FamilyMain.hs",
    args = ["$(rootpath %s)" % linked for linked in _CUTOVER + _FAMILY],
    data = _CUTOVER + _FAMILY,
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":scheduler-artifact",
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
    ],
)

haskell_test(
    name = "family-cutover-tests",
    size = "small",
    srcs = ["FamilyTests.hs", "//replacement/startup_artifact:Fixtures.hs"],
    main_file = "FamilyTests.hs",
    args = ["$(rootpath %s)" % linked for linked in _CUTOVER + _FAMILY],
    data = _CUTOVER + _FAMILY,
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":scheduler-artifact",
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:first-stage",
        "//host:update-container",
    ],
)
