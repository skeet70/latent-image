load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

exports_files(
    ["rtos_slot_contracts.json"],
    visibility = ["//visibility:public"],
)
exports_files(["rb_media_permit_stock.S"], visibility = ["//replacement/develop:__pkg__"])


filegroup(
    name = "module",
    srcs = ["src/lib.rs"],
    visibility = ["//replacement/bank:__pkg__", "//replacement/develop:__pkg__"],
)

filegroup(
    name = "adapter",
    srcs = ["src/stock.rs"],
    visibility = ["//replacement/bank:__pkg__", "//replacement/develop:__pkg__"],
)

filegroup(
    name = "relink-sources",
    srcs = [
        "rb_media_permit_stock.S",
        "src/lib.rs",
        "src/stock.rs",
        "stock_calls.json",
    ],
    visibility = ["//replacement/bank:__pkg__", "//replacement/develop:__pkg__"],
)

# media-permit-candidate.elf's bound function bytes are the media-package
# binding of E-SAVE-LIFECYCLE-PACKAGE-HOST-150 (lifecycle129/media-package-binding.json).
# Opted out until the candidate is requalified, at the latest in the runner
# requalification.
xm1_rust_staticlib(
    name = "media-permit-lib",
    src = "standalone.rs",
    crate_name = "media_permit_candidate",
    data = [
        "src/lib.rs",
        "src/stock.rs",
    ],
    strict_align = False,
)

xm1_rust_elf(
    name = "media-permit-candidate",
    asm_srcs = [
        "rb_media_permit_probe.S",
        "rb_media_permit_stock.S",
    ],
    entry = "rb_media_permit_case",
    extra_ldflags = ["-Wl,-u,rb_media_permit_case"],
    link_script = "media_permit.ld",
    rust_staticlib = ":media-permit-lib",
    visibility = ["//visibility:public"],
)

xm1_rust_staticlib(
    name = "media-permit-defect-lib",
    testonly = True,
    src = "standalone.rs",
    crate_name = "media_permit_defect",
    data = [
        "src/lib.rs",
        "src/stock.rs",
    ],
    rustc_flags = [
        "--cfg",
        "media_permit_defect",
    ],
    strict_align = False,
)

xm1_rust_elf(
    name = "media-permit-defect",
    testonly = True,
    asm_srcs = [
        "rb_media_permit_probe.S",
        "rb_media_permit_stock.S",
    ],
    entry = "rb_media_permit_case",
    extra_ldflags = ["-Wl,-u,rb_media_permit_case"],
    link_script = "media_permit.ld",
    rust_staticlib = ":media-permit-defect-lib",
    visibility = ["//visibility:public"],
)

