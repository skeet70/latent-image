load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "low-lib",
    src = "low.rs",
    crate_name = "media_permit_low",
    data = ["src/model.rs"],
    rustc_flags = ["-C", "function-sections=yes"],
)

xm1_rust_elf(
    name = "low",
    entry = "rb_mp_memcpy",
    link_script = "low.ld",
    rust_staticlib = ":low-lib",
)

