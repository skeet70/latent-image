load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_rlib")

filegroup(
    name = "module",
    srcs = ["src/lib.rs"],
    visibility = [
        "//replacement/bank:__pkg__",
        "//host/firmware:__pkg__",
    ],
)

xm1_rust_rlib(
    name = "arm",
    src = "src/arm.rs",
    crate_name = "recipe_ui",
    out = "librecipe_ui.rlib",
    data = [":module"],
    rustc_flags = [
        "-C",
        "target-feature=+strict-align",
        "-C",
        "llvm-args=-min-jump-table-entries=4096",
    ],
    rlib_deps = {"menu_engine": "//replacement/menu_engine:arm"},
    visibility = ["//replacement/bank:__pkg__"],
)

genrule(
    name = "route-tests-build",
    srcs = ["src/lib.rs", "//replacement/menu_engine:host-library"],
    outs = ["route-tests-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --test --extern menu_engine=$(location //replacement/menu_engine:host-library) -C linker=$(location @lab_clang//:bin/clang) $(location src/lib.rs) -o $@",
    executable = True,
    tools = ["@lab_rustc//:bin/rustc", "@lab_clang//:bin/clang"],
)

sh_test(
    name = "route-tests",
    size = "small",
    srcs = ["//emulation:recovery-task-state-tests.sh"],
    args = ["$(location :route-tests-build)"],
    data = [":route-tests-build"],
)
