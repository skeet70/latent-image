load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "timer-rust",
    src = "src/lib.rs",
    crate_name = "xm1_rtos_timer",
    data = [
        "src/tests.rs",
        "//replacement/rtos_layout:src/lib.rs",
    ],
)

genrule(
    name = "timer-host-tests-build",
    srcs = [
        "src/lib.rs",
        "src/tests.rs",
        "//replacement/rtos_layout:src/lib.rs",
    ],
    outs = ["timer-host-tests-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --test -C linker=$(location @lab_clang//:bin/clang) $(location src/lib.rs) -o $@",
    executable = True,
    tools = [
        "@lab_clang//:bin/clang",
        "@lab_rustc//:bin/rustc",
    ],
)

sh_test(
    name = "timer-host-tests",
    size = "small",
    srcs = ["//emulation:recovery-task-state-tests.sh"],
    args = ["$(location :timer-host-tests-build)"],
    data = [":timer-host-tests-build"],
)
