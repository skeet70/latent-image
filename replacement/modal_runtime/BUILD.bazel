    visibility = ["//replacement/bank:__pkg__"],
)

genrule(
    name = "modal75-tests-build",
    srcs = [
        "src/modal75.rs",
        "src/picker.rs",
        "//replacement/menu_engine:host-library",
    ],
    outs = ["modal75-tests-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --test --extern menu_engine=$(location //replacement/menu_engine:host-library) -C linker=$(location @lab_clang//:bin/clang) $(location src/modal75.rs) -o $@",
    executable = True,
    tools = ["@lab_rustc//:bin/rustc", "@lab_clang//:bin/clang"],
)

sh_test(
    name = "modal75-tests",
    size = "small",
    srcs = ["//emulation:recovery-task-state-tests.sh"],
    args = ["$(location :modal75-tests-build)"],
    data = [":modal75-tests-build"],
)

