load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_rlib")
load(":controls.bzl", "FILE_SERVICE_CONTROLS", "file_service_suffixes")

package(default_visibility = ["//visibility:public"])

exports_files(["imports.ld"])

_SOURCES = [
    "src/completion.rs",
    "src/handles.rs",
    "src/requests.rs",
    "src/routing.rs",
    "src/search.rs",
    "src/stock.rs",
    "src/stock_requests.rs",
    "src/stock_search.rs",
    "src/stock_workers.rs",
    "src/workers.rs",
    "src/stock_volume.rs",
    "src/volume.rs",
]

[xm1_rust_rlib(
    name = "arm" + suffix,
    src = "src/lib.rs",
    crate_name = "xm1_file_service",
    data = _SOURCES,
    out = "arm%s/libxm1_file_service.rlib" % suffix,
    rustc_flags = flags,
) for suffix, flags in [("", [])] + [
    ("-control-" + control.replace("_", "-"), ["--cfg", "file_service_control_" + control])
    for control in FILE_SERVICE_CONTROLS
]]

genrule(
    name = "host-tests",
    srcs = ["src/lib.rs"] + glob(["src/*tests.rs"]) + _SOURCES,
    outs = ["host-tests.passed"],
    cmd = "$(location @lab_xm1_rust//:bin/rustc) --edition=2021 --test $(location src/lib.rs) -o $(@D)/host-tests && $(@D)/host-tests && touch $@",
    tools = ["@lab_xm1_rust//:bin/rustc"],
)

haskell_library(
    name = "native-lib",
    srcs = [
        "Replacement/FileService/Handles.hs",
        "Replacement/FileService/Native.hs",
        "Replacement/FileService/Requests.hs",
        "Replacement/FileService/Search.hs",
        "Replacement/FileService/Workers.hs",
        "Replacement/FileService/Volume.hs",
    ],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    src_strip_prefix = ".",
    deps = [
        "//emulation:case-sha256",
        "//emulation:native-adapter",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:directory",
        "//host:filepath",
        "//host:text",
        "//host:vector",
        "//host/firmware:bank-allowlist",
        "//replacement/fixed_image:contract",
    ],
)

haskell_binary(
    name = "file-service-suite",
    srcs = ["SuiteMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    main_file = "SuiteMain.hs",
    deps = [
        ":native-lib",
        "//emulation:case-sha256",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host/firmware:bank-allowlist",
    ],
)

haskell_binary(
    name = "file-service-stage",
    srcs = ["StageMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    main_file = "StageMain.hs",
    deps = [
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host/firmware:bank-allowlist",
    ],
)

haskell_library(
    name = "payload",
    srcs = ["Replacement/FileService/Payload.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    src_strip_prefix = ".",
    deps = ["//host:base"],
)

haskell_test(
    name = "payload-tests",
    size = "small",
    srcs = ["PayloadTests.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror"],
    deps = [
        ":payload",
        "//host:base",
        "//host:bytestring",
    ],
)

haskell_binary(
    name = "file-service-observe",
    srcs = ["ObserveMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    main_file = "ObserveMain.hs",
    deps = [
        ":payload",
        "//emulation:case-sha256",
        "//emulation:emulator-usb",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:directory",
        "//host:filepath",
        "//host:text",
        "//host:vector",
    ],
)

filegroup(
    name = "all",
    srcs = [
        ":file-service-observe",
        ":file-service-stage",
        ":file-service-suite",
        ":host-tests",
    ] + ["//replacement/fixed_image:fixed-bank-image" + suffix for suffix in file_service_suffixes()],
)

filegroup(
    name = "shim-catalog-data",
    srcs = glob(["shims.json", "**/*.ld"]) + ["BUILD.bazel"],
    visibility = ["//replacement/shim_check:__pkg__"],
)
