load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "loader-orchestration-rust",
    src = "src.rs",
    crate_name = "xm1_loader_orchestration",
    rustc_flags = ["-C", "jump-tables=no", "-C", "force-frame-pointers=yes"],
)

[
    xm1_rust_elf(
        name = "loader-%s-orchestration-image" % side,
        rust_staticlib = ":loader-orchestration-rust",
        asm_srcs = ["entry.S"],
        entry = "xm1_loader_orchestration_entry",
        link_script = "loader-%s.ld" % side,
        link_includes = ["loader-orchestration.ld"],
        extra_ldflags = ["-Wl,--gc-sections"],
    )
    for side in ["a", "b"]
]

haskell_library(
    name = "loader-orchestration-artifact",
    srcs = [
        "Replacement/LoaderOrchestration/Admission.hs",
        "Replacement/LoaderOrchestration/Artifact.hs",
        "Replacement/LoaderOrchestration/Interface.hs",
    ],
    src_strip_prefix = ".",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//emulation:case-sha256",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:first-stage",
        "//host:update-container",
        "//host/firmware:bank-allowlist",
        "//replacement/startup_dispatch:startup-dispatch-artifact",
    ],
)

haskell_binary(
    name = "stage-loader-orchestration",
    srcs = ["StageMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":loader-orchestration-artifact",
        "//emulation:image4-staging-lib",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
    ],
)

haskell_test(
    name = "loader-orchestration-tests",
    srcs = ["Fixtures.hs", "Tests.hs"],
    main_file = "Tests.hs",
    args = [
        "$(rootpath :loader-a-orchestration-image.bin)",
        "$(rootpath :loader-a-orchestration-image.symbols)",
        "$(rootpath :loader-b-orchestration-image.bin)",
        "$(rootpath :loader-b-orchestration-image.symbols)",
    ],
    data = [
        ":loader-a-orchestration-image.bin",
        ":loader-a-orchestration-image.symbols",
        ":loader-b-orchestration-image.bin",
        ":loader-b-orchestration-image.symbols",
    ],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":loader-orchestration-artifact",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:update-container",
        "//host/firmware:bank-allowlist",
    ],
)
