load("//replacement/toolchain:rust.bzl", "xm1_rust_host_rlib", "xm1_rust_host_test", "xm1_rust_rlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_rlib(
    name = "saclac-interface",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_interface",
    out = "arm/libxm1_saclac_interface.rlib",
    data = ["src/stock.rs", "src/round.rs", "src/calc.rs"],
)

xm1_rust_host_rlib(
    name = "host",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_interface",
    data = ["src/stock.rs", "src/round.rs", "src/calc.rs"],
)

xm1_rust_host_test(
    name = "host-tests",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_interface",
    data = ["src/stock.rs", "src/round.rs", "src/calc.rs", "src/tests.rs", "src/calc_tests.rs"],
)
