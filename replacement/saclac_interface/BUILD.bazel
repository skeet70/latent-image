load("//replacement/toolchain:rust.bzl", "xm1_rust_host_rlib", "xm1_rust_host_test", "xm1_rust_rlib")

package(default_visibility = ["//visibility:public"])

SOURCES = [
    "src/calc.rs",
    "src/calculation.rs",
    "src/exposure.rs",
    "src/round.rs",
    "src/statistics.rs",
    "src/stock.rs",
    "src/stock/calculation_result.rs",
    "src/stock/exposure.rs",
]

xm1_rust_rlib(
    name = "saclac-interface",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_interface",
    out = "arm/libxm1_saclac_interface.rlib",
    data = SOURCES,
)

xm1_rust_host_rlib(
    name = "host",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_interface",
    data = SOURCES,
)

xm1_rust_host_test(
    name = "host-tests",
    src = "src/lib.rs",
    crate_name = "xm1_saclac_interface",
    data = SOURCES + [
        "src/calc_tests.rs",
        "src/calculation_tests.rs",
        "src/exposure_tests.rs",
        "src/statistics_tests.rs",
        "src/tests.rs",
    ],
)
