load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_rlib", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "objects-rust",
    src = "src/lib.rs",
    crate_name = "xm1_rtos_objects",
    data = [
        "src/admission.rs",
        "src/block.rs",
        "src/create.rs",
        "src/id.rs",
        "src/locked.rs",
        "src/matching.rs",
        "src/message.rs",
        "src/order.rs",
        "src/sim.rs",
        "src/status.rs",
        "src/teardown.rs",
        "src/timeout.rs",
        "src/wake.rs",
        "//replacement/rtos_layout:src/lib.rs", "//replacement/rtos_reservation:src/lib.rs",
    ],
)

[
    xm1_rust_rlib(
        name = "scheduler-%s-component" % domain,
        src = "//replacement/rtos_scheduler:src/lib.rs",
        crate_name = "xm1_rtos_scheduler",
        data = [
            "//replacement/rtos_scheduler:src/entries.rs",
            "//replacement/rtos_scheduler:src/s3a.rs",
            "//replacement/rtos_scheduler:src/s3b.rs",
            "//replacement/rtos_scheduler:src/tests.rs",
            "//replacement/rtos_layout:src/lib.rs", "//replacement/rtos_reservation:src/lib.rs",
        ],
        rustc_flags = ["--cfg", "'feature=\"domain-%s\"'" % domain, "--cfg", "'feature=\"component\"'"],
    )
    for domain in ["a", "b"]
]

[
    xm1_rust_rlib(
        name = "scheduler-s2-%s-component" % domain,
        src = "//replacement/rtos_scheduler:src/s2.rs",
        crate_name = "xm1_rtos_scheduler_s2",
        data = ["//replacement/rtos_layout:src/lib.rs", "//replacement/rtos_reservation:src/lib.rs"],
        rustc_flags = ["--cfg", "'feature=\"domain-%s\"'" % domain, "--cfg", "'feature=\"component\"'"],
    )
    for domain in ["a", "b"]
]

[
    xm1_rust_staticlib(
        name = "objects-family-adapter-%s" % domain,
        src = "stage/adapter.rs",
        crate_name = "xm1_rtos_objects_family_adapter",
        opt_level = "2",
        data = [
            "stage/abi.rs",
            "stage/family.rs",
            "src/admission.rs",
            "src/block.rs",
            "src/create.rs",
            "src/id.rs",
            "src/lib.rs",
            "src/locked.rs",
            "src/matching.rs",
            "src/message.rs",
            "src/order.rs",
            "src/status.rs",
            "src/teardown.rs",
            "src/timeout.rs",
            "src/wake.rs",
            "//replacement/rtos_layout:src/lib.rs",
            "//replacement/rtos_reservation:src/lib.rs",
        ],
        rustc_flags = [
            "--cfg",
            "'feature=\"domain-%s\"'" % domain,
            "--cfg",
            "'feature=\"stage\"'",
            "--cfg",
            "'feature=\"family\"'",
            "-C",
            "llvm-args=-enable-machine-outliner=always",
            "-C",
            "llvm-args=-machine-outliner-reruns=1",
        ],
    )
    for domain in ["a", "b"]
]

[
    xm1_rust_elf(
        name = "objects-family-stage-%s" % domain,
        rust_staticlib = ":objects-family-adapter-%s" % domain,
        rust_components = [
            ":scheduler-%s-component" % domain,
            ":scheduler-s2-%s-component" % domain,
        ],
        link_script = "stage/family-%s.ld" % domain,
        extra_ldflags = [
            "-Wl,-Map=$(@D)/objects-family-stage-%s.map" % domain,
            "-Wl,--gc-sections",
            "-Wl,--orphan-handling=error",
        ],
        link_includes = [
            "//replacement/rtos_scheduler:scheduler-%s-placement.ld" % domain,
            "//replacement/rtos_scheduler:scheduler-s2-%s-placement.ld" % domain,
        ],
        entry = "xm1_rtos_objects_family_flag_create",
    )
    for domain in ["a", "b"]
]

genrule(
    name = "objects-smoke-build",
    srcs = [
        "smoke.rs",
        "src/admission.rs",
        "src/block.rs",
        "src/create.rs",
        "src/id.rs",
        "src/lib.rs",
        "src/locked.rs",
        "src/matching.rs",
        "src/message.rs",
        "src/order.rs",
        "src/sim.rs",
        "src/status.rs",
        "src/teardown.rs",
        "src/timeout.rs",
        "src/wake.rs",
        "//replacement/rtos_layout:src/lib.rs", "//replacement/rtos_reservation:src/lib.rs",
        "//replacement/rtos_scheduler:scheduler-host-rlib",
    ],
    outs = ["objects-smoke-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --cfg 'feature=\"sim\"' --extern xm1_rtos_scheduler=$(location //replacement/rtos_scheduler:scheduler-host-rlib) $(location smoke.rs) -o $@",
    executable = True,
    tools = ["@lab_rustc//:bin/rustc"],
)

genrule(
    name = "objects-host-tests-build",
    srcs = [
        "src/admission.rs",
        "src/block.rs",
        "src/create.rs",
        "src/id.rs",
        "src/lib.rs",
        "src/locked.rs",
        "src/matching.rs",
        "src/message.rs",
        "src/order.rs",
        "src/sim.rs",
        "src/status.rs",
        "src/teardown.rs",
        "src/tests.rs",
        "src/timeout.rs",
        "src/wake.rs",
        "//replacement/rtos_layout:src/lib.rs", "//replacement/rtos_reservation:src/lib.rs",
        "//replacement/rtos_scheduler:scheduler-host-rlib",
    ],
    outs = ["objects-host-tests-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --test --extern xm1_rtos_scheduler=$(location //replacement/rtos_scheduler:scheduler-host-rlib) -C linker=$(location @lab_clang//:bin/clang) $(location src/lib.rs) -o $@",
    executable = True,
    tools = [
        "@lab_clang//:bin/clang",
        "@lab_rustc//:bin/rustc",
    ],
)


sh_test(
    name = "objects-host-tests",
    size = "small",
    srcs = ["//emulation:recovery-task-state-tests.sh"],
    args = ["$(location :objects-host-tests-build)"],
    data = [
        ":objects-host-tests-build",
        ":objects-rust",
        ":objects-smoke-build",
    ],
)

haskell_library(
    name = "family-suite",
    srcs = [
        "native/Replacement/RtosObjects/Layout.hs",
        "native/Replacement/RtosObjects/Suite.hs",
    ],
    src_strip_prefix = "native",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//emulation:cached-native-batch",
        "//emulation:native-adapter",
        "//emulation:native-observation",
        "//emulation:owned-case",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:filepath",
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//replacement/rtos_platform:aggregate",
    ],
)

haskell_binary(
    name = "family-suite-runner",
    srcs = ["native/SuiteMain.hs"],
    main_file = "native/SuiteMain.hs",
    args = [
        "--owned-a-bin", "$(rootpath :objects-family-stage-a.bin)",
        "--owned-b-bin", "$(rootpath :objects-family-stage-b.bin)",
        "--layout", "$(rootpath //replacement/rtos_scheduler/oracle:layout.json)",
    ],
    data = [
        ":objects-family-stage-a.bin",
        ":objects-family-stage-b.bin",
        "//replacement/rtos_scheduler:s3b-a.bin",
        "//replacement/rtos_scheduler:s3b-b.bin",
        "//replacement/rtos_scheduler/oracle:layout.json",
    ],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":family-suite",
        "//emulation:fujimod-native-paths",
        "//host:aeson",
        "//host:storage-budget",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
        "//host:text",
        "//replacement/rtos_own_first/stage:own-first-artifact",
        "//replacement/rtos_platform:aggregate",
        "//replacement/rtos_platform:platform-artifact",
    ],
)
