load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "objects-rust",
    src = "src/lib.rs",
    crate_name = "xm1_rtos_objects",
    data = [
        "src/admission.rs",
        "src/create.rs",
        "src/id.rs",
        "src/locked.rs",
        "src/matching.rs",
        "src/message.rs",
        "src/order.rs",
        "src/sim.rs",
        "src/status.rs",
        "src/timeout.rs",
        "src/wake.rs",
        "//replacement/rtos_layout:src/lib.rs",
    ],
)

[
    xm1_rust_staticlib(
        name = "objects-f2-adapter-%s" % domain,
        src = "stage/adapter.rs",
        crate_name = "xm1_rtos_objects_f2_adapter",
        data = [
            "stage/adapter.rs",
            "src/admission.rs",
            "src/create.rs",
            "src/id.rs",
            "src/lib.rs",
            "src/locked.rs",
            "src/matching.rs",
            "src/message.rs",
            "src/order.rs",
            "src/status.rs",
            "src/timeout.rs",
            "src/wake.rs",
            "//replacement/rtos_layout:src/lib.rs",
        ],
        rustc_flags = ["--cfg", "'feature=\"domain-%s\"'" % domain],
    )
    for domain in ["a", "b"]
]

[
    xm1_rust_elf(
        name = "objects-f2-stage-%s" % domain,
        rust_staticlib = ":objects-f2-adapter-%s" % domain,
        rust_staticlibs = [
            "//replacement/rtos_scheduler:scheduler-%s-rust" % domain,
            "//replacement/rtos_scheduler:scheduler-s2-%s-rust" % domain,
        ],
        link_script = "stage/f2-%s.ld" % domain,
        link_includes = [
            "//replacement/rtos_scheduler:scheduler-%s.ld" % domain,
            "//replacement/rtos_scheduler:scheduler-s2-%s.ld" % domain,
        ],
        entry = "xm1_rtos_objects_f2_set_flag",
    )
    for domain in ["a", "b"]
]

genrule(
    name = "objects-host-tests-build",
    srcs = [
        "src/admission.rs",
        "src/create.rs",
        "src/id.rs",
        "src/lib.rs",
        "src/locked.rs",
        "src/matching.rs",
        "src/message.rs",
        "src/order.rs",
        "src/status.rs",
        "src/tests.rs",
        "src/timeout.rs",
        "src/wake.rs",
        "//replacement/rtos_layout:src/lib.rs",
        "//replacement/rtos_scheduler:scheduler-host-rlib",
    ],
    outs = ["objects-host-tests-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --test --extern xm1_rtos_scheduler=$(location //replacement/rtos_scheduler:scheduler-host-rlib) -C linker=$(location @lab_clang//:bin/clang) $(location src/lib.rs) -o $@",
    executable = True,
    tools = [
        "@lab_clang//:bin/clang",
        "@lab_rustc//:bin/rustc",
    ],
)

genrule(
    name = "objects-smoke-build",
    srcs = [
        "smoke.rs",
        "src/admission.rs",
        "src/create.rs",
        "src/id.rs",
        "src/lib.rs",
        "src/locked.rs",
        "src/matching.rs",
        "src/message.rs",
        "src/order.rs",
        "src/sim.rs",
        "src/status.rs",
        "src/timeout.rs",
        "src/wake.rs",
        "//replacement/rtos_layout:src/lib.rs",
        "//replacement/rtos_scheduler:scheduler-host-rlib",
    ],
    outs = ["objects-smoke-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --cfg 'feature=\"sim\"' --extern xm1_rtos_scheduler=$(location //replacement/rtos_scheduler:scheduler-host-rlib) $(location smoke.rs) -o $@",
    executable = True,
    tools = ["@lab_rustc//:bin/rustc"],
)

sh_test(
    name = "objects-host-tests",
    size = "small",
    srcs = ["//emulation:recovery-task-state-tests.sh"],
    args = ["$(location :objects-host-tests-build)"],
    data = [":objects-host-tests-build"],
)

haskell_library(
    name = "family-suite",
    srcs = ["native/Replacement/RtosObjects/Suite.hs"],
    src_strip_prefix = "native",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//emulation:native-case",
        "//emulation:native-observation",
        "//emulation:owned-case",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//replacement/rtos_own_first/oracle:own-first-oracle-lib",
        "//replacement/rtos_scheduler/oracle:scheduler-oracle-lib",
    ],
)

haskell_test(
    name = "family-suite-test",
    size = "small",
    srcs = ["native/SuiteMain.hs"],
    main_file = "native/SuiteMain.hs",
    args = [
        "$(rootpath //emulation:native-runner)",
        "$(rootpath //replacement/rtos_objects:objects-f2-stage-a.bin)",
        "$(rootpath //replacement/rtos_objects:objects-f2-stage-b.bin)",
    ],
    data = [
        "//emulation:native-runner",
        "//replacement/rtos_objects:objects-f2-stage-a.bin",
        "//replacement/rtos_objects:objects-f2-stage-b.bin",
    ],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":family-suite",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
    ],
)
