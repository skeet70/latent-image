load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "objects-rust",
    src = "src/lib.rs",
    crate_name = "xm1_rtos_objects",
    data = [
        "src/admission.rs",
        "src/create.rs",
        "src/id.rs",
        "src/locked.rs",
        "src/matching.rs",
        "src/message.rs",
        "src/order.rs",
        "src/sim.rs",
        "src/status.rs",
        "src/timeout.rs",
        "src/wake.rs",
        "//replacement/rtos_layout:src/lib.rs",
    ],
)

[
    xm1_rust_staticlib(
        name = "objects-f2-adapter-%s" % domain,
        src = "stage/adapter.rs",
        crate_name = "xm1_rtos_objects_f2_adapter",
        data = [
            "stage/adapter.rs",
            "src/admission.rs",
            "src/create.rs",
            "src/id.rs",
            "src/lib.rs",
            "src/locked.rs",
            "src/matching.rs",
            "src/message.rs",
            "src/order.rs",
            "src/status.rs",
            "src/timeout.rs",
            "src/wake.rs",
            "//replacement/rtos_layout:src/lib.rs",
        ],
        rustc_flags = ["--cfg", "'feature=\"domain-%s\"'" % domain],
    )
    for domain in ["a", "b"]
]

genrule(
    name = "objects-host-tests-build",
    srcs = [
        "src/admission.rs",
        "src/create.rs",
        "src/id.rs",
        "src/lib.rs",
        "src/locked.rs",
        "src/matching.rs",
        "src/message.rs",
        "src/order.rs",
        "src/status.rs",
        "src/tests.rs",
        "src/timeout.rs",
        "src/wake.rs",
        "//replacement/rtos_layout:src/lib.rs",
        "//replacement/rtos_scheduler:scheduler-host-rlib",
    ],
    outs = ["objects-host-tests-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --test --extern xm1_rtos_scheduler=$(location //replacement/rtos_scheduler:scheduler-host-rlib) -C linker=$(location @lab_clang//:bin/clang) $(location src/lib.rs) -o $@",
    executable = True,
    tools = [
        "@lab_clang//:bin/clang",
        "@lab_rustc//:bin/rustc",
    ],
)

genrule(
    name = "objects-smoke-build",
    srcs = [
        "smoke.rs",
        "src/admission.rs",
        "src/create.rs",
        "src/id.rs",
        "src/lib.rs",
        "src/locked.rs",
        "src/matching.rs",
        "src/message.rs",
        "src/order.rs",
        "src/sim.rs",
        "src/status.rs",
        "src/timeout.rs",
        "src/wake.rs",
        "//replacement/rtos_layout:src/lib.rs",
        "//replacement/rtos_scheduler:scheduler-host-rlib",
    ],
    outs = ["objects-smoke-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --cfg 'feature=\"sim\"' --extern xm1_rtos_scheduler=$(location //replacement/rtos_scheduler:scheduler-host-rlib) $(location smoke.rs) -o $@",
    executable = True,
    tools = ["@lab_rustc//:bin/rustc"],
)

sh_test(
    name = "objects-host-tests",
    size = "small",
    srcs = ["//emulation:recovery-task-state-tests.sh"],
    args = ["$(location :objects-host-tests-build)"],
    data = [":objects-host-tests-build"],
)
