load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")
load("@rules_haskell//haskell:defs.bzl", "haskell_library")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "task-constructors-rust",
    src = "src.rs",
    crate_name = "xm1_task_constructors",
    opt_level = "s",
)

xm1_rust_elf(
    name = "task-constructors-image",
    rust_staticlib = ":task-constructors-rust",
    asm_srcs = ["entry.S"],
    entry = "xm1_ctor_d0a238",
    link_script = "task-constructors.ld",
    extra_ldflags = ["-Wl,--gc-sections", "-Wl,--orphan-handling=error"],
)

haskell_library(
    name = "task-constructors-artifact",
    srcs = [
        "Replacement/TaskConstructors/Admission.hs",
        "Replacement/TaskConstructors/Artifact.hs",
    ],
    src_strip_prefix = ".",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//emulation:case-sha256",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:first-stage",
        "//host:update-container",
        "//host/firmware:bank-allowlist",
    ],
)
