load("//build-support:rust_source_boundary.bzl", "rust_source_boundary_test")

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_rlib")

# The value transaction with its guest seam. The adapter is a module of this
# crate under rb_menu_value_owned, so the seam and the transaction are one
# subsystem and one rlib.
xm1_rust_rlib(
    name = "arm-owned",
    src = "src/lib.rs",
    crate_name = "menu_value",
    out = "libmenu_value_owned.rlib",
    data = [
        ":value-adapter-sources",
        ":module",
        "//replacement/bank/tables:menu-value-table.rs",
    ],
    env = {
        "RB_MENU_VALUE_TABLE": "$$PWD/$(location //replacement/bank/tables:menu-value-table.rs)",
    },
    rlib_deps = {
        "xm1_kernel": "//replacement/kernel:arm",
        "xm1_property_service": "//replacement/property_service:property-service-arm",
        "xm1_settings_storage_core": "//replacement/settings_storage:property-core-arm",
    },
    rustc_flags = [
        "-C",
        "target-feature=+strict-align",
        "-C",
        "llvm-args=-min-jump-table-entries=4096",
        "--cfg",
        "rb_menu_value_owned",
    ],
    visibility = [
        "//replacement/bank:__pkg__",
        "//replacement/menu_engine:__pkg__",
        "//replacement/render_adapter:__pkg__",
    ],
)

filegroup(
    name = "module",
    srcs = ["src/lib.rs"],
    visibility = [
        "//host/firmware:__pkg__",
        "//replacement/bank:__pkg__",
    ],
)

filegroup(
    name = "adapter-sources",
    srcs = [
        "adapter/entry.S",
        "adapter/mod.rs",
    ],
    visibility = ["//replacement/bank:__pkg__"],
)

filegroup(
    name = "value-adapter-sources",
    srcs = [
        "adapter/entry.S",
        "adapter/mod.rs",
    ],
    visibility = [
        "//host/firmware:__pkg__",
        "//replacement/bank:__pkg__",
    ],
)

genrule(
    name = "menu-value-tests-build",
    srcs = [
        ":module",
        "src/lib.rs",
        "src/tests.rs",
    ],
    outs = ["menu-value-tests-bin"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --test -C linker=$(location @lab_clang//:bin/clang) $(location src/lib.rs) -o $@",
    executable = True,
    tools = ["@lab_rustc//:bin/rustc", "@lab_clang//:bin/clang"],
)

sh_test(
    name = "menu-value-tests",
    size = "small",
    srcs = ["//emulation:recovery-task-state-tests.sh"],
    args = ["$(location :menu-value-tests-build)"],
    data = [":menu-value-tests-build"],
)

genrule(
    name = "host-library",
    srcs = [":module", "src/lib.rs"],
    outs = ["libmenu_value.rlib"],
    cmd = "$(location @lab_rustc//:bin/rustc) --crate-name=menu_value --edition=2021 --crate-type=rlib $(location src/lib.rs) -o $@",
    tools = ["@lab_rustc//:bin/rustc"],
    visibility = ["//replacement/modal_runtime:__pkg__"],
)

rust_source_boundary_test(
    name = "unsafe-boundary-check",
    declaration = "unsafe-boundary.json",
    srcs = glob(["src/**/*.rs", "adapter/**/*.rs"]) + ["//replacement/bank/tables:menu-value-table.rs"],
)
