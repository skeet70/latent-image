load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "completion-delay-rust",
    src = "src.rs",
    crate_name = "xm1_completion_delay",
)

xm1_rust_elf(
    name = "completion-delay-image",
    asm_srcs = ["entry.S"],
    entry = "xm1_completion_delay_entry",
    link_script = "completion-delay.ld",
    rust_staticlib = ":completion-delay-rust",
)
