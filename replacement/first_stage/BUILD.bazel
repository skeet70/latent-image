load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

exports_files(["format.rs"])

# The first-record image is 11,368 bytes, SHA-256 78184804... (E-FIRST-RECORD-FLASH-BOOT-CHECK-150),
# and its three fault controls are derived from this source.
xm1_rust_staticlib(
    name = "first-stage-rust",
    src = "src.rs",
    crate_name = "xm1_first_stage",
    data = ["media.rs", "images.rs", "format.rs", "engine.rs"],
)

xm1_rust_elf(
    name = "first-stage-image",
    asm_srcs = ["entry.S"],
    entry = "xm1_first_stage_entry",
    link_script = "first-stage.ld",
    rust_staticlib = ":first-stage-rust",
    extra_ldflags = ["-Wl,--gc-sections"],
)

xm1_rust_staticlib(
    name = "first-stage-fixed-rust",
    src = "src.rs",
    crate_name = "xm1_first_stage",
    data = ["media.rs", "images.rs", "format.rs", "engine.rs", "fixed_image.rs"],
    rustc_flags = ["--cfg", "fixed_image"],
    rlib_deps = {"xm1_fixed_image_layout": "//replacement/fixed_image:layout"},
)

xm1_rust_elf(
    name = "first-stage-fixed-image",
    asm_srcs = ["entry.S"],
    entry = "xm1_first_stage_entry",
    link_script = "first-stage.ld",
    rust_staticlib = ":first-stage-fixed-rust",
    extra_ldflags = ["-Wl,--gc-sections"],
)

xm1_rust_staticlib(
    name = "first-stage-fault-rust",
    testonly = True,
    src = "src.rs",
    crate_name = "xm1_first_stage",
    data = ["media.rs", "images.rs", "format.rs", "engine.rs"],
    rustc_flags = ["--cfg", "first_stage_fault"],
)

xm1_rust_elf(
    name = "first-stage-fault-image",
    testonly = True,
    asm_srcs = ["entry.S"],
    entry = "xm1_first_stage_entry",
    link_script = "first-stage.ld",
    rust_staticlib = ":first-stage-fault-rust",
    extra_ldflags = ["-Wl,--gc-sections"],
)

