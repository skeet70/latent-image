load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

exports_files(["format.rs"])

# The first-record image is 10,672 bytes, SHA-256 a79f7e76... (E-FIRST-RECORD-FLASH-BOOT-CHECK-150),
# and its three fault controls are derived from this source. Opted out until the
# stage is requalified, at the latest in the runner requalification.
xm1_rust_staticlib(
    name = "first-stage-rust",
    src = "src.rs",
    crate_name = "xm1_first_stage",
    data = ["media.rs", "images.rs", "format.rs", "engine.rs"],
    strict_align = False,
)

xm1_rust_elf(
    name = "first-stage-image",
    asm_srcs = ["entry.S"],
    entry = "xm1_first_stage_entry",
    link_script = "first-stage.ld",
    rust_staticlib = ":first-stage-rust",
    extra_ldflags = ["-Wl,--gc-sections"],
)

xm1_rust_staticlib(
    name = "first-stage-fault-rust",
    testonly = True,
    src = "src.rs",
    crate_name = "xm1_first_stage",
    data = ["media.rs", "images.rs", "format.rs", "engine.rs"],
    rustc_flags = ["--cfg", "first_stage_fault"],
    strict_align = False,
)

xm1_rust_elf(
    name = "first-stage-fault-image",
    testonly = True,
    asm_srcs = ["entry.S"],
    entry = "xm1_first_stage_entry",
    link_script = "first-stage.ld",
    rust_staticlib = ":first-stage-fault-rust",
    extra_ldflags = ["-Wl,--gc-sections"],
)

# Original synthetic handler-tail write in the owned first-stage source.
xm1_rust_staticlib(
    name = "first-stage-handler-tail-fault-rust",
    testonly = True,
    src = "src.rs",
    crate_name = "xm1_first_stage",
    data = ["media.rs", "images.rs", "format.rs", "engine.rs"],
    rustc_flags = ["--cfg", "first_stage_handler_tail_fault"],
    strict_align = False,
)

xm1_rust_elf(
    name = "first-stage-handler-tail-fault-image",
    testonly = True,
    asm_srcs = ["entry.S"],
    entry = "xm1_first_stage_entry",
    link_script = "first-stage.ld",
    rust_staticlib = ":first-stage-handler-tail-fault-rust",
    extra_ldflags = ["-Wl,--gc-sections"],
)

# Original synthetic in-installation handler-tail store and displaced instruction.
xm1_rust_elf(
    name = "first-stage-interleaved-tail-fault-image",
    testonly = True,
    asm_defines = ["XM1_FIRST_STAGE_INTERLEAVED_TAIL_FAULT"],
    asm_srcs = ["entry.S"],
    entry = "xm1_first_stage_entry",
    link_script = "first-stage.ld",
    rust_staticlib = ":first-stage-rust",
    extra_ldflags = ["-Wl,--gc-sections"],
)

genrule(
    name = "media-model-tests",
    testonly = True,
    srcs = ["model.rs", "media.rs", "images.rs", "format.rs", "engine.rs", "stock_core_init_addresses.rs"],
    outs = ["media-model-tests-bin", "media-model-tests.passed"],
    tools = ["@lab_rustc//:bin/rustc", "@lab_clang//:bin/clang"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 --test -C linker=$(location @lab_clang//:bin/clang) $(location model.rs) -o $(@D)/media-model-tests-bin && $(@D)/media-model-tests-bin && touch $(@D)/media-model-tests.passed",
)

genrule(
    name = "media-stream-model",
    srcs = ["stream_oracle.rs", "media.rs", "images.rs", "format.rs", "engine.rs"],
    outs = ["media-stream-model-bin"],
    executable = True,
    tools = ["@lab_rustc//:bin/rustc", "@lab_clang//:bin/clang"],
    cmd = "$(location @lab_rustc//:bin/rustc) --edition=2021 -C opt-level=2 -C linker=$(location @lab_clang//:bin/clang) $(location stream_oracle.rs) -o $@",
)
