# Original synthetic in-installation handler-tail store and displaced instruction.
xm1_rust_elf(
    name = "first-stage-interleaved-tail-fault-image",
    testonly = True,
    asm_defines = ["XM1_FIRST_STAGE_INTERLEAVED_TAIL_FAULT"],
    asm_srcs = ["entry.S"],
    entry = "xm1_first_stage_entry",
    link_script = "first-stage.ld",
    rust_staticlib = ":first-stage-rust",
    extra_ldflags = ["-Wl,--gc-sections"],
