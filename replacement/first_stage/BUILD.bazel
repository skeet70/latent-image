load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

exports_files(["format.rs"])

xm1_rust_staticlib(
    name = "first-stage-rust",
    src = "src.rs",
    crate_name = "xm1_first_stage",
)

xm1_rust_elf(
    name = "first-stage-image",
    asm_srcs = ["entry.S"],
    entry = "xm1_first_stage_entry",
    link_script = "first-stage.ld",
    rust_staticlib = ":first-stage-rust",
)

xm1_rust_staticlib(
    name = "first-stage-fault-rust",
    testonly = True,
    src = "src.rs",
    crate_name = "xm1_first_stage",
    rustc_flags = ["--cfg", "first_stage_fault"],
)

xm1_rust_elf(
    name = "first-stage-fault-image",
    testonly = True,
    asm_srcs = ["entry.S"],
    entry = "xm1_first_stage_entry",
    link_script = "first-stage.ld",
    rust_staticlib = ":first-stage-fault-rust",
)

# Original synthetic handler-tail write in the owned first-stage source.
xm1_rust_staticlib(
    name = "first-stage-handler-tail-fault-rust",
    testonly = True,
    src = "src.rs",
    crate_name = "xm1_first_stage",
    rustc_flags = ["--cfg", "first_stage_handler_tail_fault"],
)

xm1_rust_elf(
    name = "first-stage-handler-tail-fault-image",
    testonly = True,
    asm_srcs = ["entry.S"],
    entry = "xm1_first_stage_entry",
    link_script = "first-stage.ld",
    rust_staticlib = ":first-stage-handler-tail-fault-rust",
)

# Original synthetic in-installation handler-tail store and displaced instruction.
xm1_rust_staticlib(
    name = "first-stage-interleaved-tail-fault-rust",
    testonly = True,
    src = "src.rs",
    crate_name = "xm1_first_stage",
    rustc_flags = ["--cfg", "first_stage_interleaved_tail_fault"],
)

xm1_rust_elf(
    name = "first-stage-interleaved-tail-fault-image",
    testonly = True,
    asm_defines = ["XM1_FIRST_STAGE_INTERLEAVED_TAIL_FAULT"],
    asm_srcs = ["entry.S"],
    entry = "xm1_first_stage_entry",
    link_script = "first-stage.ld",
    rust_staticlib = ":first-stage-interleaved-tail-fault-rust",
)
