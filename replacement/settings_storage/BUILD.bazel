        tools = ["@lab_xm1_rust//:bin/rustc"],
    )
    for variant in ["host", "arm"]
]
_HOST_DEPS = [":record-store-host-rlib", ":area3-validator-host-rlib"]
_HOST_FLAGS = "--extern record_store=$(location :record-store-host-rlib) --extern area3_validator=$(location :area3-validator-host-rlib)"

genrule(
    name = "property-core-host",
    srcs = ["src/lib.rs"] + _RUST_DATA,
    outs = ["host/libxm1_settings_storage_core.rlib"],
    cmd = "$(location @lab_xm1_rust//:bin/rustc) --crate-name=xm1_settings_storage_core --edition=2021 --crate-type=rlib --cfg settings_storage_library --cfg settings_storage_property $(location src/lib.rs) -o $@",
    tools = ["@lab_xm1_rust//:bin/rustc"],
)

xm1_rust_staticlib(
    name = "settings-storage-rust",
    src = "src/lib.rs",
    crate_name = "xm1_settings_storage",
    data = _RUST_DATA,
    rustc_flags = _PROPERTY_FLAGS,
    rlib_deps = {"xm1_kernel": "//replacement/kernel:arm"},
)
xm1_rust_elf(
    name = "settings-storage-image",
    rust_staticlib = ":settings-storage-rust",
    asm_srcs = ["entry.S", "//replacement/property_service:storage-boundary.S"],
    link_script = "settings-storage.ld",
    entry = "xm1_getter_owned",
    extra_ldflags = ["-Wl,--gc-sections"],
)

genrule(
    name = "rust-test-binary",
    srcs = ["src/lib.rs"] + _RUST_DATA + _HOST_DEPS,
    outs = ["settings-storage-tests-bin"],
    cmd = "$(location @lab_xm1_rust//:bin/rustc) --edition=2021 --test --crate-name=settings_storage_tests " + _HOST_FLAGS + " $(location src/lib.rs) -o $@",
    tools = ["@lab_xm1_rust//:bin/rustc"],
    executable = True,
)
sh_test(name = "settings-storage-tests", srcs = [":rust-test-binary"])

genrule(
    name = "rust-full-export-control",
    srcs = ["src/lib.rs"] + _RUST_DATA + _HOST_DEPS,
