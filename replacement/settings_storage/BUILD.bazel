    for suffix in ["bin", "symbols"]
] + [
    "//replacement/property_service:property-service-storage-control-%s.%s" % (defect, suffix)
    for defect in PROPERTY_STORAGE_CONTROLS
    for suffix in ["bin", "symbols", "elf"]
]

