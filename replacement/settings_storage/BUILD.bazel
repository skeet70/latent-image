    "//replacement/property_service:property-service-image.elf",
    "//replacement/property_service:property-service-storage-refusal-image.elf",
] + [
    ":custom-settings-image-%s.%s" % (defect, suffix)
    for defect in _CUSTOM_ORACLE_DEFECTS
    for suffix in ["bin", "symbols"]
] + [
    ":custom-settings-image-bank-%s.%s" % (defect, suffix)
