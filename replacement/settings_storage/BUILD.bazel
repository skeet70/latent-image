_CUSTOM_ORACLE_DEFAULTS = [
    "--linked", "$(rootpath :custom-settings-image.bin)",
    "--symbols", "$(rootpath :custom-settings-image.symbols)",
    "--base", "0x5d0000",
    "--property-refusal-linked", "$(rootpath //replacement/property_service:property-service-storage-refusal-image.bin)",
    "--property-refusal-symbols", "$(rootpath //replacement/property_service:property-service-storage-refusal-image.symbols)",
    "--property-elf", "$(rootpath //replacement/property_service:property-service-image.elf)",
    "--property-refusal-elf", "$(rootpath //replacement/property_service:property-service-storage-refusal-image.elf)",
] + [
    argument
    for defect in _CUSTOM_ORACLE_DEFECTS
    for argument in [
        "--defect", defect,
        "$(rootpath :custom-settings-image-%s.bin)" % defect,
        "$(rootpath :custom-settings-image-%s.symbols)" % defect,
    ]
] + [
    argument
    for defect in BANK_STORAGE_CONTROLS
    for argument in [
        "--bank-defect", defect,
        "$(rootpath :custom-settings-image-bank-%s.bin)" % defect,
        "$(rootpath :custom-settings-image-bank-%s.symbols)" % defect,
    ]
] + [
    argument
    for defect in PROPERTY_STORAGE_CONTROLS
    for argument in [
        "--property-defect", defect,
        "$(rootpath //replacement/property_service:property-service-storage-control-%s.bin)" % defect,
        "$(rootpath //replacement/property_service:property-service-storage-control-%s.symbols)" % defect,
        "$(rootpath //replacement/property_service:property-service-storage-control-%s.elf)" % defect,
    ]
]

