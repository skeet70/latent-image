        name = "custom-settings-rust" + ("-" + variant.name if variant.name else ""),
        src = "src/lib.rs",
        crate_name = "xm1_settings_storage_custom",
        data = _RUST_DATA + [variant.record, ":area3-validator-arm-rlib"],
        rustc_flags = [
            "-C", "jump-tables=no",
            "--cfg", "settings_storage_library", "--cfg", "settings_custom_native",
            "--cfg", "settings_bank_native", "--cfg", "settings_storage_firmware",
            "--extern", "record_store=$(location " + variant.record + ")",
            "--extern", "area3_validator=$(location :area3-validator-arm-rlib)",
        ] + (["--cfg", variant.flag] if variant.flag else []),
        rlib_deps = {"xm1_kernel": "//replacement/kernel:arm"},
    )
    for variant in _CUSTOM_VARIANTS
]
[
    xm1_rust_elf(
        name = "custom-settings-image" + ("-" + variant.name if variant.name else ""),
        rust_staticlib = ":custom-settings-rust" + ("-" + variant.name if variant.name else ""),
        asm_srcs = ["entry.S", "custom_entry.S", "bank_entry.S", "//replacement/property_service:storage-boundary.S", "//replacement/record_store_carrier:entry.S"],
        link_script = "custom-settings.ld",
        link_includes = ["//replacement/record_store_carrier:imports.ld"],
        entry = "settings_custom_boot_entry",
        link_map = True,
        extra_ldflags = ["-Wl,--gc-sections"],
    )
    for variant in _CUSTOM_VARIANTS
]

genrule(
    name = "custom-publication-linker",
    srcs = [":custom-settings-image.symbols", ":custom-settings-image.map", "custom-settings.ld"],
    outs = ["custom-settings-published.ld"],
    cmd = """set -eu
tmp=$$(mktemp -d)
trap 'rm -rf "$$tmp"' EXIT
cp "$(location :custom-settings-image.symbols)" "$$tmp/host.symbols"
cp "$(location :custom-settings-image.map)" "$$tmp/host.map"
cp "$(location custom-settings.ld)" "$$tmp/host.ld"
"$(location :custom-publication)" prepare "$$tmp/host.symbols" "$$tmp/host.map" "$$tmp/host.ld" "$@"
""",
    tools = [":custom-publication"],
)
xm1_rust_elf(
    name = "custom-settings-published-image",
    rust_staticlib = ":custom-settings-rust",
    asm_srcs = ["entry.S", "custom_entry.S", "bank_entry.S", "//replacement/property_service:storage-boundary.S", "//replacement/record_store_carrier:entry.S"],
    link_script = ":custom-settings-published.ld",
    link_includes = ["//replacement/record_store_carrier:imports.ld"],
    entry = "settings_custom_boot_entry",
    link_map = True,
    extra_ldflags = ["-Wl,--gc-sections"],
)

