package(default_visibility = ["//visibility:public"])

_RUST_DATA = glob(["src/*.rs"], exclude = ["src/lib.rs"]) + [
    "//replacement/property_service:src/lib.rs",
    "//replacement/property_service:src/table.rs",
    "//replacement/property_service:src/property_table.rs",
    "//replacement/property_service:src/storage_boundary.rs",
]

_ARM_FLAGS = "--target=armv7r-none-eabi -C panic=abort -C relocation-model=static -C target-cpu=cortex-r4f -C codegen-units=1 -C target-feature=+strict-align -C jump-tables=no -C opt-level=z"
_PROPERTY_FLAGS = ["-C", "jump-tables=no", "--cfg", "property_embedded_storage", "--cfg", "settings_storage_firmware", "--cfg", "settings_storage_property"]
_CORE_DEFECTS = [
    "storage_open_removed", "storage_close_before_set", "storage_bracket_bank1",
    "storage_read_before_open", "storage_pair_before_close", "storage_record_save_at_bank",
    "storage_slot_defaults_moved", "storage_tail_defaults_moved", "storage_tail16_moved",
    "storage_tail16_byte", "storage_bank_slot_swap",
]

[
    genrule(
        name = "property-core" + ("-" + defect.replace("_", "-") if defect else ""),
        srcs = ["src/lib.rs", "//replacement/kernel:arm"] + _RUST_DATA,
        outs = [(defect + "/" if defect else "") + "libxm1_settings_storage_core.rlib"],
        cmd = "$(location @lab_xm1_rust//:bin/rustc) --crate-name=xm1_settings_storage_core --edition=2021 --crate-type=rlib " + _ARM_FLAGS + " --cfg settings_storage_library --cfg settings_storage_firmware --cfg settings_storage_property " + ("--cfg " + defect + " " if defect else "") + "--extern xm1_kernel=$(location //replacement/kernel:arm) $(location src/lib.rs) -o $@",
        tools = ["@lab_xm1_rust//:bin/rustc"],
    )
    for defect in [""] + _CORE_DEFECTS
]

xm1_rust_rlib(
    name = "property-core-arm",
    src = "src/lib.rs",
    crate_name = "xm1_settings_storage_core",
    out = "arm/libxm1_settings_storage_core.rlib",
    rustc_flags = ["-C", "jump-tables=no", "--cfg", "settings_storage_library", "--cfg", "settings_storage_firmware", "--cfg", "settings_storage_property"],
    data = _RUST_DATA,
    rlib_deps = {"xm1_kernel": "//replacement/kernel:arm"},
)

[
    genrule(
        name = "property-core-control-" + variant,
        srcs = ["src/lib.rs", "//replacement/kernel:arm"] + _RUST_DATA,
        outs = ["control-" + variant + "/libxm1_settings_storage_core.rlib"],
        cmd = "$(location @lab_xm1_rust//:bin/rustc) --crate-name=xm1_settings_storage_core --edition=2021 --crate-type=rlib " + _ARM_FLAGS + " --cfg settings_storage_library --cfg settings_storage_firmware --cfg settings_storage_property --cfg " + flag + " --extern xm1_kernel=$(location //replacement/kernel:arm) $(location src/lib.rs) -o $@",
        tools = ["@lab_xm1_rust//:bin/rustc"],
    )
    for variant, flag in PROPERTY_STORAGE_VARIANTS.items()
]

[
    genrule(
        name = "record-store-" + variant + "-rlib",
        srcs = [
            "//replacement/record_store:src/lib.rs",
            "//replacement/record_store:src/lifecycle.rs",
        ] + (["//replacement/record_store:src/guest.rs"] if variant == "guest" else []),
        outs = [variant + "/librecord_store.rlib"],
        cmd = "$(location @lab_xm1_rust//:bin/rustc) --crate-name=record_store --edition=2021 --crate-type=rlib " + (_ARM_FLAGS + " --cfg 'feature=\"guest\"' " if variant == "guest" else "") + "$(location //replacement/record_store:src/lib.rs) -o $@",
        tools = ["@lab_xm1_rust//:bin/rustc"],
    )
    for variant in ["host", "guest"]
]

genrule(
    name = "record-store-guest-rlib-unlock-before-copy",
    srcs = [
        "//replacement/record_store:src/lib.rs",
        "//replacement/record_store:src/lifecycle.rs",
        "//replacement/record_store:src/guest.rs",
    ],
    outs = ["guest-unlock-before-copy/librecord_store.rlib"],
    cmd = "$(location @lab_xm1_rust//:bin/rustc) --crate-name=record_store --edition=2021 --crate-type=rlib " + _ARM_FLAGS + " --cfg 'feature=\"guest\"' --cfg 'feature=\"control-unlock-before-copy\"' $(location //replacement/record_store:src/lib.rs) -o $@",
    tools = ["@lab_xm1_rust//:bin/rustc"],
)
[
    genrule(
        name = "area3-validator-" + variant + "-rlib",
        srcs = ["//replacement/validator:validator.rs"],
        outs = [variant + "/libarea3_validator.rlib"],
