load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "task1-actor-rust",
    src = "src.rs",
    crate_name = "xm1_task1_actor",
)

xm1_rust_elf(
    name = "task1-actor-image",
    rust_staticlib = ":task1-actor-rust",
    entry = "xm1_task1_actor",
    link_script = "task1-actor.ld",
    extra_ldflags = ["-Wl,--gc-sections", "-Wl,--orphan-handling=error"],
)

haskell_library(
    name = "task1-actor-artifact",
    srcs = ["Replacement/Task1Actor/Artifact.hs"],
    src_strip_prefix = ".",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//emulation:case-sha256",
        "//host:base",
        "//host:bytestring",
        "//host:first-stage",
        "//host:update-container",
        "//host/firmware:bank-allowlist",
    ],
)

haskell_binary(
    name = "host-cases",
    srcs = ["HostCases.hs"],
    ghcopts = ["-XGHC2021", "-O2"],
    deps = [
        "//emulation:native-adapter",
        "//emulation:owned-case",
        "//emulation:case-sha256",
        "//host:base",
        "//host:aeson",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
        "//host:json",
        "//host:process",
    ],
)
