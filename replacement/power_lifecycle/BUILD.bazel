xm1_rust_elf(
    name = "record-helpers",
    rust_staticlib = ":power-lifecycle-rust",
    link_script = "native/record-helpers.ld",
    entry = "xm1_power_record_helper_ef9bc0",
    extra_ldflags = ["-Wl,--gc-sections"] + ["-Wl,--undefined=xm1_power_record_helper_" + address for address in _RECORD_HELPER_COMPARED],
    testonly = True,
)

haskell_library(
    name = "record-helper-suite-lib",
    srcs = [
        "native/Replacement/PowerLifecycle/RecordHelperSuite.hs",
        "native/Replacement/PowerLifecycle/RecordHelperTable.hs",
