load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "task-submission-rust",
    src = "src.rs",
    crate_name = "xm1_task_submission",
)

xm1_rust_elf(
    name = "task-submission-image",
    rust_staticlib = ":task-submission-rust",
    asm_srcs = ["entry.S"],
    entry = "xm1_task_submit_entry",
    link_script = "task-submission.ld",
    extra_ldflags = ["-Wl,--gc-sections"],
)

haskell_library(
    name = "task-submission-artifact",
    srcs = [
        "Replacement/TaskSubmission/Admission.hs",
        "Replacement/TaskSubmission/Artifact.hs",
    ],
    src_strip_prefix = ".",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//emulation:case-sha256",
        "//emulation:image4-staging-lib",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:first-stage",
        "//host:update-container",
        "//host/firmware:bank-allowlist",
    ],
)

haskell_binary(
    name = "stage-task-submission",
    srcs = ["StageMain.hs"],
    args = [
        "$(rootpath //lz:lz-encode)",
        "$(rootpath //host/firmware:rebuild-update)",
        "$(rootpath //lz:fflzd)",
    ],
    data = ["//lz:lz-encode", "//host/firmware:rebuild-update", "//lz:fflzd"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":task-submission-artifact",
        "//emulation:image4-staging-lib",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:host-support",
    ],
)

haskell_test(
    name = "task-submission-artifact-tests",
    srcs = ["Tests.hs", "Fixtures.hs"],
    main_file = "Tests.hs",
    args = [
        "$(rootpath :task-submission-image.bin)",
        "$(rootpath :task-submission-image.symbols)",
    ],
    data = [":task-submission-image.bin", ":task-submission-image.symbols"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":task-submission-artifact",
        "//host:base",
        "//host:bytestring",
        "//host:host-support",
        "//host:update-container",
    ],
)
