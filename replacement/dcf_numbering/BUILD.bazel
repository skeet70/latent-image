load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

exports_files(["imports.ld"])

_SOURCES = ["src/numbering.rs", "src/stock.rs"]

DCF_CONTROLS = [
    "block_sequence_kept",
    "profile_ignored",
    "written_unpersisted",
    "folder_cluster_unrecorded",
    "latch_kept",
    "name_accepts_dash",
]

_VARIANTS = [("", [])] + [
    ("-control-" + control.replace("_", "-"), ["--cfg", "dcf_control_" + control])
    for control in DCF_CONTROLS
]

[xm1_rust_staticlib(
    name = "dcf-numbering-rust" + suffix,
    src = "src/lib.rs",
    crate_name = "xm1_dcf_numbering",
    data = _SOURCES,
    rustc_flags = ["-C", "overflow-checks=off"] + flags,
) for suffix, flags in _VARIANTS]

[xm1_rust_elf(
    name = "dcf-numbering-image" + suffix,
    rust_staticlib = ":dcf-numbering-rust" + suffix,
    asm_srcs = ["entry.S"],
    entry = "dcf_entry_prepare_name",
    link_script = "dcf-numbering.ld",
    link_includes = ["imports.ld"],
    extra_ldflags = ["-Wl,--gc-sections"],
) for suffix, _ in _VARIANTS]

genrule(
    name = "host-tests",
    srcs = ["src/lib.rs", "src/tests.rs"] + _SOURCES,
    outs = ["host-tests.passed"],
    cmd = "$(location @lab_xm1_rust//:bin/rustc) --edition=2021 --test $(location src/lib.rs) -o $(@D)/host-tests && $(@D)/host-tests && touch $@",
    tools = ["@lab_xm1_rust//:bin/rustc"],
)

haskell_library(
    name = "cases",
    srcs = ["Replacement/DcfNumbering/Cases.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    src_strip_prefix = ".",
    deps = [
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//replacement/file_service:native-lib",
    ],
)

haskell_binary(
    name = "dcf-numbering-suite",
    srcs = ["SuiteMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    main_file = "SuiteMain.hs",
    deps = [
        ":cases",
        "//emulation:case-sha256",
        "//host/firmware:bank-allowlist",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//replacement/file_service:native-lib",
    ],
)

haskell_library(
    name = "carrier",
    srcs = ["Replacement/DcfNumbering/Carrier.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    src_strip_prefix = ".",
    deps = [
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host/firmware:reference-scan-model",
    ],
)

haskell_binary(
    name = "stage-dcf-numbering",
    srcs = ["StageMain.hs"],
    main_file = "StageMain.hs",
    args = ["$(rootpath //lz:lz-encode)", "$(rootpath //host/firmware:rebuild-update)", "$(rootpath //lz:fflzd)"],
    data = ["//lz:lz-encode", "//host/firmware:rebuild-update", "//lz:fflzd"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":carrier",
        "//emulation:case-sha256",
        "//emulation:image4-staging-lib",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:directory",
        "//host:font-window",
        "//host:host-support",
        "//host:update-container",
        "//host/firmware:reference-scan-model",
    ],
)

haskell_test(
    name = "carrier-tests",
    srcs = ["CarrierTests.hs"],
    main_file = "CarrierTests.hs",
    args = ["$(rootpath :dcf-numbering-image%s.%s)" % (suffix, extension) for suffix, _ in _VARIANTS for extension in ["bin", "symbols"]],
    data = [":dcf-numbering-image%s.%s" % (suffix, extension) for suffix, _ in _VARIANTS for extension in ["bin", "symbols"]],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":carrier",
        "//host:base",
        "//host:bytestring",
        "//host/firmware:reference-scan-model",
    ],
)

haskell_binary(
    name = "dcf-numbering-observe",
    srcs = ["ObserveMain.hs"],
    main_file = "ObserveMain.hs",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2", "-rtsopts"],
    deps = [
        "//emulation:case-sha256",
        "//emulation:emulator-usb",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:directory",
        "//host:filepath",
        "//host:text",
        "//host:vector",
    ],
)

haskell_test(
    name = "observe-compare-tests",
    size = "small",
    srcs = ["ObserveCompareTests.hs"],
    args = ["$(rootpath :dcf-numbering-observe)"],
    data = [":dcf-numbering-observe"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror"],
    deps = [
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host:process",
        "//host:text",
    ],
)

filegroup(
    name = "all",
    srcs = [
        ":dcf-numbering-observe",
        ":dcf-numbering-suite",
        ":host-tests",
        ":stage-dcf-numbering",
    ] + [":dcf-numbering-image" + suffix for suffix, _ in _VARIANTS],
)

filegroup(
    name = "shim-catalog-data",
    srcs = glob(["shims.json", "**/*.ld"]) + ["BUILD.bazel"],
    visibility = ["//replacement/shim_check:__pkg__"],
)
