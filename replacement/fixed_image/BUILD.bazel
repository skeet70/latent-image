load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_rlib", "xm1_rust_staticlib")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files(["layout.json", "probe-allowlist.json"])

genrule(
    name = "layout-values",
    srcs = ["layout.json"],
    outs = ["Replacement/FixedImage/Values.hs"],
    tools = ["@lab_jq//:bin/jq"],
    cmd = "$(location @lab_jq//:bin/jq) -r '\"module Replacement.FixedImage.Values where\\nimport Data.Word (Word32)\\n\" + (to_entries | map(.key + \" :: Word32\\n\" + .key + \" = \" + (.value|tostring)) | join(\"\\n\"))' $(location layout.json) > $@",
)

haskell_library(
    name = "contract",
    srcs = ["Replacement/FixedImage/Layout.hs", "Replacement/FixedImage/Record.hs", ":layout-values"],
    src_strip_prefix = ".",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = ["//host:base", "//host:bytestring", "//host:update-container"],
)

haskell_binary(
    name = "fixed-image-layout",
    srcs = ["LayoutMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [":contract", "//host:base"],
)

genrule(
    name = "memory-region",
    outs = ["fixed-memory.ld"],
    tools = [":fixed-image-layout"],
    cmd = "$(location :fixed-image-layout) memory > $@",
)

genrule(
    name = "rust-layout-source",
    outs = ["layout.rs"],
    tools = [":fixed-image-layout"],
    cmd = "printf '#![no_std]\\n' > $@ && $(location :fixed-image-layout) rust >> $@",
)

xm1_rust_rlib(
    name = "layout",
    src = ":layout.rs",
    crate_name = "xm1_fixed_image_layout",
    out = "libxm1_fixed_image_layout.rlib",
)

haskell_test(
    name = "tests",
    srcs = ["Tests.hs"],
    args = ["$(rootpath //replacement/general_heap:general-heap-image.bin)", "$(rootpath //replacement/general_heap:general-heap-fixed-image.bin)"],
    data = ["//replacement/general_heap:general-heap-image.bin", "//replacement/general_heap:general-heap-fixed-image.bin"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [":contract", "//host:base", "//host:bytestring", "//host:update-container"],
)

haskell_binary(
    name = "stage-fixed-image",
    srcs = ["StageMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2", "-threaded"],
    deps = [":contract", "//host:aeson", "//host:base", "//host:bytestring", "//host:filepath", "//host:first-stage", "//host:host-support", "//host:update-container"],
)

haskell_binary(
    name = "check-fixed-image",
    srcs = ["CheckMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2", "-threaded"],
    deps = [":contract", "//host:aeson", "//host:base", "//host:bytestring", "//host:host-support", "//host/firmware:bank-allowlist"],
)

sh_test(
    name = "interface-tests",
    size = "small",
    srcs = ["interface-test.sh"],
    args = ["$(rootpath :check-fixed-image)", "$(rootpath probe-allowlist.json)", "$(rootpath :probe-image.elf)", "$(rootpath :probe-image.bin)"],
    data = [":check-fixed-image", "probe-allowlist.json", ":probe-image.elf", ":probe-image.bin"],
)


haskell_binary(
    name = "fixed-image-probe",
    testonly = True,
    srcs = ["ProbeMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [":contract", "//host:aeson", "//host:base", "//host:bytestring", "//host:first-stage", "//host:host-support", "//host:update-container"],
)

genrule(
    name = "probe-script",
    testonly = True,
    outs = ["probe.ld"],
    tools = [":fixed-image-probe"],
    cmd = "$(location :fixed-image-probe) script > $@",
)

xm1_rust_staticlib(
    name = "probe-rust",
    testonly = True,
    src = "probe.rs",
    crate_name = "xm1_fixed_image_probe",
)

xm1_rust_elf(
    name = "probe-image",
    testonly = True,
    rust_staticlib = ":probe-rust",
    asm_srcs = ["probe-entry.S"],
    entry = "xm1_fixed_test_entry",
    link_script = ":probe.ld",
    extra_ldflags = ["-Wl,--gc-sections", "-Wl,--emit-relocs"],
)
