load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_rlib", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

haskell_binary(
    name = "image5-load-source",
    srcs = ["SourceMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//emulation:case-sha256",
        "//host:directory",
        "//replacement/media_permit:stock-inventory",
    ],
)

haskell_binary(
    name = "image5-decoder-source",
    srcs = ["DecoderSource.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//emulation:case-sha256",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:json",
        "//host:update-container",
        "//host/firmware:bank-allowlist",
        "//replacement/media_permit:stock-inventory",
        "//replacement/startup_artifact:startup-artifact",
    ],
)

xm1_rust_staticlib(
    name = "image5-load-rust",
    src = "src.rs",
    crate_name = "xm1_image5_load",
)

xm1_rust_elf(
    name = "image5-load-image",
    rust_staticlib = ":image5-load-rust",
    asm_srcs = ["entry.S"],
    entry = "xm1_image5_load_entry",
    link_script = "image5-load.ld",
    extra_ldflags = ["-Wl,--gc-sections"],
)

xm1_rust_staticlib(
    name = "image5-decoder-rust",
    src = "decoder.rs",
    crate_name = "xm1_image5_decoder",
    data = ["decoder_native.rs", "//replacement/first_stage:engine.rs"],
    rustc_flags = ["--cfg", "decoder_standalone"],
)

xm1_rust_rlib(
    name = "decoder-arm",
    src = "decoder.rs",
    crate_name = "xm1_image5_decoder",
    data = ["decoder_native.rs", "//replacement/first_stage:engine.rs"],
    out = "arm/libxm1_image5_decoder.rlib",
)

xm1_rust_elf(
    name = "image5-decoder-measure",
    rust_staticlib = ":image5-decoder-rust",
    entry = "xm1_decoder_init",
    link_script = "decoder.ld",
    extra_ldflags = ["-Wl,--gc-sections"],
    link_map = True,
)

haskell_binary(
    name = "image5-decoder-artifact",
    srcs = ["DecoderArtifact.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2", "-threaded"],
    deps = [
        ":image5-load-artifact",
        "//emulation:case-sha256",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:filepath",
        "//host:first-stage",
        "//host:host-support",
        "//host:json",
        "//host:update-container",
        "//replacement/fixed_image:contract",
    ],
)

genrule(
    name = "decoder-fixed-script",
    srcs = ["decoder.ld"],
    outs = ["decoder-fixed.ld"],
    tools = [":image5-decoder-artifact"],
    cmd = "$(location :image5-decoder-artifact) script $(location decoder.ld) > $@",
)

xm1_rust_elf(
    name = "image5-decoder-image",
    rust_staticlib = "//replacement/bank:bank-image5-decoder",
    entry = "xm1_decoder_init",
    link_script = ":decoder-fixed-script",
    extra_ldflags = ["-Wl,--gc-sections", "-Wl,--emit-relocs"],
    link_map = True,
)

haskell_library(
    name = "image5-load-artifact",
    srcs = [
        "Replacement/Image5Load/Admission.hs",
        "Replacement/Image5Load/Artifact.hs",
    ],
    src_strip_prefix = ".",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//emulation:case-sha256",
        "//emulation:image4-staging-lib",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:first-stage",
        "//host:update-container",
        "//host/firmware:bank-allowlist",
    ],
)

haskell_binary(
    name = "stage-image5-load",
    srcs = ["StageMain.hs"],
    args = [
        "$(rootpath //lz:lz-encode)",
        "$(rootpath //host/firmware:rebuild-update)",
        "$(rootpath //lz:fflzd)",
    ],
    data = ["//lz:lz-encode", "//host/firmware:rebuild-update", "//lz:fflzd"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":image5-load-artifact",
        "//emulation:image4-staging-lib",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:filepath",
        "//host:host-support",
    ],
)

haskell_test(
    name = "image5-load-tests",
    srcs = ["Tests.hs", "Fixtures.hs"],
    main_file = "Tests.hs",
    args = [
        "$(rootpath :image5-load-image.bin)",
        "$(rootpath :image5-load-image.symbols)",
    ],
    data = [":image5-load-image.bin", ":image5-load-image.symbols"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":image5-load-artifact",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:update-container",
    ],
)

haskell_test(
    name = "image5-load-artifact-tests",
    srcs = ["ArtifactTests.hs"],
    args = [
        "$(rootpath :image5-load-image.bin)",
        "$(rootpath :image5-load-image.symbols)",
    ],
    data = [":image5-load-image.bin", ":image5-load-image.symbols"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":image5-load-artifact",
        "//host:base",
        "//host:bytestring",
    ],
)

haskell_binary(
    name = "image5-native-routes",
    srcs = ["NativeRoutes.hs", "Fixtures.hs"],
    main_file = "NativeRoutes.hs",
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":image5-load-artifact",
        "//replacement/plain_load:plain-load-artifact",
        "//emulation:owned-case",
        "//emulation:native-observation",
        "//host:containers",
        "//host:update-container",
        "//emulation:case-sha256",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:directory",
        "//host:json",
    ],
)

filegroup(
    name = "shim-catalog-data",
    srcs = glob(["shims.json", "**/*.json", "**/*.ld"]) + ["BUILD.bazel"],
    visibility = ["//replacement/shim_check:__pkg__"],
)
