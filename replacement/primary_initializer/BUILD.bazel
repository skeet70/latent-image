load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

xm1_rust_staticlib(
    name = "primary-initializer-rust",
    src = "src.rs",
    crate_name = "xm1_primary_initializer",
)

xm1_rust_elf(
    name = "primary-initializer-image",
    asm_srcs = ["entry.S"],
    entry = "xm1_primary_initializer_entry",
    link_script = "primary-initializer.ld",
    rust_staticlib = ":primary-initializer-rust",
)
