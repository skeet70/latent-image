_CORE_DEFECTS = [
    "storage_open_removed", "storage_close_before_set", "storage_bracket_bank1",
    "storage_read_before_open", "storage_pair_before_close", "storage_record_save_at_bank",
    "storage_slot_defaults_moved", "storage_tail_defaults_moved", "storage_tail16_moved",
    "storage_tail16_byte", "storage_bank_slot_swap",
]

# The oracle's must-fail controls that change Rust code: each links the crate with one
# `property_defect_*` cfg into a defect image the oracle stages like the candidate.
_DEFECTS = [
    "drop_provisional",
    "drop_second_save",
    "mask_config_default",
    "config_save",
    "invert_gate",
    "index_without_subtract",
    "signed_bound",
    "upper_bound_plus_one",
    "nonzero_means_default",
    "sentinel_plus_one",
] + _CORE_DEFECTS

xm1_rust_staticlib(
    name = "property-service-rust",
    src = "src/lib.rs",
    crate_name = "xm1_property_service",
    rustc_flags = _RUSTC_FLAGS,
    data = _RUST_DATA + ["//replacement/settings_storage:property-core"],
    rlib_deps = {"xm1_kernel": "//replacement/kernel:arm"},
)

xm1_rust_rlib(
    name = "property-service-arm",
    src = "src/lib.rs",
    crate_name = "xm1_property_service",
    out = "arm/libxm1_property_service.rlib",
    rustc_flags = ["-C", "jump-tables=no", "--cfg", "property_reload", "--cfg", "property_rlib"],
    data = _RUST_DATA,
    rlib_deps = {
        "xm1_kernel": "//replacement/kernel:arm",
        "xm1_settings_storage_core": "//replacement/settings_storage:property-core-arm",
    },
)

xm1_rust_staticlib(
    name = "property-service-recipe-edit-rust",
    src = "src/lib.rs",
    crate_name = "xm1_property_service",
    rustc_flags = _RUSTC_FLAGS + ["--cfg", "property_recipe_edit"],
    data = _RUST_DATA + ["//replacement/settings_storage:property-core"],
    rlib_deps = {"xm1_kernel": "//replacement/kernel:arm"},
)

genrule(
    name = "property-service-rust-test-binary",
    srcs = ["src/lib.rs", "src/tests.rs"] + _RUST_DATA + ["//replacement/settings_storage:property-core-host"],
    outs = ["property-service-rust-tests-bin"],
    cmd = "$(location @lab_xm1_rust//:bin/rustc) --edition=2021 --test --crate-name=property_service_tests --extern xm1_settings_storage_core=$(location //replacement/settings_storage:property-core-host) $(location src/lib.rs) -o $@",
    tools = ["@lab_xm1_rust//:bin/rustc"],
    executable = True,
    testonly = True,
)
sh_test(
    name = "property-service-rust-tests",
    srcs = [":property-service-rust-test-binary"],
)

xm1_rust_elf(
    name = "property-service-image",
    rust_staticlib = ":property-service-rust",
    asm_srcs = ["entry.S", "storage-boundary.S"],
    entry = "xm1_property_get_entry",
    link_script = "property-service.ld",
    extra_ldflags = ["-Wl,--gc-sections", "-Wl,--emit-relocs"],
)

# The same owned body behind the two public wrappers the stock image calls.
xm1_rust_elf(
    name = "property-service-public-image",
    rust_staticlib = ":property-service-rust",
    asm_srcs = ["entry-public.S", "storage-boundary.S"],
    entry = "xm1_public_get",
    link_script = "property-service-public.ld",
    extra_ldflags = ["-Wl,--gc-sections", "-Wl,--emit-relocs"],
)

# The rlib the image links, in its carrier layout, for the oracle and the judge.
xm1_rust_staticlib(
    name = "property-linked-panic",
    src = "linked-panic.rs",
    crate_name = "xm1_property_linked_panic",
)

xm1_rust_elf(
    name = "property-service-linked-image",
    rust_staticlib = ":property-linked-panic",
    rust_components = [
        ":property-service-arm",
        "//replacement/settings_storage:property-core-arm",
        "//replacement/kernel:arm",
    ],
    asm_srcs = ["entry-public.S", "storage-boundary.S"],
    entry = "xm1_public_get",
    link_script = "property-service-public.ld",
    extra_ldflags = ["-Wl,--gc-sections", "-Wl,--emit-relocs"],
)

[
    xm1_rust_staticlib(
        name = "property-service-rust-defect-" + defect.replace("_", "-"),
        src = "src/lib.rs",
        crate_name = "xm1_property_service",
        rustc_flags = (["-C", "jump-tables=no", "--extern", "xm1_settings_storage_core=$(location //replacement/settings_storage:property-core-" + defect.replace("_", "-") + ")", "--cfg", defect] if defect in _CORE_DEFECTS else _RUSTC_FLAGS + ["--cfg", "property_defect_" + defect]),
        data = _RUST_DATA + ["//replacement/settings_storage:property-core-" + defect.replace("_", "-") if defect in _CORE_DEFECTS else "//replacement/settings_storage:property-core"],
        rlib_deps = {"xm1_kernel": "//replacement/kernel:arm"},
    )
    for defect in _DEFECTS
]

[
    xm1_rust_elf(
        name = "property-service-defect-" + defect.replace("_", "-"),
        rust_staticlib = ":property-service-rust-defect-" + defect.replace("_", "-"),
        asm_srcs = ["entry.S", "storage-boundary.S"],
        entry = "xm1_property_get_entry",
        link_script = "property-service.ld",
        extra_ldflags = ["-Wl,--gc-sections", "-Wl,--emit-relocs"],
    )
    for defect in _DEFECTS
]

[
    xm1_rust_elf(
        name = "property-service-public-defect-" + defect.replace("_", "-"),
        rust_staticlib = ":property-service-rust-defect-" + defect.replace("_", "-"),
        asm_srcs = ["entry-public.S", "storage-boundary.S"],
        entry = "xm1_public_get",
        link_script = "property-service-public.ld",
        extra_ldflags = ["-Wl,--gc-sections", "-Wl,--emit-relocs"],
    )
    for defect in _DEFECTS
]

# The four defects the rlib-linked oracle runs, built from the same rlib configuration.
_LINKED_DEFECTS = ["storage_open_removed", "storage_close_before_set", "nonzero_means_default", "sentinel_plus_one"]

[
    xm1_rust_rlib(
        name = "property-service-linked-rust-defect-" + defect.replace("_", "-"),
        src = "src/lib.rs",
        crate_name = "xm1_property_service",
        out = "linked-defect/%s/libxm1_property_service.rlib" % defect.replace("_", "-"),
        rustc_flags = ["-C", "jump-tables=no", "--cfg", "property_reload", "--cfg", "property_rlib"] + (
            ["--cfg", defect] if defect in _CORE_DEFECTS else ["--cfg", "property_defect_" + defect]
        ),
        data = _RUST_DATA,
        rlib_deps = {
            "xm1_kernel": "//replacement/kernel:arm",
            "xm1_settings_storage_core": "//replacement/settings_storage:property-core-" + defect.replace("_", "-") if defect in _CORE_DEFECTS else "//replacement/settings_storage:property-core-arm",
        },
    )
    for defect in _LINKED_DEFECTS
]

[
    xm1_rust_elf(
        name = "property-service-linked-defect-" + defect.replace("_", "-"),
        rust_staticlib = ":property-linked-panic",
        rust_components = [
            ":property-service-linked-rust-defect-" + defect.replace("_", "-"),
            "//replacement/settings_storage:property-core-" + defect.replace("_", "-") if defect in _CORE_DEFECTS else "//replacement/settings_storage:property-core-arm",
            "//replacement/kernel:arm",
        ],
        asm_srcs = ["entry-public.S", "storage-boundary.S"],
        entry = "xm1_public_get",
        link_script = "property-service-public.ld",
        extra_ldflags = ["-Wl,--gc-sections", "-Wl,--emit-relocs"],
    )
    for defect in _LINKED_DEFECTS
]

[
    xm1_rust_staticlib(
        name = "property-service-storage-rust-" + variant,
        src = "src/lib.rs",
        crate_name = "xm1_property_service",
        rustc_flags = [
            "-C", "jump-tables=no",
            "--extern", "xm1_settings_storage_core=$(location //replacement/settings_storage:property-core-control-" + variant + ")",
            "--cfg", flag,
        ],
        data = _RUST_DATA + ["//replacement/settings_storage:property-core-control-" + variant],
        rlib_deps = {"xm1_kernel": "//replacement/kernel:arm"},
    )
    for variant, flag in PROPERTY_STORAGE_VARIANTS.items()
]
[
    xm1_rust_elf(
        name = "property-service-storage-refusal-image" if variant == "refusal" else "property-service-storage-control-" + variant,
        rust_staticlib = ":property-service-storage-rust-" + variant,
        asm_srcs = ["entry.S", "storage-boundary.S"],
        entry = "xm1_property_get_entry",
        link_script = "property-service.ld",
        extra_ldflags = ["-Wl,--gc-sections", "-Wl,--emit-relocs"],
    )
    for variant in PROPERTY_STORAGE_VARIANTS
]

