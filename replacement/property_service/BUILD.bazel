haskell_binary(
    name = "qualify",
    srcs = ["QualifyMain.hs"],
    main_file = "QualifyMain.hs",
    args = [
        "--emulator-slot",
        "$(rootpath //emulation:emulator-slot)",
        "--oracle",
        "$(rootpath :property-oracle)",
        "--stage",
        "$(rootpath :stage-property-service)",
        "--stage-encoder",
        "$(rootpath //lz:lz-encode)",
        "--stage-rebuild",
        "$(rootpath //host/firmware:rebuild-update)",
        "--stage-decoder",
        "$(rootpath //lz:fflzd)",
        "--linked",
        "$(rootpath :property-service-image.bin)",
        "--symbols",
        "$(rootpath :property-service-image.symbols)",
    ] + [
        argument
        for defect in _DEFECTS
        for argument in [
            "--defect",
            defect,
            "$(rootpath :property-service-defect-%s.bin)" % defect.replace("_", "-"),
            "$(rootpath :property-service-defect-%s.symbols)" % defect.replace("_", "-"),
        ]
    ],
    data = [
        ":property-oracle",
        ":property-service-image.bin",
        ":property-service-image.symbols",
        ":stage-property-service",
        "//emulation:emulator-slot",
        "//host/firmware:rebuild-update",
        "//lz:fflzd",
        "//lz:lz-encode",
    ] + [
        ":property-service-defect-%s.%s" % (defect.replace("_", "-"), suffix)
        for defect in _DEFECTS
        for suffix in ["bin", "symbols"]
    ],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        ":qualification",
        "//host:base",
        "//host:host-support",
    ],
)

