load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

exports_files([
    "imports.ld",
    "plain-overlay-unit.json",
])

_SOURCES = [
    "src/machine0.rs",
    "src/machine1.rs",
    "src/machine2.rs",
    "src/machine3.rs",
    "src/machine4.rs",
    "src/machine5.rs",
    "src/machine6.rs",
    "src/machine7.rs",
    "src/machine8.rs",
    "src/machine30.rs",
    "src/machine34.rs",
    "src/machine44.rs",
    "src/machine45.rs",
    "src/machine46.rs",
    "src/machine47.rs",
    "src/machine56.rs",
    "src/machine57.rs",
    "src/machine61.rs",
    "src/machine66.rs",
    "src/machine70.rs",
    "src/request.rs",
    "src/stock.rs",
]

PLAYBACK_ACTOR_CONTROLS = [
    "abort_keeps_state",
    "start_unpublished",
    "error_without_restart",
    "packet_082d_result_dropped",
    "buffer_step_kept",
    "navigation_result_shifted",
    "m7_action47_result_shifted",
    "m30_gate_swapped",
    "m30_action17_result_shifted",
    "m61_action22_result_shifted",
    "m1_action12_result_shifted",
    "m2_action11_result_shifted",
    "m3_action09_result_shifted",
    "m4_action06_result_shifted",
    "m5_action09_result_shifted",
    "m6_action06_result_shifted",
    "m8_action03_result_shifted",
    "m34_action10_result_shifted",
    "m44_action16_result_shifted",
    "m45_action09_result_shifted",
    "m46_action09_result_shifted",
    "m47_action10_result_shifted",
    "m56_action11_result_shifted",
    "m57_action08_result_shifted",
    "m66_action06_result_shifted",
    "m70_action21_result_shifted",
]

_VARIANTS = [("", [])] + [
    ("-control-" + control.replace("_", "-"), ["--cfg", "playback_control_" + control])
    for control in PLAYBACK_ACTOR_CONTROLS
]

[xm1_rust_staticlib(
    name = "playback-actor-rust" + suffix,
    src = "src/lib.rs",
    crate_name = "xm1_playback_actor",
    data = _SOURCES,
    rustc_flags = ["-C", "overflow-checks=off"] + flags,
) for suffix, flags in _VARIANTS]

[xm1_rust_elf(
    name = "playback-actor-image" + suffix,
    rust_staticlib = ":playback-actor-rust" + suffix,
    asm_srcs = ["table.S"],
    entry = "xm1_playback_m0_action02",
    link_script = "playback-actor.ld",
    link_includes = ["imports.ld"],
    extra_ldflags = ["-Wl,--gc-sections"],
) for suffix, _ in _VARIANTS]

genrule(
    name = "host-tests",
    srcs = ["src/lib.rs", "src/tests.rs"] + _SOURCES,
    outs = ["host-tests.passed"],
    cmd = "$(location @lab_xm1_rust//:bin/rustc) --edition=2021 --test $(location src/lib.rs) -o $(@D)/host-tests && $(@D)/host-tests && touch $@",
    tools = ["@lab_xm1_rust//:bin/rustc"],
)

haskell_library(
    name = "actor",
    srcs = [
        "Replacement/PlaybackActor/Actor.hs",
        "Replacement/PlaybackActor/Provenance.hs",
    ],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    src_strip_prefix = ".",
    deps = [
        "//host:base",
        "//host:containers",
        "//host:text",
    ],
)

haskell_test(
    name = "provenance-tests",
    size = "small",
    srcs = ["ProvenanceTests.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror"],
    main_file = "ProvenanceTests.hs",
    deps = [
        ":actor",
        "//host:base",
    ],
)

haskell_library(
    name = "cases",
    srcs = [
        "Replacement/PlaybackActor/Cases.hs",
        "Replacement/PlaybackActor/Machine1.hs",
        "Replacement/PlaybackActor/Machine2.hs",
        "Replacement/PlaybackActor/Machine3.hs",
        "Replacement/PlaybackActor/Machine30.hs",
        "Replacement/PlaybackActor/Machine34.hs",
        "Replacement/PlaybackActor/Machine4.hs",
        "Replacement/PlaybackActor/Machine44.hs",
        "Replacement/PlaybackActor/Machine45.hs",
        "Replacement/PlaybackActor/Machine46.hs",
        "Replacement/PlaybackActor/Machine47.hs",
        "Replacement/PlaybackActor/Machine5.hs",
        "Replacement/PlaybackActor/Machine56.hs",
        "Replacement/PlaybackActor/Machine57.hs",
        "Replacement/PlaybackActor/Machine6.hs",
        "Replacement/PlaybackActor/Machine61.hs",
        "Replacement/PlaybackActor/Machine66.hs",
        "Replacement/PlaybackActor/Machine7.hs",
        "Replacement/PlaybackActor/Machine70.hs",
        "Replacement/PlaybackActor/Machine8.hs",
        "Replacement/PlaybackActor/Model.hs",
    ],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    src_strip_prefix = ".",
    deps = [
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//replacement/file_service:native-lib",
    ],
)

haskell_binary(
    name = "playback-actor-suite",
    srcs = ["SuiteMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    main_file = "SuiteMain.hs",
    deps = [
        ":cases",
        "//emulation:case-sha256",
        "//host/firmware:bank-allowlist",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:deepseq",
        "//host:directory",
        "//host:filepath",
        "//replacement/file_service:native-lib",
    ],
)

haskell_binary(
    name = "playback-actor-observe",
    srcs = ["ObserveMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2", "-rtsopts"],
    main_file = "ObserveMain.hs",
    deps = [
        ":actor",
        "//emulation:case-sha256",
        "//emulation:emulator-usb",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:deepseq",
        "//host:directory",
        "//host:filepath",
        "//host:text",
        "//host:vector",
    ],
)

filegroup(
    name = "all",
    srcs = [
        ":host-tests",
        ":playback-actor-observe",
        ":playback-actor-suite",
    ] + [":playback-actor-image" + suffix for suffix, _ in _VARIANTS],
)

filegroup(
    name = "shim-catalog-data",
    srcs = glob(["shims.json", "**/*.ld"]) + ["BUILD.bazel"],
    visibility = ["//replacement/shim_check:__pkg__"],
)
