load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("//replacement/toolchain:rust.bzl", "xm1_rust_elf", "xm1_rust_staticlib")

package(default_visibility = ["//visibility:public"])

exports_files(["imports.ld"])

_SOURCES = ["src/machine0.rs", "src/machine7.rs", "src/machine30.rs", "src/machine61.rs", "src/request.rs", "src/stock.rs"]

# Staged machines' controls; the native image also carries the native-only machines 30 and 61
# and their controls.
PLAYBACK_ACTOR_CONTROLS = [
    "abort_keeps_state",
    "start_unpublished",
    "error_without_restart",
    "packet_082d_result_dropped",
    "buffer_step_kept",
    "navigation_result_shifted",
    "m7_action47_result_shifted",
]

PLAYBACK_ACTOR_NATIVE_CONTROLS = PLAYBACK_ACTOR_CONTROLS + [
    "m30_gate_swapped",
    "m30_action17_result_shifted",
    "m61_action22_result_shifted",
]

_VARIANTS = [("", [])] + [
    ("-control-" + control.replace("_", "-"), ["--cfg", "playback_control_" + control])
    for control in PLAYBACK_ACTOR_CONTROLS
]

_NATIVE_VARIANTS = [("", [])] + [
    ("-control-" + control.replace("_", "-"), ["--cfg", "playback_control_" + control])
    for control in PLAYBACK_ACTOR_NATIVE_CONTROLS
]

[xm1_rust_staticlib(
    name = "playback-actor-rust" + suffix,
    src = "src/lib.rs",
    crate_name = "xm1_playback_actor",
    data = _SOURCES,
    rustc_flags = ["-C", "overflow-checks=off"] + flags,
) for suffix, flags in _VARIANTS]

[xm1_rust_elf(
    name = "playback-actor-image" + suffix,
    rust_staticlib = ":playback-actor-rust" + suffix,
    asm_srcs = ["table.S"],
    entry = "xm1_playback_m0_action02",
    link_script = "playback-actor.ld",
    link_includes = ["imports.ld"],
    extra_ldflags = ["-Wl,--gc-sections"],
) for suffix, _ in _VARIANTS]

[xm1_rust_staticlib(
    name = "playback-actor-native-rust" + suffix,
    src = "src/lib.rs",
    crate_name = "xm1_playback_actor",
    data = _SOURCES,
    rustc_flags = ["-C", "overflow-checks=off", "--cfg", "playback_native_machines"] + flags,
) for suffix, flags in _NATIVE_VARIANTS]

[xm1_rust_elf(
    name = "playback-actor-native-image" + suffix,
    rust_staticlib = ":playback-actor-native-rust" + suffix,
    asm_srcs = ["table.S", "table-native.S"],
    entry = "xm1_playback_m0_action02",
    link_script = "playback-actor-native.ld",
    link_includes = ["imports.ld", "imports-native.ld"],
    extra_ldflags = ["-Wl,--gc-sections"],
) for suffix, _ in _NATIVE_VARIANTS]

genrule(
    name = "host-tests",
    srcs = ["src/lib.rs", "src/tests.rs"] + _SOURCES,
    outs = ["host-tests.passed"],
    cmd = "$(location @lab_xm1_rust//:bin/rustc) --edition=2021 --test $(location src/lib.rs) -o $(@D)/host-tests && $(@D)/host-tests && touch $@",
    tools = ["@lab_xm1_rust//:bin/rustc"],
)

haskell_library(
    name = "actor",
    srcs = [
        "Replacement/PlaybackActor/Actor.hs",
        "Replacement/PlaybackActor/Provenance.hs",
    ],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    src_strip_prefix = ".",
    deps = [
        "//host:base",
        "//host:containers",
        "//host:text",
    ],
)

haskell_test(
    name = "provenance-tests",
    size = "small",
    srcs = ["ProvenanceTests.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror"],
    main_file = "ProvenanceTests.hs",
    deps = [
        ":actor",
        "//host:base",
    ],
)

haskell_library(
    name = "cases",
    srcs = [
        "Replacement/PlaybackActor/Cases.hs",
        "Replacement/PlaybackActor/Machine30.hs",
        "Replacement/PlaybackActor/Machine61.hs",
        "Replacement/PlaybackActor/Machine7.hs",
        "Replacement/PlaybackActor/Model.hs",
    ],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    src_strip_prefix = ".",
    deps = [
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//replacement/file_service:native-lib",
    ],
)

haskell_binary(
    name = "playback-actor-suite",
    srcs = ["SuiteMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    main_file = "SuiteMain.hs",
    deps = [
        ":cases",
        "//emulation:case-sha256",
        "//host/firmware:bank-allowlist",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:deepseq",
        "//host:directory",
        "//host:filepath",
        "//replacement/file_service:native-lib",
    ],
)

haskell_binary(
    name = "playback-actor-stage",
    srcs = ["StageMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    main_file = "StageMain.hs",
    deps = [
        "//emulation:case-sha256",
        "//host/firmware:bank-allowlist",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:directory",
    ],
)

haskell_binary(
    name = "playback-actor-observe",
    srcs = ["ObserveMain.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2", "-rtsopts"],
    main_file = "ObserveMain.hs",
    deps = [
        ":actor",
        "//emulation:case-sha256",
        "//emulation:emulator-usb",
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:deepseq",
        "//host:directory",
        "//host:filepath",
        "//host:text",
        "//host:vector",
    ],
)

filegroup(
    name = "all",
    srcs = [
        ":host-tests",
        ":playback-actor-observe",
        ":playback-actor-stage",
        ":playback-actor-suite",
    ] + [":playback-actor-image" + suffix for suffix, _ in _VARIANTS] + [
        ":playback-actor-native-image" + suffix
        for suffix, _ in _NATIVE_VARIANTS
    ],
)

filegroup(
    name = "shim-catalog-data",
    srcs = glob(["shims.json", "**/*.ld"]) + ["BUILD.bazel"],
    visibility = ["//replacement/shim_check:__pkg__"],
)
