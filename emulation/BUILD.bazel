      $(location :render-adapter-class-cases) --json $(@D)/render-adapter-class-cases.json --rust $(@D)/render-adapter-class-cases.rs &&
      $(location @lab_rustc//:bin/rustc) --edition=2021 --crate-name render_adapter_class --crate-type=rlib --extern menu_engine_adapter=$(location //replacement/menu_engine:adapter-class-host) $(location //replacement/render_adapter:class.rs) -o $(@D)/librender_adapter_class.rlib &&
      $(location @lab_rustc//:bin/rustc) --edition=2021 --test -C linker=$(location @lab_clang//:bin/clang) --extern render_adapter_class=$(@D)/librender_adapter_class.rlib -L dependency=$$(dirname $(location //replacement/menu_engine:adapter-class-host)) $(@D)/render-adapter-class-cases.rs -o $(@D)/render-adapter-class-tests-bin
    """,
    testonly = True,
    tools = [
        ":render-adapter-class-cases",
        "@lab_rustc//:bin/rustc",
        "@lab_clang//:bin/clang",
    ],
)

