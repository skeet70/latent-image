# The paths come from the package's store-path file, whose bytes change with the store path.
config_setting(
    name = "r1diag-fujimod-store",
    define_values = {"fujimod_store": "r1diag"},
)

genrule(
    name = "fujimod-paths-module",
    srcs = select({
        ":r1diag-fujimod-store": ["fujimod-r1diag-store-path.txt"],
        "//conditions:default": ["@lab_fujimod_xm1//:share/fujimod-xm1/store-path"],
    }),
    outs = ["FujiModPaths.hs"],
    cmd = " && ".join([
        "read -r store < $(SRCS)",
        "printf 'module FujiModPaths (fujimodDriver, fujimodRamPushBridge, fujimodToggleBridge, fujimodRun) where\\n\\nfujimodDriver :: FilePath\\nfujimodDriver = \"%s\"\\n\\nfujimodRamPushBridge :: FilePath\\nfujimodRamPushBridge = \"%s\"\\n\\nfujimodToggleBridge :: FilePath\\nfujimodToggleBridge = \"%s\"\\n\\nfujimodRun :: FilePath\\nfujimodRun = \"%s\"\\n' \"$$store/bin/fujimod-xm1\" \"$$store/bin/fujimod-xm1-ram-push\" \"$$store/bin/fujimod-xm1-toggle\" \"$$store/share/fujimod-xm1/xm1-150.json\" > $@",
    ]),
)

haskell_library(
    name = "fujimod-paths",
    srcs = [":fujimod-paths-module"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror"],
    visibility = ["//visibility:public"],
    deps = ["//host:base"],
)

