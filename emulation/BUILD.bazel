# The RAM-push host procedure's compiled sources, hashed as one digest. A post-INSTALL
# checkpoint names it, so a change here replaces that checkpoint and keeps the attach one.
genrule(
    name = "ram-push-procedure-module",
    srcs = [
        "CardlessRamPush.hs",
        "EmulatorUsb.hs",
        "Xm1RamPushE2E.hs",
        "Emulation/LiveSettings.hs",
        "Emulation/MachineFingerprint.hs",
        "Emulation/CaptureStream.hs",
        "Emulation/SaveLifecycle.hs",
        "Emulation/SaveLifecycleRun.hs",
        "//transport:FujiAF/RamPush.hs",
        "//transport:FujiAF/Transport.hs",
    ],
    outs = ["RamPushProcedure.hs"],
    cmd = "digest=$$(cat $(SRCS) | sha256sum); digest=$${digest%% *}; printf 'module RamPushProcedure (procedureSourcesDigest) where\\n\\nprocedureSourcesDigest :: String\\nprocedureSourcesDigest = \"%s\"\\n' \"$$digest\" > $@",
)

