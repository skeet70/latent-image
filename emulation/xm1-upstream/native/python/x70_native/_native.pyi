class Machine:
    def __init__(self, library: str, ram_size: int, rom: bytes,
                 low_rom_alias: bool = True, entries: list[int] = ...) -> None: ...
    def set_handler(self, callback: Any, counters: bool = False) -> None: ...
    def aux_version(self) -> int: ...
    def audit_begin(self, core: int, stack_start: int, stack_end: int,
                    text_begin: int = 0, text_end: int = 0, fault_address: int = 0,
                    trace: bool = False, data_begin: int = 0, data_end: int = 0) -> None: ...
    def audit_state(self, core: int) -> dict[str, Any]: ...
    def fetch_guard_begin(self, core: int, ranges: list[tuple[int, int]],
                          vector_ranges: list[tuple[int, int]] = ...,
                          vector_opcode: int = 0xe59ff018, fault_address: int = 0,
                          stop_addresses: list[int] = ...) -> None: ...
