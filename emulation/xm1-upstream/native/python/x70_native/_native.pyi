    def release_menu_key(self, session: Any, key: str, cap: int) -> bool | None: ...
    def menu_keys_released(self) -> bool: ...
    def store_log_begin(self, core: int, stack_start: int, stack_end: int,
                        allowed: list[tuple[int, int]] | None = None, limit: int = 1048576,
                        include_stack: bool = False) -> None: ...
    def store_log_state(self, core: int, stores: bool = True, records: bool = False) -> dict[str, Any]: ...
    def coverage_begin(self, core: int) -> None: ...
    def coverage_end(self, core: int) -> None: ...
    def coverage_state(self, core: int) -> list[int] | None: ...
    def exec_probe_begin(self, core: int, ranges: list[tuple[int, int]] = ..., trace: int = 0) -> None: ...
    def exec_probe_end(self, core: int) -> None: ...
    def exec_probe_state(self, core: int) -> tuple[list[int], list[int], int] | None: ...
    def breakpoint_halt(self, core: int) -> None: ...
    def set_tick_deadline(self, deadline: int = 18446744073709551615) -> None: ...
    def tick_deadline(self) -> int: ...
    def set_cp14_identity(self, core: int, value: int) -> None: ...
    def cp14_identity(self) -> tuple[int, int]: ...
    def store_log_end(self, core: int) -> None: ...
    def memory_address(self, name: str) -> int: ...
    def reg_read(self, core: int, reg: int) -> bytes: ...
    def reg_write(self, core: int, reg: int, data: bytes) -> None: ...
    def cpr(self, core: int, cp: int, opc1: int, crn: int, crm: int, opc2: int,
            sec: int, is64: bool, value: int | None = None) -> int: ...
    def mem_read(self, core: int, address: int, size: int) -> bytes: ...
    def mem_write(self, core: int, address: int, data: bytes) -> None: ...
    def write_bus(self, core: int, address: int, data: bytes) -> None: ...
    def prepare_declared_ui_conversion(self, src_phys: int, dst_phys: int, width: int,
                                       height: int, stride: int) -> DeclaredUIConversionPlan: ...
    def convert_declared_ui(self, plan: DeclaredUIConversionPlan, core: int,
                            instructions: int, ticks: int) -> None: ...
    def mem_regions(self, core: int) -> list[tuple[int, int, int]]: ...
    def mem_map(self, core: int, address: int, size: int, protection: int = 7) -> None: ...
    def mem_map_ptr(self, core: int, address: int, size: int, protection: int, pointer: int) -> None: ...
    def mem_unmap(self, core: int, address: int, size: int) -> None: ...
    def mem_protect(self, core: int, address: int, size: int, protection: int) -> None: ...
    def add_mmio_hook(self, core: int, begin: int, end: int) -> int: ...
    def remove_cache(self, core: int, address: int, end: int) -> None: ...
    def flush_tb(self, core: int) -> None: ...
    def clear_caches(self) -> None: ...
    def flush_pending(self) -> None: ...
    def invalidate_write(self, core: int, address: int, size: int, exclusive: bool = True) -> None: ...
    def instruction(self, core: int, address: int, size: int) -> tuple[int, bytes, int, bool]: ...
    def load_state(self, instructions: int, ticks: int, cores: list[Any], monitors: list[Any],
                   counts: tuple[int, int, int, int], remap: bool, cache_enabled: bool,
                   cp14_sites: list[tuple[int, int]] | None = None,
                   seen_entries: list[tuple[int, int]] | None = None,
                   tick_ratio: tuple[int, int] | None = None, tick_phase: int | None = None) -> None: ...
    def load_trace(self, traces: list[list[tuple[int, bytes]]]) -> None: ...
    def state(self, trace: bool = True) -> dict[str, Any]: ...
    def metrics(self) -> dict[str, Any]: ...
    def emu_start(self, core: int, begin: int, until: int, timeout: int = 0, count: int = 0) -> int: ...
    def set_execution(self, mode: str) -> None: ...
    def execution(self) -> str: ...
    def emu_stop(self, core: int) -> None: ...
    def context_save(self, core: int) -> CpuContext: ...
    def context_restore(self, core: int, context: CpuContext) -> None: ...

