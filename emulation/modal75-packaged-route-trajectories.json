    {
      "source": "emulation/ram-push-e2e-trajectories.json:5-8",
      "expectation": "The installed package uses the qualified two-MENU prefix before shooting-menu navigation."
    },
    {
      "source": "emulation/modal75-stock-route-trajectories.json:14-35",
      "expectation": "The natural FILMSIM path reaches shooting (1,5,2), film list (1,254,0) and returned shooting (1,5,6) through MENU, four DOWN, OK and BACK."
    },
    {
      "source": "emulation/ram-push-e2e-trajectories.json: stock-film-before-unload and d3-film-list-after-unload",
      "expectation": "BACK closes the shooting menu while retained menu fields remain (1,5,6); MENU reopens it and OK reaches the film list after rollback."
    }
  ],
