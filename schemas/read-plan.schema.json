{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded adjustment-area read plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "firmware_basis", "channel", "windows", "oracle", "generated_by"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$"},
    "firmware_basis": {"type": "string", "minLength": 1, "maxLength": 256},
    "channel": {
      "type": "object", "additionalProperties": false,
      "required": ["opcode", "function", "mb", "length"],
      "properties": {
        "opcode": {"const": "0x1a0002"},
        "function": {"const": 2},
        "mb": {"const": 1},
        "length": {"const": 256}
      }
    },
    "windows": {
      "type": "array", "minItems": 1, "maxItems": 2048, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "offset", "length", "purpose"],
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 2047},
          "offset": {
            "allOf": [
              {"$ref": "common.schema.json#/$defs/address"},
              {"pattern": "^0x(0[0-9a-f]|[1-3][0-9a-f]|4[01])[0-9a-f]{2}00$"}
            ]
          },
          "length": {"const": 256},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["window_index", "byte_offset", "expect"],
      "properties": {
        "window_index": {"type": "integer", "minimum": 0, "maximum": 2047},
        "byte_offset": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/address"},
            {"pattern": "^0x([0-9a-e][0-9a-f]|f[0-9ab])$"}
          ]
        },
        "expect": {"const": "product-string"}
      }
    },
    "generated_by": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "sha256"],
      "properties": {
        "tool": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    }
  }
}
