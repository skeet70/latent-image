{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One evidence ledger entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "recorded_at",
    "label",
    "claim",
    "scope",
    "firmware_sha256",
    "sources",
    "artifacts",
    "commands",
    "limitations",
    "camera_state_change"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "label": {
      "$ref": "common.schema.json#/$defs/evidenceLabel"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "firmware_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifact"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "camera_state_change": {
      "enum": [
        "none",
        "temporary",
        "persistent",
        "unknown"
      ]
    }
  }
}
