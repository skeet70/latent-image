{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared research types v1",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "evidenceLabel": {
      "enum": [
        "reported",
        "source-inspected",
        "static-inference",
        "emulated",
        "hardware-observed",
        "independently-reproduced"
      ]
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{1,16}$"
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock_id",
        "ticks"
      ],
      "properties": {
        "clock_id": {
          "type": "string",
          "minLength": 1
        },
        "ticks": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    }
  }
}
