{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mapped firmware regions v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "firmware",
    "cpu",
    "regions"
  ],
  "allOf": [
    {
      "if": { "properties": { "regions": { "minItems": 1 } } },
      "then": { "properties": { "firmware": { "type": "object" } } }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "firmware": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "cpu": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "architecture",
        "mode",
        "endianness",
        "evidence_ids"
      ],
      "properties": {
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "endianness": {
          "enum": [
            "little",
            "big"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start",
          "length_bytes",
          "classification",
          "permissions",
          "provenance",
          "confidence",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "$ref": "common.schema.json#/$defs/address"
          },
          "length_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "classification": {
            "enum": [
              "code",
              "writable-ram",
              "rom",
              "device-registers",
              "storage-window",
              "unknown"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "enum": [
                "read",
                "write",
                "execute"
              ]
            },
            "uniqueItems": true
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "unknown",
              "low",
              "medium",
              "high"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
