{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skeet70/latent-image/schemas/file-manifest.schema.json",
  "title": "X-M1 file and media service source inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "firmware", "scope", "inputs", "extentMethod", "savedStackTaintResiduals", "censusMethod", "callerClosure", "mediaTask", "messageCodes", "entries", "objects", "families"],
  "properties": {
    "schemaVersion": {"const": 1},
    "firmware": {"const": "X-M1 1.50"},
    "scope": {"type": "string"},
    "extentMethod": {"type": "string"},
    "savedStackTaintResiduals": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["name", "statement"], "properties": {"name": {"enum": ["sub-word-load", "sub-word-or-unaligned-store", "untracked-pointer", "joined-address", "unknown-first-operand-address", "call-boundary"]}, "statement": {"type": "string"}}}},
    "censusMethod": {"type": "string"},
    "callerClosure": {"type": "string"},
    "inputs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "mediaTask": {
      "type": "object", "additionalProperties": false, "required": ["requestTable", "requests"],
      "properties": {
        "requestTable": {"const": "0x814740"},
        "requests": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["code", "handler", "entry"], "properties": {"code": {"$ref": "#/$defs/code"}, "handler": {"$ref": "#/$defs/address"}, "entry": {"type": "string"}}}}
      }
    },
    "messageCodes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "handler", "handlerEntry", "sites"], "properties": {
      "code": {"$ref": "#/$defs/code"}, "handler": {"$ref": "#/$defs/nullableAddress"}, "handlerEntry": {"type": ["string", "null"]},
      "sites": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["site", "form", "register", "candidateFunction", "candidateEntry"], "properties": {"site": {"$ref": "#/$defs/address"}, "form": {"enum": ["movw", "mov", "ldr-literal"]}, "register": {"type": "string"}, "candidateFunction": {"$ref": "#/$defs/nullableAddress"}, "candidateEntry": {"type": ["string", "null"]}}}}
    }}},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
    "families": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["family", "entries"], "properties": {"family": {"$ref": "#/$defs/family"}, "entries": {"type": "integer", "minimum": 0}}}}
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x[0-9a-f]+$"},
    "nullableAddress": {"anyOf": [{"$ref": "#/$defs/address"}, {"type": "null"}]},
    "code": {"type": "string", "pattern": "^0x2c[0-9a-f]{2}$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "family": {"enum": ["caller-facing", "synchronous-form", "poster", "media-task", "media-worker", "handle-manager", "completion", "volume-registry", "media-state", "helper"]},
    "callSite": {"type": "object", "additionalProperties": false, "required": ["site", "candidateFunction"], "properties": {"site": {"$ref": "#/$defs/address"}, "candidateFunction": {"$ref": "#/$defs/nullableAddress"}}},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "name", "family", "recovery", "message", "operation", "arguments", "result", "codes", "context", "objects", "callers", "directCalls", "branchSites", "literalWords", "constructedSites", "extent", "grounded", "unknown", "evidence"],
      "properties": {
        "address": {"$ref": "#/$defs/address"}, "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}, "family": {"$ref": "#/$defs/family"},
        "recovery": {"enum": ["recovered", "partial", "unknown"]},
        "message": {"anyOf": [{"$ref": "#/$defs/code"}, {"type": "null"}]},
        "operation": {"type": "string"}, "arguments": {"type": "string"}, "result": {"type": "string"}, "context": {"type": "string"}, "callers": {"type": "string"},
        "codes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["value", "meaning"], "properties": {"value": {"type": "integer"}, "meaning": {"type": "string"}}}},
        "objects": {"$ref": "#/$defs/strings"},
        "directCalls": {"type": "array", "items": {"$ref": "#/$defs/callSite"}},
        "branchSites": {"type": "array", "items": {"$ref": "#/$defs/callSite"}},
        "literalWords": {"type": "array", "items": {"$ref": "#/$defs/address"}},
        "constructedSites": {"type": "array", "items": {"$ref": "#/$defs/callSite"}},
        "extent": {"$ref": "#/$defs/extent"},
        "grounded": {"$ref": "#/$defs/strings"}, "unknown": {"$ref": "#/$defs/strings"}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "object": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "address", "bytes", "layout", "constructedAddressSites", "grounded", "unknown", "evidence"],
      "properties": {
        "name": {"type": "string"}, "address": {"$ref": "#/$defs/address"}, "bytes": {"type": "integer", "minimum": 1}, "layout": {"type": "string"},
        "constructedAddressSites": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["site", "form", "address", "candidateFunction"], "properties": {"site": {"$ref": "#/$defs/address"}, "form": {"enum": ["movw-movt", "ldr-literal"]}, "address": {"$ref": "#/$defs/address"}, "candidateFunction": {"$ref": "#/$defs/nullableAddress"}}}},
        "grounded": {"$ref": "#/$defs/strings"}, "unknown": {"$ref": "#/$defs/strings"}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "extent": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status", "start", "end", "codeEnvelopeBytes", "windowEnd", "returnPremises", "scope"], "properties": {"status": {"const": "derived"}, "start": {"$ref": "#/$defs/address"}, "end": {"$ref": "#/$defs/address"}, "codeEnvelopeBytes": {"type": "integer", "minimum": 4}, "windowEnd": {"$ref": "#/$defs/address"}, "returnPremises": {"$ref": "#/$defs/strings"}, "scope": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "start", "windowEnd", "refusal", "scope"], "properties": {"status": {"const": "unknown"}, "start": {"$ref": "#/$defs/address"}, "windowEnd": {"$ref": "#/$defs/address"}, "refusal": {"type": "string"}, "scope": {"type": "string"}}}
      ]
    }
  }
}
