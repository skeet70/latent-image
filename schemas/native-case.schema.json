{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native-case.schema.json",
  "title": "Bounded native case v1, Cortex-R5F ARM-only profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "origin", "provenance", "cpu", "artifacts", "entry", "exit", "registers", "regions", "functions", "stubs", "limits", "expected", "exclusions"],
  "properties": {
    "schema_version": {"const": 1},
    "memory_profile": {"const": "resource8", "description": "Absent retains the default envelope. resource8 permits 8388608 mapped bytes, bytes per region/artifact and aggregate stub contract bytes, 41943040 wire bytes and 67108864 JSON bytes. Semantic sums, fences and permissions are checked by the host and SDK."},
    "id": {"$ref": "#/$defs/id"},
    "origin": {"enum": ["synthetic", "stock"]},
    "provenance": {"type": "string", "minLength": 1},
    "cpu": {
      "type": "object", "additionalProperties": false,
      "required": ["architecture", "model", "mode", "endian"],
      "properties": {"architecture": {"const": "arm"}, "model": {"const": "cortex-r5f"}, "mode": {"const": "arm"}, "endian": {"const": "little"}}
    },
    "artifacts": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "size", "sha256"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"type": "string", "minLength": 1},
          "size": {"$ref": "#/$defs/size"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "entry": {"$ref": "#/$defs/u32"}, "exit": {"$ref": "#/$defs/u32"},
    "registers": {
      "allOf": [{"$ref": "#/$defs/registers"}],
      "required": ["r0", "r1", "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "sp", "lr", "cpsr"],
      "not": {"required": ["pc"]}
    },
    "regions": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "address", "size", "permissions", "initial"],
        "properties": {
          "id": {"$ref": "#/$defs/id"}, "address": {"$ref": "#/$defs/u32"},
          "size": {"$ref": "#/$defs/size"}, "permissions": {"enum": ["r", "rw", "rx", "device"], "description": "device: one interrupt-controller bank word 0xfffb30cc, 0xfffb40cc, 0xfffb30ec or 0xfffb40ec of a kernel case, size 4, taking aligned word stores only"},
          "initial": {
            "oneOf": [
              {"type": "object", "additionalProperties": false, "required": ["zero"], "properties": {"zero": {"const": true}}},
              {"type": "object", "additionalProperties": false, "required": ["artifact", "offset", "length"], "properties": {"artifact": {"$ref": "#/$defs/id"}, "offset": {"type": "integer", "minimum": 0, "maximum": 8388608}, "length": {"$ref": "#/$defs/size"}}}
            ]
          }
        }
      }
    },
    "functions": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {"type": "object", "additionalProperties": false, "required": ["address", "size"], "properties": {"address": {"$ref": "#/$defs/u32"}, "size": {"$ref": "#/$defs/size"}}}
    },
    "stubs": {
      "type": "array", "maxItems": 32,
      "items": {"oneOf": [{"$ref": "#/$defs/legacyStub"}, {"$ref": "#/$defs/scriptStub"}]},
      "description": "All stubs in a case use one form. Script calls total at most 128 and their read/write bytes total at most 4194304."
    },
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["instructions", "wall_ms"],
      "properties": {"instructions": {"type": "integer", "minimum": 1, "maximum": 16000000}, "wall_ms": {"type": "integer", "minimum": 1, "maximum": 10000}}
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "registers", "memory", "events"],
      "properties": {
        "status": {"enum": ["returned", "instruction_budget", "wall_budget", "memory_guard", "fetch_guard", "unknown_call", "unsupported_instruction", "stub_contract", "stop_address"]},
        "registers": {"$ref": "#/$defs/registers", "minProperties": 1},
        "memory": {
          "type": "array", "maxItems": 64,
          "items": {"type": "object", "additionalProperties": false, "required": ["region", "offset", "hex"], "properties": {"region": {"$ref": "#/$defs/id"}, "offset": {"type": "integer", "minimum": 0, "maximum": 8388608}, "hex": {"type": "string", "pattern": "^([0-9a-f]{2})+$", "maxLength": 16777216}}}
        },
        "ignored_memory": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "description": "Disjoint private frame spans in the writable region containing entry SP, ending at or below entry SP, disjoint from expected.memory. At most 4194304 bytes total. Requires scripted stubs or no stubs.",
          "items": {"type": "object", "additionalProperties": false, "required": ["region", "offset", "length"], "properties": {"region": {"$ref": "#/$defs/id"}, "offset": {"type": "integer", "minimum": 0, "maximum": 8388608}, "length": {"$ref": "#/$defs/size"}}}
        },
        "events": {
          "type": "array", "maxItems": 128,
          "items": {"type": "object", "additionalProperties": false, "required": ["address", "inputs", "outputs"], "properties": {"address": {"$ref": "#/$defs/u32"}, "inputs": {"$ref": "#/$defs/scriptRegisters"}, "outputs": {"$ref": "#/$defs/stubRegisters"}}}
        },
        "kernel": {"$ref": "#/$defs/kernelRegisters", "description": "Final TPIDRURW and FPEXC of a kernel case that declares them, and the word its last LDREX reserved."}
      }
    },
    "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "ignored_memory": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["region", "offset", "length"],
        "properties": {"region": {"$ref": "#/$defs/id"}, "offset": {"type": "integer", "minimum": 0, "maximum": 2097152}, "length": {"$ref": "#/$defs/size"}, "reason": {"enum": ["private-frame", "caller-output"], "description": "private-frame ignores a returned case's stack below incoming SP; caller-output ignores a writable caller-owned output range that follows the asserted prefix."}}
      }
    },
    "cp14_identity": {"$ref": "#/$defs/u32", "description": "The value MRC p14, 0, Rt, c2, c0, 0 reads. Only a privileged case, whose registers.cpsr is SVC 0x13 or SYS 0x1f with only NZCVQ, GE, I and F besides the mode, may name it; a user case's CPSR is 0x10 with NZCV only."},
    "kernel": {
      "type": "object", "additionalProperties": false,
      "dependentRequired": {"fpexc": ["cpacr"]},
      "description": "Makes a privileged case a kernel case: word LDREX/STREX/CLREX with a single-core local monitor, DMB/DSB with a defined option, ISB SY and CP15 c7 c10 5/4 logged in memory_provenance, NOP, MOV pc,lr as a tracked return, device regions, and the named values served to MRC/MCR TPIDRURW, MRC CPACR and VMRS/VMSR FPEXC, TPIDRURW and FPEXC writes also logged in memory_provenance.",
      "properties": {
        "stop": {"$ref": "#/$defs/u32", "description": "The case ends as stop_address when the PC reaches it; aligned, executable, not the entry, exit or a stub."},
        "tpidrurw": {"$ref": "#/$defs/u32"},
        "cpacr": {"$ref": "#/$defs/u32"},
        "fpexc": {"enum": ["0x00000000", "0x40000000"], "description": "EN only. FPEXC words are served only when cpacr cp10 (bits 21:20) and cp11 (bits 23:22) are equal and 0b01 or 0b11, and refused otherwise."},
        "stack_contexts": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "description": "Opt-in private stack contexts. Each interval [low, high) is eight-byte aligned, low < high, disjoint from the others, wholly inside one writable non-device region, and the case's initial SP lies in exactly one context (low < SP <= high). Absent keeps the legacy single-context wire unchanged; an empty array is invalid.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["low", "high"],
            "properties": {
              "low": {"$ref": "#/$defs/u32", "pattern": "^0x[0-9a-f]{7}[08]$"},
              "high": {"$ref": "#/$defs/u32", "pattern": "^0x[0-9a-f]{7}[08]$"}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"not": {"required": ["memory_profile"]}},
      "then": {"properties": {
        "limits": {"properties": {"instructions": {"maximum": 4000000}}},
        "artifacts": {"items": {"properties": {"size": {"maximum": 2097152}}}},
        "regions": {"items": {"properties": {"size": {"maximum": 2097152}, "initial": {"properties": {"offset": {"maximum": 2097152}, "length": {"maximum": 2097152}}}}}},
        "functions": {"items": {"properties": {"size": {"maximum": 2097152}}}},
        "expected": {"properties": {
          "memory": {"items": {"properties": {"offset": {"maximum": 2097152}, "hex": {"maxLength": 4194304}}}},
          "ignored_memory": {"items": {"properties": {"offset": {"maximum": 2097152}, "length": {"maximum": 2097152}}}}
        }},
        "stubs": {"items": {"properties": {"calls": {"items": {"properties": {
          "reads": {"items": {"properties": {"hex": {"maxLength": 4194304}}}},
          "writes": {"items": {"properties": {"hex": {"maxLength": 4194304}}}}
        }}}}}}
      }}
    },
    {
      "if": {"anyOf": [{"properties": {"stubs": {"contains": {"required": ["calls"]}}}}, {"properties": {"expected": {"required": ["ignored_memory"]}}}]},
      "then": {"properties": {"stubs": {"items": {"$ref": "#/$defs/scriptStub"}}}},
      "else": {"properties": {"expected": {"properties": {"events": {"items": {"properties": {"inputs": {"$ref": "#/$defs/stubRegisters"}}}}}}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "u32": {"type": "string", "pattern": "^0x[0-9a-f]{8}$"},
    "size": {"type": "integer", "minimum": 1, "maximum": 8388608},
    "registers": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "r0": {"$ref": "#/$defs/u32"}, "r1": {"$ref": "#/$defs/u32"}, "r2": {"$ref": "#/$defs/u32"}, "r3": {"$ref": "#/$defs/u32"}, "r4": {"$ref": "#/$defs/u32"}, "r5": {"$ref": "#/$defs/u32"}, "r6": {"$ref": "#/$defs/u32"}, "r7": {"$ref": "#/$defs/u32"}, "r8": {"$ref": "#/$defs/u32"}, "r9": {"$ref": "#/$defs/u32"}, "r10": {"$ref": "#/$defs/u32"}, "r11": {"$ref": "#/$defs/u32"}, "r12": {"$ref": "#/$defs/u32"}, "sp": {"$ref": "#/$defs/u32"}, "lr": {"$ref": "#/$defs/u32"}, "cpsr": {"$ref": "#/$defs/u32"}, "pc": {"$ref": "#/$defs/u32"}
      }
    },
    "stubRegisters": {"allOf": [{"$ref": "#/$defs/registers"}], "not": {"anyOf": [{"required": ["sp"]}, {"required": ["lr"]}, {"required": ["cpsr"]}, {"required": ["pc"]}]}},
    "scriptRegisters": {"allOf": [{"$ref": "#/$defs/registers"}], "not": {"anyOf": [{"required": ["cpsr"]}, {"required": ["pc"]}]}},
    "legacyStub": {"type": "object", "additionalProperties": false, "required": ["address", "inputs", "outputs", "side_effects"], "properties": {"address": {"$ref": "#/$defs/u32"}, "inputs": {"$ref": "#/$defs/stubRegisters"}, "outputs": {"$ref": "#/$defs/stubRegisters", "minProperties": 1}, "side_effects": {"const": "registers-only"}}},
    "scriptStub": {
      "type": "object", "additionalProperties": false, "required": ["address", "calls"],
      "properties": {"address": {"$ref": "#/$defs/u32"}, "calls": {"type": "array", "minItems": 0, "maxItems": 128, "items": {"$ref": "#/$defs/scriptCall"}}}
    },
    "scriptCall": {
      "type": "object", "additionalProperties": false, "required": ["inputs", "outputs", "reads", "writes"],
      "properties": {"inputs": {"$ref": "#/$defs/scriptRegisters"}, "outputs": {"$ref": "#/$defs/stubRegisters"}, "reads": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/contractMemory"}}, "writes": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/contractMemory"}}},
      "description": "At most 64 read and write rows combined."
    },
    "contractMemory": {
      "type": "object", "additionalProperties": false, "required": ["offset", "hex"],
      "oneOf": [{"required": ["address"]}, {"required": ["register"]}, {"required": ["indirect_register"]}],
      "properties": {
        "address": {"$ref": "#/$defs/u32"},
        "register": {"enum": ["r0", "r1", "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "sp", "lr"]},
        "indirect_register": {"enum": ["r0", "r1", "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "sp", "lr"]},
        "offset": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "hex": {"type": "string", "pattern": "^([0-9a-f]{2})+$", "maxLength": 16777216}
      }
    },
    "kernelRegisters": {"type": "object", "additionalProperties": false, "properties": {"tpidrurw": {"$ref": "#/$defs/u32"}, "fpexc": {"$ref": "#/$defs/u32"}, "reserved": {"$ref": "#/$defs/u32"}}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "batch": {
      "description": "A batch input: case files beside it, run in one runner process. maxJsonBytes bounds this file and its case files together; maxArtifactBytes bounds the distinct artifact bytes, by SHA256, that the adapter reads for the batch's cases.",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "cases"],
      "maxJsonBytes": 268435456,
      "maxArtifactBytes": 268435456,
      "properties": {
        "schema_version": {"const": 1},
        "cases": {
          "type": "array", "minItems": 1, "maxItems": 4096,
          "items": {"type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "minLength": 1}}}
        }
      }
    },
    "batchSummary": {
      "description": "The batch result: the batch file's SHA256 bound to every case id and status, in batch order. Each case also has its own report in the single-case format.",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "cases"],
      "properties": {
        "schema_version": {"const": 1},
        "batch_sha256": {"$ref": "#/$defs/sha256"},
        "runner_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["complete", "invalid_batch", "runner_failure", "host_timeout"]},
        "reason": {"type": "string"},
        "failed_case": {"$ref": "#/$defs/id"},
        "runner_exit": {"type": "integer"},
        "stderr": {"type": "string"},
        "cases": {
          "type": "array", "maxItems": 4096,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "status"],
            "properties": {"id": {"$ref": "#/$defs/id"}, "status": {"enum": ["passed", "failed", "invalid_case", "runner_failure", "host_timeout", "not_run"]}, "case_sha256": {"$ref": "#/$defs/sha256"}}
          }
        }
      },
      "if": {"properties": {"status": {"const": "invalid_batch"}}},
      "then": {"required": ["reason"], "not": {"required": ["failed_case"]}},
      "else": {"required": ["batch_sha256", "runner_sha256", "stderr"]}
    }
  }
}
