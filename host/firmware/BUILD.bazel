    cmd = "$(location @lab_bash//:bin/bash) $(location ram-push-toolchain.sh) $@ $(location @lab_coreutils//:bin/readlink) $(location @lab_coreutils//:bin/sha256sum) $(location @lab_coreutils//:bin/sort) $(location @lab_bash//:bin/bash) $(location @lab_clang//:bin/clang) $(location @lab_lld//:bin/ld.lld) $(location @lab_llvm//:bin/llvm-objcopy) $(location @lab_llvm//:bin/llvm-nm) $(location @lab_llvm//:bin/llvm-objdump) $(locations :build-recipe-bank-sources)",
    tools = ["ram-push-toolchain.sh"],
)

# The bank ELF the relink script links at the reviewed RAM push's two
# reference bases, with a no-op builder in place of the RC0 packaging step.
[genrule(
    name = "bank-elf-" + base,
    srcs = [
        "build-recipe-bank-ram.sh",
        "//menu:ram-push-relink-sources",
    ],
    outs = ["bank-elf-" + base + ".elf"],
    cmd = " && ".join([
        "here=$$PWD",
        "root=$$(mktemp -d)",
        "out=private-data/analysis/x-m1-1.50/ram-push/bank-elf",
        "mkdir -p $$root/menu $$root/$$out",
        "for source in $(locations //menu:ram-push-relink-sources); do ln -s $$here/$$source $$root/menu/; done",
        "cd $$root",
        " ".join([
            "RAM_PUSH_BUILDER=true",
            "RAM_PUSH_CLANG=$$here/$(location @lab_clang//:bin/clang)",
            "RAM_PUSH_LD_LLD=$$here/$(location @lab_lld//:bin/ld.lld)",
            "RAM_PUSH_OBJCOPY=$$here/$(location @lab_llvm//:bin/llvm-objcopy)",
            "RAM_PUSH_NM=$$here/$(location @lab_llvm//:bin/llvm-nm)",
            "RAM_PUSH_OBJDUMP=$$here/$(location @lab_llvm//:bin/llvm-objdump)",
            "SPEC=unused RC0_ID4=unused RC0_ID5=unused RC0_PLAIN=unused",
            "$$here/$(location @lab_bash//:bin/bash) $$here/$(location build-recipe-bank-ram.sh) 0x" + base + " $$out > /dev/null",
        ]),
        "cp $$out/kernel.elf $$here/$@",
        "rm -rf $$root",
    ]),
    tools = [
        "@lab_bash//:bin/bash",
        "@lab_clang//:bin/clang",
        "@lab_lld//:bin/ld.lld",
        "@lab_llvm//:bin/llvm-nm",
        "@lab_llvm//:bin/llvm-objcopy",
        "@lab_llvm//:bin/llvm-objdump",
    ],
) for base in [
    "00c20000",
    "00c21f88",
]]

