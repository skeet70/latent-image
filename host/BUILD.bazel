haskell_toolchain_library(name = "text")

haskell_toolchain_library(name = "time")

haskell_toolchain_library(name = "unix")

haskell_toolchain_library(name = "vector")

haskell_library(
    name = "json",
    srcs = ["FujiAF/JSON.hs"],
    ghcopts = [
        "-Wall",
        "-Werror",
        "-O2",
        "-XGHC2021",
    ],
    src_strip_prefix = ".",
    deps = [
        ":aeson",
        ":attoparsec",
        ":base",
        ":bytestring",
        ":scientific",
        ":text",
        ":vector",
    ],
)

