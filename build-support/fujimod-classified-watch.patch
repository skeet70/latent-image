+#[test]
+fn fixed_view_watch_reports_a_committed_decode_even_after_its_restoration() {
+    use observation::{ViewPolicy, WatchKinds, WatchRange};
+    let watched = || vec![WatchRange { start: 0x10020, end: 0x10024, kinds: WatchKinds::ALL }];
+    let (mut b, _) = board_with_event(false, Some((4, 0)));
+    let mut watch = b
+        .memory_watch_begin_classified(watched(), 64, b.mappings().to_vec(), ViewPolicy::Fixed)
+        .unwrap();
+    b.run_until(10, 1).unwrap();
+    let state = watch.records.borrow().state();
+    b.memory_watch_end(&mut watch).unwrap();
+    assert_eq!(b.state()["memory_decoders"]["choices"], json!([0]));
+    assert!(state["violation"].is_string());
+    for classified in [true, false] {
+        let (mut b, _) = board_with_event(false, Some((4, 0)));
+        let mut watch = if classified {
+            b.memory_watch_begin_classified(watched(), 64, b.mappings().to_vec(), ViewPolicy::Observe)
+        } else {
+            b.memory_watch_begin(vec![(0x10020, 0x10024)], 64, b.mappings().to_vec())
+        }
+        .unwrap();
+        b.run_until(10, 1).unwrap();
+        let state = watch.records.borrow().state();
+        b.memory_watch_end(&mut watch).unwrap();
+        assert!(state["violation"].is_null());
+        assert_eq!(state.get("classes").is_some(), classified);
+        assert_eq!(state.get("views").is_some(), classified);
+        assert!(sources(&state).contains(&("model-bus-write".into(), 0x10020)));
+    }
+}
+#[test]
+fn overlapping_classified_ranges_record_only_the_sources_each_lists() {
+    use observation::{ViewPolicy, WatchKinds, WatchRange};
+    let (mut b, _) = board(false);
+    let classes = vec![
+        WatchRange { start: 0x10000, end: 0x10008, kinds: WatchKinds::HOST_WRITE },
+        WatchRange { start: 0x10004, end: 0x1000c, kinds: WatchKinds::HOST_READ },
+        WatchRange { start: 0x10020, end: 0x10024, kinds: WatchKinds::MODEL_BUS_WRITE },
+    ];
+    let mut watch = b
+        .memory_watch_begin_classified(classes, 64, b.mappings().to_vec(), ViewPolicy::Observe)
+        .unwrap();
+    b.run_until(10, 1).unwrap();
+    b.write_physical(0x10000, &[0; 4]).unwrap();
+    b.write_physical(0x10008, &[0; 4]).unwrap();
+    let mut bytes = [0; 4];
+    b.read_physical(0x10004, &mut bytes).unwrap();
+    b.read_physical(0x10020, &mut bytes).unwrap();
+    let state = watch.records.borrow().state();
+    b.memory_watch_end(&mut watch).unwrap();
+    assert!(state["violation"].is_null());
+    assert_eq!(
+        sources(&state),
+        [("model-bus-write".into(), 0x10020), ("host-write".into(), 0x10000), ("host-read".into(), 0x10004)]
+    );
+    assert_eq!(state["classes"][1]["kinds"], json!(["host-read"]));
+    assert_eq!(state["ranges"], json!([[0x10000, 0x1000c], [0x10020, 0x10024]]));
+}
+#[test]
+fn a_refused_classified_watch_leaves_the_board_able_to_watch_again() {
+    use observation::{ViewPolicy, WatchKinds, WatchRange};
+    let (b, _) = board(false);
+    for classes in [
+        vec![],
+        vec![WatchRange { start: 0x20000, end: 0x20004, kinds: WatchKinds::ALL }],
+        vec![WatchRange { start: 0x10004, end: 0x10000, kinds: WatchKinds::ALL }],
+    ] {
+        assert!(
+            b.memory_watch_begin_classified(classes, 64, b.mappings().to_vec(), ViewPolicy::Fixed)
+                .is_err()
+        );
+        let valid = vec![WatchRange { start: 0x10000, end: 0x10004, kinds: WatchKinds::HOST_WRITE }];
+        let mut watch = b
+            .memory_watch_begin_classified(valid, 64, b.mappings().to_vec(), ViewPolicy::Fixed)
+            .unwrap();
+        b.write_physical(0x10000, &[1, 2, 3, 4]).unwrap();
+        let state = watch.records.borrow().state();
+        b.memory_watch_end(&mut watch).unwrap();
+        assert!(state["violation"].is_null());
+        assert_eq!(sources(&state), [("host-write".into(), 0x10000)]);
+        let mut bytes = [0; 4];
+        b.read_physical(0x10000, &mut bytes).unwrap();
+        assert_eq!(bytes, [1, 2, 3, 4]);
+    }
+}
