+#[test]
+fn completion_inside_an_enable_clear_stays_pending_until_reenabled() {
+    let (mut d, mut h, mut c) = setup();
+    h.deliver = true;
+    reset(&mut d, &mut h);
+    let register = |c: &mut [irq::InterruptController; 2], h: &mut Ram, o: u64, v: Option<u32>| {
+        let mut cx = Cx::new(h, 0, 0, 0);
+        let read = match v {
+            Some(v) => {
+                c[0].write(&mut cx, 0xfffb3000 + o, 4, v.into());
+                0
+            }
+            None => c[0].read(&mut cx, 0xfffb3000 + o, 4) as u32,
+        };
+        assert!(cx.take_refusal().is_none());
+        read
+    };
+    register(&mut c, &mut h, 0x400 + u64::from(IRQ) * 4, Some(0x10000 + IRQ * 4));
+    register(&mut c, &mut h, 0x800 + u64::from(IRQ) * 4, Some(3));
+    enabled(&mut c, &mut h, 0, true);
+    h.bytes[0x4000..0x4004].copy_from_slice(&[3, 11, 22, 33]);
+    lz(&mut d, &mut h, 0x4000, 0x8000, 4);
+    enabled(&mut c, &mut h, 0, false);
+    tick(&mut d, &mut h, 4).unwrap();
+    assert_eq!(&h.bytes[0x8000..0x8003], &[11, 22, 33]);
+    assert_eq!((d.r(0x4c), d.r(0x88)), (3, 1));
+    let mut cx = Cx::new(&mut h, 0, 0, 0);
+    c[0].advance(&mut cx);
+    assert!(cx.take_refusal().is_none());
+    assert!(!h.inputs[0].irq());
+    enabled(&mut c, &mut h, 0, true);
+    assert!(h.inputs[0].irq());
+    assert!(!h.inputs[1].irq());
+    assert_eq!(register(&mut c, &mut h, 0x200, None), 0x10000 + IRQ * 4);
+}
 
