diff --git a/crates/emulator/src/board/tests.rs b/crates/emulator/src/board/tests.rs
--- a/crates/emulator/src/board/tests.rs
+++ b/crates/emulator/src/board/tests.rs
@@ -1,1 +1,52 @@
 use super::*;
+
+#[test]
+fn canonical_backing_reads_bypass_host_aliases_and_refuse_incomplete_spans_without_copy() {
+    use factory::*;
+    use memory::BusMapping;
+    let graph = Graph {
+        decoders: vec![],
+        processors: vec![Processor {
+            rprofile: Some(Default::default()),
+            mprofile: None,
+            model: fujimod_emulator_cpu::Model::CortexR5F,
+            registers: vec![(Register::Pc, 0x10000)],
+            released: true,
+        }],
+        dma_mappings: vec![
+            BusMapping { address: 0x10000, physical: 0x11000, size: 0x1000, permissions: 3 },
+            BusMapping { address: 0x30000, physical: 0x10000, size: 0x1000, permissions: 3 },
+        ],
+        ram: vec![Ram { base: 0x10000, size: 0x1000 }, Ram { base: 0x11000, size: 0x1000 }],
+        mappings: vec![
+            MemoryMap { core: 0, address: 0x10000, physical: 0x10000, size: 0x1000, permissions: 7 },
+            MemoryMap { core: 0, address: 0x11000, physical: 0x11000, size: 0x1000, permissions: 7 },
+        ],
+        peripherals: vec![],
+        instructions_per_tick: Ratio::new(1, 1).unwrap(),
+    };
+    let board = graph.build(
+        Options { engine: Engine::Unicorn, translation_cache_bytes: 1024 * 1024 },
+        Bus::new(bus::Mode::Strict),
+        None,
+    ).unwrap();
+    board.write_physical(0x10000, &[1, 2, 3, 4]).unwrap();
+    board.write_physical(0x30000, &[5, 6, 7, 8]).unwrap();
+    let context = board.observation_context();
+    let mut bytes = [0; 4];
+    context.read_physical(0x10000, &mut bytes).unwrap();
+    assert_eq!(bytes, [1, 2, 3, 4]);
+    context.read_backing(0x10000, &mut bytes).unwrap();
+    assert_eq!(bytes, [5, 6, 7, 8]);
+    context.read_backing(0x11000, &mut bytes).unwrap();
+    assert_eq!(bytes, [1, 2, 3, 4]);
+    for address in [u64::MAX - 1, 0x30000, 0x10ffe, 0x11ffe] {
+        let before = bytes;
+        assert!(context.read_backing(address, &mut bytes).is_err());
+        assert_eq!(bytes, before);
+    }
+    let mut physical = [0; 4];
+    board.read_physical(0x10000, &mut physical).unwrap();
+    assert_eq!(physical, [1, 2, 3, 4]);
+}
+
