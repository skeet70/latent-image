     #[test]
+    fn enumeration_module_leaves_cmd53_unanswered() {
+        let mut m = model(Protocol::Enumeration);
+        let mut h = Ram::new(0x10000);
+        setup(&mut m, &mut h);
+        write(&mut m, &mut h, 0x36, 0xffff);
+        write(&mut m, &mut h, 0x3a, 0xffff);
+        for (word, arg) in [(0x05020000, 0x200000), (0x031a0000, 0), (0x071b0000, 0x12340000)] {
+            command(&mut m, &mut h, word, arg);
+            due(&mut m, &mut h);
+        }
+        write(&mut m, &mut h, 0, 0x1000);
+        write(&mut m, &mut h, 4, 4);
+        h.bytes[0x1000..0x1004].copy_from_slice(&0x8000u32.to_le_bytes());
+        let read = |m: &mut SdioHost, h: &mut Ram, offset: u64, size: u8| m.read(&mut h.cx(), BASE + offset, size);
+        for (word, arg) in [(0x353a0001, 0x90000000 | (0x8c << 9) | 4), (0x353a0011, 0x10000000 | (0x8c << 9) | 4)] {
+            command(&mut m, &mut h, word, arg);
+            let writes = h.effects.iter().filter(|e| matches!(e, Effect::Write(..))).count();
+            due(&mut m, &mut h);
+            assert_eq!(h.effects.iter().filter(|e| matches!(e, Effect::Write(..))).count(), writes, "{word:#x}");
+            assert_eq!(read(&mut m, &mut h, 0x32, 2), 1, "{word:#x}");
+            assert_eq!(read(&mut m, &mut h, 0x30, 2), 0x8000, "{word:#x}");
+            assert_eq!(read(&mut m, &mut h, 0x10, 2), 0, "{word:#x}");
+            assert_eq!(h.effects.last(), Some(&Effect::Irq(79, true)));
+            write(&mut m, &mut h, 0x32, 0xffff);
+        }
+        for (word, arg) in [(0x353a0023u32, 0x98000000u32 | (0x8c << 9) | 1), (0x353a0001, 0xa0000000 | (0x8c << 9) | 4)] {
+            write(&mut m, &mut h, 0x30, 0xffff);
+            write(&mut m, &mut h, 8, (arg & 65535) as u64);
+            write(&mut m, &mut h, 10, (arg >> 16) as u64);
+            let mut cx = h.cx();
+            m.write(&mut cx, BASE + 12, 4, word as u64);
+            assert!(cx.refusal().is_some(), "{word:#x}");
+        }
+        assert_eq!(&h.bytes[0x1000..0x1004], &0x8000u32.to_le_bytes());
+    }
