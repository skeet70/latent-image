+    let library = crate::test_support::library();
+    let worker = Core::new_parallel_worker(
+        library.open(Model::CortexR5F, 1024 * 1024).unwrap(),
+        Options::default(),
+        Wiring {
+            memory: Memory::default(),
+        },
+    )
+    .unwrap();
+    let raw = library.open(Model::CortexR5F, 1024 * 1024).unwrap();
+    for unsupported in [&worker as &dyn Cpu, &raw] {
+        assert!(!unsupported.supports_mutation_observation());
+        assert!(unsafe { unsupported.install_hook(hook) }.is_err());
+        unsupported.map_zeroed(0x1000, 0x1000, 7).unwrap();
+    }
