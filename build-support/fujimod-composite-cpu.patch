+#[test]
+fn restore_and_policy_transitions_report_transactions_and_keep_observers() {
+    let cpu = processor_with_options(&Memory::default(), banks(false));
+    cpu.map_zeroed(0x1000, 0x1000, 7).unwrap();
+    set(&cpu, arm::CORE[0], 1);
+    let recorder = Recorder::default();
+    let id = observe(&cpu, &recorder);
+    let snapshot = cpu.snapshot(None).unwrap();
+    let imported = cpu.import_snapshot(&snapshot.export().unwrap()).unwrap();
+    cpu.set_execution_policy(ExecutionPolicy::Exact).unwrap();
+    assert!(recorder.take().is_empty());
+    cpu.set_execution_policy(ExecutionPolicy::Interactive).unwrap();
+    cpu.coprocessor(tcm(1), Some(0xa001)).unwrap();
+    set(&cpu, arm::CORE[0], 2);
+    cpu.restore(snapshot.as_ref()).unwrap();
+    let policy = |cpu: &Core| cpu.fingerprint().unwrap()["execution_policy"].clone();
+    assert_eq!(
+        (
+            get(&cpu, arm::CORE[0]),
+            cpu.coprocessor(tcm(1), None).unwrap(),
+            policy(&cpu)
+        ),
+        (1, 0x800d, ExecutionPolicy::Exact.name().into())
+    );
+    cpu.restore(imported.as_ref()).unwrap();
+    assert_eq!(
+        recorder.take(),
+        [
+            CpuMutation::ExecutionPolicy {
+                before: ExecutionPolicy::Exact,
+                after: ExecutionPolicy::Interactive,
+            },
+            moved(1, 0x800d, 0xa00d, MutationOrigin::Host),
+            CpuMutation::Restore,
+            CpuMutation::Restore,
+        ]
+    );
+    // The observer and its identity survive restore.
+    cpu.coprocessor(tcm(1), Some(0xa001)).unwrap();
+    assert_eq!(
+        recorder.take(),
+        [moved(1, 0x800d, 0xa00d, MutationOrigin::Host)]
+    );
+    recorder.refuse.set(true);
+    set(&cpu, arm::CORE[0], 3);
+    assert!(cpu.restore(snapshot.as_ref()).is_err());
+    assert!(cpu.set_execution_policy(ExecutionPolicy::Interactive).is_err());
+    assert_eq!(
+        (
+            get(&cpu, arm::CORE[0]),
+            cpu.coprocessor(tcm(1), None).unwrap(),
+            policy(&cpu)
+        ),
+        (3, 0xa00d, ExecutionPolicy::Exact.name().into())
+    );
+    assert_eq!(recorder.take().len(), 2);
+    cpu.remove_hook(id).unwrap();
+    cpu.coprocessor(tcm(1), Some(0x8001)).unwrap();
+    assert!(recorder.take().is_empty());
+}
