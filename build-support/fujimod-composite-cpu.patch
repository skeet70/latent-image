+    }
+    assert!(unsafe { cpu.install_hook(hook) }.is_err());
+    cpu.map_zeroed(0x1000, 0x1000, 7).unwrap();
+    assert_eq!(recorder.take().len(), MAX_MUTATION_OBSERVERS);
