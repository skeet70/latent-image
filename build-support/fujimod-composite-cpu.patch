+//! Synchronous mutation admission, independent of board observation state.
+use super::*;
+
+pub(super) const MAX_MUTATION_OBSERVERS: usize = 16;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Refusal {
+    Observer,
+    Panicked,
+    Reentered,
+}
+impl Refusal {
+    fn error(self) -> String {
+        match self {
+            Self::Observer => "CPU mutation observer refused the transaction",
+            Self::Panicked => "CPU mutation observer panicked",
+            Self::Reentered => "CPU mutation during mutation dispatch is refused",
+        }
+        .into()
+    }
+}
+
+/// `refusal` holds the first refusal while any admitted transaction is open.
+#[derive(Default)]
+pub(super) struct Admission {
+    dispatching: Cell<bool>,
+    depth: Cell<u32>,
+    refusal: Cell<Option<Refusal>>,
+}
+impl Admission {
+    pub(super) fn dispatching(&self) -> bool {
+        self.dispatching.get()
+    }
+    fn refuse(&self, refusal: Refusal) -> String {
+        let first = self.refusal.get().unwrap_or(refusal);
+        self.refusal.set(Some(first));
+        first.error()
+    }
+}
+
+struct Open<'a>(&'a Admission);
+impl Drop for Open<'_> {
+    fn drop(&mut self) {
+        let depth = self.0.depth.get() - 1;
+        self.0.depth.set(depth);
+        if depth == 0 {
+            self.0.refusal.set(None);
+        }
+    }
+}
+
+struct Dispatch<'a>(&'a Admission);
+impl Drop for Dispatch<'_> {
+    fn drop(&mut self) {
+        self.0.dispatching.set(false);
+    }
+}
+
+impl Execution {
+    /// Offers `event` to every mutation observer in installation order, then
+    /// runs `apply`, which must start at the first potentially mutating step.
+    /// A refusal recorded by a nested transaction fails every enclosing one.
+    pub(super) fn mutate<T>(
+        &self,
+        event: CpuMutation,
+        apply: impl FnOnce() -> Result<T, String>,
+    ) -> Result<T, String> {
+        let admission = &self.mutation;
+        if admission.dispatching.get() {
+            return Err(admission.refuse(Refusal::Reentered));
+        }
+        if let Some(first) = admission.refusal.get() {
+            return Err(first.error());
+        }
+        admission.depth.set(admission.depth.get() + 1);
+        let _open = Open(admission);
+        {
+            let observers = self.observer_index.borrow();
+            admission.dispatching.set(true);
+            let _dispatch = Dispatch(admission);
+            for &(_, hook) in &observers.mutations {
+                let Hook::Mutation { callback, data } = hook else {
+                    continue;
+                };
+                let refusal =
+                    match catch_unwind(AssertUnwindSafe(|| unsafe { callback(event, data) })) {
+                        Ok(true) => admission.refusal.get(),
+                        Ok(false) => Some(Refusal::Observer),
+                        Err(_) => Some(Refusal::Panicked),
+                    };
+                if let Some(refusal) = refusal {
+                    return Err(admission.refuse(refusal));
+                }
+            }
+        }
+        let result = apply();
+        match admission.refusal.get() {
+            Some(first) => Err(first.error()),
+            None => result,
+        }
+    }
+
+    /// Fails an admitted transaction once a nested transaction was refused.
+    pub(super) fn mutation_refusal(&self) -> Result<(), String> {
+        self.mutation
+            .refusal
+            .get()
+            .map_or(Ok(()), |first| Err(first.error()))
+    }
+}
