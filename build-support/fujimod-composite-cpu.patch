+#[derive(Debug, PartialEq, Eq)]
+enum Entry {
+    Mutation(CpuMutation),
+    HostWrite(u64, usize),
+}
+#[derive(Default)]
+struct Log {
+    entries: RefCell<Vec<Entry>>,
+    refuse: Cell<bool>,
+}
+unsafe fn log_mutation(event: CpuMutation, data: *mut c_void) -> bool {
+    let log = unsafe { &*data.cast::<Log>() };
+    log.entries.borrow_mut().push(Entry::Mutation(event));
+    !log.refuse.get()
+}
+unsafe fn log_host_write(address: u64, bytes: usize, data: *mut c_void) {
+    let log = unsafe { &*data.cast::<Log>() };
+    log.entries.borrow_mut().push(Entry::HostWrite(address, bytes));
+}
