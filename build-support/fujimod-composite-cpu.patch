+#[test]
+fn direct_maps_and_hidden_underlays_report_each_operation_before_its_effect() {
+    let underlay = Backing::aligned_zeros(0x2000, 4096).unwrap();
+    let physical = Backing::aligned_zeros(0x1000, 4096).unwrap();
+    let replacement = Backing::aligned_zeros(0x1000, 4096).unwrap();
+    unsafe { std::ptr::write_unaligned(replacement.as_ptr().cast::<u32>(), 0xbbbb) };
+    let cpu = processor_with_options(&Memory::default(), banks(false));
+    let recorder = Recorder::default();
+    observe(&cpu, &recorder);
+    unsafe {
+        // The first page stays hidden under the ATCM window.
+        cpu.map_backing(0x8000, 0x2000, 7, pointer(&underlay)).unwrap();
+        cpu.map_physical(0x2000, 0x10000, 0x1000, 7, pointer(&physical))
+            .unwrap();
+    }
+    cpu.map_zeroed(0x4000, 0x1000, 7).unwrap();
+    unsafe {
+        cpu.replace_physical(0x8000, 0x20000, 0x1000, 5, pointer(&replacement))
+            .unwrap();
+    }
+    cpu.protect(0x9000, 0x1000, 5).unwrap();
+    cpu.unmap(0x4000, 0x1000).unwrap();
+    unsafe { cpu.map_mmio(0xc000, 0x1000, idle()).unwrap() };
+    // Validation refusals and empty native operations change nothing.
+    assert!(cpu.unmap(0x8000, 0x1000).is_err());
+    assert!(cpu.protect(0x8000, 0x1000, 5).is_err());
+    assert!(cpu.map_zeroed(0x4100, 0x1000, 7).is_err());
+    assert!(unsafe { cpu.map_mmio(0x8000, 0x1000, idle()) }.is_err());
+    cpu.unmap(0x2000, 0).unwrap();
+    cpu.protect(0x2000, 0, 5).unwrap();
+    assert_eq!(
+        recorder.take(),
+        [
+            mapping(MappingMutation::MapBacking, 0x8000, None, 0x2000, Some(7)),
+            mapping(MappingMutation::MapPhysical, 0x2000, Some(0x10000), 0x1000, Some(7)),
+            mapping(MappingMutation::MapZeroed, 0x4000, None, 0x1000, Some(7)),
+            mapping(MappingMutation::ReplacePhysical, 0x8000, Some(0x20000), 0x1000, Some(5)),
+            mapping(MappingMutation::Protect, 0x9000, None, 0x1000, Some(5)),
+            mapping(MappingMutation::Unmap, 0x4000, None, 0x1000, None),
+            mapping(MappingMutation::MapMmio, 0xc000, None, 0x1000, None),
+        ]
+    );
+    cpu.coprocessor(tcm(1), Some(0xa001)).unwrap();
+    assert_eq!(read(&cpu, 0x8000), 0xbbbb);
+}
