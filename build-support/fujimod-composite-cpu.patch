@@ -0,0 +1,676 @@
+use super::super::tests::{get, processor_with_options, resume, run, set, words};
+use super::*;
+use crate::rprofile::tcm::{BankOptions, Options as TcmOptions};
+
+#[derive(Default)]
+struct Recorder {
+    events: RefCell<Vec<CpuMutation>>,
+    refuse: Cell<bool>,
+}
+impl Recorder {
+    fn take(&self) -> Vec<CpuMutation> {
+        self.events.take()
+    }
+}
+unsafe fn record(event: CpuMutation, data: *mut c_void) -> bool {
+    let recorder = unsafe { &*data.cast::<Recorder>() };
+    recorder.events.borrow_mut().push(event);
+    !recorder.refuse.get()
+}
+fn observe(cpu: &dyn Cpu, recorder: &Recorder) -> HookId {
+    unsafe {
+        cpu.install_hook(Hook::Mutation {
+            callback: record,
+            data: (recorder as *const Recorder).cast_mut().cast(),
+        })
+    }
+    .unwrap()
+}
+
+fn tcm(bank: u32) -> arm::Coprocessor {
+    arm::Coprocessor {
+        cp: 15,
+        opc1: 0,
+        crn: 9,
+        crm: 1,
+        opc2: bank,
+        secure: 0,
+        wide: false,
+    }
+}
+fn moved(bank: u32, previous: u32, next: u32, origin: MutationOrigin) -> CpuMutation {
+    CpuMutation::Tcm {
+        register: tcm(bank),
+        previous,
+        next,
+        origin,
+    }
+}
+fn mapping(
+    operation: MappingMutation,
+    address: u64,
+    physical: Option<u64>,
+    bytes: usize,
+    permissions: Option<u32>,
+) -> CpuMutation {
+    CpuMutation::Mapping {
+        operation,
+        address,
+        physical,
+        bytes,
+        permissions,
+    }
+}
+/// ATCM at 0x8000 and, with `btcm`, BTCM at 0x6000; 4 KiB each.
+fn banks(btcm: bool) -> Options {
+    Options {
+        tcm: TcmOptions {
+            btcm: BankOptions {
+                bytes: if btcm { 0x1000 } else { 0 },
+                reset: if btcm { 0x6001 } else { 0 },
+            },
+            atcm: BankOptions {
+                bytes: 0x1000,
+                reset: 0x8001,
+            },
+        },
+        ..Options::default()
+    }
+}
+fn read(cpu: &dyn Cpu, address: u64) -> u32 {
+    let mut bytes = [0; 4];
+    cpu.read_memory(address, &mut bytes).unwrap();
+    u32::from_le_bytes(bytes)
+}
+fn pointer(backing: &Backing) -> NonNull<u8> {
+    NonNull::new(backing.as_ptr()).unwrap()
+}
+unsafe fn idle_read(_: u64, _: u32, _: *mut c_void) -> u64 {
+    0
+}
+unsafe fn idle_write(_: u64, _: u32, _: u64, _: *mut c_void) {}
+fn idle() -> Mmio {
+    Mmio {
+        read: idle_read,
+        write: idle_write,
+        data: std::ptr::null_mut(),
+    }
+}
