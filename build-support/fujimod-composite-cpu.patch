+struct Reenter {
+    cpu: *const Core,
+    id: Cell<Option<HookId>>,
+    calls: Cell<usize>,
+    changes: RefCell<Vec<bool>>,
+    inspected: Cell<Option<u64>>,
+    captured: Cell<bool>,
+}
+unsafe fn admit(_: CpuMutation, _: *mut c_void) -> bool {
+    true
+}
+unsafe fn reenter_during_dispatch(_: CpuMutation, data: *mut c_void) -> bool {
+    let reenter = unsafe { &*data.cast::<Reenter>() };
+    let cpu = unsafe { &*reenter.cpu };
+    reenter.calls.set(reenter.calls.get() + 1);
+    let installed = unsafe {
+        cpu.install_hook(Hook::Mutation {
+            callback: admit,
+            data,
+        })
+    };
+    let changes = [
+        cpu.write_memory(0x1004, &[0xff]).is_ok(),
+        cpu.coprocessor(tcm(1), Some(0xa001)).is_ok(),
+        installed.is_ok(),
+        cpu.remove_hook(reenter.id.get().unwrap()).is_ok(),
+    ];
+    reenter.changes.borrow_mut().extend(changes);
+    reenter.inspected.set(cpu.coprocessor(tcm(1), None).ok());
+    reenter.captured.set(cpu.snapshot(None).is_ok());
+    true
+}
