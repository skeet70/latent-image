+#[test]
+fn mutation_callbacks_cannot_reenter_or_change_hooks_and_the_transaction_is_refused() {
+    let cpu = processor_with_options(&Memory::default(), banks(false));
+    cpu.map_zeroed(0x1000, 0x1000, 7).unwrap();
+    let reenter = Reenter {
+        cpu: &cpu,
+        id: Cell::new(None),
+        calls: Cell::new(0),
+        changes: RefCell::new(Vec::new()),
+        inspected: Cell::new(None),
+        captured: Cell::new(false),
+    };
+    let id = unsafe {
+        cpu.install_hook(Hook::Mutation {
+            callback: reenter_during_dispatch,
+            data: (&reenter as *const Reenter).cast_mut().cast(),
+        })
+    }
+    .unwrap();
+    reenter.id.set(Some(id));
+    assert!(cpu.write_memory(0x1000, &[0xaa; 4]).is_err());
+    assert_eq!(reenter.calls.get(), 1);
+    assert_eq!(*reenter.changes.borrow(), [false; 4]);
+    assert_eq!(
+        (reenter.inspected.get(), reenter.captured.get()),
+        (Some(0x800d), true)
+    );
+    assert_eq!((read(&cpu, 0x1000), read(&cpu, 0x1004)), (0, 0));
+    assert_eq!(cpu.coprocessor(tcm(1), None).unwrap(), 0x800d);
+    // The refusal ends with its transaction.
+    cpu.remove_hook(id).unwrap();
+    cpu.write_memory(0x1000, &[0xaa; 4]).unwrap();
+    assert_eq!(read(&cpu, 0x1000), 0xaaaa_aaaa);
+}
