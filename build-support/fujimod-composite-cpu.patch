+    );
+    assert_eq!((read(&cpu, 0x1000), read(&cpu, 0x1004)), (0, 0));
+    cpu.write_memory(0x1008, &[0xcc]).unwrap();
+    assert_eq!(read(&cpu, 0x1008), 0xcc);
+}
