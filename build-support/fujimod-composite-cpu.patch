+struct Nested {
+    cpu: *const Core,
+    events: RefCell<Vec<CpuMutation>>,
+    nested: RefCell<Vec<Result<(), String>>>,
+}
+unsafe fn refuse_nested(event: CpuMutation, data: *mut c_void) -> bool {
+    let nested = unsafe { &*data.cast::<Nested>() };
+    nested.events.borrow_mut().push(event);
+    !matches!(event, CpuMutation::HostWrite { address: 0x1004, .. })
+}
+unsafe fn write_nested(address: u64, _: usize, data: *mut c_void) {
+    let nested = unsafe { &*data.cast::<Nested>() };
+    if address == 0x1000 {
+        let cpu = unsafe { &*nested.cpu };
+        for _ in 0..2 {
+            let result = cpu.write_memory(0x1004, &[0xbb]);
+            nested.nested.borrow_mut().push(result);
+        }
+    }
+}
+fn nested_writer(cpu: &Core, nested: &Nested, refusing: bool) {
+    let data = (nested as *const Nested).cast_mut().cast();
+    unsafe {
+        cpu.install_hook(Hook::HostWrite {
+            callback: write_nested,
+            data,
+            range: HookRange::All,
+        })
+        .unwrap();
+        if refusing {
+            cpu.install_hook(Hook::Mutation {
+                callback: refuse_nested,
+                data,
+            })
+            .unwrap();
+        }
+    }
+}
