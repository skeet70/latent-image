+}
+
+unsafe fn panic_on_mutation(_: CpuMutation, _: *mut c_void) -> bool {
+    panic!("mutation observer panicked");
+}
+
+#[test]
+fn a_panicking_observer_refuses_before_later_observers_and_fast_mmio_reports_its_mapping() {
+    let cpu = processor_with_options(&Memory::default(), Options::default());
+    cpu.map_zeroed(0x1000, 0x1000, 7).unwrap();
+    words(&cpu, 0x1000, &[0x11]);
+    let panicking = unsafe {
+        cpu.install_hook(Hook::Mutation {
+            callback: panic_on_mutation,
+            data: std::ptr::null_mut(),
+        })
+    }
+    .unwrap();
+    let recorder = Recorder::default();
+    observe(&cpu, &recorder);
+    assert!(cpu.write_memory(0x1000, &[0x22; 4]).is_err());
+    assert_eq!(read(&cpu, 0x1000), 0x11);
+    assert!(recorder.take().is_empty());
+    cpu.remove_hook(panicking).unwrap();
+    cpu.write_memory(0x1000, &[0x22; 4]).unwrap();
+    assert_eq!(read(&cpu, 0x1000), 0x2222_2222);
+    assert_eq!(
+        recorder.take(),
+        [CpuMutation::HostWrite {
+            address: 0x1000,
+            bytes: 4
+        }]
+    );
+
+    unsafe { cpu.map_mmio_fast(0xc000, 0x1000, idle(), Vec::new()) }.unwrap();
+    assert_eq!(
+        recorder.take(),
+        [mapping(MappingMutation::MapMmio, 0xc000, None, 0x1000, None)]
+    );
+    recorder.refuse.set(true);
+    let regions = cpu.memory_regions().unwrap();
+    assert!(unsafe { cpu.map_mmio_fast(0xd000, 0x1000, idle(), Vec::new()) }.is_err());
+    assert_eq!(cpu.memory_regions().unwrap(), regions);
+    assert_eq!(
+        recorder.take(),
+        [mapping(MappingMutation::MapMmio, 0xd000, None, 0x1000, None)]
+    );
+}
