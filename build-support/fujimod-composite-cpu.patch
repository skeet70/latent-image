+#[test]
+fn refused_transactions_leave_tcm_maps_policy_bytes_and_later_observers_untouched() {
+    unsafe fn host_write(_: u64, _: usize, data: *mut c_void) {
+        let calls = unsafe { &*data.cast::<Cell<usize>>() };
+        calls.set(calls.get() + 1);
+    }
+    let backing = Backing::aligned_zeros(0x1000, 4096).unwrap();
+    let replacement = Backing::aligned_zeros(0x1000, 4096).unwrap();
+    let cpu = processor_with_options(&Memory::default(), banks(false));
+    cpu.map_zeroed(0x1000, 0x1000, 7).unwrap();
+    unsafe {
+        cpu.map_physical(0x2000, 0x10000, 0x1000, 7, pointer(&backing))
+            .unwrap();
+    }
+    words(&cpu, 0x1000, &[0xee090f31]); // mcr atcm,r0
+    words(&cpu, 0x2000, &[0x11]);
+    set(&cpu, arm::CORE[0], 0xa001);
+    let host_writes = Cell::new(0usize);
+    unsafe {
+        cpu.install_hook(Hook::HostWrite {
+            callback: host_write,
+            data: (&host_writes as *const Cell<usize>).cast_mut().cast(),
+            range: HookRange::All,
+        })
+    }
+    .unwrap();
+    let first = Recorder {
+        refuse: Cell::new(true),
+        ..Recorder::default()
+    };
+    let later = Recorder::default();
+    observe(&cpu, &first);
+    observe(&cpu, &later);
+    let regions = cpu.memory_regions().unwrap();
+    let state = cpu.fingerprint().unwrap();
+    assert!(cpu.write_memory(0x2000, &[0x22; 4]).is_err());
+    assert!(cpu.coprocessor(tcm(1), Some(0xa001)).is_err());
+    assert!(cpu.map_zeroed(0x4000, 0x1000, 7).is_err());
+    assert!(
+        unsafe { cpu.replace_physical(0x2000, 0x20000, 0x1000, 5, pointer(&replacement)) }
+            .is_err()
+    );
+    assert!(cpu.protect(0x2000, 0x1000, 5).is_err());
+    assert!(cpu.unmap(0x2000, 0x1000).is_err());
+    assert!(unsafe { cpu.map_mmio(0xc000, 0x1000, idle()) }.is_err());
+    assert!(cpu.set_execution_policy(ExecutionPolicy::Interactive).is_err());
+    assert_eq!(first.take().len(), 8);
+    assert!(later.take().is_empty());
+    assert_eq!(host_writes.get(), 0);
+    assert_eq!(cpu.memory_regions().unwrap(), regions);
+    assert_eq!(cpu.fingerprint().unwrap(), state);
+    assert_eq!(read(&cpu, 0x2000), 0x11);
+    // A refused final guest MCR keeps the bank in place.
+    assert!(run(&cpu, 0x1000, 1).is_err());
+    assert_eq!(
+        first.take(),
+        [moved(1, 0x800d, 0xa00d, MutationOrigin::Guest)]
+    );
+    assert!(later.take().is_empty());
+    assert_eq!(cpu.coprocessor(tcm(1), None).unwrap(), 0x800d);
+    assert_eq!(cpu.memory_regions().unwrap(), regions);
+}
