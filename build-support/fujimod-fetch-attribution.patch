+        let result = match addresses {
+            PointAddresses::Fixed(addresses) => addresses.iter().try_for_each(|&pc| install(HookRange::Inclusive { begin: pc, end: pc })),
+            PointAddresses::Mutable(_) => install(HookRange::All),
+        };
+        if let Err(error) = result {
+            self.instruction_points_end(core, &mut points)?;
+            return Err(error);
         }
         Ok(points)
     }
