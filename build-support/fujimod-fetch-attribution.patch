+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct CpuAttribution {
+    core: CoreIndex,
+    pub(super) clock: Attribution,
+    core_instructions: CoreInstructionCount,
+    entry: Option<InstructionEntry>,
+}
+impl CpuAttribution {
+    #[inline]
+    pub(super) fn capture(state: &State, cpu: &dyn Cpu, core: CoreIndex, require_entry: bool) -> Result<Self, String> {
+        let entry = require_entry.then(|| cpu.instruction_entry()).flatten();
+        if require_entry && entry.is_none() { return Err("Fetch attribution requires an actual instruction-entry context".into()); }
+        let progress = entry.map(|entry| entry.progress).or_else(|| cpu.instruction_progress());
+        let pc = match entry { Some(entry) => entry.address, None => scalar(cpu, Register::Pc)? };
+        Self::coordinates(state, core, pc, progress, entry)
+    }
+    pub(super) fn capture_data(state: &State, cpu: &dyn Cpu, core: CoreIndex) -> Result<Self, String> {
+        let pc = scalar(cpu, Register::Pc)?;
+        let progress = cpu.instruction_progress();
+        let entry = cpu.instruction_entry().filter(|entry| entry.address == pc && Some(entry.progress) == progress);
+        Self::coordinates(state, core, pc, progress, entry)
+    }
+    fn coordinates(state: &State, core: CoreIndex, pc: u64, progress: Option<u64>, entry: Option<InstructionEntry>) -> Result<Self, String> {
+        let extra = progress.unwrap_or(state.accounted[core.0]).saturating_sub(state.accounted[core.0]);
+        let instructions = state.instructions.iter().sum::<u64>().saturating_add(extra);
+        let elapsed = state.timeline.ratio().advance_phase(state.timeline.phase(), extra)?.0;
+        let tick = state.timeline.now().saturating_add(elapsed.min(u64::MAX as u128) as u64);
+        Ok(Self {
+            core,
+            clock: Attribution { pc, instructions, tick },
+            core_instructions: CoreInstructionCount(state.instructions[core.0].saturating_add(extra)),
+            entry,
+        })
+    }
+}
