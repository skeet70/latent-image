+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum InstructionCores { Core0, Core1, Both }
+impl InstructionCores {
+    fn admits(self, core: CoreIndex) -> bool {
+        matches!((self, core.0), (Self::Core0 | Self::Both, 0) | (Self::Core1 | Self::Both, 1))
+    }
+}
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum InstructionExecutionState {
+    #[default]
+    A32Little,
+    UnmaskedSvcA32Little,
+}
+impl InstructionExecutionState {
+    fn admits(self, pstate: u32) -> bool {
+        const A32_LITTLE_MASK: u32 = (1 << 24) | (1 << 9) | (1 << 5);
+        const UNMASKED_SVC_MASK: u32 = (1 << 24) | (1 << 9) | (1 << 7) | (1 << 5) | 0x1f;
+        match self {
+            Self::A32Little => pstate & A32_LITTLE_MASK == 0,
+            Self::UnmaskedSvcA32Little => pstate & UNMASKED_SVC_MASK == 0x13,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PhysicalInstructionGuard {
+    physical: WatchRange,
+    canonical: GuestAddress,
+    cores: InstructionCores,
+    execution_state: InstructionExecutionState,
+}
+impl PhysicalInstructionGuard {
+    pub fn arm32_little(physical: WatchRange, canonical: GuestAddress, cores: InstructionCores) -> Result<Self, String> {
+        if physical.kinds != WatchKinds::CPU_FETCH || physical.start >= physical.end || physical.end > 1 << 32
+            || physical.start & 3 != 0 || physical.end & 3 != 0 || canonical.0 & 3 != 0
+            || canonical.0.checked_add(physical.end - physical.start).is_none_or(|end| end > 1 << 32)
+        {
+            return Err("Instruction guards require aligned ARM32 physical and canonical intervals".into());
+        }
+        Ok(Self { physical, canonical, cores, execution_state: InstructionExecutionState::A32Little })
+    }
+    pub fn with_execution_state(mut self, state: InstructionExecutionState) -> Self {
+        self.execution_state = state;
+        self
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct FetchEvent {
+    pub entry: InstructionEntry,
+    pub core: CoreIndex,
+    pub address: GuestAddress,
+    pub physical: PhysicalAddress,
+    pub size: AccessBytes,
+    pub byte_order: ByteOrder,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum InstructionGuardFailure {
+    ViewChanged,
+    ObservationFailed,
+    MissingEntry,
+    EntryMismatch,
+    UnresolvedBacking,
+    BackingChanged,
+    Tcm,
+    InvalidWidth,
+    Straddling,
+    Alias,
+    CoreNotAdmitted,
+    ByteOrder,
+    ExecutionState,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct InstructionGuardRefusal {
+    pub kind: InstructionGuardFailure,
+    pub core: Option<CoreIndex>,
+    pub entry: Option<InstructionEntry>,
+}
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct InstructionGuardStatus {
+    pub hook_entries: u64,
+    pub protected_entries: u64,
+    pub accepted_entries: u64,
+    pub refused_entries: u64,
+    pub first_failure: Option<InstructionGuardRefusal>,
+}
+impl FetchCapture {
+    pub(super) fn guarded(&self) -> bool { !self.specification.guards.is_empty() }
+    pub(super) fn observation_failed(&mut self) {
+        if self.guarded() {
+            self.guard_status.first_failure.get_or_insert(InstructionGuardRefusal {
+                kind: InstructionGuardFailure::ObservationFailed, core: None, entry: None,
+            });
+            self.latest = [None; 2];
+            self.pause.set(true);
+            if let Some(gate) = &self.refusal { gate.refuse(); }
+        }
+    }
+    pub(super) fn view_changed(&mut self) {
+        if self.guarded() {
+            self.guard_status.first_failure.get_or_insert(InstructionGuardRefusal {
+                kind: InstructionGuardFailure::ViewChanged, core: None, entry: None,
+            });
+            self.latest = [None; 2];
+            self.pause.set(true);
+            if let Some(gate) = &self.refusal { gate.refuse(); }
+        }
+    }
+    fn refuse(&mut self, kind: InstructionGuardFailure, core: CoreIndex, entry: Option<InstructionEntry>) {
+        self.guard_status.refused_entries = self.guard_status.refused_entries.saturating_add(1);
+        self.guard_status.first_failure.get_or_insert(InstructionGuardRefusal { kind, core: Some(core), entry });
+        self.latest[core.0] = None;
+        self.pause.set(true);
+        if let Some(gate) = &self.refusal { gate.refuse(); }
+    }
+    fn validate_guard(&mut self, core: CoreIndex, entry: InstructionEntry, physical: Option<u64>, address: u64, size: u64)
+        -> Result<Option<PhysicalAddress>, InstructionGuardFailure>
+    {
+        self.guard_status.hook_entries = self.guard_status.hook_entries.saturating_add(1);
+        if entry.address != address || u64::from(entry.bytes) != size {
+            return Err(InstructionGuardFailure::EntryMismatch);
+        }
+        if entry.tcm.iter().flatten().any(|tcm| address < tcm.address + tcm.bytes as u64 && tcm.address < address.saturating_add(size)) {
+            return Err(InstructionGuardFailure::Tcm);
+        }
+        let physical = physical.ok_or(InstructionGuardFailure::UnresolvedBacking)?;
+        let actual = entry.physical.ok_or(InstructionGuardFailure::UnresolvedBacking)?;
+        if actual != physical { return Err(InstructionGuardFailure::BackingChanged); }
+        let Some(guard) = self.specification.guards.iter().find(|guard| {
+            physical < guard.physical.end && guard.physical.start < physical.saturating_add(size)
+        }) else { return Ok(None); };
+        self.guard_status.protected_entries = self.guard_status.protected_entries.saturating_add(1);
+        if physical < guard.physical.start || physical.checked_add(size).is_none_or(|end| end > guard.physical.end) {
+            return Err(InstructionGuardFailure::Straddling);
+        }
+        if size != 4 || address & 3 != 0 || physical & 3 != 0 || entry.pstate & (1 << 5) != 0 {
+            return Err(InstructionGuardFailure::InvalidWidth);
+        }
+        if entry.pstate & (1 << 9) != 0 { return Err(InstructionGuardFailure::ByteOrder); }
+        if !guard.execution_state.admits(entry.pstate) {
+            return Err(InstructionGuardFailure::ExecutionState);
+        }
+        if !guard.cores.admits(core) { return Err(InstructionGuardFailure::CoreNotAdmitted); }
+        if address != guard.canonical.0 + physical - guard.physical.start {
+            return Err(InstructionGuardFailure::Alias);
+        }
+        Ok(Some(PhysicalAddress(physical)))
+    }
+}
+impl MemoryWatch {
+    pub(super) fn disarm_instruction_guard(&mut self, board: &Board) -> Result<(), String> {
+        let Some(gate) = &self.refusal else { return Ok(()); };
+        for (core, cpu) in board.cpus.iter().enumerate() {
+            if let Err(error) = cpu.disarm_execution_refusal(gate) {
+                gate.refuse();
+                for previous in &board.cpus[..core] {
+                    previous.arm_execution_refusal(gate.clone())?;
+                }
+                return Err(error);
+            }
+        }
+        self.refusal = None;
+        Ok(())
+    }
+    /// A later entry cannot satisfy this lookup.
+    pub fn fetch_event(&self, core: CoreIndex, entry: InstructionEntryId) -> Option<FetchEvent> {
+        let records = self.records.borrow();
+        let capture = records.fetch_attribution.as_ref()?;
+        if capture.guard_status.first_failure.is_some() { return None; }
+        let fetch = capture.latest.get(core.0).copied().flatten()?;
+        let observed = fetch.attribution.entry?;
+        (observed.id == entry).then_some(FetchEvent {
+            entry: observed, core, address: fetch.address, physical: fetch.physical,
+            size: fetch.size, byte_order: fetch.byte_order,
+        })
+    }
+    pub fn instruction_guard_status(&self) -> Option<InstructionGuardStatus> {
+        let records = self.records.borrow();
+        let capture = records.fetch_attribution.as_ref()?;
+        capture.guarded().then_some(capture.guard_status)
+    }
+}
+impl MemoryContext {
+    pub(super) fn guarded_fetch(&self, address: u64, size: u64) -> bool {
+        let guarded = self.records.borrow().fetch_attribution.as_ref().is_some_and(FetchCapture::guarded);
+        if !guarded { return false; }
+        let (Some(state), Some(cpu)) = (self.state.upgrade(), self.cpu.upgrade()) else { return true; };
+        let state = state.borrow();
+        let physical = self.physical(&state, address, size);
+        let entry = cpu.instruction_entry();
+        let mut records = self.records.borrow_mut();
+        let observation_failed = records.violation.is_some();
+        let capture = records.fetch_attribution.as_mut().unwrap();
+        let result = if capture.guard_status.first_failure.is_some() || observation_failed {
+            Err(InstructionGuardFailure::ObservationFailed)
+        } else {
+            entry.ok_or(InstructionGuardFailure::MissingEntry)
+                .and_then(|entry| capture.validate_guard(CoreIndex(self.core), entry, physical, address, size))
+        };
+        let protected = matches!(result, Ok(Some(_)));
+        let failure = match result {
+            Err(failure) => Some(failure),
+            Ok(_) => {
+                if let (Some(physical), Some(entry)) = (physical, entry) {
+                    if capture.wants(PhysicalAddress(physical), AccessBytes(size)) {
+                        match CpuAttribution::capture(&state, &*cpu, CoreIndex(self.core), true) {
+                            Ok(attribution) => {
+                                capture.latest[self.core] = Some(CapturedFetch {
+                                    address: GuestAddress(address), physical: PhysicalAddress(physical), size: AccessBytes(size),
+                                    byte_order: if entry.pstate & (1 << 9) == 0 { ByteOrder::Little } else { ByteOrder::Big },
+                                    attribution,
+                                });
+                                None
+                            }
+                            Err(_) => Some(InstructionGuardFailure::MissingEntry),
+                        }
+                    } else { None }
