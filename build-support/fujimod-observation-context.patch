@@ -27,6 +27,51 @@
 pub use journal::{MAX_JOURNAL_ROWS, MutationJournal, MutationRow};
 pub(in crate::board) use lifecycle::ObservationRegistry;
 type Span = (u64, u64);
+
+pub struct ObservationContext {
+    cpus: Rc<Vec<Rc<dyn Cpu>>>,
+    memory: Rc<super::memory::Memory>,
+    mappings: Vec<MemoryMap>,
+    pause: Rc<Cell<bool>>,
+}
+impl ObservationContext {
+    pub fn cpu(&self, core: usize) -> Result<&dyn Cpu, String> {
+        self.cpus.get(core).map(|cpu| &**cpu).ok_or_else(|| "observation core is unavailable".into())
+    }
+    pub fn mappings(&self) -> &[MemoryMap] { &self.mappings }
+    pub fn core_count(&self) -> usize { self.cpus.len() }
+    pub fn read_register(&self, core: usize, register: Register) -> Result<u64, String> {
+        scalar(self.cpu(core)?, register)
+    }
+    pub fn read_memory(&self, core: usize, address: u64, bytes: &mut [u8]) -> Result<(), String> {
+        self.cpu(core)?.read_memory(address, bytes)
+    }
+    pub fn read_physical(&self, address: u64, bytes: &mut [u8]) -> Result<(), String> {
+        self.memory.read_host(address, bytes)
+    }
+    pub fn read_backing(&self, address: u64, bytes: &mut [u8]) -> Result<(), String> {
+        let end = address.checked_add(bytes.len() as u64).ok_or("canonical backing read overflows")?;
+        let (base, backing) = self.memory.regions().iter().find(|(base, backing)| {
+            *base <= address && base.checked_add(backing.len() as u64).is_some_and(|limit| end <= limit)
+        }).ok_or("canonical backing read has no complete region")?;
+        let offset = usize::try_from(address - base).map_err(|_| "canonical backing offset exceeds host size")?;
+        unsafe {
+            std::ptr::copy_nonoverlapping(backing.as_ptr().add(offset), bytes.as_mut_ptr(), bytes.len());
+        }
+        Ok(())
+    }
+    /// A new board window clears the request.
+    pub fn request_pause(&self) { self.pause.set(true); }
+}
+impl Board {
+    pub fn observation_context(&self) -> ObservationContext {
+        ObservationContext {
+            cpus: self.cpus.clone(), memory: self.physical_memory.clone(),
+            mappings: self.mappings.clone(), pause: self.host_pause.clone(),
+        }
+    }
+}
