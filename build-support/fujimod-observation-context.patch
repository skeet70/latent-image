diff --git a/crates/emulator/src/board/tests.rs b/crates/emulator/src/board/tests.rs
--- a/crates/emulator/src/board/tests.rs
+++ b/crates/emulator/src/board/tests.rs
@@ -1,8 +1,40 @@
 use super::*;
 use fujimod_emulator_devices::{Cx, Device};
 use fujimod_emulator_cpu::Model;
 use fujimod_emulator_cpu_unicorn::Library;
 use std::sync::{Arc, Mutex};
+
+#[test]
+fn observation_pause_returns_before_a_zero_progress_retry_and_unhooked_execution_resumes() {
+    use fujimod_emulator_cpu::{Hook, HookRange};
+    unsafe fn pause(_: u64, _: u32, data: *mut std::ffi::c_void) {
+        let context = unsafe { &*data.cast::<observation::ObservationContext>() };
+        context.request_pause();
+        context.cpu(0).unwrap().stop_before_instruction().unwrap();
+    }
+    let (mut board, _) = build_rprofile(bus::Mode::Strict, true);
+    let context = Box::new(board.observation_context());
+    let data = (&*context as *const observation::ObservationContext).cast_mut().cast();
+    let before = board.read_register(0, Register::Arm32(fujimod_emulator_cpu::arm::Register::R(0))).unwrap();
+    let hook = unsafe {
+        context.cpu(0).unwrap().install_hook(Hook::Instruction {
+            callback: pause,
+            data,
+            range: HookRange::Inclusive { begin: 0x10000, end: 0x10000 },
+        }).unwrap()
+    };
+    board.run_until(100, 100).unwrap();
+    assert_eq!(board.instruction_counts(), vec![0]);
+    assert_eq!(board.read_register(0, Register::Arm32(fujimod_emulator_cpu::arm::Register::R(0))).unwrap(), before);
+    context.cpu(0).unwrap().remove_hook(hook).unwrap();
+    board.run_until(4, 100).unwrap();
+    let (mut unhooked, _) = build_rprofile(bus::Mode::Strict, true);
+    unhooked.run_until(4, 100).unwrap();
+    assert_eq!(board.instruction_counts(), unhooked.instruction_counts());
+    for register in [Register::Pc, Register::Arm32(fujimod_emulator_cpu::arm::Register::R(0)), Register::Arm32(fujimod_emulator_cpu::arm::Register::R(2))] {
+        assert_eq!(board.read_register(0, register).unwrap(), unhooked.read_register(0, register).unwrap());
+    }
+}
