+    /// Image 4 `0x723ffc(us)`: target = 1000·us / (10,000,000 / reload) counts
+    /// of `reload - count`; a rise is a wrap and adds `reload + 1`.
+    fn stock_busy_wait(timer: &mut Timers, host: &mut Clock, us: u32, step: u64) -> u64 {
+        fn read(timer: &mut Timers, host: &mut Clock, offset: u64, step: u64) -> u32 {
+            let value = get(timer, host, offset) as u32;
+            host.now += step;
+            value
+        }
+        let start = host.now;
+        let reload = read(timer, host, 4, step);
+        let target = 1000 * us / (10_000_000 / reload);
+        let mut previous = read(timer, host, 4, step).wrapping_sub(read(timer, host, 0, step));
+        let mut accumulated = 0u32;
+        loop {
+            let current = read(timer, host, 4, step).wrapping_sub(read(timer, host, 0, step));
+            accumulated = if previous >= current {
+                accumulated + previous - current
+            } else {
+                accumulated + reload + previous + 1 - current
+            };
+            if accumulated >= target {
+                return host.now - start;
+            }
+            previous = current;
+        }
+    }
+    #[test]
