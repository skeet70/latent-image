+/// In mode 0x23 the state keeps the counts remaining until the next expiry
+/// and the register reads `reload - remaining`; X-M1 1.50 console captures
+/// show `[+0x04] - [+0x00]` falling within each tick. A remaining value above
+/// the reload reads 0; a stopped or zero-reload timer reads the stored count.
+fn main_counter_register(count: u64, reload: u64, control: u64) -> u64 {
+    if control != 0x23 || reload == 0 {
+        return count;
+    }
+    let remaining = if count != 0 { count } else { reload };
+    reload.saturating_sub(remaining)
+}
