+    #[test]
+    fn kernel_counter_rises_within_each_period_and_wraps_at_expiry() {
+        let mut host = Clock::default();
+        let mut timer = kernel_switch(&mut host, 1000);
+        let mut previous_remaining = None;
+        let mut wraps = 0;
+        for now in (0..(1000 + 2 * 30000) * 4).step_by(37) {
+            host.now = now;
+            timer.advance(&mut Cx::new(&mut host, 0, 0, 0));
+            let reload = get(&mut timer, &mut host, 4);
+            let count = get(&mut timer, &mut host, 0);
+            assert_eq!(reload, 30000);
+            assert!(count < 30000, "count {count} at {now}");
+            let remaining = reload - count;
+            if let Some(previous) = previous_remaining {
+                if remaining > previous {
+                    wraps += 1;
+                } else {
+                    assert!(previous - remaining <= 10, "step at {now}");
+                }
+            }
+            previous_remaining = Some(remaining);
+        }
