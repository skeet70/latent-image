+//! Passive owner-thread evidence. None of these events admits an instruction or handoff.
+use crate::{Identity, InstructionEntry, InstructionTcm};
+pub mod shadow;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct EvidenceId {
+    pub owner: Identity,
+    pub serial: std::num::NonZeroU64,
+}
+impl EvidenceId {
+    pub fn next(owner: Identity, previous: Option<Self>) -> Option<Self> {
+        let serial = match previous {
+            None => 1,
+            Some(previous) if previous.owner == owner => previous.serial.get().checked_add(1)?,
+            Some(_) => return None,
+        };
+        Some(Self { owner, serial: std::num::NonZeroU64::new(serial)? })
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ExecutionSource {
+    pub address: u32,
+    pub physical: u64,
+    pub word: u32,
+    pub tcm: [Option<InstructionTcm>; 2],
+}
+
+/// The native A32 layout is copied, never selected by changing processor mode.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Arm32State {
+    pub registers: [u32; 16],
+    pub cpsr: u32,
+    pub spsr: u32,
+    pub svc_spsr: u32,
+    pub irq_spsr: u32,
+    pub svc_sp: u32,
+    pub irq_sp: u32,
+    pub svc_lr: u32,
+    pub irq_lr: u32,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SavedFrame {
+    pub address: u32,
+    pub physical: u64,
+    pub words: [u32; 9],
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct InstructionRetirement {
+    pub execution: EvidenceId,
+    pub observation: Option<InstructionEntry>,
+    pub resumed_from: Option<InstructionEntry>,
+    pub source: ExecutionSource,
+    pub before: Arm32State,
+    pub after: Arm32State,
+    pub frame: SavedFrame,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ExceptionEntry {
+    pub execution: EvidenceId,
+    pub before: Arm32State,
+    pub after: Arm32State,
+    pub vector: u32,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SavedStatusWrite {
+    pub exception: EvidenceId,
+    pub source: ExecutionSource,
+    pub before: Arm32State,
+    pub after: Arm32State,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ExceptionReturn {
+    pub exception: EvidenceId,
+    pub source: ExecutionSource,
+    pub before: Arm32State,
+    pub after: Arm32State,
+    pub written_status: u32,
+    pub mask: u32,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum EvidenceFailure {
+    UnsupportedProcessor,
+    UnsupportedInstruction,
+    MissingEntry,
+    MissingRetirement,
+    SourceChanged,
+    IncompleteFrame,
+    Faulted,
+    Restarted,
+    Duplicate,
+    IdentityExhausted,
+    UnpairedException,
+    ExceptionDepth,
+    EvidenceCapacity,
+    UnresolvedMemory,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PreservationEvidence {
+    Retired(InstructionRetirement),
+    Entered(ExceptionEntry),
+    SavedStatus(SavedStatusWrite),
+    Returned(ExceptionReturn),
+    Refused { address: u64, reason: EvidenceFailure },
+}
