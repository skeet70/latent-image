+//! Native post-effect capture. This module never changes architectural execution.
+use super::*;
+use fujimod_emulator_cpu::preservation::*;
+
+#[derive(Clone, Copy)]
+struct Pending {
+    id: EvidenceId,
+    source: ExecutionSource,
+    before: Arm32State,
+    observation: Option<InstructionEntry>,
+    resumed_from: Option<InstructionEntry>,
+}
+
+#[derive(Default)]
+pub(super) struct Capture {
+    serial: Cell<Option<EvidenceId>>,
+    instruction: Cell<Option<Pending>>,
+    status: Cell<Option<Pending>>,
+    returning: Cell<Option<Pending>>,
+    entering: Cell<Option<(EvidenceId, Arm32State)>>,
+    exceptions: RefCell<[Option<EvidenceId>; 8]>,
+    depth: Cell<usize>,
+    dispatching: Cell<bool>,
+    completed: RefCell<[Option<InstructionRetirement>; 32]>,
+    completed_len: Cell<usize>,
+    paused: Cell<Option<InstructionEntry>>,
+    resuming: Cell<Option<InstructionEntry>>,
+}
+pub(super) struct RunValidity<'a> {
+    execution: &'a Execution,
+    pub(super) success: bool,
+}
+impl<'a> RunValidity<'a> {
+    pub(super) fn new(execution: &'a Execution) -> Self { Self { execution, success: false } }
+}
+impl Drop for RunValidity<'_> {
+    fn drop(&mut self) {
+        if !self.success {
+            self.execution.preservation.invalidate(self.execution, EvidenceFailure::Faulted);
+        }
+    }
+}
+
+
+struct Dispatch<'a>(&'a Cell<bool>);
+impl Drop for Dispatch<'_> {
+    fn drop(&mut self) { self.0.set(false); }
+}
+
+impl Capture {
+    pub(super) fn dispatching(&self) -> bool { self.dispatching.get() }
+    pub(super) fn paused(&self, entry: Option<InstructionEntry>) {
+        self.resuming.take();
+        self.paused.set(entry);
+    }
+
+    pub(super) fn admit(&self, execution: &Execution, begin: u64) {
+        let paused = self.paused.take();
+        self.resuming.set(paused.filter(|entry|
+            entry.address == (begin & !1)
+                && (begin & 1 != 0) == (entry.pstate & 32 != 0)
+                && execution.scalar(arm::CPSR).ok() == Some(entry.pstate)));
+        if paused.is_some() && self.resuming.get().is_none() {
+            execution.evidence_failed(paused.unwrap().address, EvidenceFailure::SourceChanged);
+        }
+    }
+
+    pub(super) fn expire_lineage(&self, execution: &Execution, reason: EvidenceFailure) {
+        let paused = self.paused.take().or(self.resuming.take());
+        if let Some(entry) = paused { execution.evidence_failed(entry.address, reason); }
+    }
+
+    fn next(&self, execution: &Execution) -> Option<EvidenceId> {
+        let id = EvidenceId::next(execution.cpu.identity(), self.serial.get());
+        if let Some(id) = id { self.serial.set(Some(id)); }
+        else { execution.evidence_failed(0, EvidenceFailure::IdentityExhausted); }
+        id
+    }
+
+    pub(super) fn invalidate(&self, execution: &Execution, reason: EvidenceFailure) {
+        self.expire_lineage(execution, reason);
+        self.finish_run(execution, reason);
+        let entering = self.entering.take().is_some();
+        let depth = self.depth.replace(0);
+        if entering || depth != 0 { execution.evidence_failed(0, reason); }
+        self.exceptions.borrow_mut().fill(None);
+    }
+
+    pub(super) fn finish_run(&self, execution: &Execution, reason: EvidenceFailure) {
+        for pending in [self.instruction.take(), self.status.take(), self.returning.take()]
+            .into_iter().flatten() {
+            execution.evidence_failed(u64::from(pending.source.address), reason);
+        }
+        let count = self.completed_len.replace(0);
+        for index in 0..count {
+            if let Some(retired) = self.completed.borrow_mut()[index].take() {
+                execution.evidence_failed(u64::from(retired.source.address), reason);
+            }
+        }
+        if self.resuming.get().is_some() {
+            self.expire_lineage(execution, reason);
+        }
+    }
+
+    pub(super) fn publish(&self, execution: &Execution) {
+        let count = self.completed_len.replace(0);
+        for index in 0..count {
+            let retired = self.completed.borrow_mut()[index].take();
+            if let Some(retired) = retired {
+                execution.emit_evidence(PreservationEvidence::Retired(retired));
+            }
+        }
+    }
+
+    fn pending(&self, execution: &Execution, address: u32, word: u32, before: Arm32State)
+        -> Option<Pending>
+    {
+        let source = match execution.evidence_source(address, word) {
+            Some(source) => source,
+            None => {
+                execution.evidence_failed(u64::from(address), EvidenceFailure::UnresolvedMemory);
+                return None;
+            }
+        };
+        let observation = execution.entry.get().filter(|entry| {
+            entry.address == u64::from(address)
+                && entry.physical == Some(source.physical)
+                && entry.bytes == 4
+                && entry.pstate == before.cpsr
+                && entry.tcm == source.tcm
+        });
+        let resumed_from = self.resuming.take().filter(|entry| {
+            entry.address == u64::from(address) && entry.physical == Some(source.physical)
+                && entry.bytes == 4 && entry.tcm == source.tcm && entry.pstate == before.cpsr
+        });
+        Some(Pending { id: self.next(execution)?, source, before, observation, resumed_from })
+    }
+
+    fn top(&self) -> Option<EvidenceId> {
+        self.depth.get().checked_sub(1).and_then(|index| self.exceptions.borrow()[index])
+    }
+
+    pub(super) fn before_irq(&self, execution: &Execution) {
+        if execution.observer_index.borrow().preservation.is_empty() { return; }
+        self.expire_lineage(execution, EvidenceFailure::MissingRetirement);
+        let Some(id) = self.next(execution) else { return; };
+        match execution.cpu.capture_arm32() {
+            Ok(before) => {
+                if self.entering.replace(Some((id, before))).is_some() {
+                    execution.evidence_failed(u64::from(before.registers[15]), EvidenceFailure::Duplicate);
+                }
+            }
+            Err(_) => execution.evidence_failed(0, EvidenceFailure::UnsupportedProcessor),
+        }
+    }
+
+    pub(super) fn after_irq(&self, execution: &Execution, vector: u32) {
+        let Some((id, before)) = self.entering.take() else { return; };
+        let depth = self.depth.get();
+        if depth == self.exceptions.borrow().len() {
+            execution.evidence_failed(u64::from(vector), EvidenceFailure::ExceptionDepth);
+            return;
+        }
+        match execution.cpu.capture_arm32() {
+            Ok(mut after) => {
+                after.registers[15] = vector;
+                self.exceptions.borrow_mut()[depth] = Some(id);
+                self.depth.set(depth + 1);
+                execution.emit_evidence(PreservationEvidence::Entered(ExceptionEntry {
+                    execution: id, before, after, vector,
+                }));
+            }
+            Err(_) => execution.evidence_failed(u64::from(vector), EvidenceFailure::UnsupportedProcessor),
+        }
+    }
+
+    fn native(&self, execution: &Execution, phase: u32, address: u32, word: u32,
+              status: u32, mask: u32, state: Arm32State) {
+        match phase {
+            0 | 2 | 4 => {
+                let Some(pending) = self.pending(execution, address, word, state) else { return; };
+                let slot = match phase { 0 => &self.instruction, 2 => &self.status, _ => &self.returning };
+                if slot.replace(Some(pending)).is_some() {
+                    execution.evidence_failed(u64::from(address), EvidenceFailure::MissingRetirement);
+                }
+            }
+            1 => {
+                let Some(pending) = self.instruction.take() else {
+                    execution.evidence_failed(u64::from(address), EvidenceFailure::MissingEntry);
+                    return;
+                };
+                if pending.source.address != address || pending.source.word != word
+                    || execution.evidence_source(address, word) != Some(pending.source) {
+                    execution.evidence_failed(u64::from(address), EvidenceFailure::SourceChanged);
+                    return;
+                }
+                if word != 0xe92d4ff0 {
+                    execution.evidence_failed(u64::from(address), EvidenceFailure::UnsupportedInstruction);
+                    return;
+                }
+                if pending.before.registers[13].checked_sub(36) != Some(state.registers[13]) {
+                    execution.evidence_failed(u64::from(address), EvidenceFailure::IncompleteFrame);
+                    return;
+                }
+                let Some(frame) = execution.evidence_frame(state.registers[13], state.cpsr) else {
+                    execution.evidence_failed(u64::from(address), EvidenceFailure::IncompleteFrame);
+                    return;
+                };
+                let index = self.completed_len.get();
+                if index == 32 {
+                    execution.evidence_failed(u64::from(address), EvidenceFailure::EvidenceCapacity);
+                    return;
+                }
+                self.completed.borrow_mut()[index] = Some(InstructionRetirement {
+                    execution: pending.id, source: pending.source, before: pending.before,
+                    observation: pending.observation,
+                    resumed_from: pending.resumed_from,
+                    after: state, frame,
+                });
+                self.completed_len.set(index + 1);
+            }
+            3 => {
+                let Some(pending) = self.status.take() else {
+                    execution.evidence_failed(u64::from(address), EvidenceFailure::MissingEntry);
+                    return;
+                };
+                let Some(exception) = self.top() else {
+                    execution.evidence_failed(u64::from(address), EvidenceFailure::UnpairedException);
+                    return;
+                };
+                if pending.source.address != address || pending.source.word != word
+                    || execution.evidence_source(address, word) != Some(pending.source) {
+                    execution.evidence_failed(u64::from(address), EvidenceFailure::SourceChanged);
+                    return;
+                }
+                execution.emit_evidence(PreservationEvidence::SavedStatus(SavedStatusWrite {
+                    exception, source: pending.source,
+                    before: pending.before, after: state,
+                }));
+            }
+            5 => {
+                let Some(pending) = self.returning.take() else {
+                    execution.evidence_failed(u64::from(state.registers[15]), EvidenceFailure::MissingEntry);
+                    return;
+                };
+                let Some(exception) = self.top() else {
+                    execution.evidence_failed(u64::from(pending.source.address), EvidenceFailure::UnpairedException);
+                    return;
+                };
+                if execution.evidence_source(pending.source.address, pending.source.word) != Some(pending.source) {
+                    execution.evidence_failed(u64::from(pending.source.address), EvidenceFailure::SourceChanged);
+                    return;
+                }
+                let depth = self.depth.get() - 1;
+                self.exceptions.borrow_mut()[depth] = None;
+                self.depth.set(depth);
+                execution.emit_evidence(PreservationEvidence::Returned(ExceptionReturn {
+                    exception, source: pending.source, before: pending.before, after: state,
+                    written_status: status, mask,
+                }));
+            }
+            _ => execution.evidence_failed(u64::from(address), EvidenceFailure::UnsupportedInstruction),
+        }
+    }
+}
+
+impl Execution {
+    fn evidence_source(&self, address: u32, word: u32) -> Option<ExecutionSource> {
+        let address64 = u64::from(address);
+        if self.overlaps_tcm(address64, 4) { return None; }
+        let maps = self.maps.borrow();
+        let map = maps.iter().find(|map| map.address <= address64
+            && address64.checked_add(4).is_some_and(|end| end <= map.end())
+            && map.permissions & 4 != 0)?;
+        Some(ExecutionSource {
+            address, physical: map.physical?.checked_add(address64 - map.address)?, word,
+            tcm: std::array::from_fn(|bank| self.tcm[bank].extent()
+                .map(|(address, bytes)| InstructionTcm { address, bytes })),
+        })
+    }
+
+    fn evidence_frame(&self, address: u32, cpsr: u32) -> Option<SavedFrame> {
+        let address64 = u64::from(address);
+        if address % 4 != 0 || self.overlaps_tcm(address64, 36) { return None; }
+        let maps = self.maps.borrow();
+        let map = maps.iter().find(|map| map.address <= address64
+            && address64.checked_add(36).is_some_and(|end| end <= map.end())
+            && map.permissions & 1 != 0)?;
+        let physical = map.physical?.checked_add(address64 - map.address)?;
+        let offset = usize::try_from(address64 - map.address).ok()?;
+        let pointer = map.pointer.checked_add(offset)? as *const u8;
+        // The run owns this RAM mapping; no CPU API, device or observer is reentered.
+        let bytes = unsafe { std::slice::from_raw_parts(pointer, 36) };
+        let words = std::array::from_fn(|index| {
+            let value = <[u8; 4]>::try_from(&bytes[index * 4..index * 4 + 4]).unwrap();
+            if cpsr & (1 << 9) == 0 { u32::from_le_bytes(value) } else { u32::from_be_bytes(value) }
+        });
+        Some(SavedFrame { address, physical, words })
+    }
+
+    fn evidence_failed(&self, address: u64, reason: EvidenceFailure) {
+        self.emit_evidence(PreservationEvidence::Refused { address, reason });
+    }
