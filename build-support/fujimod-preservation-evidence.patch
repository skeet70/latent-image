+//! A passive proposal checker. A successful check never authorizes execution.
+use super::*;
+use crate::InstructionEntry;
+#[derive(Clone, Copy, Debug)]
+pub struct Binding<C: Copy + Eq> {
+    pub entry: InstructionEntry,
+    pub registers: [u32; 16],
+    pub cpsr: u32,
+    pub context: C,
+}
+
+/// Source-bound stock SVC-bank restoration: saved IRQ status, F preserved, MSR
+/// SPSR_fc followed by LDM sp!, {r0-r3, ip, lr, pc}^. The caller authenticates
+/// the containing stock image and its lifetime, not just these two words.
+#[derive(Clone, Copy, Debug)]
+pub struct StockReturn {
+    pub vector: u32,
+    pub status: ExecutionSource,
+    pub returning: ExecutionSource,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Failure {
+    Binding, Duplicate, MissingRetirement, Retirement, Frame, WrongCore,
+    ExceptionOrder, ExceptionEntry, UnsupportedSource, SavedStatus,
+    ExceptionReturn, Destination, Context, Incomplete, Backend(EvidenceFailure),
+}
+
+#[derive(Clone, Copy)]
+struct Irq {
+    entry: ExceptionEntry,
+    predicted: Arm32State,
+    written: Option<SavedStatusWrite>,
+}
+
+pub struct Shadow<C: Copy + Eq> {
+    binding: Binding<C>,
+    stock: StockReturn,
+    retired: Option<InstructionRetirement>,
+    irq: Option<Irq>,
+    expected: Option<Arm32State>,
+    last_id: Option<EvidenceId>,
+    completed: bool,
+    failure: Option<Failure>,
+}
+
+impl<C: Copy + Eq> Shadow<C> {
+    pub fn new(binding: Binding<C>, stock: StockReturn) -> Result<Self, Failure> {
+        if binding.entry.address != u64::from(binding.registers[15])
+            || binding.entry.bytes != 4 || binding.entry.pstate != binding.cpsr
+            || binding.entry.physical.is_none() || binding.cpsr & 0x0100003f != 0x13
+            || binding.registers[13] & 7 != 0
+            || stock.status.word != 0xe169f001 || stock.returning.word != 0xe8fdd00f
+            || stock.status.address.checked_add(4) != Some(stock.returning.address)
+            || stock.status.physical.checked_add(4) != Some(stock.returning.physical) {
+            return Err(Failure::Binding);
+        }
+        Ok(Self { binding, stock, retired: None, irq: None, expected: None,
+            last_id: None, completed: false, failure: None })
+    }
+
+    pub fn failure(&self) -> Option<Failure> { self.failure }
+    pub fn completed(&self) -> bool { self.completed && self.failure.is_none() }
+
+    fn reject<T>(&mut self, reason: Failure) -> Result<T, Failure> {
+        let first = *self.failure.get_or_insert(reason);
+        Err(first)
+    }
+
+    fn identity(&mut self, id: EvidenceId) -> Result<(), Failure> {
+        if id.owner != self.binding.entry.id.owner { return Err(Failure::WrongCore); }
+        if self.last_id.is_some_and(|old| id.serial <= old.serial) { return Err(Failure::Duplicate); }
+        self.last_id = Some(id);
+        Ok(())
+    }
+
+    pub fn observe(&mut self, event: PreservationEvidence) -> Result<(), Failure> {
+        if let Some(first) = self.failure { return Err(first); }
+        if self.completed { return self.reject(Failure::Duplicate); }
+        let result = self.observe_inner(event);
+        if let Err(reason) = result { return self.reject(reason); }
+        Ok(())
+    }
+
+    fn observe_inner(&mut self, event: PreservationEvidence) -> Result<(), Failure> {
+        match event {
+            PreservationEvidence::Refused { reason, .. } => Err(Failure::Backend(reason)),
+            PreservationEvidence::Retired(retired) => {
+                self.identity(retired.execution)?;
+                if self.retired.is_some() || self.irq.is_some() { return Err(Failure::Duplicate); }
+                let observed = retired.observation.ok_or(Failure::Binding)?;
+                if observed.id != self.binding.entry.id
+                    && retired.resumed_from != Some(self.binding.entry) {
+                    return Err(Failure::Binding);
+                }
+                if observed.address != self.binding.entry.address
+                    || observed.physical != self.binding.entry.physical
+                    || observed.tcm != self.binding.entry.tcm
+                    || observed.id.owner != self.binding.entry.id.owner
+                    || retired.source.address != self.binding.registers[15]
+                    || Some(retired.source.physical) != self.binding.entry.physical
+                    || retired.source.tcm != self.binding.entry.tcm
+                    || retired.source.word != 0xe92d4ff0
+                    || retired.before.registers != self.binding.registers
+                    || retired.before.cpsr != self.binding.cpsr {
+                    return Err(Failure::Retirement);
+                }
+                let mut expected = retired.before;
+                expected.registers[13] = expected.registers[13].checked_sub(36).ok_or(Failure::Frame)?;
+                expected.registers[15] = expected.registers[15].checked_add(4).ok_or(Failure::Destination)?;
+                if retired.after != expected { return Err(Failure::Retirement); }
+                let words = std::array::from_fn(|index| if index < 8 {
+                    self.binding.registers[index + 4]
+                } else { self.binding.registers[14] });
+                if retired.frame.address != expected.registers[13] || retired.frame.words != words {
+                    return Err(Failure::Frame);
+                }
+                self.retired = Some(retired);
+                self.expected = Some(expected);
+                Ok(())
+            }
+            PreservationEvidence::Entered(entry) => {
+                self.identity(entry.execution)?;
+                if self.irq.is_some() { return Err(Failure::ExceptionOrder); }
+                let before = self.expected.ok_or(Failure::MissingRetirement)?;
+                if entry.before != before || entry.vector != self.stock.vector
+                    || before.cpsr & 0x1f != 0x13 || before.cpsr & 0x80 != 0 {
+                    return Err(Failure::ExceptionEntry);
+                }
+                let mut expected = before;
+                expected.cpsr = (before.cpsr & !(0x1f | 0x20 | 0x0600fc00 | 0x01000000 | 0x200))
+                    | 0x12 | 0x80 | 0x100;
+                expected.spsr = before.cpsr;
+                expected.svc_spsr = before.spsr;
+                expected.svc_sp = before.registers[13];
+                expected.svc_lr = before.registers[14];
+                expected.registers[13] = before.irq_sp;
+                expected.registers[14] = before.registers[15].checked_add(4).ok_or(Failure::ExceptionEntry)?;
+                expected.registers[15] = entry.vector;
+                if entry.after != expected { return Err(Failure::ExceptionEntry); }
+                let mut predicted = before;
+                predicted.spsr = (before.spsr & !0xff0000ff) | (before.cpsr & 0xff0000ff);
+                predicted.cpsr = predicted.spsr;
+                predicted.svc_spsr = before.spsr;
+                predicted.irq_spsr = before.cpsr;
+                predicted.svc_sp = before.registers[13].checked_sub(28).ok_or(Failure::ExceptionEntry)?;
+                predicted.svc_lr = before.registers[14];
+                predicted.irq_sp = 0xd3;
+                predicted.irq_lr = before.registers[15].checked_add(4).ok_or(Failure::ExceptionEntry)?;
+                self.irq = Some(Irq { entry, predicted, written: None });
+                Ok(())
+            }
+            PreservationEvidence::SavedStatus(written) => {
+                let irq = self.irq.as_mut().ok_or(Failure::ExceptionOrder)?;
+                if written.exception != irq.entry.execution || irq.written.is_some() {
+                    return Err(Failure::ExceptionOrder);
+                }
+                if written.source != self.stock.status {
+                    return Err(Failure::UnsupportedSource);
+                }
+                let old_svc = irq.entry.before.spsr;
+                let saved = irq.entry.before.cpsr;
+                if written.before.cpsr & 0x1bf != 0x193 || written.before.spsr != old_svc
+                    || written.before.cpsr & 0x40 != saved & 0x40
+                    || written.before.registers[1] != saved
+                    || written.before.svc_spsr != old_svc
+                    || written.before.irq_spsr != irq.predicted.irq_spsr
+                    || written.before.svc_sp != irq.predicted.svc_sp
+                    || written.before.svc_lr != irq.predicted.svc_lr
+                    || written.before.irq_sp != irq.predicted.irq_sp
+                    || written.before.irq_lr != irq.predicted.irq_lr {
+                    return Err(Failure::SavedStatus);
+                }
+                let mut expected = written.before;
+                expected.spsr = irq.predicted.spsr;
+                expected.registers[15] = written.source.address.checked_add(4).ok_or(Failure::SavedStatus)?;
+                if written.after != expected { return Err(Failure::SavedStatus); }
+                irq.written = Some(written);
+                Ok(())
+            }
+            PreservationEvidence::Returned(returned) => {
+                let irq = self.irq.ok_or(Failure::ExceptionOrder)?;
+                let written = irq.written.ok_or(Failure::SavedStatus)?;
+                if returned.exception != irq.entry.execution { return Err(Failure::ExceptionOrder); }
+                if returned.source != self.stock.returning {
+                    return Err(Failure::UnsupportedSource);
+                }
+                if returned.before != written.after || returned.written_status != written.after.spsr
+                    || returned.mask != 0xff1fffff { return Err(Failure::ExceptionReturn); }
+                let expected = irq.predicted;
+                if returned.after != expected { return Err(Failure::ExceptionReturn); }
+                self.expected = Some(expected);
+                self.irq = None;
+                Ok(())
+            }
+        }
+    }
+
+    /// The one-use destination check remains separate from retirement evidence.
+    pub fn handoff(&mut self, registers: [u32; 16], cpsr: u32, frame: SavedFrame,
+        context: C) -> Result<(), Failure> {
+        if let Some(first) = self.failure { return Err(first); }
+        if self.completed { return self.reject(Failure::Duplicate); }
+        if self.irq.is_some() { return self.reject(Failure::Incomplete); }
+        let Some(expected) = self.expected else { return self.reject(Failure::MissingRetirement); };
+        if context != self.binding.context { return self.reject(Failure::Context); }
+        if registers != expected.registers || cpsr != expected.cpsr {
+            return self.reject(Failure::Destination);
+        }
+        if self.retired.is_none_or(|retired| retired.frame != frame) {
+            return self.reject(Failure::Frame);
+        }
+        self.completed = true;
+        Ok(())
+    }
+
+    pub fn finish(&mut self) -> Result<(), Failure> {
+        if let Some(first) = self.failure { return Err(first); }
+        if !self.completed { return self.reject(Failure::Incomplete); }
+        Ok(())
+    }
+}
