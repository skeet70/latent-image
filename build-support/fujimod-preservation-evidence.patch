+    cpu.run(Run { begin: 0x1004, until: Some(0x1004), watchdog_us: 0, instructions: Some(100) }).unwrap();
+    cpu.set_interrupt(Interrupt::Irq, false).unwrap();
+    let after = cpu.execution.cpu.capture_arm32().unwrap();
