+    cpu.read_memory(0x6fdc, &mut saved).unwrap();
+    let frame = SavedFrame { address: 0x6fdc, physical: 0x6fdc,
+        words: std::array::from_fn(|index| u32::from_le_bytes(
+            saved[index * 4..index * 4 + 4].try_into().unwrap())) };
+    let source = |address, word| ExecutionSource { address, physical: address as u64, word, tcm: [None; 2] };
+    let stock = shadow::StockReturn { vector: 0x18,
+        status: source(0x2044, 0xe169f001), returning: source(0x2048, 0xe8fdd00f) };
+    let binding = shadow::Binding { entry, registers: before.registers, cpsr: before.cpsr,
+        context: (1, 1) };
+    let fingerprint = cpu.fingerprint().unwrap();
+    let mut ram = vec![0; 0x8000];
+    cpu.read_memory(0, &mut ram).unwrap();
+    if let Some(hook) = evidence_hook { cpu.remove_hook(hook).unwrap(); }
+    cpu.remove_hook(entry_hook).unwrap();
+    Trace { binding, stock, events: capture.events.into_inner(), after, frame, fingerprint, ram }
+}
+
+fn check(trace: &Trace, events: &[PreservationEvidence], after: Arm32State, frame: SavedFrame)
+    -> Result<(), shadow::Failure> {
+    let mut shadow = shadow::Shadow::new(trace.binding, trace.stock)?;
+    for event in events { shadow.observe(*event)?; }
+    shadow.handoff(after.registers, after.cpsr, frame, trace.binding.context)?;
+    shadow.finish()
+}
+
+#[test]
+fn native_push_irq_retirement_and_late_handoff_preserve_state_without_masking_a() {
+    let trace = execute(true);
+    assert_eq!(trace.events.len(), 4);
+    assert_eq!(trace.after.registers[15], 0x1004);
+    assert_eq!(trace.binding.cpsr, 0x80000153);
+    assert_eq!(trace.after.cpsr, 0x80000053);
+    assert_eq!(check(&trace, &trace.events, trace.after, trace.frame), Ok(()));
+    let inactive = execute(false);
+    assert!(inactive.events.is_empty());
+    assert_eq!(trace.fingerprint, inactive.fingerprint);
+    assert_eq!(trace.ram, inactive.ram);
+}
+
+#[test]
+fn retirement_exception_and_late_corruption_are_sticky_refusals() {
+    let trace = execute(true);
+    let mut after = trace.after;
+    after.cpsr ^= 0x100;
+    assert_eq!(check(&trace, &trace.events, after, trace.frame), Err(shadow::Failure::Destination));
+    let mut frame = trace.frame;
+    frame.words[8] ^= 4;
+    assert_eq!(check(&trace, &trace.events, trace.after, frame), Err(shadow::Failure::Frame));
+    assert_eq!(check(&trace, &[], trace.after, trace.frame), Err(shadow::Failure::MissingRetirement));
+    assert_eq!(check(&trace, &trace.events[..2], trace.after, trace.frame), Err(shadow::Failure::Incomplete));
+    let mut events = trace.events.clone();
+    events.insert(1, events[0]);
+    assert_eq!(check(&trace, &events, trace.after, trace.frame), Err(shadow::Failure::Duplicate));
+    for bit in [0x100, 0x80000000, 0x40] {
+        let mut events = trace.events.clone();
+        let PreservationEvidence::SavedStatus(write) = &mut events[2] else { panic!("missing native status write") };
+        write.before.registers[1] ^= bit;
+        assert_eq!(check(&trace, &events, trace.after, trace.frame), Err(shadow::Failure::SavedStatus));
+    }
+    let mut events = trace.events.clone();
+    let PreservationEvidence::Entered(entry) = &mut events[1] else { panic!("missing native IRQ") };
+    entry.before.cpsr ^= 0x100;
+    assert_eq!(check(&trace, &events, trace.after, trace.frame), Err(shadow::Failure::ExceptionEntry));
+    let mut shadow = shadow::Shadow::new(trace.binding, trace.stock).unwrap();
+    assert_eq!(shadow.observe(PreservationEvidence::Refused { address: 0x1000, reason: EvidenceFailure::Faulted }),
+        Err(shadow::Failure::Backend(EvidenceFailure::Faulted)));
+    assert_eq!(shadow.observe(trace.events[0]), Err(shadow::Failure::Backend(EvidenceFailure::Faulted)));
+    assert_eq!(shadow.finish(), Err(shadow::Failure::Backend(EvidenceFailure::Faulted)));
+}
