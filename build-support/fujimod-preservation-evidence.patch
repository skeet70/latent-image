+    fn emit_evidence(&self, event: PreservationEvidence) {
+        self.preservation.dispatching.set(true);
+        let _dispatch = Dispatch(&self.preservation.dispatching);
+        let observers = self.observers.borrow();
+        for observer in observers.values() {
+            let Hook::Preservation { callback, data, range } = observer.hook else { continue; };
