+                let address = u64::from(retired.source.address);
+                let selected = match range {
+                    HookRange::All => false,
+                    HookRange::Inclusive { begin, end } => begin <= address && address <= end,
+                };
+                if !selected { continue; }
+            }
+            unsafe { callback(event, data) };
+        }
+    }
