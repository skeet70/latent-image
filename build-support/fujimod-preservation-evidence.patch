+    set(&cpu, arm::SPSR, 0x53);
+    set(&cpu, arm::CPSR, 0x12);
+    set(&cpu, arm::CORE[13], 0xd3);
+    set(&cpu, arm::SPSR, 0x53);
+    set(&cpu, arm::CPSR, 0x80000153);
+    for index in 0..13 { set(&cpu, arm::CORE[index], 0x10000000 + index as u32); }
+    set(&cpu, arm::CORE[13], 0x7000);
+    set(&cpu, arm::CORE[14], 0x1800);
+    set(&cpu, arm::PC, 0x1000);
+    cpu.set_execution_policy(ExecutionPolicy::Exact).unwrap();
+    cpu.set_guest_clock(Clock { now: 100, phase: 7,
+        ratio: timeline::Ratio::new(24, 1).unwrap() }).unwrap();
+    let before = cpu.execution.cpu.capture_arm32().unwrap();
+    let capture = Capture { cpu: &cpu, entry: Cell::new(None), events: RefCell::new(Vec::with_capacity(16)) };
+    let data = (&capture as *const Capture).cast_mut().cast();
+    let range = HookRange::Inclusive { begin: 0x1000, end: 0x1000 };
+    let entry_hook = unsafe { cpu.install_hook(Hook::Instruction { callback: entered, data, range }) }.unwrap();
