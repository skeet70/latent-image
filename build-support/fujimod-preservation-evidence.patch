+    data: *mut c_void, phase: u32, address: u32, word: u32, status: u32, mask: u32,
+    state: *const Arm32State,
+) {
+    let execution = unsafe { &*data.cast::<Execution>() };
+    let captured = catch_unwind(AssertUnwindSafe(|| {
+        if let Some(state) = unsafe { state.as_ref() } {
+            execution.preservation.native(execution, phase, address, word, status, mask, *state);
+        } else {
+            execution.evidence_failed(u64::from(address), EvidenceFailure::UnresolvedMemory);
+        }
+    }));
+    if captured.is_err() {
+        execution.fail("preservation observer panicked".into());
+    }
