+//! Bounded native evidence forwarding; callbacks never inspect or re-enter a CPU.
+use super::{Board, CoreIndex, ObservationContext, lifecycle};
+use fujimod_emulator_cpu::{Cpu, Hook, HookId, HookRange, preservation::PreservationEvidence};
+use std::{cell::Cell, ffi::c_void, rc::{Rc, Weak}};
+
+struct Context {
+    cpu: Weak<dyn Cpu>,
+    core: CoreIndex,
+    callback: Rc<dyn Fn(CoreIndex, PreservationEvidence)>,
+}
+
+/// Removal failure retains callback storage in the board's observer registry.
+pub struct PreservationWatch {
+    context: Rc<Context>,
+    hooks: Vec<HookId>,
+    memory: Weak<crate::board::memory::Memory>,
+    cleanup_failed: Rc<Cell<bool>>,
+}
+
+unsafe fn observed(evidence: PreservationEvidence, data: *mut c_void) {
+    let context = unsafe { &*data.cast::<Context>() };
+    (context.callback)(context.core, evidence);
+}
+
+impl PreservationWatch {
+    pub fn remove(&mut self) -> Result<(), String> {
+        let cpu = self.context.cpu.upgrade();
+        let result = lifecycle::remove_hooks(&mut self.hooks,
+            |&hook| cpu.as_ref().map_or(Ok(()), |cpu| cpu.remove_hook(hook)));
+        if result.is_err() { self.cleanup_failed.set(true); }
+        result
+    }
+}
+impl Drop for PreservationWatch {
+    fn drop(&mut self) {
+        if self.hooks.is_empty() || self.remove().is_ok() { return; }
+        if let Some(memory) = self.memory.upgrade() {
+            memory.observers.retain(Box::new((self.context.clone(), std::mem::take(&mut self.hooks))));
+        }
+    }
+}
+
+fn begin(
+    cpus: &[Rc<dyn Cpu>], memory: &Rc<crate::board::memory::Memory>, core: usize,
+    range: HookRange, callback: Rc<dyn Fn(CoreIndex, PreservationEvidence)>,
+) -> Result<PreservationWatch, String> {
+    let cpu = cpus.get(core).ok_or("preservation core is unavailable")?;
+    let context = Rc::new(Context { cpu: Rc::downgrade(cpu), core: CoreIndex(core), callback });
+    let data = Rc::as_ptr(&context).cast_mut().cast();
+    // The watch owns this context until removal, including the failed-removal path.
+    let hook = unsafe { cpu.install_hook(Hook::Preservation { callback: observed, data, range }) }?;
+    Ok(PreservationWatch { context, hooks: vec![hook], memory: Rc::downgrade(memory),
+        cleanup_failed: memory.observers.cleanup_failed.clone() })
+}
+
+impl Board {
+    pub fn preservation_evidence_begin(&self, core: usize, range: HookRange,
+        callback: Rc<dyn Fn(CoreIndex, PreservationEvidence)>) -> Result<PreservationWatch, String> {
+        begin(&self.cpus, &self.physical_memory, core, range, callback)
+    }
+}
+impl ObservationContext {
+    pub fn preservation_evidence_begin(&self, core: usize, range: HookRange,
+        callback: Rc<dyn Fn(CoreIndex, PreservationEvidence)>) -> Result<PreservationWatch, String> {
+        begin(&self.cpus, &self.memory, core, range, callback)
+    }
+}
