+/// Both processors share one `Faults`, so budgets count calls across cores.
+fn flaky_board() -> (Board, Rc<Faults>) {
+    let faults = Rc::new(Faults::default());
+    let shared = faults.clone();
+    let board = graph([true, false], false)
+        .build_with(options(), devices(), None, move |_, inner| {
+            Box::new(Flaky { inner, faults: shared.clone() }) as Box<dyn Cpu>
+        })
+        .unwrap();
+    (board, faults)
