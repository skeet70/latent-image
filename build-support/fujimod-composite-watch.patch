+    fn read(&mut self, cx: &mut Cx<'_>, _: u64, _: u8) -> u64 {
+        cx.unmodeled();
+        0
+    }
+    fn write(&mut self, cx: &mut Cx<'_>, _: u64, _: u8, value: u64) {
+        if let Err(error) = cx.ram_write(value, &0x5a5a_5a5au32.to_le_bytes()) {
