+#[test]
+fn attach_preserves_existing_rows_classes_and_wire() {
+    let board = board();
+    let mut watch = watch(&board, 64);
+    board.write_physical(0x40000, &[1, 2, 3, 4]).unwrap();
+    let before = watch.records.borrow().state();
+    let fingerprint = board.fingerprint().unwrap();
+    let token = board.memory_guard_attach(&mut watch, config(open)).unwrap();
+    assert_eq!(watch.records.borrow().state(), before);
+    assert_eq!(board.fingerprint().unwrap(), fingerprint);
+    board.write_physical(0x40004, &[5, 6, 7, 8]).unwrap();
+    let after = rows(&watch);
+    assert_eq!(after.len(), 2);
+    assert_eq!(after[0], before["records"][0]);
+    let report = token.report();
+    assert_eq!((report.status, report.first_fault, report.write_checks), (GuardStatus::Armed, None, 1));
+}
