+//! Opt-in write and mutation admission attached to the current classified
+//! memory watch. The guard retains bounded policy, checked counters and the
+//! first typed fault; it adds no rows to the watch. Declared TCM region writes
+//! and memory decoder commits are admitted once each, in their declared order,
+//! and move the pinned TCM windows and processor views with them.
+use super::{Board, MemoryWatch, State, ViewPolicy, lifecycle::LeasePhase};
+use crate::board::{
+    factory::MemoryMap,
+    memory::{BulkWrite, Memory},
+    scalar,
+};
+use fujimod_emulator_cpu::{
+    Access, Cpu, CpuMutation, ExecutionPolicy, Hook, HookId, HookRange, MappingMutation, Model, MutationOrigin,
+    Register, arm,
+};
+use std::{
+    cell::{Cell, RefCell},
+    ffi::c_void,
+    rc::{Rc, Weak},
+};
+
+pub const MAX_GUARD_CORES: usize = 16;
+/// Allow and forbid ranges across every policy of one configuration.
+pub const MAX_GUARD_RANGES: usize = 1024;
+pub const MAX_GUARD_PC_SPANS: usize = 512;
+/// Partitions of one `Cpu` source.
+pub const MAX_GUARD_PARTITIONS: usize = 64;
+/// Pinned processor views per core.
+pub const MAX_GUARD_VIEWS: usize = 256;
+pub const MAX_GUARD_DECLARED_MUTATIONS: usize = 16;
+/// Heap bytes retained for one configuration's policy storage.
+pub const MAX_GUARD_BYTES: usize = 1 << 20;
+const ADDRESS_END: u64 = 1 << 32;
+const GUEST_WIDTHS: [usize; 5] = [1, 2, 4, 8, 16];
+/// A32 `MCR p15,0,Rt,c9,c1,opc2` with cond and Rt masked out; opc2 is ORed in at bit 5.
+const TCM_REGION_MCR: u32 = 0x0e09_0f11;
+const TCM_REGION_MCR_MASK: u32 = 0x0fff_0fff;
+const CPSR_THUMB: u64 = 0x20;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct GuardCore(u8);
+impl GuardCore {
+    pub fn new(core: usize) -> Result<Self, GuardAttachError> {
+        u8::try_from(core)
+            .ok()
+            .filter(|_| core < MAX_GUARD_CORES)
+            .map(Self)
+            .ok_or(GuardAttachError::InvalidCore)
+    }
+    pub fn get(self) -> usize {
+        usize::from(self.0)
+    }
+}
+/// Half-open and within the 32-bit address space.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct GuardSpan {
+    start: u64,
+    end: u64,
+}
+impl GuardSpan {
+    pub fn new(start: u64, end: u64) -> Result<Self, GuardAttachError> {
+        if start >= end || end > ADDRESS_END {
+            return Err(GuardAttachError::InvalidInterval);
+        }
+        Ok(Self { start, end })
+    }
+    pub fn start(self) -> u64 {
+        self.start
+    }
+    pub fn end(self) -> u64 {
+        self.end
+    }
+    fn holds(self, address: u64) -> bool {
+        self.start <= address && address < self.end
+    }
+    fn intersects(self, start: u64, end: u64) -> bool {
+        start < self.end && self.start < end
+    }
+}
+/// `Data` is CP15 c9,c1,0 (BTCM on Cortex-R5); `Instruction` is c9,c1,1 (ATCM).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum TcmBank {
+    Data,
+    Instruction,
+}
+impl TcmBank {
+    pub const ALL: [Self; 2] = [Self::Data, Self::Instruction];
+    fn opc2(self) -> u32 {
+        match self {
+            Self::Data => 0,
+            Self::Instruction => 1,
+        }
+    }
+    fn index(self) -> usize {
+        self.opc2() as usize
+    }
+    pub fn register(self) -> arm::Coprocessor {
+        arm::Coprocessor { cp: 15, opc1: 0, crn: 9, crm: 1, opc2: self.opc2(), secure: 0, wide: false }
+    }
+    fn of(register: arm::Coprocessor) -> Option<Self> {
+        Self::ALL.into_iter().find(|bank| bank.register() == register)
+    }
+}
+/// A TCM span is an offset range within that core's bank.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum GuardTarget {
+    Physical,
+    Tcm { core: GuardCore, bank: TcmBank },
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct GuardRange {
+    pub target: GuardTarget,
+    pub span: GuardSpan,
+}
+/// The union of `allow` must cover a whole access; any `forbid` overlap denies it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct DestinationPolicy {
+    pub allow: Vec<GuardRange>,
+    pub forbid: Vec<GuardRange>,
+}
+/// Index into `SourcePolicy::partitions`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct PartitionId(u16);
+impl PartitionId {
+    pub fn get(self) -> usize {
+        usize::from(self.0)
+    }
+}
+/// Writes by instructions whose PC lies in `spans` use `destinations`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PcPartition {
+    pub spans: Vec<GuardSpan>,
+    pub destinations: DestinationPolicy,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum WriteSource {
+    /// Guest stores by this core.
+    Cpu(GuardCore),
+    /// Host writes through this core's view, including `Cpu::write_memory`.
+    CoreHost(GuardCore),
+    /// Host writes through the physical bus.
+    PhysicalHost,
+    /// Device writes through the physical bus.
+    ModelBus,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct SourcePolicy {
+    pub source: WriteSource,
+    /// For `Cpu` sources, the policy for PCs outside every partition.
+    pub destinations: DestinationPolicy,
+    /// `Cpu` sources only; span sets pairwise disjoint.
+    pub partitions: Vec<PcPartition>,
+}
+/// A TCM region register value as the CPU stores it after normalization.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct TcmRegister(pub u32);
+/// Address of the A32 instruction that requested a mutation.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct WriterPc(pub u32);
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct DecoderIndex(pub u16);
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct DecoderChoice(pub u16);
+/// Index into `CompositeGuardConfig::declared`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct DeclarationId(u8);
+impl DeclarationId {
+    pub fn get(self) -> usize {
+        usize::from(self.0)
+    }
+}
+/// The guest store that selected a memory decoder choice.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct SelectionWriter {
+    pub core: usize,
+    pub pc: u64,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum DeclaredMutation {
+    /// A guest A32 `MCR p15,0,Rt,c9,c1,{0,1}` at `writer` on `core`.
+    TcmRegion { core: GuardCore, bank: TcmBank, previous: TcmRegister, next: TcmRegister, writer: WriterPc },
+    /// A memory decoder commit selected by a guest store at `writer` on `core`.
+    DecoderCommit { decoder: DecoderIndex, previous: DecoderChoice, next: DecoderChoice, core: GuardCore, writer: WriterPc },
+}
+/// Exactly one policy for every `Cpu` and `CoreHost` core, `PhysicalHost`
+/// and `ModelBus`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct CompositeGuardConfig {
+    pub sources: Vec<SourcePolicy>,
+    /// Each admits one occurrence. Per TCM register and per decoder the
+    /// declarations form one chain starting at the value read at attach.
+    pub declared: Vec<DeclaredMutation>,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum GuardHook {
+    Mutation,
+    Write,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum GuardAttachError {
+    NotPaused,
+    PendingDecode,
+    UnsupportedBackend,
+    WrongOwner,
+    DeadWatch,
+    NotCurrent,
+    SiblingWatch,
+    NotClassified,
+    AlreadyAttached,
+    CleanupFailed,
+    InvalidCore,
+    InvalidInterval,
+    MissingSource,
+    DuplicateSource,
+    InvalidTarget,
+    InvalidPartition,
+    /// Two partition spans of one source intersect.
+    PartitionOverlap,
+    AmbiguousRanges,
+    BoundExceeded,
+    InvalidMapping,
+    CpuInspection,
+    /// A declaration names an absent core, bank, decoder or choice, or keeps its value.
+    InvalidDeclaration,
+    /// The declarations of one register or decoder do not form one chain from its attach-time value.
+    DeclarationChain,
+    DuplicateDeclaration,
+    /// A declared decoder commit on a fixed-view watch.
+    FixedViewsWithDeclaredCommit,
+    /// A mutation journal is recording.
+    MutationJournal,
+    /// Installation failed and every hook installed before it was removed.
+    HookInstallation { core: GuardCore, hook: GuardHook },
+}
+impl std::fmt::Display for GuardAttachError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "composite guard attach refused: {self:?}")
+    }
+}
+impl std::error::Error for GuardAttachError {}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum GuardStatus {
+    Armed,
+    Faulted,
+    Ended,
+    /// A hook removal failed; board execution is refused.
+    CleanupFailed,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum WriteFaultReason {
+    Denied,
+    Unresolved,
+    InvalidWidth,
+    Overflow,
+    CpuInspection,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum WriteOutcome {
+    /// The write did not happen. Earlier accesses of the same guest
+    /// instruction may have.
+    Refused,
+    /// The backend could not refuse the guest write; the core was stopped at it and the write may have happened.
+    Attempted,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum FailurePhase {
+    BeforeCopy,
+    /// Some bytes may have been copied; nothing was rolled back.
+    AfterCopy,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum GuardMutation {
+    Cpu(CpuMutation),
+    /// A memory decoder choice, including one that changes only DMA windows.
+    /// `writer` is absent for a selection no guest store made.
+    Decoder { decoder: usize, previous: usize, choice: usize, writer: Option<SelectionWriter> },
+    /// A board keyframe restore.
+    Restore,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DeclaredField {
+    Next,
+    Writer,
+    WriterCore,
+    /// The word at the writer is not a TCM region MCR for the bank.
+    Instruction,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MutationRefusal {
+    /// No declaration names this register or decoder with this `previous`.
+    Undeclared,
+    Mismatch { declaration: DeclarationId, field: DeclaredField },
+    Consumed(DeclarationId),
+    /// PC, CPSR or the writer word could not be read, or the core was in T32 state.
+    WriterUnresolved,
+    HostOrigin,
+    /// A mapping change outside an open declared commit or outside its choice.
+    UnexpectedMapping,
+    /// A declared commit failed or left maps of its choice unapplied.
+    CommitIncomplete,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AdmittedAt {
+    pub core: GuardCore,
+    /// The writer core's entered instruction count, when the backend reports it.
+    pub instructions: Option<u64>,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DeclaredUse {
+    pub declaration: DeclaredMutation,
+    pub admitted: Option<AdmittedAt>,
+}
+/// A resolved destination: a physical address, or an offset within a TCM bank.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct GuardLocation {
+    pub target: GuardTarget,
+    pub address: u64,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum GuardFault {
+    Write {
+        source: WriteSource,
+        /// The processor address for core sources, the bus address otherwise.
+        address: u64,
+        bytes: usize,
+        pc: Option<u64>,
+        /// The partition whose policy denied the write; `None` for the source default.
+        partition: Option<PartitionId>,
+        /// The first offending chunk; absent when the access did not resolve.
+        location: Option<GuardLocation>,
+        reason: WriteFaultReason,
+        outcome: WriteOutcome,
+    },
+    /// Refused before its first effect, except `CommitIncomplete`.
+    Mutation {
+        core: Option<GuardCore>,
+        mutation: GuardMutation,
+        reason: MutationRefusal,
+    },
+    /// An admitted bulk write failed.
+    Operational {
+        source: WriteSource,
+        address: u64,
+        bytes: usize,
+        phase: FailurePhase,
+    },
+    CounterOverflow,
+    CleanupFailed,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct GuardReport {
+    pub status: GuardStatus,
+    pub first_fault: Option<GuardFault>,
+    pub write_checks: u64,
+    /// Refused mutations.
+    pub mutation_attempts: u64,
+    pub mutations_admitted: u64,
+}
+/// Read-only; the attached watch owns the guard.
+#[derive(Clone)]
+pub struct GuardStatusToken(Rc<GuardLatch>);
+impl GuardStatusToken {
+    pub fn report(&self) -> GuardReport {
+        self.0.report.get()
+    }
+    /// Guest writes checked under each partition of `Cpu(core)`, indexed by `PartitionId`.
+    pub fn partition_checks(&self, core: GuardCore) -> Vec<u64> {
+        self.0.partition_checks.get(core.get()).map_or_else(Vec::new, |checks| checks.iter().map(Cell::get).collect())
+    }
+    /// Every declaration in configuration order with its admission.
+    pub fn declared(&self) -> Vec<DeclaredUse> {
+        self.0
+            .declared
+            .iter()
+            .zip(&self.0.admitted)
+            .map(|(&declaration, admitted)| DeclaredUse { declaration, admitted: admitted.get() })
+            .collect()
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct TcmWindow {
+    base: u64,
+    end: u64,
+}
+/// A processor RAM or MMIO view as it is pinned now.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct PinnedView {
+    start: u64,
+    end: u64,
+    physical: u64,
+}
+/// The inputs of a core's pinned views; rebuilt from these after a declared commit.
+struct ViewTables {
+    /// The board graph's processor mappings.
+    graph: Vec<MemoryMap>,
+    /// Per decoder, per choice: its processor maps.
+    choices: Vec<Vec<Vec<MemoryMap>>>,
+    /// Per decoder.
+    selected: Vec<Cell<usize>>,
+    /// Per core: MMIO bindings.
+    mmio: Vec<Vec<PinnedView>>,
+}
+impl ViewTables {
+    fn views(&self, core: usize) -> Result<Vec<PinnedView>, GuardAttachError> {
+        let mut views = Vec::new();
+        let mut push = |address: u64, physical: u64, size: usize| {
+            if views.len() == MAX_GUARD_VIEWS {
+                return Err(GuardAttachError::BoundExceeded);
+            }
+            let size = size as u64;
+            let end = address.checked_add(size).filter(|&end| size != 0 && end <= ADDRESS_END);
+            let (Some(end), Some(_)) = (end, physical.checked_add(size)) else {
+                return Err(GuardAttachError::InvalidMapping);
+            };
+            views.push(PinnedView { start: address, end, physical });
+            Ok(())
+        };
+        for map in self.graph.iter().filter(|map| map.core == core) {
+            let map = self
+                .choices
+                .iter()
+                .zip(&self.selected)
+                .flat_map(|(choices, selected)| &choices[selected.get()])
+                .find(|chosen| chosen.core == core && chosen.address == map.address && chosen.size == map.size)
+                .unwrap_or(map);
+            push(map.address, map.physical, map.size)?;
+        }
+        for view in self.mmio.get(core).into_iter().flatten() {
+            push(view.start, view.physical, (view.end - view.start) as usize)?;
+        }
+        views.sort_unstable_by_key(|view| view.start);
+        if views.windows(2).any(|pair| pair[1].start < pair[0].end) {
+            return Err(GuardAttachError::InvalidMapping);
+        }
+        views.shrink_to_fit();
+        Ok(views)
+    }
+}
+/// A declared decoder commit between its admission and its close.
+struct OpenCommit {
+    declaration: DeclarationId,
+    decoder: usize,
+    choice: usize,
+    core: GuardCore,
+    /// Processor maps of the choice not yet replaced.
+    remaining: Vec<MemoryMap>,
+}
+
+/// Policy, pins and report shared by every guard callback, without Records or State.
+pub(in crate::board) struct GuardLatch {
+    /// Indexed by `slot`.
+    policies: Vec<SourcePolicy>,
+    /// Per `Cpu` core: partition spans sorted by start.
+    partition_spans: Vec<Vec<(GuardSpan, PartitionId)>>,
+    /// Per `Cpu` core, indexed by `PartitionId`.
+    partition_checks: Vec<Vec<Cell<u64>>>,
+    cores: usize,
+    cpus: Vec<Weak<dyn Cpu>>,
+    declared: Vec<DeclaredMutation>,
+    /// Indexed like `declared`.
+    admitted: Vec<Cell<Option<AdmittedAt>>>,
+    /// Per core, indexed like `TcmBank::ALL`.
+    tcm: Vec<Cell<[Option<TcmWindow>; 2]>>,
+    /// Per core; sorted and disjoint.
+    views: Vec<RefCell<Vec<PinnedView>>>,
+    tables: ViewTables,
+    open: RefCell<Option<OpenCommit>>,
+    report: Cell<GuardReport>,
+    /// Set by `Board::drop`; callbacks then admit without counting.
+    released: Cell<bool>,
+}
+#[derive(Clone, Copy)]
+enum Counter {
+    Write,
+    Mutation,
+    Admitted,
+}
+impl GuardLatch {
+    pub(in crate::board) fn release(&self) {
+        self.released.set(true);
+    }
+    fn record(&self, fault: GuardFault) {
+        let mut report = self.report.get();
+        report.first_fault.get_or_insert(fault);
+        if report.status == GuardStatus::Armed {
+            report.status = GuardStatus::Faulted;
+        }
+        self.report.set(report);
+    }
+    fn count(&self, counter: Counter) {
+        let mut report = self.report.get();
+        let value = match counter {
+            Counter::Write => &mut report.write_checks,
+            Counter::Mutation => &mut report.mutation_attempts,
+            Counter::Admitted => &mut report.mutations_admitted,
+        };
+        match value.checked_add(1) {
+            Some(next) => {
+                *value = next;
+                self.report.set(report);
+            }
+            None => self.record(GuardFault::CounterOverflow),
+        }
+    }
+    fn destinations(&self, source: WriteSource, pc: Option<u64>) -> (&DestinationPolicy, Option<PartitionId>) {
+        let policy = &self.policies[slot(source, self.cores)];
+        let partition = match (source, pc) {
+            (WriteSource::Cpu(core), Some(pc)) => {
+                let spans = &self.partition_spans[core.get()];
+                let index = spans.partition_point(|(span, _)| span.start <= pc);
+                index.checked_sub(1).map(|index| spans[index]).filter(|(span, _)| pc < span.end).map(|(_, id)| id)
+            }
+            _ => None,
+        };
+        match partition {
+            Some(id) => (&policy.partitions[id.get()].destinations, Some(id)),
+            None => (&policy.destinations, None),
+        }
+    }
+    fn count_partition(&self, core: GuardCore, partition: PartitionId) {
+        let counter = &self.partition_checks[core.get()][partition.get()];
+        match counter.get().checked_add(1) {
+            Some(next) => counter.set(next),
+            None => self.record(GuardFault::CounterOverflow),
+        }
+    }
+    fn end(&self) {
+        let mut report = self.report.get();
+        report.status = GuardStatus::Ended;
+        self.report.set(report);
+    }
+    fn cleanup_failed(&self) {
+        self.record(GuardFault::CleanupFailed);
+        let mut report = self.report.get();
+        report.status = GuardStatus::CleanupFailed;
+        self.report.set(report);
+    }
+    fn refuse(&self, core: Option<GuardCore>, mutation: GuardMutation, reason: MutationRefusal) {
+        self.count(Counter::Mutation);
+        self.record(GuardFault::Mutation { core, mutation, reason });
+    }
+    fn declaration(&self, key: impl Fn(&DeclaredMutation) -> bool) -> Option<(DeclarationId, DeclaredMutation)> {
+        self.declared
+            .iter()
+            .position(key)
+            .map(|index| (DeclarationId(index as u8), self.declared[index]))
+    }
+    fn admit(&self, id: DeclarationId, core: GuardCore) {
+        let instructions = self.cpus.get(core.get()).and_then(Weak::upgrade).and_then(|cpu| cpu.instruction_progress());
+        self.admitted[id.get()].set(Some(AdmittedAt { core, instructions }));
+        self.count(Counter::Admitted);
+    }
+    /// A guest TCM region write on `core`, offered before it applies.
+    fn tcm_write(&self, core: GuardCore, cpu: &dyn Cpu, bank: TcmBank, previous: u32, next: u32) -> Result<(), MutationRefusal> {
+        let (id, declaration) = self
+            .declaration(|declared| {
+                matches!(*declared, DeclaredMutation::TcmRegion { core: owner, bank: declared_bank, previous: TcmRegister(value), .. }
+                    if owner == core && declared_bank == bank && value == previous)
+            })
+            .ok_or(MutationRefusal::Undeclared)?;
+        let DeclaredMutation::TcmRegion { next: TcmRegister(declared_next), writer: WriterPc(writer), .. } = declaration else {
+            unreachable!("the selector matched a TCM declaration");
+        };
+        if self.admitted[id.get()].get().is_some() {
+            return Err(MutationRefusal::Consumed(id));
+        }
+        if declared_next != next {
+            return Err(MutationRefusal::Mismatch { declaration: id, field: DeclaredField::Next });
+        }
+        let (pc, cpsr) = scalar(cpu, Register::Pc)
+            .ok()
+            .zip(scalar(cpu, Register::Pstate).ok())
+            .ok_or(MutationRefusal::WriterUnresolved)?;
+        if cpsr & CPSR_THUMB != 0 {
+            return Err(MutationRefusal::WriterUnresolved);
+        }
+        // A deferred TCM write applies after `advance` moved PC past the MCR.
+        if pc.wrapping_sub(4) != u64::from(writer) {
+            return Err(MutationRefusal::Mismatch { declaration: id, field: DeclaredField::Writer });
+        }
+        let mut word = [0; 4];
+        cpu.read_memory(u64::from(writer), &mut word).map_err(|_| MutationRefusal::WriterUnresolved)?;
+        if u32::from_le_bytes(word) & TCM_REGION_MCR_MASK != TCM_REGION_MCR | (bank.opc2() << 5) {
+            return Err(MutationRefusal::Mismatch { declaration: id, field: DeclaredField::Instruction });
+        }
+        let window = tcm_window(next).map_err(|_| MutationRefusal::WriterUnresolved)?;
+        let mut windows = self.tcm[core.get()].get();
+        windows[bank.index()] = window;
+        self.tcm[core.get()].set(windows);
+        self.admit(id, core);
+        Ok(())
+    }
+    /// A processor mapping replacement on `core`; admitted only inside an open declared commit.
+    fn mapping(&self, core: GuardCore, address: u64, physical: Option<u64>, bytes: usize, permissions: Option<u32>) -> Result<(), MutationRefusal> {
+        let mut open = self.open.borrow_mut();
+        let commit = open.as_mut().ok_or(MutationRefusal::UnexpectedMapping)?;
+        let index = commit
+            .remaining
+            .iter()
+            .position(|map| {
+                map.core == core.get()
+                    && map.address == address
+                    && Some(map.physical) == physical
+                    && map.size == bytes
+                    && Some(map.permissions) == permissions
+            })
+            .ok_or(MutationRefusal::UnexpectedMapping)?;
+        commit.remaining.swap_remove(index);
+        Ok(())
+    }
+    /// A board transaction: a decoder commit or a keyframe restore.
+    fn board(&self, mutation: GuardMutation) -> Result<(), (Option<GuardCore>, MutationRefusal)> {
+        let GuardMutation::Decoder { decoder, previous, choice, writer } = mutation else {
+            return Err((None, MutationRefusal::Undeclared));
+        };
+        let writer_core = writer.and_then(|writer| GuardCore::new(writer.core).ok());
+        let refuse = |reason| Err((writer_core, reason));
+        if self.open.borrow().is_some() {
+            return refuse(MutationRefusal::CommitIncomplete);
+        }
+        let Some((id, declaration)) = self.declaration(|declared| {
+            matches!(*declared, DeclaredMutation::DecoderCommit { decoder: DecoderIndex(index), previous: DecoderChoice(from), .. }
+                if usize::from(index) == decoder && usize::from(from) == previous)
+        }) else {
+            return refuse(MutationRefusal::Undeclared);
+        };
+        let DeclaredMutation::DecoderCommit { next: DecoderChoice(next), core, writer: WriterPc(pc), .. } = declaration else {
+            unreachable!("the selector matched a decoder declaration");
+        };
+        if self.admitted[id.get()].get().is_some() {
+            return refuse(MutationRefusal::Consumed(id));
+        }
+        if usize::from(next) != choice {
+            return refuse(MutationRefusal::Mismatch { declaration: id, field: DeclaredField::Next });
+        }
+        let Some(writer) = writer else {
+            return refuse(MutationRefusal::Mismatch { declaration: id, field: DeclaredField::Writer });
+        };
+        if writer.core != core.get() {
+            return refuse(MutationRefusal::Mismatch { declaration: id, field: DeclaredField::WriterCore });
+        }
+        if writer.pc != u64::from(pc) {
+            return refuse(MutationRefusal::Mismatch { declaration: id, field: DeclaredField::Writer });
+        }
+        let remaining = self.tables.choices[decoder][choice].clone();
+        self.open.replace(Some(OpenCommit { declaration: id, decoder, choice, core, remaining }));
+        Ok(())
+    }
+    /// Moves the pinned views to the committed choice.
+    fn close(&self) -> Result<(), String> {
+        let Some(commit) = self.open.take() else {
+            return Ok(());
+        };
+        let mutation = GuardMutation::Decoder {
+            decoder: commit.decoder,
+            previous: self.tables.selected[commit.decoder].get(),
+            choice: commit.choice,
+            writer: None,
+        };
+        let incomplete = || {
+            self.record(GuardFault::Mutation { core: Some(commit.core), mutation, reason: MutationRefusal::CommitIncomplete });
+            Err("composite guard: a declared decoder commit was incomplete".to_string())
+        };
+        if !commit.remaining.is_empty() {
+            return incomplete();
+        }
+        let previous = self.tables.selected[commit.decoder].replace(commit.choice);
+        let views: Result<Vec<_>, _> = (0..self.cores).map(|core| self.tables.views(core)).collect();
+        let Ok(views) = views else {
+            self.tables.selected[commit.decoder].set(previous);
+            return incomplete();
+        };
+        for (slot, views) in self.views.iter().zip(views) {
+            slot.replace(views);
+        }
+        self.admit(commit.declaration, commit.core);
+        Ok(())
+    }
+    fn abort(&self) {
+        if let Some(commit) = self.open.take() {
+            let mutation = GuardMutation::Decoder {
+                decoder: commit.decoder,
+                previous: self.tables.selected[commit.decoder].get(),
+                choice: commit.choice,
+                writer: None,
+            };
+            self.record(GuardFault::Mutation { core: Some(commit.core), mutation, reason: MutationRefusal::CommitIncomplete });
+        }
+    }
+    /// Checks every chunk of a bulk transfer before its first copy.
+    pub(in crate::board) fn admit_bulk(
+        &self,
+        source: BulkWrite,
+        address: u64,
+        bytes: usize,
+        chunks: impl Iterator<Item = (u64, usize)>,
+    ) -> Result<(), String> {
+        if bytes == 0 {
+            return Ok(());
+        }
+        let source = WriteSource::from(source);
+        self.count(Counter::Write);
+        let (policy, _) = self.destinations(source, None);
+        for (physical, len) in chunks {
+            let location = GuardLocation { target: GuardTarget::Physical, address: physical };
+            let reason = match physical.checked_add(len as u64) {
+                Some(end) if permits(policy, GuardTarget::Physical, physical, end) => continue,
+                Some(_) => WriteFaultReason::Denied,
+                None => WriteFaultReason::Overflow,
+            };
+            self.record(GuardFault::Write {
+                source,
+                address,
+                bytes,
+                pc: None,
+                partition: None,
+                location: Some(location),
+                reason,
+                outcome: WriteOutcome::Refused,
+            });
+            return Err(format!("composite guard refused a {source:?} write of {bytes} bytes at {address:#x}"));
+        }
+        Ok(())
+    }
+    pub(in crate::board) fn operational(&self, source: BulkWrite, address: u64, bytes: usize, phase: FailurePhase) {
+        self.record(GuardFault::Operational { source: source.into(), address, bytes, phase });
+    }
+    /// The location of `cursor` on `core` and the end of its contiguous chunk below `end`.
+    fn resolve(&self, core: GuardCore, cursor: u64, end: u64) -> Option<(GuardLocation, u64)> {
+        let tcm = self.tcm[core.get()].get();
+        for (bank, window) in TcmBank::ALL.into_iter().zip(tcm) {
+            if let Some(window) = window
+                && window.base <= cursor
+                && cursor < window.end
+            {
+                let target = GuardTarget::Tcm { core, bank };
+                return Some((GuardLocation { target, address: cursor - window.base }, end.min(window.end)));
+            }
+        }
+        let views = self.views[core.get()].borrow();
+        let view = views.iter().find(|view| view.start <= cursor && cursor < view.end)?;
+        let next = tcm
+            .iter()
+            .flatten()
+            .filter(|window| cursor < window.base)
+            .fold(end.min(view.end), |next, window| next.min(window.base));
+        let address = view.physical + (cursor - view.start);
+        Some((GuardLocation { target: GuardTarget::Physical, address }, next))
+    }
+}
+fn slot(source: WriteSource, cores: usize) -> usize {
+    match source {
+        WriteSource::Cpu(core) => core.get(),
+        WriteSource::CoreHost(core) => cores + core.get(),
+        WriteSource::PhysicalHost => 2 * cores,
+        WriteSource::ModelBus => 2 * cores + 1,
+    }
+}
+/// `policy`'s lists are sorted by (target, start) and disjoint per target.
+fn permits(policy: &DestinationPolicy, target: GuardTarget, start: u64, end: u64) -> bool {
+    // The last range of `list` on `target` starting at or before `address`.
+    let at_or_before = |list: &[GuardRange], address: u64| {
+        let index = list.partition_point(|range| (range.target, range.span.start) <= (target, address));
+        index.checked_sub(1).map(|index| list[index]).filter(|range| range.target == target)
+    };
+    if start >= end {
+        return true;
+    }
+    if at_or_before(&policy.forbid, end - 1).is_some_and(|range| range.span.intersects(start, end)) {
+        return false;
+    }
+    let mut cursor = start;
+    while cursor < end {
+        match at_or_before(&policy.allow, cursor).filter(|range| range.span.holds(cursor)) {
+            Some(range) => cursor = range.span.end,
+            None => return false,
+        }
+    }
+    true
+}
+impl From<BulkWrite> for WriteSource {
+    fn from(source: BulkWrite) -> Self {
+        match source {
+            BulkWrite::Host => Self::PhysicalHost,
+            BulkWrite::ModelBus => Self::ModelBus,
+        }
+    }
+}
+
+type Denial = (WriteFaultReason, Option<GuardLocation>);
+struct GuardContext {
+    core: GuardCore,
+    cpu: Weak<dyn Cpu>,
+    latch: Rc<GuardLatch>,
+    pause: Rc<Cell<bool>>,
+}
+impl GuardContext {
+    fn admit(&self, policy: &DestinationPolicy, address: u64, bytes: usize) -> Result<(), Denial> {
+        let end = address
+            .checked_add(bytes as u64)
+            .filter(|&end| end <= ADDRESS_END)
+            .ok_or((WriteFaultReason::Overflow, None))?;
+        let mut cursor = address;
+        while cursor < end {
+            let (location, next) =
+                self.latch.resolve(self.core, cursor, end).ok_or((WriteFaultReason::Unresolved, None))?;
+            let chunk_end = location.address + (next - cursor);
+            if !permits(policy, location.target, location.address, chunk_end) {
+                return Err((WriteFaultReason::Denied, Some(location)));
+            }
+            cursor = next;
+        }
+        Ok(())
+    }
+    fn guest_write(&self, address: u64, size: i32) {
+        let Some(cpu) = self.cpu.upgrade().filter(|_| !self.latch.released.get()) else {
+            return;
+        };
+        let source = WriteSource::Cpu(self.core);
+        self.latch.count(Counter::Write);
+        let bytes = usize::try_from(size).unwrap_or(0);
+        let pc = scalar(&*cpu, Register::Pc).ok();
+        let (policy, partition) = self.latch.destinations(source, pc);
+        if let Some(partition) = partition {
+            self.latch.count_partition(self.core, partition);
+        }
+        let decision = if !GUEST_WIDTHS.contains(&bytes) {
+            Err((WriteFaultReason::InvalidWidth, None))
+        } else if pc.is_none() {
+            Err((WriteFaultReason::CpuInspection, None))
+        } else {
+            self.admit(policy, address, bytes)
+        };
+        let Err((reason, location)) = decision else {
+            return;
+        };
+        let outcome = if cpu.refuse_access().is_ok() {
+            WriteOutcome::Refused
+        } else {
+            self.pause.set(true);
+            let _ = cpu.stop();
+            WriteOutcome::Attempted
+        };
+        self.latch.record(GuardFault::Write { source, address, bytes, pc, partition, location, reason, outcome });
+    }
+    fn mutation(&self, event: CpuMutation) -> bool {
+        if self.latch.released.get() {
+            return true;
+        }
+        let decision = match event {
+            CpuMutation::HostWrite { address, bytes } => return self.host_write(address, bytes),
+            CpuMutation::Tcm { origin: MutationOrigin::Host, .. } => Err(MutationRefusal::HostOrigin),
+            CpuMutation::Tcm { register, previous, next, origin: MutationOrigin::Guest } => {
+                match (TcmBank::of(register), self.cpu.upgrade()) {
+                    (Some(bank), Some(cpu)) => self.latch.tcm_write(self.core, &*cpu, bank, previous, next),
+                    _ => Err(MutationRefusal::WriterUnresolved),
+                }
+            }
+            CpuMutation::Mapping { operation: MappingMutation::ReplacePhysical, address, physical, bytes, permissions } => {
+                self.latch.mapping(self.core, address, physical, bytes, permissions)
+            }
+            CpuMutation::Mapping { .. } => Err(MutationRefusal::UnexpectedMapping),
+            _ => Err(MutationRefusal::Undeclared),
+        };
+        match decision {
+            Ok(()) => true,
+            Err(reason) => {
+                self.latch.refuse(Some(self.core), GuardMutation::Cpu(event), reason);
+                false
+            }
+        }
+    }
+    fn host_write(&self, address: u64, bytes: usize) -> bool {
+        let source = WriteSource::CoreHost(self.core);
+        self.latch.count(Counter::Write);
+        let (policy, _) = self.latch.destinations(source, None);
+        let Err((reason, location)) = self.admit(policy, address, bytes) else {
+            return true;
+        };
+        self.latch.record(GuardFault::Write {
+            source,
+            address,
+            bytes,
+            pc: None,
+            partition: None,
+            location,
+            reason,
+            outcome: WriteOutcome::Refused,
+        });
+        false
+    }
+}
+unsafe fn mutation(event: CpuMutation, data: *mut c_void) -> bool {
+    // SAFETY: `data` is a `GuardContext` its lease keeps until this hook is removed.
+    let context = unsafe { &*data.cast::<GuardContext>() };
+    context.mutation(event)
+}
+unsafe fn guest_write(access: Access, address: u64, size: i32, _value: i64, data: *mut c_void) {
+    // SAFETY: `data` is a `GuardContext` its lease keeps until this hook is removed.
+    let context = unsafe { &*data.cast::<GuardContext>() };
+    if access == Access::Write {
+        context.guest_write(address, size);
+    }
+}
+
+/// Owns guard contexts and hooks. Dropping it with a hook still installed
+/// hands both to the board instead of freeing the contexts.
+pub(super) struct GuardLease {
+    latch: Rc<GuardLatch>,
+    owner: Weak<Memory>,
+    cleanup_failed: Rc<Cell<bool>>,
+    contexts: Vec<Box<GuardContext>>,
+    hooks: Vec<(Weak<dyn Cpu>, HookId)>,
+}
+impl GuardLease {
+    /// Keeps every hook whose removal failed or was not reached.
+    pub(super) fn remove(&mut self) -> Result<(), String> {
+        let result = super::lifecycle::remove_hooks(&mut self.hooks, |(cpu, hook)| {
+            cpu.upgrade().map_or(Ok(()), |cpu| cpu.remove_hook(*hook))
+        });
+        match &result {
+            Ok(()) => {
+                self.latch.end();
+                if let Some(memory) = self.owner.upgrade() {
+                    memory.observers.clear_guard(&self.latch);
+                }
+            }
+            Err(_) => {
+                self.latch.cleanup_failed();
+                self.cleanup_failed.set(true);
+            }
+        }
+        result
+    }
+}
+impl Drop for GuardLease {
+    fn drop(&mut self) {
+        if self.hooks.is_empty() || self.remove().is_ok() {
+            return;
+        }
+        if let Some(memory) = self.owner.upgrade() {
+            memory
+                .observers
+                .retain(Box::new((std::mem::take(&mut self.contexts), std::mem::take(&mut self.hooks))));
+        }
+    }
+}
+
+/// Sorts both lists by (target, start), as `permits` requires.
+fn validate_destinations(
+    policy: &mut DestinationPolicy,
+    source: WriteSource,
+    cores: usize,
+) -> Result<(), GuardAttachError> {
+    for list in [&mut policy.allow, &mut policy.forbid] {
+        for range in list.iter() {
+            match (range.target, source) {
+                (GuardTarget::Physical, _) => (),
+                (GuardTarget::Tcm { core, .. }, WriteSource::Cpu(owner) | WriteSource::CoreHost(owner))
+                    if core == owner && core.get() < cores => {}
+                (GuardTarget::Tcm { .. }, _) => return Err(GuardAttachError::InvalidTarget),
+            }
+        }
+        list.sort_unstable_by_key(|range| (range.target, range.span.start));
+        if list.windows(2).any(|pair| pair[0].target == pair[1].target && pair[1].span.start < pair[0].span.end) {
+            return Err(GuardAttachError::AmbiguousRanges);
+        }
+        list.shrink_to_fit();
+    }
+    Ok(())
+}
+fn retained_bytes<T>(list: &Vec<T>) -> Option<usize> {
+    list.capacity().checked_mul(size_of::<T>())
+}
+fn policy_lists(policy: &SourcePolicy) -> impl Iterator<Item = &DestinationPolicy> {
+    std::iter::once(&policy.destinations).chain(policy.partitions.iter().map(|partition| &partition.destinations))
+}
+struct ValidatedConfig {
+    /// Indexed by `slot`.
+    policies: Vec<SourcePolicy>,
+    /// Per `Cpu` core: partition spans sorted by start.
+    partition_spans: Vec<Vec<(GuardSpan, PartitionId)>>,
+    declared: Vec<DeclaredMutation>,
+}
+impl CompositeGuardConfig {
+    /// Returns the policies indexed by `slot`.
+    fn validate(self, cores: usize) -> Result<ValidatedConfig, GuardAttachError> {
+        use GuardAttachError::*;
+        if cores == 0 || cores > MAX_GUARD_CORES {
+            return Err(InvalidCore);
+        }
+        let expected = 2 * cores + 2;
+        let (mut ranges, mut pc_spans) = (0usize, 0usize);
+        for policy in &self.sources {
+            for destinations in policy_lists(policy) {
+                ranges = ranges
+                    .checked_add(destinations.allow.len())
+                    .and_then(|n| n.checked_add(destinations.forbid.len()))
+                    .ok_or(BoundExceeded)?;
+            }
+            for partition in &policy.partitions {
+                pc_spans = pc_spans.checked_add(partition.spans.len()).ok_or(BoundExceeded)?;
+            }
+        }
+        if self.sources.len() > expected
+            || ranges > MAX_GUARD_RANGES
+            || pc_spans > MAX_GUARD_PC_SPANS
+            || self.declared.len() > MAX_GUARD_DECLARED_MUTATIONS
+            || self.sources.iter().any(|policy| policy.partitions.len() > MAX_GUARD_PARTITIONS)
+        {
+            return Err(BoundExceeded);
+        }
+        for (index, declared) in self.declared.iter().enumerate() {
+            if self.declared[..index].contains(declared) {
+                return Err(DuplicateDeclaration);
+            }
+            let (core, unchanged) = match *declared {
+                DeclaredMutation::TcmRegion { core, previous, next, .. } => (core, previous == next),
+                DeclaredMutation::DecoderCommit { core, previous, next, .. } => (core, previous == next),
+            };
+            if core.get() >= cores || unchanged {
+                return Err(InvalidDeclaration);
+            }
+        }
+        let mut slots: Vec<Option<SourcePolicy>> = (0..expected).map(|_| None).collect();
+        let mut partition_spans: Vec<Vec<(GuardSpan, PartitionId)>> = vec![Vec::new(); cores];
+        for mut policy in self.sources {
+            if let WriteSource::Cpu(core) | WriteSource::CoreHost(core) = policy.source
+                && core.get() >= cores
+            {
+                return Err(InvalidCore);
+            }
+            validate_destinations(&mut policy.destinations, policy.source, cores)?;
+            if !policy.partitions.is_empty() {
+                let WriteSource::Cpu(core) = policy.source else {
+                    return Err(InvalidPartition);
+                };
+                let spans = &mut partition_spans[core.get()];
+                for (index, partition) in policy.partitions.iter_mut().enumerate() {
+                    if partition.spans.is_empty() {
+                        return Err(InvalidPartition);
+                    }
+                    let id = PartitionId(u16::try_from(index).map_err(|_| BoundExceeded)?);
+                    spans.extend(partition.spans.iter().map(|span| (*span, id)));
+                    partition.spans.shrink_to_fit();
+                    validate_destinations(&mut partition.destinations, policy.source, cores)?;
+                }
+                spans.sort_unstable_by_key(|(span, _)| span.start);
+                if spans.windows(2).any(|pair| pair[1].0.start < pair[0].0.end) {
+                    return Err(PartitionOverlap);
+                }
+                spans.shrink_to_fit();
+            }
+            policy.partitions.shrink_to_fit();
+            if slots[slot(policy.source, cores)].replace(policy).is_some() {
+                return Err(DuplicateSource);
+            }
+        }
+        let policies = slots.into_iter().collect::<Option<Vec<_>>>().ok_or(MissingSource)?;
+        let mut bytes = retained_bytes(&policies)
+            .zip(retained_bytes(&partition_spans))
+            .and_then(|(a, b)| a.checked_add(b))
+            .ok_or(BoundExceeded)?;
+        for spans in &partition_spans {
+            bytes = retained_bytes(spans).and_then(|n| bytes.checked_add(n)).ok_or(BoundExceeded)?;
+        }
+        for policy in &policies {
+            bytes = retained_bytes(&policy.partitions).and_then(|n| bytes.checked_add(n)).ok_or(BoundExceeded)?;
+            for partition in &policy.partitions {
+                bytes = retained_bytes(&partition.spans).and_then(|n| bytes.checked_add(n)).ok_or(BoundExceeded)?;
+            }
+            for destinations in policy_lists(policy) {
+                for list in [&destinations.allow, &destinations.forbid] {
+                    bytes = retained_bytes(list).and_then(|n| bytes.checked_add(n)).ok_or(BoundExceeded)?;
+                }
+            }
+        }
+        if bytes > MAX_GUARD_BYTES {
+            return Err(BoundExceeded);
+        }
+        Ok(ValidatedConfig { policies, partition_spans, declared: self.declared })
+    }
+}
+/// The window a TCM region register value maps, absent when disabled.
+fn tcm_window(register: u32) -> Result<Option<TcmWindow>, GuardAttachError> {
+    if register & 1 == 0 {
+        return Ok(None);
+    }
+    let base = u64::from(register & 0xffff_f000);
+    let end = (512u64 << ((register >> 2) & 31))
+        .checked_add(base)
+        .filter(|&end| end <= ADDRESS_END)
+        .ok_or(GuardAttachError::InvalidMapping)?;
+    Ok(Some(TcmWindow { base, end }))
+}
+fn tcm_registers(cpu: &dyn Cpu) -> Result<[u32; 2], GuardAttachError> {
+    let mut registers = [0; 2];
+    for (bank, register) in TcmBank::ALL.into_iter().zip(&mut registers) {
+        *register = cpu
+            .coprocessor(bank.register(), None)
+            .ok()
+            .and_then(|value| u32::try_from(value).ok())
+            .ok_or(GuardAttachError::CpuInspection)?;
+    }
+    Ok(registers)
+}
+/// Requires the declarations of each key to form one chain from `start(key)`.
+fn check_chains<K: PartialEq + Copy>(
+    declared: &[DeclaredMutation],
+    key: impl Fn(&DeclaredMutation) -> Option<(K, u32, u32)>,
+    start: impl Fn(K) -> Result<u32, GuardAttachError>,
+) -> Result<(), GuardAttachError> {
+    let links: Vec<(K, u32, u32)> = declared.iter().filter_map(&key).collect();
+    for (index, &(owner, previous, _)) in links.iter().enumerate() {
+        if links[..index].iter().any(|&(other, from, _)| other == owner && from == previous) {
+            return Err(GuardAttachError::DeclarationChain);
+        }
+    }
+    let mut visited = vec![false; links.len()];
+    for &(owner, _, _) in &links {
+        let mut cursor = start(owner)?;
+        while let Some(index) = links.iter().position(|&(other, from, _)| other == owner && from == cursor) {
+            if visited[index] {
+                break;
+            }
+            visited[index] = true;
+            cursor = links[index].2;
+        }
+    }
+    if visited.iter().all(|&seen| seen) { Ok(()) } else { Err(GuardAttachError::DeclarationChain) }
+}
+impl Board {
+    fn view_tables(&self, state: &State) -> Result<ViewTables, GuardAttachError> {
+        let (selected, choices) = state.decoders.guard_tables();
+        let mut mmio = vec![Vec::new(); self.cpus.len()];
+        for (binding, &(owner, address, bytes)) in self.bindings[self.cpus.len()..].iter().zip(&self.mmio) {
+            let end = address.checked_add(bytes as u64).filter(|&end| bytes != 0 && end <= ADDRESS_END);
+            let views: &mut Vec<PinnedView> = mmio.get_mut(owner).ok_or(GuardAttachError::InvalidMapping)?;
+            views.push(PinnedView { start: address, end: end.ok_or(GuardAttachError::InvalidMapping)?, physical: binding.base });
+        }
+        let maps = choices.iter().flatten().map(Vec::len).sum::<usize>() + self.mappings.len();
+        if maps.checked_mul(size_of::<MemoryMap>()).is_none_or(|bytes| bytes > MAX_GUARD_BYTES) {
+            return Err(GuardAttachError::BoundExceeded);
+        }
+        Ok(ViewTables { graph: self.mappings.clone(), choices, selected: selected.into_iter().map(Cell::new).collect(), mmio })
+    }
+    /// Attach write and mutation admission to the current classified watch,
+    /// keeping its records, classes, fetch capture, bounds and hooks.
+    pub fn memory_guard_attach(
+        &self,
+        watch: &mut MemoryWatch,
+        config: CompositeGuardConfig,
+    ) -> Result<GuardStatusToken, GuardAttachError> {
+        use GuardAttachError::*;
+        let state = self.state.try_borrow_mut().map_err(|_| NotPaused)?;
+        if state.active_slice.is_some() || state.parallel.is_some() || state.memory_access {
+            return Err(NotPaused);
+        }
+        if state.decoders.pending() {
+            return Err(PendingDecode);
+        }
+        let observers = &self.physical_memory.observers;
+        if observers.cleanup_failed.get() {
+            return Err(CleanupFailed);
+        }
+        if state.execution_policy != ExecutionPolicy::Exact
+            || self
+                .cpus
+                .iter()
+                .any(|cpu| cpu.model() != Model::CortexR5F || !cpu.supports_mutation_observation())
+        {
+            return Err(UnsupportedBackend);
+        }
+        if observers.journal_active() {
+            return Err(MutationJournal);
+        }
+        let fixed_views = {
+            let records = watch.records.borrow();
+            if !records.lease.owned_by(&self.physical_memory) {
+                return Err(WrongOwner);
+            }
+            if records.lease.cleanup_failed {
+                return Err(CleanupFailed);
+            }
+            if records.lease.phase != LeasePhase::Armed {
+                return Err(DeadWatch);
+            }
+            if records.lease.guard.is_some() || observers.guard().is_some() {
+                return Err(AlreadyAttached);
+            }
+            if records.classes.is_empty() {
+                return Err(NotClassified);
+            }
+            records.views == ViewPolicy::Fixed
+        };
+        let current = self
+            .physical_memory
+            .observation
+            .borrow()
+            .as_ref()
+            .and_then(Weak::upgrade)
+            .is_some_and(|current| Rc::ptr_eq(&current, &watch.records));
+        if !current {
+            return Err(NotCurrent);
+        }
+        if observers.live_watches() != 1 {
+            return Err(SiblingWatch);
+        }
+        let cores = self.cpus.len();
+        let validated = config.validate(cores)?;
+        let tables = self.view_tables(&state)?;
+        let registers = self.cpus.iter().map(|cpu| tcm_registers(&**cpu)).collect::<Result<Vec<_>, _>>()?;
+        for declared in &validated.declared {
+            if let DeclaredMutation::DecoderCommit { decoder: DecoderIndex(decoder), previous, next, .. } = *declared {
+                let choices = tables.choices.get(usize::from(decoder)).ok_or(InvalidDeclaration)?;
+                if [previous, next].iter().any(|&DecoderChoice(choice)| usize::from(choice) >= choices.len()) {
+                    return Err(InvalidDeclaration);
+                }
+                if fixed_views {
+                    return Err(FixedViewsWithDeclaredCommit);
+                }
+            }
+        }
+        check_chains(
+            &validated.declared,
+            |declared| match *declared {
+                DeclaredMutation::TcmRegion { core, bank, previous: TcmRegister(from), next: TcmRegister(to), .. } => {
+                    Some(((core, bank), from, to))
+                }
+                DeclaredMutation::DecoderCommit { .. } => None,
+            },
+            |(core, bank)| Ok(registers[core.get()][bank.index()]),
+        )?;
+        check_chains(
+            &validated.declared,
+            |declared| match *declared {
+                DeclaredMutation::DecoderCommit { decoder, previous: DecoderChoice(from), next: DecoderChoice(to), .. } => {
+                    Some((decoder, u32::from(from), u32::from(to)))
+                }
+                DeclaredMutation::TcmRegion { .. } => None,
+            },
+            |DecoderIndex(decoder)| {
+                let selected = tables.selected.get(usize::from(decoder)).ok_or(InvalidDeclaration)?;
+                u32::try_from(selected.get()).map_err(|_| InvalidDeclaration)
+            },
+        )?;
+        let mut tcm = Vec::with_capacity(cores);
+        let mut views = Vec::with_capacity(cores);
+        for (core, registers) in registers.iter().enumerate() {
+            tcm.push(Cell::new([tcm_window(registers[0])?, tcm_window(registers[1])?]));
+            views.push(RefCell::new(tables.views(core)?));
+        }
+        let partition_checks = (0..cores)
+            .map(|core| validated.policies[core].partitions.iter().map(|_| Cell::new(0)).collect())
+            .collect();
+        let latch = Rc::new(GuardLatch {
+            policies: validated.policies,
+            partition_spans: validated.partition_spans,
+            partition_checks,
+            cores,
+            cpus: self.cpus.iter().map(Rc::downgrade).collect(),
+            admitted: validated.declared.iter().map(|_| Cell::new(None)).collect(),
+            declared: validated.declared,
+            tcm,
+            views,
+            tables,
+            open: RefCell::new(None),
+            report: Cell::new(GuardReport {
+                status: GuardStatus::Armed,
+                first_fault: None,
+                write_checks: 0,
+                mutation_attempts: 0,
+                mutations_admitted: 0,
+            }),
+            released: Cell::new(false),
+        });
+        let mut contexts = Vec::with_capacity(cores);
+        for (core, cpu) in self.cpus.iter().enumerate() {
+            contexts.push(Box::new(GuardContext {
+                core: GuardCore::new(core)?,
+                cpu: Rc::downgrade(cpu),
+                latch: latch.clone(),
+                pause: self.host_pause.clone(),
+            }));
+        }
+        drop(state);
+        let mut lease = GuardLease {
+            latch,
+            owner: Rc::downgrade(&self.physical_memory),
+            cleanup_failed: observers.cleanup_failed.clone(),
+            contexts,
+            hooks: Vec::with_capacity(2 * cores),
+        };
+        for (core, cpu) in self.cpus.iter().enumerate() {
+            let context = &*lease.contexts[core];
+            let guard_core = context.core;
+            let data = (context as *const GuardContext).cast_mut().cast();
+            let hooks = [
+                (GuardHook::Mutation, Hook::Mutation { callback: mutation, data }),
+                (
+                    GuardHook::Write,
+                    Hook::Memory { callback: guest_write, data, read: false, write: true, range: HookRange::All },
+                ),
+            ];
+            for (kind, hook) in hooks {
+                // SAFETY: the lease keeps the boxed context until this hook is removed.
+                match unsafe { cpu.install_hook(hook) } {
+                    Ok(id) => lease.hooks.push((Rc::downgrade(cpu), id)),
+                    Err(_) => {
+                        if lease.remove().is_ok() {
+                            return Err(HookInstallation { core: guard_core, hook: kind });
+                        }
+                        observers.set_guard(&lease.latch);
+                        watch.records.borrow_mut().lease.guard = Some(lease);
+                        return Err(CleanupFailed);
+                    }
+                }
+            }
+        }
+        observers.set_guard(&lease.latch);
+        let token = GuardStatusToken(lease.latch.clone());
+        watch.records.borrow_mut().lease.guard = Some(lease);
+        Ok(token)
+    }
+}
+impl Memory {
+    /// Offers a board transaction to the mutation journal, then to the guard,
+    /// which refuses it before its first effect unless it is declared.
+    pub(in crate::board) fn admit_transaction(&self, mutation: GuardMutation) -> Result<(), String> {
+        self.observers.journal_board(mutation);
+        let Some(guard) = self.observers.guard() else {
+            return Ok(());
+        };
+        if guard.released.get() {
+            return Ok(());
+        }
+        guard.board(mutation).map_err(|(core, reason)| {
+            guard.refuse(core, mutation, reason);
+            format!("composite guard refused {mutation:?}: {reason:?}")
+        })
+    }
+    /// Ends an admitted decoder commit after every map and DMA view of its choice applied.
+    pub(in crate::board) fn close_transaction(&self) -> Result<(), String> {
+        self.observers.guard().map_or(Ok(()), |guard| guard.close())
+    }
+    /// Faults the open declared commit as incomplete.
+    pub(in crate::board) fn abort_transaction(&self) {
+        if let Some(guard) = self.observers.guard() {
+            guard.abort();
+        }
+    }
+}
