+/// Successful calls left before every later call fails; `None` never fails.
+#[derive(Default)]
+struct Faults {
+    installs: Cell<Option<usize>>,
+    removals: Cell<Option<usize>>,
+}
+impl Faults {
+    fn fails(budget: &Cell<Option<usize>>) -> bool {
+        match budget.get() {
+            None => false,
+            Some(0) => true,
+            Some(left) => {
+                budget.set(Some(left - 1));
+                false
+            }
+        }
+    }
+    fn clear(&self) {
+        self.installs.set(None);
+        self.removals.set(None);
+    }
+}
