+fn core(index: usize) -> GuardCore {
+    GuardCore::new(index).unwrap()
+}
+fn range(target: GuardTarget, start: u64, end: u64) -> GuardRange {
+    GuardRange { target, span: GuardSpan::new(start, end).unwrap() }
+}
+fn physical(start: u64, end: u64) -> GuardRange {
+    range(GuardTarget::Physical, start, end)
+}
+fn every_source(cores: usize) -> Vec<WriteSource> {
+    let mut sources: Vec<_> = (0..cores).flat_map(|index| [WriteSource::Cpu(core(index)), WriteSource::CoreHost(core(index))]).collect();
+    sources.extend([WriteSource::PhysicalHost, WriteSource::ModelBus]);
+    sources
+}
+/// Every physical address, and both TCM banks of a core source.
+fn open(source: WriteSource) -> DestinationPolicy {
+    let mut allow = vec![physical(0, ADDRESS_END)];
+    if let WriteSource::Cpu(owner) | WriteSource::CoreHost(owner) = source {
+        allow.extend(TcmBank::ALL.map(|bank| range(GuardTarget::Tcm { core: owner, bank }, 0, 0x1000)));
+    }
+    DestinationPolicy { allow, forbid: vec![] }
+}
+fn config(policy: impl Fn(WriteSource) -> DestinationPolicy) -> CompositeGuardConfig {
+    let sources =
+        every_source(2).into_iter().map(|source| SourcePolicy { source, destinations: policy(source), owned_pc: None });
+    CompositeGuardConfig { sources: sources.collect() }
+}
+fn forbidding(denied: WriteSource, forbidden: GuardRange) -> CompositeGuardConfig {
+    config(|source| {
+        let mut policy = open(source);
+        if source == denied {
+            policy.forbid.push(forbidden);
+        }
+        policy
+    })
+}
+fn classes() -> Vec<WatchRange> {
+    vec![WatchRange { start: 0x40000, end: 0x40100, kinds: WatchKinds::WRITES }]
+}
+fn watch(board: &Board, limit: usize) -> Box<MemoryWatch> {
+    board.memory_watch_begin_classified(classes(), limit, board.mappings().to_vec(), ViewPolicy::Observe).unwrap()
+}
+fn rows(watch: &MemoryWatch) -> Vec<serde_json::Value> {
+    watch.records.borrow().state()["records"].as_array().unwrap().clone()
+}
+fn program(board: &Board, core: usize, at: u64, value: u64, target: u64) {
+    let code: Vec<u8> = STORE.iter().flat_map(|word| word.to_le_bytes()).collect();
+    board.write_memory(core, at, &code).unwrap();
+    board.write_register(core, Register::Pc, at).unwrap();
+    board.write_register(core, arm::CORE[0], value).unwrap();
+    board.write_register(core, arm::CORE[1], target).unwrap();
+}
+fn word(board: &Board, core: usize, address: u64) -> u32 {
+    let mut bytes = [0; 4];
+    board.read_memory(core, address, &mut bytes).unwrap();
+    u32::from_le_bytes(bytes)
+}
+fn physical_word(board: &Board, address: u64) -> u32 {
+    let mut bytes = [0; 4];
+    board.inspect_physical(address, &mut bytes).unwrap();
+    u32::from_le_bytes(bytes)
+}
+fn tcm_register(board: &Board, core: usize, bank: TcmBank) -> u64 {
+    board.cpu(core).unwrap().coprocessor(bank.register(), None).unwrap()
+}
+fn outcome(board: &Board, core: usize) -> WriteOutcome {
+    if board.cpu(core).unwrap().features().access_refusal { WriteOutcome::Refused } else { WriteOutcome::Attempted }
+}
+fn denied(source: WriteSource, address: u64, bytes: usize, pc: Option<u64>, location: GuardLocation, outcome: WriteOutcome) -> Option<GuardFault> {
+    Some(GuardFault::Write { source, address, bytes, pc, location: Some(location), reason: WriteFaultReason::Denied, outcome })
+}
+fn at(target: GuardTarget, address: u64) -> GuardLocation {
+    GuardLocation { target, address }
+}
+fn mutation_fault(core: Option<GuardCore>, mutation: GuardMutation) -> Option<GuardFault> {
+    Some(GuardFault::Mutation { core, mutation })
+}
+/// A guest store that `forbidding` denied: it either did not happen and the
+/// run failed, or it was attempted and the board paused at it.
+fn assert_guest_denial(board: &Board, result: Result<(), String>, address: u64, value: u32, before: u32) {
+    match outcome(board, 0) {
+        WriteOutcome::Refused => {
+            assert!(result.is_err());
+            assert_eq!(physical_word(board, address), before);
+        }
+        WriteOutcome::Attempted => {
+            result.unwrap();
+            assert_eq!(physical_word(board, address), value);
+        }
+    }
+}
