+//! Hook ownership for memory watches, instruction points and guards. A failed
+//! removal keeps the hook's identity and context and blocks board execution.
+use super::{
+    Board, MemoryWatch,
+    composite::{GuardLatch, GuardLease},
+};
+use crate::board::memory::Memory;
+use std::{
+    any::Any,
+    cell::{Cell, RefCell},
+    rc::{Rc, Weak},
+};
+
+/// Observation lifecycle state of one board, owned by its physical memory.
+#[derive(Default)]
+pub(in crate::board) struct ObservationRegistry {
+    /// The same cell as `State::observation_cleanup_failed`.
+    pub(in crate::board) cleanup_failed: Rc<Cell<bool>>,
+    /// Armed legacy and classified watches whose end has not completed.
+    live_watches: Cell<usize>,
+    guard: RefCell<Option<Weak<GuardLatch>>>,
+    /// Callback contexts of hooks that may still be installed. Processors
+    /// drop before the board's memory.
+    retained: RefCell<Vec<Box<dyn Any>>>,
+}
+impl ObservationRegistry {
+    pub(in crate::board) fn guard(&self) -> Option<Rc<GuardLatch>> {
+        self.guard.borrow().as_ref().and_then(Weak::upgrade)
+    }
+    pub(super) fn set_guard(&self, latch: &Rc<GuardLatch>) {
+        self.guard.replace(Some(Rc::downgrade(latch)));
+    }
+    pub(super) fn clear_guard(&self, latch: &Rc<GuardLatch>) {
+        let mut slot = self.guard.borrow_mut();
+        if slot.as_ref().is_some_and(|current| Weak::ptr_eq(current, &Rc::downgrade(latch))) {
+            *slot = None;
+        }
+    }
+    pub(super) fn live_watches(&self) -> usize {
+        self.live_watches.get()
+    }
+    pub(super) fn retain(&self, contexts: Box<dyn Any>) {
+        self.cleanup_failed.set(true);
+        self.retained.borrow_mut().push(contexts);
+    }
+}
+
+/// Removes `hooks` in order, keeping the first one that fails and every later one.
+pub(super) fn remove_hooks<T>(
+    hooks: &mut Vec<T>,
+    mut remove: impl FnMut(&T) -> Result<(), String>,
+) -> Result<(), String> {
+    let mut removed = 0;
+    let result = hooks.iter().try_for_each(|hook| {
+        remove(hook)?;
+        removed += 1;
+        Ok(())
+    });
+    hooks.drain(..removed);
+    result
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(super) enum LeasePhase {
+    /// Begun, hooks not yet complete.
+    #[default]
+    Pending,
+    Armed,
+    Ended,
+}
+/// Lifecycle of the watch that owns these records.
+#[derive(Default)]
+pub(super) struct WatchLease {
+    owner: Weak<Memory>,
+    pub(super) phase: LeasePhase,
+    pub(super) cleanup_failed: bool,
+    pub(super) guard: Option<GuardLease>,
+}
+impl WatchLease {
+    pub(super) fn new(owner: &Rc<Memory>) -> Self {
+        Self { owner: Rc::downgrade(owner), ..Self::default() }
+    }
+    pub(super) fn owned_by(&self, memory: &Rc<Memory>) -> bool {
+        Weak::ptr_eq(&self.owner, &Rc::downgrade(memory))
+    }
+    pub(super) fn arm(&mut self) {
+        self.phase = LeasePhase::Armed;
+        if let Some(memory) = self.owner.upgrade() {
+            let live = &memory.observers.live_watches;
+            live.set(live.get() + 1);
+        }
+    }
+    fn fail(&mut self, owner: Option<&Rc<Memory>>) {
+        self.cleanup_failed = true;
+        if let Some(memory) = owner {
+            memory.observers.cleanup_failed.set(true);
+        }
+    }
+}
+
+impl MemoryWatch {
+    /// Ends classified then guard registrations. A failure leaves the
+    /// remaining hooks and the guard attached.
+    fn release(&mut self) -> Result<(), String> {
+        let owner = self.records.borrow().lease.owner.upgrade();
+        let contexts = &self.contexts;
+        let classified = remove_hooks(&mut self.hooks, |&(core, hook)| {
+            match contexts.iter().find(|context| context.core == core) {
+                Some(context) => context.cpu.upgrade().map_or(Ok(()), |cpu| cpu.remove_hook(hook)),
+                None => Err("memory watch hook has no processor context".into()),
+            }
+        });
+        if let Err(error) = classified {
+            self.records.borrow_mut().lease.fail(owner.as_ref());
+            return Err(error);
+        }
+        let guard = self.records.borrow_mut().lease.guard.take();
+        if let Some(mut guard) = guard
+            && let Err(error) = guard.remove()
+        {
+            let mut records = self.records.borrow_mut();
+            records.lease.fail(owner.as_ref());
+            records.lease.guard = Some(guard);
+            return Err(error);
+        }
+        let ended = {
+            let mut records = self.records.borrow_mut();
+            let armed = records.lease.phase == LeasePhase::Armed;
+            records.lease.phase = LeasePhase::Ended;
+            armed
+        };
+        if let Some(memory) = owner {
+            if ended {
+                let live = &memory.observers.live_watches;
+                live.set(live.get().saturating_sub(1));
+            }
+            let mut slot = memory.observation.borrow_mut();
+            if slot.as_ref().and_then(Weak::upgrade).is_some_and(|current| Rc::ptr_eq(&current, &self.records)) {
+                *slot = None;
+            }
+        }
+        Ok(())
+    }
+}
+impl Drop for MemoryWatch {
+    fn drop(&mut self) {
+        if self.release().is_ok() || self.hooks.is_empty() {
+            return;
+        }
+        let owner = self.records.borrow().lease.owner.upgrade();
+        if let Some(memory) = owner {
+            memory
+                .observers
+                .retain(Box::new((std::mem::take(&mut self.contexts), std::mem::take(&mut self.hooks))));
+        }
+    }
+}
+impl Board {
+    pub(super) fn refuse_watch_replacement(&self) -> Result<(), String> {
+        if self.physical_memory.observers.guard().is_some() {
+            return Err("A composite guard is attached to the current memory watch".into());
+        }
+        Ok(())
+    }
+    /// Ends `watch` as one operation, clearing the observation slot only when
+    /// it still names this watch.
+    pub(super) fn memory_watch_release(&self, watch: &mut MemoryWatch) -> Result<(), String> {
+        if !watch.records.borrow().lease.owned_by(&self.physical_memory) {
+            return Err("memory watch belongs to a different board".into());
+        }
+        watch.release()
+    }
+}
