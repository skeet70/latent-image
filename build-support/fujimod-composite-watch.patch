+++ b/crates/emulator/src/board/observation/journal.rs
@@ -0,0 +1,173 @@
+//! A recording of every CPU and board mutation transaction, admitted as it is
+//! offered. It cannot run beside a composite guard.
+use super::{Board, composite::GuardMutation, lifecycle::remove_hooks};
+use crate::board::{memory::Memory, scalar};
+use fujimod_emulator_cpu::{Cpu, CpuMutation, Hook, HookId, MutationOrigin, Register};
+use std::{
+    cell::{Cell, RefCell},
+    ffi::c_void,
+    rc::{Rc, Weak},
+};
+
+pub const MAX_JOURNAL_ROWS: usize = 4096;
+const CPSR_THUMB: u64 = 0x20;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct MutationRow {
+    /// The offering core for a CPU row; the selecting core for a decoder row.
+    pub core: Option<usize>,
+    pub mutation: GuardMutation,
+    /// PC at dispatch; absent for board rows.
+    pub pc: Option<u64>,
+    pub cpsr: Option<u32>,
+    /// The requesting instruction as the guard derives it: PC minus 4 for an
+    /// A32 guest TCM write, the selecting store for a decoder commit.
+    pub writer: Option<u64>,
+    /// The offering core's entered instruction count; absent for board rows.
+    pub instructions: Option<u64>,
+}
+
+pub(super) struct JournalLatch {
+    rows: RefCell<Vec<MutationRow>>,
+    limit: usize,
+    overflow: Cell<bool>,
+}
+impl JournalLatch {
+    fn push(&self, row: MutationRow) {
+        let mut rows = self.rows.borrow_mut();
+        if rows.len() == self.limit {
+            self.overflow.set(true);
+        } else {
+            rows.push(row);
+        }
+    }
+    pub(super) fn board(&self, mutation: GuardMutation) {
+        let writer = match mutation {
+            GuardMutation::Decoder { writer, .. } => writer,
+            _ => None,
+        };
+        self.push(MutationRow {
+            core: writer.map(|writer| writer.core),
+            mutation,
+            pc: None,
+            cpsr: None,
+            writer: writer.map(|writer| writer.pc),
+            instructions: None,
+        });
+    }
+}
+struct JournalContext {
+    core: usize,
+    cpu: Weak<dyn Cpu>,
+    latch: Rc<JournalLatch>,
+}
+unsafe fn record(event: CpuMutation, data: *mut c_void) -> bool {
+    // SAFETY: `data` is a `JournalContext` its journal keeps until this hook is removed.
+    let context = unsafe { &*data.cast::<JournalContext>() };
+    let cpu = context.cpu.upgrade();
+    let pc = cpu.as_ref().and_then(|cpu| scalar(&**cpu, Register::Pc).ok());
+    let cpsr = cpu.as_ref().and_then(|cpu| scalar(&**cpu, Register::Pstate).ok());
+    let writer = match event {
+        CpuMutation::Tcm { origin: MutationOrigin::Guest, .. } => {
+            pc.zip(cpsr).filter(|&(_, cpsr)| cpsr & CPSR_THUMB == 0).map(|(pc, _)| pc.wrapping_sub(4))
+        }
+        _ => None,
+    };
+    context.latch.push(MutationRow {
+        core: Some(context.core),
+        mutation: GuardMutation::Cpu(event),
+        pc,
+        cpsr: cpsr.and_then(|cpsr| u32::try_from(cpsr).ok()),
+        writer,
+        instructions: cpu.and_then(|cpu| cpu.instruction_progress()),
+    });
+    true
+}
+
+/// Dropping it with a hook still installed hands the hooks and contexts to the board.
+pub struct MutationJournal {
+    latch: Rc<JournalLatch>,
+    owner: Weak<Memory>,
+    contexts: Vec<Box<JournalContext>>,
+    hooks: Vec<(Weak<dyn Cpu>, HookId)>,
+}
+impl MutationJournal {
+    fn remove(&mut self) -> Result<(), String> {
+        let result = remove_hooks(&mut self.hooks, |(cpu, hook)| cpu.upgrade().map_or(Ok(()), |cpu| cpu.remove_hook(*hook)));
+        if result.is_ok()
+            && let Some(memory) = self.owner.upgrade()
+        {
+            memory.observers.set_journal(None);
+        }
+        result
+    }
+}
+impl Drop for MutationJournal {
+    fn drop(&mut self) {
+        if self.hooks.is_empty() || self.remove().is_ok() {
+            return;
+        }
+        if let Some(memory) = self.owner.upgrade() {
+            memory.observers.retain(Box::new((std::mem::take(&mut self.contexts), std::mem::take(&mut self.hooks))));
+        }
+    }
+}
+impl Board {
+    /// Records mutations from now until `mutation_journal_end`, at most `limit` rows.
+    pub fn mutation_journal_begin(&self, limit: usize) -> Result<Box<MutationJournal>, String> {
+        let state = self.state.try_borrow().map_err(|_| "mutation journal requires a paused board")?;
+        if state.active_slice.is_some() || state.parallel.is_some() || state.memory_access {
+            return Err("mutation journal requires a paused board".into());
+        }
+        drop(state);
+        if limit == 0 || limit > MAX_JOURNAL_ROWS {
+            return Err("mutation journal row bound is outside 1..=4096".into());
+        }
+        let observers = &self.physical_memory.observers;
+        if observers.cleanup_failed.get() {
+            return Err("an observation hook could not be removed".into());
+        }
+        if observers.guard().is_some() || observers.journal_active() {
+            return Err("a composite guard or another mutation journal is active".into());
+        }
+        if self.cpus.iter().any(|cpu| !cpu.supports_mutation_observation()) {
+            return Err("mutation journal requires mutation observation on every processor".into());
+        }
+        let latch = Rc::new(JournalLatch { rows: RefCell::new(Vec::new()), limit, overflow: Cell::new(false) });
+        let mut journal = Box::new(MutationJournal {
+            latch: latch.clone(),
+            owner: Rc::downgrade(&self.physical_memory),
+            contexts: self
+                .cpus
+                .iter()
+                .enumerate()
+                .map(|(core, cpu)| Box::new(JournalContext { core, cpu: Rc::downgrade(cpu), latch: latch.clone() }))
+                .collect(),
+            hooks: Vec::with_capacity(self.cpus.len()),
+        });
+        for (cpu, context) in self.cpus.iter().zip(&journal.contexts) {
+            let data = (&**context as *const JournalContext).cast_mut().cast();
+            // SAFETY: the journal keeps the boxed context until this hook is removed.
+            match unsafe { cpu.install_hook(Hook::Mutation { callback: record, data }) } {
+                Ok(id) => journal.hooks.push((Rc::downgrade(cpu), id)),
+                Err(error) => {
+                    journal.remove()?;
+                    return Err(error);
+                }
+            }
+        }
+        observers.set_journal(Some(&latch));
+        Ok(journal)
+    }
+    /// Removes the journal's hooks; refuses if the row bound was exceeded.
+    pub fn mutation_journal_end(&self, journal: &mut MutationJournal) -> Result<Vec<MutationRow>, String> {
+        if !journal.owner.upgrade().is_some_and(|owner| Rc::ptr_eq(&owner, &self.physical_memory)) {
+            return Err("mutation journal belongs to a different board".into());
+        }
+        journal.remove()?;
+        if journal.latch.overflow.get() {
+            return Err("mutation journal exceeded its row bound".into());
+        }
+        Ok(journal.latch.rows.take())
+    }
+}
