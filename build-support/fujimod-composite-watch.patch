+#[test]
+fn attach_refusals_are_typed() {
+    use GuardAttachError::*;
+    let board = board();
+    let mut legacy = board.memory_watch_begin(vec![(0x40000, 0x40100)], 8, board.mappings().to_vec()).unwrap();
+    assert_eq!(board.memory_guard_attach(&mut legacy, config(open)).err(), Some(NotClassified));
+    board.memory_watch_end(&mut legacy).unwrap();
+    assert_eq!(board.memory_guard_attach(&mut legacy, config(open)).err(), Some(DeadWatch));
+
+    let mut first = watch(&board, 8);
+    let mut second = watch(&board, 8);
+    assert_eq!(board.memory_guard_attach(&mut first, config(open)).err(), Some(NotCurrent));
+    assert_eq!(board.memory_guard_attach(&mut second, config(open)).err(), Some(SiblingWatch));
+    board.memory_watch_end(&mut first).unwrap();
+
+    let other = self::board();
+    let mut foreign = watch(&other, 8);
+    assert_eq!(board.memory_guard_attach(&mut foreign, config(open)).err(), Some(WrongOwner));
+
+    {
+        let _busy = board.state.borrow_mut();
+        assert_eq!(board.memory_guard_attach(&mut second, config(open)).err(), Some(NotPaused));
+    }
+    let mut missing = config(open);
+    missing.sources.pop();
+    assert_eq!(board.memory_guard_attach(&mut second, missing).err(), Some(MissingSource));
+    let mut duplicate = config(open);
+    duplicate.sources[1] = duplicate.sources[0].clone();
+    assert_eq!(board.memory_guard_attach(&mut second, duplicate).err(), Some(DuplicateSource));
+    let foreign_tcm = range(GuardTarget::Tcm { core: core(1), bank: TcmBank::Data }, 0, 4);
+    assert_eq!(
+        board.memory_guard_attach(&mut second, forbidding(WriteSource::Cpu(core(0)), foreign_tcm)).err(),
+        Some(InvalidTarget)
+    );
+    let host_tcm = range(GuardTarget::Tcm { core: core(0), bank: TcmBank::Data }, 0, 4);
+    assert_eq!(
+        board.memory_guard_attach(&mut second, forbidding(WriteSource::PhysicalHost, host_tcm)).err(),
+        Some(InvalidTarget)
+    );
+    let ambiguous = config(|source| {
+        let mut policy = open(source);
+        policy.allow.push(physical(0x40000, 0x40004));
+        policy
+    });
+    assert_eq!(board.memory_guard_attach(&mut second, ambiguous).err(), Some(AmbiguousRanges));
+    let mut partitioned = config(open);
+    let last = partitioned.sources.len() - 1;
+    partitioned.sources[last].owned_pc =
+        Some(OwnedPcPolicy { spans: vec![GuardSpan::new(0x30000, 0x30004).unwrap()], destinations: open(WriteSource::ModelBus) });
+    assert_eq!(board.memory_guard_attach(&mut second, partitioned).err(), Some(InvalidPartition));
+    let oversized = config(|source| {
+        let mut policy = open(source);
+        policy.forbid = (0..MAX_GUARD_RANGES as u64).map(|index| physical(index * 4, index * 4 + 4)).collect();
+        policy
+    });
+    assert_eq!(board.memory_guard_attach(&mut second, oversized).err(), Some(BoundExceeded));
+    let mut absent_core = config(open);
+    absent_core.sources[0].source = WriteSource::Cpu(core(2));
+    assert_eq!(board.memory_guard_attach(&mut second, absent_core).err(), Some(InvalidCore));
+    assert_eq!(GuardCore::new(MAX_GUARD_CORES).err(), Some(InvalidCore));
+    assert_eq!(GuardSpan::new(5, 5).err(), Some(InvalidInterval));
+    assert_eq!(GuardSpan::new(0, ADDRESS_END + 1).err(), Some(InvalidInterval));
+
+    // None of the refusals above changed the watch.
+    board.memory_guard_attach(&mut second, config(open)).unwrap();
+    assert_eq!(board.memory_guard_attach(&mut second, config(open)).err(), Some(AlreadyAttached));
+    board.memory_watch_end(&mut second).unwrap();
+}
