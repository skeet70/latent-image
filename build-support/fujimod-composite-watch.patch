+    board.write_physical(0x40000, &[1; 4]).unwrap();
+    assert_eq!(token.report().write_checks, 0);
+    let mut next = self::watch(&board, 8);
+    board.memory_guard_attach(&mut next, config(open)).unwrap();
+    board.memory_watch_end(&mut next).unwrap();
+}
+
+#[test]
+fn dropping_a_watch_whose_hooks_cannot_be_removed_blocks_execution() {
+    let (mut board, faults) = flaky_board();
+    let mut watch = watch(&board, 64);
+    let token = board.memory_guard_attach(&mut watch, config(open)).unwrap();
+    faults.removals.set(Some(0));
+    drop(watch);
+    faults.clear();
+    assert_ne!(token.report().status, GuardStatus::Ended);
+    assert!(board.run_until(2, 1).is_err());
+    assert!(board.write_physical(0x40000, &[1; 4]).is_ok());
+    assert_eq!(token.report().write_checks, 1);
+}
+
+#[test]
+fn a_watch_may_outlive_its_board() {
+    let board = board();
+    let mut watch = watch(&board, 64);
+    let token = board.memory_guard_attach(&mut watch, config(open)).unwrap();
+    drop(board);
+    drop(watch);
+    let report = token.report();
+    assert_eq!((report.status, report.first_fault, report.mutation_attempts), (GuardStatus::Ended, None, 0));
+}
+
+#[test]
+fn point_removal_failure_keeps_the_points_and_blocks_execution() {
+    let (mut board, faults) = flaky_board();
+    let mut points = board.instruction_points_begin(0, vec![0x30004]).unwrap();
+    faults.removals.set(Some(0));
+    assert!(board.instruction_points_end(0, &mut points).is_err());
+    faults.clear();
+    assert!(board.run_until(2, 1).is_err());
+    board.instruction_points_end(0, &mut points).unwrap();
+    assert!(board.run_until(2, 1).is_err(), "cleanup failure stays sticky");
+}
+
+#[test]
+fn dropping_points_whose_hook_cannot_be_removed_keeps_their_context() {
+    let (mut board, faults) = flaky_board();
+    let points: Box<InstructionPoints> = board.instruction_points_begin_mutable(0, vec![0x30004]).unwrap();
+    faults.removals.set(Some(0));
+    drop(points);
+    faults.clear();
+    assert!(board.run_until(2, 1).is_err());
+}
+
+#[test]
+fn point_installation_rollback_failure_blocks_execution() {
+    let (mut board, faults) = flaky_board();
+    faults.installs.set(Some(1));
+    faults.removals.set(Some(0));
+    assert!(board.instruction_points_begin(0, vec![0x30000, 0x30004]).is_err());
+    faults.clear();
+    assert!(board.run_until(2, 1).is_err());
+}
+
+/// Calls `replace_addresses` from a guest instruction hook and keeps its result.
+struct ReplaceDuringRun<'a> {
+    points: &'a InstructionPoints,
+    addresses: Vec<u64>,
+    result: std::cell::RefCell<Option<Result<(), String>>>,
+}
+unsafe fn replace_during_run(_: u64, _: u32, data: *mut c_void) {
+    // SAFETY: the test removes this hook before `ReplaceDuringRun` drops.
+    let attempt = unsafe { &*data.cast::<ReplaceDuringRun>() };
+    attempt.result.replace(Some(attempt.points.replace_addresses(attempt.addresses.clone())));
+}
+
+#[test]
+fn mutable_point_replacement_is_refused_while_the_board_runs() {
+    let mut board = board();
+    // nop; nop; nop; b .
+    let code = [0xe1a00000u32, 0xe1a00000, 0xe1a00000, 0xeafffffe];
+    board.write_memory(0, 0x30000, &code.iter().flat_map(|word| word.to_le_bytes()).collect::<Vec<_>>()).unwrap();
+    let mut points = board.instruction_points_begin_mutable(0, vec![0x30004]).unwrap();
+    let attempt = ReplaceDuringRun { points: &points, addresses: vec![0x30008], result: Default::default() };
+    let data = (&attempt as *const ReplaceDuringRun).cast_mut().cast();
+    let range = HookRange::Inclusive { begin: 0x30000, end: 0x30000 };
+    // SAFETY: removed below while `attempt` is alive.
+    let hook = unsafe { board.cpu(0).unwrap().install_hook(Hook::Instruction { callback: replace_during_run, data, range }) }
+        .unwrap();
+    board.run_until(10, 1).unwrap();
+    board.cpu(0).unwrap().remove_hook(hook).unwrap();
+    assert!(attempt.result.take().expect("the guest reached the hook").is_err());
+    drop(attempt);
+    assert_eq!(points.event(), Some(0x30004));
+    assert_eq!(board.read_register(0, Register::Pc).unwrap(), 0x30004);
+    points.resume(0x30004, 0x30004);
+    board.run_until(20, 1).unwrap();
+    assert_eq!(points.event(), None);
+    assert_eq!(board.read_register(0, Register::Pc).unwrap(), 0x3000c);
+    board.instruction_points_end(0, &mut points).unwrap();
+}
+
+#[test]
+fn mutable_point_replacement_moves_points_until_the_board_is_dropped() {
+    let mut board = board();
+    // nop; nop; b .
+    board.write_memory(0, 0x30000, &[0x00, 0x00, 0xa0, 0xe1, 0x00, 0x00, 0xa0, 0xe1, 0xfe, 0xff, 0xff, 0xea]).unwrap();
+    let points = board.instruction_points_begin_mutable(0, vec![]).unwrap();
+    points.replace_addresses(vec![0x30004]).unwrap();
+    board.run_until(10, 1).unwrap();
+    assert_eq!(points.event(), Some(0x30004));
+    assert_eq!(board.read_register(0, Register::Pc).unwrap(), 0x30004);
+    drop(board);
+    assert!(points.replace_addresses(vec![0x30000]).is_err());
+}
+
+#[test]
+fn fixed_points_refuse_replacement_and_another_core_end() {
+    let board = board();
+    let mut points = board.instruction_points_begin(0, vec![0x30004]).unwrap();
+    assert!(points.replace_addresses(vec![0x30000]).is_err());
+    assert!(board.instruction_points_end(1, &mut points).is_err());
+    board.instruction_points_end(0, &mut points).unwrap();
+}
