+fn tcm_overlays_resolve_to_their_bank_and_aliases_to_physical() {
+    for (address, location) in [
+        (ATCM + 0x10, at(GuardTarget::Tcm { core: core(0), bank: TcmBank::Instruction }, 0x10)),
+        (BTCM + 0x20, at(GuardTarget::Tcm { core: core(0), bank: TcmBank::Data }, 0x20)),
+        (0x20030, at(GuardTarget::Physical, 0x10030)),
+    ] {
+        let mut board = board();
+        program(&board, 0, 0x30000, 0x55, address);
+        let mut watch = watch(&board, 64);
+        let source = WriteSource::Cpu(core(0));
+        let forbidden = range(location.target, location.address, location.address + 4);
+        let token = board.memory_guard_attach(&mut watch, forbidding(source, forbidden)).unwrap();
+        let _ = board.run_until(4, 1);
+        assert_eq!(
+            token.report().first_fault,
+            denied(source, address, 4, Some(0x30000), location, outcome(&board, 0))
+        );
+    }
+    // A TCM write is not a write to the physical RAM the overlay hides.
+    let mut board = board();
+    program(&board, 0, 0x30000, 0x55, ATCM + 0x10);
+    let mut watch = watch(&board, 64);
+    let token =
+        board.memory_guard_attach(&mut watch, forbidding(WriteSource::Cpu(core(0)), physical(0x10000, 0x11000))).unwrap();
+    board.run_until(4, 1).unwrap();
+    assert_eq!(token.report().first_fault, None);
+    assert_eq!(word(&board, 0, ATCM + 0x10), 0x55);
+}
