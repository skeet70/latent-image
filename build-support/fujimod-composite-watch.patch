+#[test]
+fn pc_partitions_select_their_own_destinations() {
+    let a = partition(vec![span(0x30000, 0x30008)], vec![physical(0x40000, 0x40004)]);
+    let b = partition(vec![span(0x30100, 0x30108)], vec![physical(0x40010, 0x40014)]);
+    let mut board = board();
+    let mut watch = watch(&board, 64);
+    let token = board.memory_guard_attach(&mut watch, partitioned(vec![a.clone(), b.clone()])).unwrap();
+    program(&board, 0, 0x30000, 0x77, 0x40000);
+    board.run_until(4, 1).unwrap();
+    program(&board, 0, 0x30100, 0x66, 0x40010);
+    board.run_until(8, 1).unwrap();
+    program(&board, 0, 0x30200, 0x55, 0x40020);
+    board.run_until(12, 1).unwrap();
+    assert_eq!(token.report().first_fault, None);
+    assert_eq!([0x40000, 0x40010, 0x40020].map(|address| physical_word(&board, address)), [0x77, 0x66, 0x55]);
+    assert_eq!(token.partition_checks(core(0)), [1, 1]);
+    assert_eq!(token.partition_checks(core(1)), Vec::<u64>::new());
+
+    for (from, to, id) in [(0x30000, 0x40010, 0), (0x30100, 0x40000, 1)] {
+        let mut board = self::board();
+        let mut watch = self::watch(&board, 64);
+        let token = board.memory_guard_attach(&mut watch, partitioned(vec![a.clone(), b.clone()])).unwrap();
+        program(&board, 0, from, 0x44, to);
+        let result = board.run_until(4, 1);
+        let partition = Some(PartitionId(id));
+        let location = at(GuardTarget::Physical, to);
+        assert_eq!(token.report().first_fault, denied_in(partition, WriteSource::Cpu(core(0)), to, 4, Some(from), location, outcome(&board, 0)));
+        assert_guest_denial(&board, result, to, 0x44, 0);
+    }
+}
