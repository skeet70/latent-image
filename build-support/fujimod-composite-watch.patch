+#[test]
+fn mutable_point_replacement_is_refused_while_the_board_runs() {
+    let mut board = board();
+    // nop; nop; nop; b .
+    let code = [0xe1a00000u32, 0xe1a00000, 0xe1a00000, 0xeafffffe];
+    board.write_memory(0, 0x30000, &code.iter().flat_map(|word| word.to_le_bytes()).collect::<Vec<_>>()).unwrap();
+    let mut points = board.instruction_points_begin_mutable(0, vec![0x30004]).unwrap();
+    let attempt = ReplaceDuringRun { points: &points, addresses: vec![0x30008], result: Default::default() };
+    let data = (&attempt as *const ReplaceDuringRun).cast_mut().cast();
+    let range = HookRange::Inclusive { begin: 0x30000, end: 0x30000 };
+    // SAFETY: removed below while `attempt` is alive.
+    let hook = unsafe { board.cpu(0).unwrap().install_hook(Hook::Instruction { callback: replace_during_run, data, range }) }
+        .unwrap();
+    board.run_until(10, 1).unwrap();
+    board.cpu(0).unwrap().remove_hook(hook).unwrap();
+    assert!(attempt.result.take().expect("the guest reached the hook").is_err());
+    drop(attempt);
+    assert_eq!(points.event(), Some(0x30004));
+    assert_eq!(board.read_register(0, Register::Pc).unwrap(), 0x30004);
+    points.resume(0x30004, 0x30004);
+    board.run_until(20, 1).unwrap();
+    assert_eq!(points.event(), None);
+    assert_eq!(board.read_register(0, Register::Pc).unwrap(), 0x3000c);
+    board.instruction_points_end(0, &mut points).unwrap();
+}
+
+#[test]
+fn mutable_point_replacement_moves_points_until_the_board_is_dropped() {
+    let mut board = board();
+    // nop; nop; b .
+    board.write_memory(0, 0x30000, &[0x00, 0x00, 0xa0, 0xe1, 0x00, 0x00, 0xa0, 0xe1, 0xfe, 0xff, 0xff, 0xea]).unwrap();
+    let points = board.instruction_points_begin_mutable(0, vec![]).unwrap();
+    points.replace_addresses(vec![0x30004]).unwrap();
+    board.run_until(10, 1).unwrap();
+    assert_eq!(points.event(), Some(0x30004));
+    assert_eq!(board.read_register(0, Register::Pc).unwrap(), 0x30004);
+    drop(board);
+    assert!(points.replace_addresses(vec![0x30000]).is_err());
+}
+
+#[test]
+fn fixed_points_refuse_replacement_and_another_core_end() {
+    let board = board();
+    let mut points = board.instruction_points_begin(0, vec![0x30004]).unwrap();
+    assert!(points.replace_addresses(vec![0x30000]).is_err());
+    assert!(board.instruction_points_end(1, &mut points).is_err());
+    board.instruction_points_end(0, &mut points).unwrap();
+}
+
+const MCR_ATCM_R0: u32 = 0xee09_0f31; // mcr p15,0,r0,c9,c1,1
+const MCR_ATCM_R3: u32 = 0xee09_3f31; // mcr p15,0,r3,c9,c1,1
+const STR_R0_R1: u32 = 0xe581_0000; // str r0,[r1]
+const STR_R2_R1: u32 = 0xe581_2000; // str r2,[r1]
+const STR_R2_R3: u32 = 0xe583_2000; // str r2,[r3]
+const HALT: u32 = 0xeaff_fffe; // b .
+
+/// The normalized region register of an enabled 4 KiB bank at `base`.
+fn atcm(base: u32) -> u32 {
+    base | (3 << 2) | 1
+}
+fn load(board: &Board, words: &[u32], registers: &[(usize, u64)]) {
+    let code: Vec<u8> = words.iter().flat_map(|word| word.to_le_bytes()).collect();
+    board.write_memory(0, 0x30000, &code).unwrap();
+    board.write_register(0, Register::Pc, 0x30000).unwrap();
+    for &(index, value) in registers {
+        board.write_register(0, arm::CORE[index], value).unwrap();
+    }
+}
+fn tcm(previous: u32, next: u32, writer: u32) -> DeclaredMutation {
+    DeclaredMutation::TcmRegion {
+        core: core(0),
+        bank: TcmBank::Instruction,
+        previous: TcmRegister(previous),
+        next: TcmRegister(next),
+        writer: WriterPc(writer),
+    }
+}
+fn commit(writer: u32) -> DeclaredMutation {
+    DeclaredMutation::DecoderCommit {
+        decoder: DecoderIndex(0),
+        previous: DecoderChoice(0),
+        next: DecoderChoice(1),
+        core: core(0),
+        writer: WriterPc(writer),
+    }
+}
+fn declaring(mut config: CompositeGuardConfig, declared: Vec<DeclaredMutation>) -> CompositeGuardConfig {
+    config.declared = declared;
+    config
+}
+fn refusal(token: &GuardStatusToken) -> Option<MutationRefusal> {
+    match token.report().first_fault {
+        Some(GuardFault::Mutation { reason, .. }) => Some(reason),
+        _ => None,
+    }
+}
+
+#[test]
+fn a_declared_tcm_write_moves_the_window() {
+    let mut board = board();
+    load(&board, &[MCR_ATCM_R0, STR_R2_R1, HALT], &[(0, 0x60001), (1, 0x60010), (2, 0x77)]);
+    assert_eq!(tcm_register(&board, 0, TcmBank::Instruction), u64::from(atcm(0x10000)));
+    let mut watch = watch(&board, 64);
+    let atcm_word = range(GuardTarget::Tcm { core: core(0), bank: TcmBank::Instruction }, 0x10, 0x14);
+    let config = declaring(forbidding(WriteSource::Cpu(core(0)), atcm_word), vec![tcm(atcm(0x10000), atcm(0x60000), 0x30000)]);
+    let token = board.memory_guard_attach(&mut watch, config).unwrap();
+    let _ = board.run_until(8, 1);
+    assert_eq!(tcm_register(&board, 0, TcmBank::Instruction), u64::from(atcm(0x60000)));
+    let location = at(GuardTarget::Tcm { core: core(0), bank: TcmBank::Instruction }, 0x10);
+    assert_eq!(
+        token.report().first_fault,
+        denied(WriteSource::Cpu(core(0)), 0x60010, 4, Some(0x30004), location, outcome(&board, 0))
+    );
+    assert_eq!(token.report().mutations_admitted, 1);
+    assert!(token.declared()[0].admitted.is_some_and(|admitted| admitted.core == core(0)));
+}
+
+#[test]
+fn undeclared_and_mismatched_tcm_writes_are_refused_before_they_apply() {
+    let (from, to) = (atcm(0x10000), atcm(0x60000));
+    let first = DeclarationId(0);
+    for (declared, reason) in [
+        (vec![], MutationRefusal::Undeclared),
+        (vec![tcm(from, atcm(0x70000), 0x30000)], MutationRefusal::Mismatch { declaration: first, field: DeclaredField::Next }),
+        (vec![tcm(from, to, 0x30004)], MutationRefusal::Mismatch { declaration: first, field: DeclaredField::Writer }),
+    ] {
+        let mut board = board();
+        load(&board, &[MCR_ATCM_R0, HALT], &[(0, 0x60001)]);
+        let mut watch = watch(&board, 64);
+        let token = board.memory_guard_attach(&mut watch, declaring(config(open), declared)).unwrap();
+        assert!(board.run_until(4, 1).is_err());
+        assert_eq!(tcm_register(&board, 0, TcmBank::Instruction), u64::from(from));
+        assert_eq!(refusal(&token), Some(reason));
+        assert_eq!(token.report().mutations_admitted, 0);
+    }
+}
+
+#[test]
+fn each_declaration_admits_one_occurrence() {
+    let (from, to) = (atcm(0x10000), atcm(0x60000));
+    let mut board = board();
+    load(&board, &[MCR_ATCM_R0, MCR_ATCM_R3, MCR_ATCM_R0, HALT], &[(0, 0x60001), (3, 0x10001)]);
+    let mut watch = watch(&board, 64);
+    let config = declaring(config(open), vec![tcm(from, to, 0x30000), tcm(to, from, 0x30004)]);
+    let token = board.memory_guard_attach(&mut watch, config).unwrap();
+    assert!(board.run_until(8, 1).is_err());
+    assert_eq!(tcm_register(&board, 0, TcmBank::Instruction), u64::from(from));
+    assert_eq!(refusal(&token), Some(MutationRefusal::Consumed(DeclarationId(0))));
+    assert_eq!(token.report().mutations_admitted, 2);
+    assert!(token.declared().iter().all(|used| used.admitted.is_some()));
+}
+
+#[test]
+fn a_host_tcm_write_matching_a_declaration_is_refused() {
+    let board = board();
+    let mut watch = watch(&board, 64);
+    let config = declaring(config(open), vec![tcm(atcm(0x10000), atcm(0x60000), 0x30000)]);
+    let token = board.memory_guard_attach(&mut watch, config).unwrap();
+    assert!(board.cpu(0).unwrap().coprocessor(TcmBank::Instruction.register(), Some(0x60001)).is_err());
+    assert_eq!(tcm_register(&board, 0, TcmBank::Instruction), u64::from(atcm(0x10000)));
+    assert_eq!(refusal(&token), Some(MutationRefusal::HostOrigin));
+    assert_eq!(token.declared()[0].admitted, None);
+}
+
+#[test]
+fn a_declared_decoder_commit_switches_the_views() {
+    let mut board = board_with([true, false], true);
+    load(&board, &[STR_R0_R1, STR_R2_R3, HALT], &[(0, 1), (1, SELECT), (2, 0x99), (3, 0x70010)]);
+    let mut watch = watch(&board, 64);
+    let config = declaring(forbidding(WriteSource::Cpu(core(0)), physical(0x40010, 0x40014)), vec![commit(0x30000)]);
+    let token = board.memory_guard_attach(&mut watch, config).unwrap();
+    let _ = board.run_until(8, 1);
+    assert_eq!(board.state()["memory_decoders"]["choices"], serde_json::json!([1, 0]));
+    assert_eq!(
+        token.report().first_fault,
+        denied(WriteSource::Cpu(core(0)), 0x70010, 4, Some(0x30004), at(GuardTarget::Physical, 0x40010), outcome(&board, 0))
+    );
+    assert_eq!(token.report().mutations_admitted, 1);
+    assert!(token.declared()[0].admitted.is_some_and(|admitted| admitted.core == core(0)));
+}
+
+#[test]
+fn a_commit_without_its_declared_writer_is_refused() {
+    for writer in [None, Some(0x30004)] {
+        let mut board = board_with([true, false], true);
+        load(&board, &[STR_R0_R1, HALT], &[(0, 1), (1, SELECT)]);
+        board.write_physical(0x30000 + 0x10, &[3; 4]).unwrap();
+        let mut watch = watch(&board, 64);
+        let token = board.memory_guard_attach(&mut watch, declaring(config(open), vec![commit(0x30000)])).unwrap();
+        match writer {
+            None => board.state.borrow_mut().decoders.select(0, 1, true, None).unwrap(),
+            Some(pc) => load(&board, &[HALT, STR_R0_R1, HALT], &[(0, 1), (1, SELECT), (15, pc)]),
+        }
+        assert!(board.run_until(8, 1).is_err());
+        assert_eq!(board.state()["memory_decoders"]["choices"], serde_json::json!([0, 0]));
+        assert_eq!(word(&board, 0, 0x70010), 0x0303_0303);
+        assert_eq!(
+            refusal(&token),
+            Some(MutationRefusal::Mismatch { declaration: DeclarationId(0), field: DeclaredField::Writer })
+        );
+    }
+}
+
+#[test]
+fn declaration_refusals_are_typed() {
+    use GuardAttachError::*;
+    let (from, to) = (atcm(0x10000), atcm(0x60000));
+    let board = board_with([true, false], true);
+    let mut watch = watch(&board, 8);
+    let mut attach = |declared| board.memory_guard_attach(&mut watch, declaring(config(open), declared)).err();
+    assert_eq!(attach(vec![tcm(to, from, 0x30000)]), Some(DeclarationChain));
+    assert_eq!(attach(vec![tcm(from, to, 0x30000), tcm(from, atcm(0x70000), 0x30004)]), Some(DeclarationChain));
+    assert_eq!(attach(vec![tcm(from, to, 0x30000), tcm(atcm(0x70000), from, 0x30004)]), Some(DeclarationChain));
+    assert_eq!(attach(vec![tcm(from, to, 0x30000), tcm(from, to, 0x30000)]), Some(DuplicateDeclaration));
+    assert_eq!(attach(vec![tcm(from, from, 0x30000)]), Some(InvalidDeclaration));
+    let absent_decoder = DeclaredMutation::DecoderCommit {
+        decoder: DecoderIndex(5),
+        previous: DecoderChoice(0),
+        next: DecoderChoice(1),
+        core: core(0),
+        writer: WriterPc(0x30000),
+    };
+    assert_eq!(attach(vec![absent_decoder]), Some(InvalidDeclaration));
+    let absent_choice = DeclaredMutation::DecoderCommit {
+        decoder: DecoderIndex(0),
+        previous: DecoderChoice(0),
+        next: DecoderChoice(9),
+        core: core(0),
+        writer: WriterPc(0x30000),
+    };
+    assert_eq!(attach(vec![absent_choice]), Some(InvalidDeclaration));
+    let absent_core = DeclaredMutation::TcmRegion {
+        core: core(2),
+        bank: TcmBank::Instruction,
+        previous: TcmRegister(from),
+        next: TcmRegister(to),
+        writer: WriterPc(0x30000),
+    };
+    assert_eq!(attach(vec![absent_core]), Some(InvalidDeclaration));
+    let too_many = (0..=MAX_GUARD_DECLARED_MUTATIONS as u32).map(|index| tcm(from, to, 0x30000 + 4 * index)).collect();
+    assert_eq!(attach(too_many), Some(BoundExceeded));
+    assert_eq!(attach(vec![commit(0x30000), tcm(from, to, 0x30000)]), None);
+
+    let board = board_with([true, false], true);
+    let mut fixed = board.memory_watch_begin_classified(classes(), 8, board.mappings().to_vec(), ViewPolicy::Fixed).unwrap();
+    let commit_only = declaring(config(open), vec![commit(0x30000)]);
+    assert_eq!(board.memory_guard_attach(&mut fixed, commit_only).err(), Some(FixedViewsWithDeclaredCommit));
+    board.memory_guard_attach(&mut fixed, declaring(config(open), vec![tcm(from, to, 0x30000)])).unwrap();
+}
+
+#[test]
+fn the_journal_records_mutations_with_the_writers_the_guard_derives() {
+    let mut board = board_with([true, false], true);
+    load(&board, &[MCR_ATCM_R0, STR_R2_R1, HALT], &[(0, 0x60001), (1, SELECT), (2, 1)]);
+    let mut journal = board.mutation_journal_begin(MAX_JOURNAL_ROWS).unwrap();
+    let mut watch = watch(&board, 8);
+    assert_eq!(board.memory_guard_attach(&mut watch, config(open)).err(), Some(GuardAttachError::MutationJournal));
+    board.run_until(8, 1).unwrap();
+    let rows = board.mutation_journal_end(&mut journal).unwrap();
+    let replaced = GuardMutation::Cpu(CpuMutation::Mapping {
+        operation: MappingMutation::ReplacePhysical,
+        address: 0x70000,
+        physical: Some(0x40000),
+        bytes: 0x1000,
+        permissions: Some(7),
+    });
+    let tcm_write = GuardMutation::Cpu(CpuMutation::Tcm {
+        register: TcmBank::Instruction.register(),
+        previous: atcm(0x10000),
+        next: atcm(0x60000),
+        origin: MutationOrigin::Guest,
+    });
+    let selection = SelectionWriter { core: 0, pc: 0x30004 };
+    let commit = GuardMutation::Decoder { decoder: 0, previous: 0, choice: 1, writer: Some(selection) };
+    assert_eq!(
+        rows.iter().map(|row| (row.core, row.mutation, row.writer)).collect::<Vec<_>>(),
+        [
+            (Some(0), tcm_write, Some(0x30000)),
+            (Some(0), commit, Some(0x30004)),
+            (Some(0), replaced, None),
+            (Some(1), replaced, None),
+        ]
+    );
+    board.memory_guard_attach(&mut watch, config(open)).unwrap();
+    assert!(board.mutation_journal_begin(MAX_JOURNAL_ROWS).is_err());
+}
+
+#[test]
+fn the_journal_refuses_once_its_bound_is_exceeded() {
+    let mut board = board();
+    load(&board, &[MCR_ATCM_R0, MCR_ATCM_R3, HALT], &[(0, 0x60001), (3, 0x10001)]);
+    let mut journal = board.mutation_journal_begin(1).unwrap();
+    board.run_until(8, 1).unwrap();
+    assert!(board.mutation_journal_end(&mut journal).is_err());
+    assert!(board.mutation_journal_begin(1).is_ok());
+}
