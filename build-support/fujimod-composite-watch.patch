+/// Writes four bytes at the bus address it is given.
+#[derive(serde::Serialize, serde::Deserialize)]
+struct Dma;
+impl Device for Dma {
+    fn name(&self) -> &'static str {
+        "composite-guard-dma"
+    }
+    fn fingerprint(&self) -> Result<serde_json::Value, String> {
