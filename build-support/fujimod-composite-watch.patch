+fn map(core: usize, address: u64, physical: u64) -> MemoryMap {
+    MemoryMap { core, address, physical, size: 0x1000, permissions: 7 }
+}
+fn graph(released: [bool; 2], decoders: bool) -> Graph {
+    let mut mappings: Vec<_> = (0..2)
+        .flat_map(|core| {
+            [map(core, ATCM, 0x10000), map(core, 0x20000, 0x10000), map(core, 0x30000, 0x30000), map(core, 0x40000, 0x40000)]
+        })
+        .collect();
+    let mut dma_mappings = vec![
+        BusMapping::ram(0x10000, 0x1000),
+        BusMapping::ram(0x30000, 0x1000),
+        BusMapping::ram(0x40000, 0x1000),
+        BusMapping { address: 0x60000, physical: 0x30000, size: 0x1000, permissions: 3 },
+        BusMapping { address: 0x61000, physical: 0x40000, size: 0x1000, permissions: 3 },
+    ];
+    let mut graph_decoders = vec![];
+    if decoders {
+        let processors = |physical| (0..2).map(|core| map(core, 0x70000, physical)).collect::<Vec<_>>();
+        let window = |physical| BusMapping { address: 0x70000, physical, size: 0x1000, permissions: 3 };
+        mappings.extend(processors(0x30000));
+        dma_mappings.push(window(0x30000));
+        graph_decoders = vec![
+            Decoder {
+                initial: 0,
+                choices: vec![
+                    Choice { processors: processors(0x30000), dma: vec![] },
+                    Choice { processors: processors(0x40000), dma: vec![] },
+                ],
+            },
+            Decoder {
+                initial: 0,
+                choices: vec![
+                    Choice { processors: vec![], dma: vec![window(0x30000)] },
+                    Choice { processors: vec![], dma: vec![window(0x40000)] },
+                ],
+            },
+        ];
+    }
+    Graph {
+        processors: released
+            .into_iter()
+            .map(|released| Processor {
+                model: Model::CortexR5F,
+                released,
+                mprofile: None,
+                rprofile: Some(rprofile::core::Options {
+                    tcm: rprofile::tcm::Options {
+                        atcm: rprofile::tcm::BankOptions { bytes: 0x1000, reset: ATCM as u32 | 1 },
+                        btcm: rprofile::tcm::BankOptions { bytes: 0x1000, reset: BTCM as u32 | 1 },
+                    },
+                    ..Default::default()
+                }),
+                registers: vec![(Register::Pc, 0x30000), (Register::Pstate, 0xd3)],
+            })
+            .collect(),
+        ram: [0x10000, 0x30000, 0x40000].map(|base| Ram { base, size: 0x1000 }).into(),
+        dma_mappings,
+        decoders: graph_decoders,
+        mappings,
+        peripherals: (0..2).map(|core| Peripheral { core, address: DMA, physical: DMA, size: 0x1000 }).collect(),
+        instructions_per_tick: Ratio::new(1, 1).unwrap(),
+    }
+}
+fn options() -> Options {
+    Options { engine: Engine::Unicorn, translation_cache_bytes: 1024 * 1024 }
+}
+fn devices() -> Bus {
+    let mut bus = Bus::new(bus::Mode::Strict);
+    bus.register(DMA, 4, Box::new(Dma)).unwrap();
+    bus.register(SELECT, 4, Box::new(Select)).unwrap();
+    bus
+}
+fn board_with(released: [bool; 2], decoders: bool) -> Board {
+    graph(released, decoders).build(options(), devices(), None).unwrap()
+}
+fn board() -> Board {
+    board_with([true, false], false)
+}
