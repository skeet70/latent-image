+#[test]
+fn byte_and_halfword_exclusives_store_once_and_fail_without_a_matching_reservation() {
+    let backing = Backing::aligned_zeros(0x2000, 4096).unwrap();
+    let cpu = processor(&Memory::default());
+    unsafe {
+        cpu.map_physical(0, 0, 0x2000, 7, NonNull::new(backing.as_ptr()).unwrap())
+            .unwrap();
+    }
+    let memory = |cpu: &Core| {
+        let mut bytes = [0; 4];
+        cpu.read_memory(0x1800, &mut bytes).unwrap();
+        bytes
+    };
+    // ldrexb r0,[r1]; strexb r3,r2,[r1]
+    words(&cpu, 0x1000, &[0xe1d10f9f, 0xe1c13f92]);
+    words(&cpu, 0x1800, &[0x8877_6655]);
+    set(&cpu, arm::CORE[1], 0x1801);
+    set(&cpu, arm::CORE[2], 0x1aa);
+    run(&cpu, 0x1000, 2).unwrap();
+    assert_eq!((get(&cpu, arm::CORE[0]), get(&cpu, arm::CORE[3])), (0x66, 0));
+    assert_eq!(memory(&cpu), [0x55, 0xaa, 0x77, 0x88]);
+    // ldrexh r0,[r1]; strexh r3,r2,[r1]
+    words(&cpu, 0x1000, &[0xe1f10f9f, 0xe1e13f92]);
+    set(&cpu, arm::CORE[1], 0x1802);
+    set(&cpu, arm::CORE[2], 0x1_2345);
+    run(&cpu, 0x1000, 2).unwrap();
+    assert_eq!((get(&cpu, arm::CORE[0]), get(&cpu, arm::CORE[3])), (0x8877, 0));
+    assert_eq!(memory(&cpu), [0x55, 0xaa, 0x45, 0x23]);
+    // A cleared reservation, a store of another width and a second store all fail
+    // without writing.
+    for program in [
+        [0xe1f10f9f, 0xf57ff01f, 0xe1e13f92], // ldrexh; clrex; strexh
+        [0xe1f10f9f, 0xe320f000, 0xe1c13f92], // ldrexh; nop; strexb
+        [0xe1e13f92, 0xe320f000, 0xe1e13f92], // strexh with no reservation, twice
+    ] {
+        words(&cpu, 0x1000, &program);
+        set(&cpu, arm::CORE[2], 0xbeef);
+        run(&cpu, 0x1000, 3).unwrap();
+        assert_eq!(get(&cpu, arm::CORE[3]), 1);
+        assert_eq!(memory(&cpu), [0x55, 0xaa, 0x45, 0x23]);
+    }
+    // ldrexb r0,[r1]; strexb r3,r2,[r1] in Thumb, then the halfword pair.
+    cpu.write_memory(0x1000, &[0xd1, 0xe8, 0x4f, 0x0f, 0xc1, 0xe8, 0x43, 0x2f])
+        .unwrap();
+    set(&cpu, arm::CORE[1], 0x1800);
+    set(&cpu, arm::CORE[2], 0x11);
+    run(&cpu, 0x1001, 2).unwrap();
+    assert_eq!((get(&cpu, arm::CORE[0]), get(&cpu, arm::CORE[3])), (0x55, 0));
+    cpu.write_memory(0x1000, &[0xd1, 0xe8, 0x5f, 0x0f, 0xc1, 0xe8, 0x53, 0x2f])
+        .unwrap();
+    set(&cpu, arm::CORE[1], 0x1802);
+    set(&cpu, arm::CORE[2], 0x6789);
+    run(&cpu, 0x1001, 2).unwrap();
+    assert_eq!((get(&cpu, arm::CORE[0]), get(&cpu, arm::CORE[3])), (0x2345, 0));
+    assert_eq!(memory(&cpu), [0x11, 0xaa, 0x89, 0x67]);
+    // ldrexh; clrex; strexh in Thumb fails without writing.
+    cpu.write_memory(
+        0x1000,
+        &[0xd1, 0xe8, 0x5f, 0x0f, 0xbf, 0xf3, 0x2f, 0x8f, 0xc1, 0xe8, 0x53, 0x2f],
+    )
+    .unwrap();
+    set(&cpu, arm::CORE[2], 0x1111);
+    run(&cpu, 0x1001, 3).unwrap();
+    assert_eq!((get(&cpu, arm::CORE[0]), get(&cpu, arm::CORE[3])), (0x6789, 1));
+    assert_eq!(memory(&cpu), [0x11, 0xaa, 0x89, 0x67]);
+    // Unaligned halfwords and doubleword exclusives refuse.
+    for (program, address, message) in [
