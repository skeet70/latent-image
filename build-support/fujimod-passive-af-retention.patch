+#[test]
+fn unresolved_accesses_in_original_data_hook_padding_keep_source_specific_terminal_scope() {
+    for (instruction, protected_access) in [(0xe5810000u32, true), (0xe5912000, false)] {
+        for current in [PassivePhase::Unarmed, PassivePhase::Armed, PassivePhase::Ended, PassivePhase::Refused] {
+            let maps = vec![
+                MemoryMap { core: 0, address: 0x10000, physical: 0x10000, size: 0x1000, permissions: 7 },
+                MemoryMap { core: 0, address: 0x20000, physical: 0x11000, size: 0x1000, permissions: 7 },
+            ];
+            let graph = Graph {
+                decoders: vec![], processors: vec![Processor {
+                    rprofile: Some(Default::default()), mprofile: None, model: Model::CortexR5F,
+                    registers: vec![(Register::Pc, 0x10000), (Register::Arm32(arm::Register::R(1)), 0x1fff4)],
+                    released: true,
+                }],
+                dma_mappings: vec![crate::board::memory::BusMapping::ram(0x10000, 0x2000)],
+                ram: vec![Ram { base: 0x10000, size: 0x2000 }], mappings: maps.clone(), peripherals: vec![],
+                instructions_per_tick: Ratio::new(1, 1).unwrap(),
+            };
+            let mut board = graph.build(
+                Options { engine: Engine::Unicorn, translation_cache_bytes: 1024 * 1024 },
+                Bus::new(bus::Mode::Strict), None,
+            ).unwrap();
+            board.cpu(0).unwrap().map_zeroed(0x1f000, 0x1000, 7).unwrap();
+            write_code(&board, 0x10000, &[0xe3a00029, instruction, 0xeafffffe]);
+            let mut watch = install(&board, maps, 4, 8);
+            phase(&watch, current);
+            let run = board.run_until(3, 100);
+            if protected_access {
+                assert!(watch.records.borrow().violation().is_some());
+                assert_eq!(watch.instruction_guard_status().unwrap().first_failure.unwrap().kind, InstructionGuardFailure::ObservationFailed);
+            } else {
+                run.unwrap();
+                assert!(watch.records.borrow().violation().is_none());
+                assert!(watch.instruction_guard_status().unwrap().first_failure.is_none());
+                assert_eq!(watch.records.borrow().passive_retention_status(), status_after_passive_failure(current));
+            }
+            assert_eq!(watch.records.borrow().row_count(), 0);
+            board.memory_watch_end(&mut watch).unwrap();
+        }
+    }
+}
