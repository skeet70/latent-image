+#[test]
+fn valid_passive_cache_cannot_satisfy_an_original_protected_fetch_requirement() {
+    let (mut board, maps) = board();
+    let passive = passive(8).with_fetch_attribution(PassiveFetchAttribution::new(CpuDataAttribution::Writes,
+        vec![WatchRange { start: 0x10000, end: 0x10010, kinds: WatchKinds::CPU_FETCH }]).unwrap());
+    let mut watch = board.memory_watch_begin_with_passive_fetch_attribution(
+        protected(), remote_attribution(CpuDataAttribution::Writes), 2, maps, ViewPolicy::Fixed, passive,
+    ).unwrap();
+    watch.records.borrow_mut().arm_passive_retention().unwrap();
+    let _ = board.run_until(4, 100);
+    assert!(watch.records.borrow().violation().is_some());
+    assert_eq!(watch.instruction_guard_status().unwrap().first_failure.unwrap().kind, InstructionGuardFailure::ObservationFailed);
+    assert!(watch.records.borrow().rows_since(0).unwrap()[0]["latest_fetch"].is_null());
+    board.memory_watch_end(&mut watch).unwrap();
+}
