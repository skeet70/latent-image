+fn board_with_tcm(base: Option<u32>) -> (Board, Vec<MemoryMap>) {
+    let maps = vec![MemoryMap { core: 0, address: 0x10000, physical: 0x10000, size: 0x2000, permissions: 7 }];
+    let graph = Graph {
+        decoders: vec![],
+        processors: vec![Processor {
+            rprofile: Some(rprofile::core::Options {
+                tcm: base.map(|base| rprofile::tcm::Options {
+                    atcm: rprofile::tcm::BankOptions { bytes: 0x1000, reset: base | 1 },
+                    ..Default::default()
+                }).unwrap_or_default(),
+                ..Default::default()
+            }), mprofile: None, model: Model::CortexR5F,
+            registers: vec![(Register::Pc, 0x10000), (Register::Arm32(arm::Register::R(1)), 0x11000)],
+            released: true,
+        }],
+        dma_mappings: vec![crate::board::memory::BusMapping::ram(0x10000, 0x2000)], ram: vec![Ram { base: 0x10000, size: 0x2000 }],
+        mappings: maps.clone(), peripherals: vec![], instructions_per_tick: Ratio::new(1, 1).unwrap(),
+    };
+    let board = graph.build(
+        Options { engine: Engine::Unicorn, translation_cache_bytes: 1024 * 1024 },
+        Bus::new(bus::Mode::Strict), None,
+    ).unwrap();
+    let code = [0xe3a00029u32, 0xe5810000, 0xe5912000, 0xeafffffd];
+    board.write_physical(0x10000, &code.into_iter().flat_map(u32::to_le_bytes).collect::<Vec<_>>()).unwrap();
