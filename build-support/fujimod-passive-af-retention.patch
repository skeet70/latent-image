+#[derive(Clone, Copy)]
+enum PassivePhase { Unarmed, Armed, Ended, Refused }
+fn phase(watch: &MemoryWatch, phase: PassivePhase) {
+    match phase {
+        PassivePhase::Unarmed => {}
+        PassivePhase::Armed => watch.records.borrow_mut().arm_passive_retention().unwrap(),
+        PassivePhase::Ended => watch.records.borrow_mut().stop_passive_retention(PassiveStopReason::End).unwrap(),
+        PassivePhase::Refused => watch.records.borrow_mut().stop_passive_retention(PassiveStopReason::Refused).unwrap(),
+    }
+}
+fn status_after_passive_failure(phase: PassivePhase) -> PassiveRetentionStatus {
+    match phase {
+        PassivePhase::Unarmed => PassiveRetentionStatus::Unarmed,
+        PassivePhase::Armed => PassiveRetentionStatus::Stopped(PassiveStopReason::ProvenanceUnavailable),
+        PassivePhase::Ended => PassiveRetentionStatus::Stopped(PassiveStopReason::End),
+        PassivePhase::Refused => PassiveRetentionStatus::Stopped(PassiveStopReason::Refused),
+    }
+}
