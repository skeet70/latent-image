+    ).unwrap();
+    watch.records.borrow_mut().arm_passive_retention().unwrap();
+    board.run_until(4, 100).unwrap();
+    assert!(watch.records.borrow().violation().is_none());
+    assert!(watch.instruction_guard_status().unwrap().first_failure.is_none());
+    assert_eq!(watch.records.borrow().passive_retention_status(),
+        PassiveRetentionStatus::Stopped(PassiveStopReason::ProvenanceUnavailable));
+    assert!(watch.records.borrow().rows_since(0).unwrap()[0].get("latest_fetch").is_none());
+    assert!(watch.records.borrow().rows_since(0).unwrap()[0].get("core_instructions").is_none());
+    board.write_physical(0x11000, &[1]).unwrap();
+    board.write_physical(0x11000, &[2]).unwrap();
+    assert!(watch.records.borrow().violation().is_some());
+    assert_eq!(watch.instruction_guard_status().unwrap().first_failure.unwrap().kind, InstructionGuardFailure::ObservationFailed);
+    board.memory_watch_end(&mut watch).unwrap();
+}
