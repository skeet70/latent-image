--- /dev/null
+++ b/crates/emulator/src/board/observation/passive.rs
@@ -0,0 +1,180 @@
+use super::{Board, CpuSource, FetchAttribution, MemoryMap, MemoryWatch, PassiveFetchAttribution, Records, Span, ViewPolicy, WatchKinds, WatchRange};
+use serde_json::{Value, json};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Serialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum PassiveStopReason { End, Refused, CapacityExceeded, ProvenanceUnavailable }
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Serialize)]
+#[serde(tag = "state", content = "reason", rename_all = "kebab-case")]
+pub enum PassiveRetentionStatus { Disabled, Unarmed, Armed, Stopped(PassiveStopReason) }
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Serialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum PassiveCaptureFailure { UnresolvedPhysical, CpuCapture, MissingFetch }
+
+#[derive(Debug, serde::Serialize)]
+pub struct PassiveCaptureRefusal {
+    pub kind: PassiveCaptureFailure,
+    pub detail: String,
+}
+
+pub struct PassiveRetention {
+    classes: Vec<WatchRange>,
+    row_limit: usize,
+    attribution: Option<PassiveFetchAttribution>,
+}
+impl PassiveRetention {
+    pub fn new(classes: Vec<WatchRange>, row_limit: usize) -> Result<Self, String> {
+        if classes.is_empty() || classes.len() > 256 || row_limit == 0 || row_limit > 65_536
+            || classes.iter().any(|range| range.start >= range.end || range.end > 1 << 32 || range.kinds.0 == 0)
+        {
+            return Err("Passive retention requires bounded classified ranges and at most 65536 rows".into());
+        }
+        Ok(Self { classes, row_limit, attribution: None })
+    }
+    pub fn with_fetch_attribution(mut self, attribution: PassiveFetchAttribution) -> Self {
+        self.attribution = Some(attribution);
+        self
+    }
+}
+
+struct TerminalCpuSpans {
+    reads: Vec<Span>,
+    writes: Vec<Span>,
+    fetches: Vec<Span>,
+}
+pub(super) struct PassiveCapture {
+    protected: Vec<WatchRange>,
+    classes: Vec<WatchRange>,
+    terminal_hooks: Vec<TerminalCpuSpans>,
+    pub(super) protected_rows: usize,
+    passive_rows: usize,
+    row_limit: usize,
+    status: PassiveRetentionStatus,
+    failure: Option<PassiveCaptureRefusal>,
+}
+impl PassiveCapture {
+    pub(super) fn describe(&self, state: &mut Value) {
+        state["passive_retention"] = json!({
+            "mode":"passive-class-retention-v1", "status":self.status,
+            "protected_rows":self.protected_rows, "passive_rows":self.passive_rows,
+            "row_limit":self.row_limit, "failure":self.failure,
+        });
+    }
+    fn matches(classes: &[WatchRange], source: &str, address: u64, bytes: u64) -> bool {
+        WatchKinds::from_source(source).is_some_and(|kind| classes.iter().any(|range| {
+            range.kinds.contains(kind) && address < range.end && range.start < address.saturating_add(bytes)
+        }))
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(super) enum RetentionClass { Protected, Passive, Skip }
+
+impl Records {
+    pub fn passive_retention_status(&self) -> PassiveRetentionStatus {
+        self.passive.as_ref().map_or(PassiveRetentionStatus::Disabled, |capture| capture.status)
+    }
+    pub fn passive_retention_failure(&self) -> Option<&PassiveCaptureRefusal> {
+        self.passive.as_ref().and_then(|capture| capture.failure.as_ref())
+    }
+    pub(super) fn passive_failed(&mut self, kind: PassiveCaptureFailure, detail: String) {
+        if let Some(capture) = &mut self.passive {
+            if capture.status == PassiveRetentionStatus::Armed {
+                capture.status = PassiveRetentionStatus::Stopped(PassiveStopReason::ProvenanceUnavailable);
+                capture.failure = Some(PassiveCaptureRefusal { kind, detail });
+            }
+        }
+    }
+    pub(super) fn passive_data(&self, source: &str, address: u64, bytes: u64) -> bool {
+        self.passive.as_ref().is_some_and(|capture| capture.status == PassiveRetentionStatus::Armed
+            && PassiveCapture::matches(&capture.classes, source, address, bytes))
+    }
+    pub(super) fn passive_only(&self, source: &str, address: u64, bytes: u64) -> bool {
+        self.passive.as_ref().is_some_and(|capture| !PassiveCapture::matches(&capture.protected, source, address, bytes))
+    }
+    pub(super) fn original_cpu_hook(&self, core: usize, source: CpuSource, address: u64, bytes: u64) -> bool {
+        self.passive.as_ref().is_none_or(|capture| {
+            let hooks = &capture.terminal_hooks[core];
+            let spans = match source {
+                CpuSource::CpuRead => &hooks.reads,
+                CpuSource::CpuWrite => &hooks.writes,
+                CpuSource::CpuFetch => &hooks.fetches,
+            };
+            spans.iter().any(|&(start, end)| address < end && start < address.saturating_add(bytes))
+        })
+    }
+    pub(super) fn passive_fetch_only(&self, core: usize, address: u64, bytes: u64) -> bool {
+        !self.original_cpu_hook(core, CpuSource::CpuFetch, address, bytes)
+    }
+    pub fn arm_passive_retention(&mut self) -> Result<(), String> {
+        let capture = self.passive.as_mut().ok_or("Passive retention is disabled")?;
+        if capture.status != PassiveRetentionStatus::Unarmed {
+            return Err("Passive retention can only be armed once".into());
+        }
+        capture.status = PassiveRetentionStatus::Armed;
+        Ok(())
+    }
+    pub fn stop_passive_retention(&mut self, reason: PassiveStopReason) -> Result<(), String> {
+        if matches!(reason, PassiveStopReason::CapacityExceeded | PassiveStopReason::ProvenanceUnavailable) {
+            return Err("Passive recorder failures can only be reported by the recorder".into());
+        }
+        let capture = self.passive.as_mut().ok_or("Passive retention is disabled")?;
+        if matches!(capture.status, PassiveRetentionStatus::Unarmed | PassiveRetentionStatus::Armed) {
+            capture.status = PassiveRetentionStatus::Stopped(reason);
+        }
+        Ok(())
+    }
+    pub(super) fn retention(&mut self, source: &str, address: u64, bytes: u64) -> RetentionClass {
+        let Some(capture) = &mut self.passive else { return RetentionClass::Protected; };
+        let protected = PassiveCapture::matches(&capture.protected, source, address, bytes);
+        if protected { return RetentionClass::Protected; }
+        if capture.status != PassiveRetentionStatus::Armed { return RetentionClass::Skip; }
+        if capture.passive_rows == capture.row_limit {
+            capture.status = PassiveRetentionStatus::Stopped(PassiveStopReason::CapacityExceeded);
+            return RetentionClass::Skip;
+        }
+        RetentionClass::Passive
+    }
+    pub(super) fn push_retained(&mut self, row: Value, retention: RetentionClass) {
+        match retention {
+            RetentionClass::Protected => self.push(row),
+            RetentionClass::Passive if self.violation.is_none() => {
+                self.rows.push(row);
+                self.passive.as_mut().unwrap().passive_rows += 1;
+            }
+            RetentionClass::Passive | RetentionClass::Skip => {}
+        }
+    }
+}
+
+impl Board {
+    pub fn memory_watch_begin_with_passive_fetch_attribution(
+        &self, protected_classes: Vec<WatchRange>, mut attribution: FetchAttribution, protected_limit: usize,
+        maps: Vec<MemoryMap>, views: ViewPolicy, passive: PassiveRetention,
+    ) -> Result<Box<MemoryWatch>, String> {
+        if protected_classes.is_empty() || protected_limit == 0 || protected_limit > 1_048_576 {
+            return Err("Passive watch requires protected classes and at most 1048576 protected rows".into());
+        }
+        let terminal_hooks = self.cpus.iter().enumerate().map(|(core, _)| {
+            let decoder_maps = self.state.borrow().decoders.observation_maps(core);
+            let processor_maps = maps.iter().filter(|map| map.core == core).chain(&decoder_maps);
+            TerminalCpuSpans {
+                reads: super::fetch_attribution::mapped_spans_for(processor_maps.clone(), &protected_classes, WatchKinds::CPU_READ),
+                writes: super::fetch_attribution::mapped_spans_for(processor_maps.clone(), &protected_classes, WatchKinds::CPU_WRITE),
+                fetches: attribution.terminal_spans(processor_maps, &protected_classes),
+            }
+        }).collect();
+        attribution.passive = passive.attribution;
+        let mut classes = protected_classes.clone();
+        classes.extend(passive.classes.iter().copied());
+        let watch = self.memory_watch_begin_with_fetch_attribution(classes, attribution, protected_limit, maps, views)?;
+        watch.records.borrow_mut().passive = Some(PassiveCapture {
+            protected: protected_classes, protected_rows: 0, passive_rows: 0,
+            classes: passive.classes, terminal_hooks, failure: None,
+            row_limit: passive.row_limit, status: PassiveRetentionStatus::Unarmed,
+        });
+        Ok(watch)
+    }
+}
