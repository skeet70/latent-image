+#[test]
+fn primary_bit0_common_gates_cancel_edges_and_resume_after_the_original_delay() {
+    for (offset, closed, open) in [(0x48, 0, 1), (0x70, 1, 0)] {
+        for (mask, expected) in [
+            (1, &[(0, 39)][..]),
+            (0x10003, &[(0, 39), (1, 41)][..]),
+        ] {
+            let mut h = TestHost::new();
+            let mut d = primary_gate_device(Some(InputEnablePrimaryGate::SourceBit0));
+            write(&mut d, &mut h, 0xfff10048, 1);
+            write(&mut d, &mut h, 0xfff1038c, mask);
+            advance(&mut d, &mut h, 5);
+            write(&mut d, &mut h, 0xfff10000 + offset, closed);
+            assert_eq!(read(&mut d, &mut h, 0xfff10000 + offset), u64::from(closed));
+            advance(&mut d, &mut h, 15);
+            assert!(h.irqs.is_empty());
+            write(&mut d, &mut h, 0xfff10000 + offset, open);
+            advance(&mut d, &mut h, 24);
+            assert!(h.irqs.is_empty());
+            advance(&mut d, &mut h, 25);
+            assert_eq!(h.irqs, expected);
+        }
+    }
+}
+#[test]
+fn primary_bit0_reset_cancels_edges_and_restarts_after_reset_completion() {
+    for (mask, expected_readback, expected) in [
+        (1, 1, &[(0, 39)][..]),
+        (0x10003, 0x10201, &[(0, 39), (1, 41)][..]),
+    ] {
+        let mut h = TestHost::new();
+        let mut d = primary_gate_device(Some(InputEnablePrimaryGate::SourceBit0));
+        write(&mut d, &mut h, 0xfff10048, 1);
+        write(&mut d, &mut h, 0xfff1038c, mask);
+        advance(&mut d, &mut h, 9);
+        write(&mut d, &mut h, 0xfff10000, 0);
+        advance(&mut d, &mut h, 10);
+        assert_eq!(read(&mut d, &mut h, 0xfff10000), 0);
+        assert!(h.irqs.is_empty());
+        advance(&mut d, &mut h, 11);
+        assert_eq!(read(&mut d, &mut h, 0xfff10000), 1);
+        assert_eq!(read(&mut d, &mut h, 0xfff1038c), expected_readback);
+        advance(&mut d, &mut h, 20);
+        assert!(h.irqs.is_empty());
+        advance(&mut d, &mut h, 21);
+        assert_eq!(h.irqs, expected);
+    }
+}
+#[test]
+fn primary_gate_choice_preserves_source1_stored_bits_secondary_and_companion_gates() {
+    for gate in [InputEnablePrimaryGate::SharedBit16, InputEnablePrimaryGate::SourceBit0] {
+        for (mask, secondary, companion, enabled) in [
+            (1, true, true, false),
+            (2, true, true, false),
+            (0x200, true, true, false),
+            (0x202, true, true, false),
+            (0x10002, true, false, true),
+            (0x10003, true, false, false),
+            (0x10003, true, true, true),
+            (0x10002, false, true, false),
+            (0x10003, false, true, false),
+            (0x10200, true, true, false),
+            (0x10201, true, true, false),
+            (0x10202, true, true, true),
+            (0x10203, true, true, true),
+        ] {
+            let mut plan = input_enable_plan(Some("exchanged_source_bits"));
+            plan["clock"]["primary_gate"] = serde_json::to_value(gate).unwrap();
+            plan["clock"]["secondary"] = serde_json::json!(secondary);
+            plan["clock"]["companion_secondary"] = serde_json::json!(companion);
+            let mut d = ImageInput::new(serde_json::from_value(plan).unwrap(), input_wiring()).unwrap();
+            let mut h = TestHost::new();
+            write(&mut d, &mut h, 0xfff10048, 1);
+            write(&mut d, &mut h, 0xfff1038c, mask);
+            advance(&mut d, &mut h, 10);
+            assert_eq!(h.irqs.contains(&(1, 41)), enabled);
+            write(&mut d, &mut h, 0xfff10388, 0);
+            advance(&mut d, &mut h, 20);
+            assert_eq!(h.irqs.iter().filter(|irq| **irq == (1, 41)).count(), if enabled { 2 } else { 0 });
+        }
+    }
+}
