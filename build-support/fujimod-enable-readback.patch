+#[test]
+fn primary_gate_json_preserves_legacy_clock_shape_and_omits_the_default() {
+    let legacy = input_enable_plan(None)["clock"].clone();
+    let clock: options::input::Clock = serde_json::from_value(legacy.clone()).unwrap();
+    assert_eq!(serde_json::to_value(clock).unwrap(), legacy);
+    for gate in [InputEnablePrimaryGate::SharedBit16, InputEnablePrimaryGate::SourceBit0] {
+        let mut explicit = legacy.clone();
+        explicit["primary_gate"] = serde_json::to_value(gate).unwrap();
+        let clock: options::input::Clock = serde_json::from_value(explicit.clone()).unwrap();
+        let expected = if gate == InputEnablePrimaryGate::SharedBit16 { &legacy } else { &explicit };
+        assert_eq!(&serde_json::to_value(clock).unwrap(), expected);
+    }
+    for mode in ["register_periods", "source_mask"] {
+        let mut plan = legacy.clone();
+        plan["mode"] = serde_json::json!(mode);
+        let clock: options::input::Clock = serde_json::from_value(plan.clone()).unwrap();
+        assert_eq!(serde_json::to_value(clock).unwrap(), plan);
+        plan["primary_gate"] = serde_json::json!("source_bit0");
+        assert!(serde_json::from_value::<options::input::Clock>(plan).is_err());
+    }
+    let mut unknown = legacy.clone();
+    unknown["primary_gate"] = serde_json::json!("unmodeled_gate");
+    assert!(serde_json::from_value::<options::input::Clock>(unknown).is_err());
+    let mut unknown = legacy;
+    unknown["unmodeled_gate"] = serde_json::json!(true);
+    assert!(serde_json::from_value::<options::input::Clock>(unknown).is_err());
+}
