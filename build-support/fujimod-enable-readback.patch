+#[test]
+fn primary_bit0_delivers_irq39_stops_at_zero_and_restarts_at_one_without_irq41() {
+    let mut h = TestHost::new();
+    let mut d = primary_gate_device(Some(InputEnablePrimaryGate::SourceBit0));
+    for (o, v) in [(0x48, 1), (0x38c, 1)] {
+        write(&mut d, &mut h, 0xfff10000 + o, v);
+    }
+    assert_eq!(read(&mut d, &mut h, 0xfff10000), 0);
+    assert_eq!(read(&mut d, &mut h, 0xfff1038c), 1);
+    advance(&mut d, &mut h, 9);
+    assert!(h.irqs.is_empty());
+    advance(&mut d, &mut h, 10);
+    assert_eq!(h.irqs, [(0, 39)]);
+    advance(&mut d, &mut h, 20);
+    assert_eq!(h.irqs, [(0, 39)]);
+    write(&mut d, &mut h, 0xfff10388, 1);
+    advance(&mut d, &mut h, 29);
+    assert_eq!(h.irqs, [(0, 39)]);
+    write(&mut d, &mut h, 0xfff1038c, 0);
+    assert_eq!(read(&mut d, &mut h, 0xfff1038c), 0);
+    advance(&mut d, &mut h, 40);
+    assert_eq!(h.irqs, [(0, 39)]);
+    write(&mut d, &mut h, 0xfff1038c, 1);
+    advance(&mut d, &mut h, 49);
+    assert_eq!(h.irqs, [(0, 39)]);
+    advance(&mut d, &mut h, 50);
+    assert_eq!(read(&mut d, &mut h, 0xfff1038c), 1);
+    assert_eq!(h.irqs, [(0, 39), (0, 39)]);
+}
