+fn input_enable_plan(enable_readback: Option<&str>) -> serde_json::Value {
+    let mut options = serde_json::json!({
+        "reset_ticks": 2, "command_ticks": 3, "phase_ticks": 2, "command": null, "command_controls": [0],
+        "phase_ack": "enabled",
+        "clock": {"mode": "input_enable", "source": {"kind": "periodic", "period_ticks": 10, "first_delay_ticks": null},
+            "secondary": true, "companion_secondary": true},
+        "sensor_period_ticks": null, "raw_dma_ticks": 5, "readback_ticks": 7, "cfa": null
+    });
+    if let Some(law) = enable_readback {
+        options["enable_readback"] = serde_json::json!(law);
+    }
+    options
+}
+fn input_enable_device(enable_readback: Option<&str>) -> ImageInput {
+    let options = serde_json::from_value(input_enable_plan(enable_readback)).unwrap();
+    ImageInput::new(options, input_wiring()).unwrap()
+}
+#[test]
+fn exchanged_readback_keeps_source1_running_across_selector0_registration_and_removal() {
+    let mut h = TestHost::new();
+    let mut d = input_enable_device(Some("exchanged_source_bits"));
+    for (o, v) in [(0x48, 1), (0x38c, 0x10002)] {
+        write(&mut d, &mut h, 0xfff10000 + o, v);
+    }
+    advance(&mut d, &mut h, 10);
+    assert_eq!(h.irqs, [(1, 41)]);
+    write(&mut d, &mut h, 0xfff10388, 0);
+    assert_eq!(read(&mut d, &mut h, 0xfff1038c), 0x10200);
+    // The X-M1 1.50 0x0074100c(0, 1) store after that read.
+    write(&mut d, &mut h, 0xfff1038c, 0x10003);
+    advance(&mut d, &mut h, 20);
+    assert_eq!(h.irqs, [(1, 41), (0, 39), (1, 41)]);
+    for ack in [1, 0] {
+        write(&mut d, &mut h, 0xfff10388, ack);
+    }
+    assert_eq!(read(&mut d, &mut h, 0xfff1038c), 0x10201);
+    // 0x0074100c(0, 0) after that read.
+    write(&mut d, &mut h, 0xfff1038c, 0x10002);
+    advance(&mut d, &mut h, 30);
+    assert_eq!(h.irqs[3..], [(1, 41)]);
+}
+#[test]
+fn exchanged_readback_last_selector1_removal_stops_source1() {
+    for (registered, read_back, removed) in [(0x10003, 0x10201, 1), (0x10002, 0x10200, 0)] {
+        let mut h = TestHost::new();
+        let mut d = input_enable_device(Some("exchanged_source_bits"));
+        for (o, v) in [(0x48, 1), (0x38c, registered)] {
+            write(&mut d, &mut h, 0xfff10000 + o, v);
+        }
+        advance(&mut d, &mut h, 10);
+        assert!(h.irqs.contains(&(1, 41)));
+        for ack in [1, 0] {
+            write(&mut d, &mut h, 0xfff10388, ack);
+        }
+        assert_eq!(read(&mut d, &mut h, 0xfff1038c), read_back);
+        // 0x0074100c(1, 0) after that read.
+        write(&mut d, &mut h, 0xfff1038c, removed);
+        let delivered = h.irqs.len();
+        advance(&mut d, &mut h, 20);
+        assert!(!h.irqs[delivered..].contains(&(1, 41)));
+    }
+}
+#[test]
+fn exchanged_readback_keeps_the_enable_mask_domain() {
+    let mut h = TestHost::new();
+    let mut d = input_enable_device(Some("exchanged_source_bits"));
+    for unsupported in [0x10001, 0x10000] {
+        let mut cx = h.cx();
+        d.write(&mut cx, 0xfff1038c, 4, unsupported);
+        assert!(cx.refusal().is_some());
+    }
+}
+#[test]
+fn exchanged_readback_leaves_the_source1_gate_on_the_stored_word() {
+    let mut h = TestHost::new();
+    let mut d = input_enable_device(Some("exchanged_source_bits"));
+    for (o, v) in [(0x48, 1), (0x38c, 0x10200)] {
+        write(&mut d, &mut h, 0xfff10000 + o, v);
+    }
+    assert_eq!(read(&mut d, &mut h, 0xfff1038c), 0x10002);
+    assert_eq!(d.next_deadline(0), None);
+    advance(&mut d, &mut h, 10);
+    assert!(h.irqs.is_empty());
+}
+#[test]
+fn plan_without_enable_readback_reads_the_stored_mask_and_refuses_an_unselected_enable() {
+    let mut h = TestHost::new();
+    let mut d = input_enable_device(None);
+    for (o, v) in [(0x48, 1), (0x38c, 0x10002)] {
+        write(&mut d, &mut h, 0xfff10000 + o, v);
+    }
+    advance(&mut d, &mut h, 10);
+    assert_eq!(h.irqs, [(1, 41)]);
+    write(&mut d, &mut h, 0xfff10388, 0);
+    assert_eq!(read(&mut d, &mut h, 0xfff1038c), 0x10002);
+    // 0x0074100c(0, 1) after that read.
+    write(&mut d, &mut h, 0xfff1038c, 0x10201);
+    advance(&mut d, &mut h, 20);
+    assert_eq!(h.irqs[1..], [(0, 39)]);
+    let mut cx = h.cx();
+    d.write(&mut cx, 0xfff1038c, 4, 0x10001);
+    assert!(cx.refusal().is_some());
+}
+#[test]
+fn plan_refuses_an_unknown_enable_readback() {
+    let plan = input_enable_plan(Some("exchanged_all_bits"));
+    assert!(serde_json::from_value::<options::input::Options>(plan).is_err());
+}
