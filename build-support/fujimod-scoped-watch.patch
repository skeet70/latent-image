+#[test]
+fn ending_a_replaced_legacy_watch_leaves_the_scoped_watch_armed() {
+    let board = board();
+    let maps = board.mappings().to_vec();
+    let range = vec![(SHARED_PHYSICAL, SHARED_PHYSICAL + 4)];
+    let mut replaced = board.memory_watch_begin(range.clone(), 8, maps.clone()).unwrap();
+    let mut current = board.memory_watch_begin(range, 8, maps).unwrap();
+    board.memory_watch_end(&mut current).unwrap();
+    let scoped = begin(&board, host_writes());
+    board.memory_watch_end(&mut replaced).unwrap();
+    board.write_physical(SHARED_PHYSICAL, &[1, 0, 0, 0]).unwrap();
+    assert_eq!(rows(&scoped.state()["records"]).len(), 1);
+    assert!(board.checkpoint(None).is_err());
+    drop(scoped);
+    assert!(board.checkpoint(None).is_ok());
+}
