+#[test]
+fn an_active_scoped_watch_excludes_other_observers_and_keyframes() {
+    let mut board = board();
+    let maps = board.mappings().to_vec();
+    let legacy_range = vec![(SHARED_PHYSICAL, SHARED_PHYSICAL + 4)];
+    let protected = || {
+        ProtectedRanges::new(vec![PhysicalRange::new(SHARED_PHYSICAL, SHARED_PHYSICAL + 4).unwrap()])
+            .unwrap()
+    };
+    let keyframe = board.checkpoint(None).unwrap();
+    let mut legacy = board.memory_watch_begin(legacy_range.clone(), 8, maps.clone()).unwrap();
+    assert!(board.memory_watch_begin_scoped(host_writes(), maps.clone()).is_err());
+    board.memory_watch_end(&mut legacy).unwrap();
+    let preservation = board.preservation_begin(protected()).unwrap();
+    assert!(board.memory_watch_begin_scoped(host_writes(), maps.clone()).is_err());
+    drop(preservation);
+
+    let mut scoped = begin(&board, host_writes());
+    assert!(board.memory_watch_begin(legacy_range.clone(), 8, maps.clone()).is_err());
+    assert!(
+        board
+            .memory_watch_begin_classified(
+                vec![WatchRange {
+                    start: SHARED_PHYSICAL,
+                    end: SHARED_PHYSICAL + 4,
+                    kinds: WatchKinds::ALL,
+                }],
+                8,
+                maps.clone(),
+                ViewPolicy::Fixed,
+            )
+            .is_err()
+    );
+    assert!(board.preservation_begin(protected()).is_err());
+    assert!(board.memory_watch_begin_scoped(host_writes(), maps.clone()).is_err());
+    assert!(board.checkpoint(None).is_err());
+    assert!(board.restore_keyframe(&keyframe).is_err());
+    board.write_physical(SHARED_PHYSICAL, &[1, 0, 0, 0]).unwrap();
+    board.memory_watch_end_scoped(&mut scoped).unwrap();
+    board.write_physical(SHARED_PHYSICAL, &[2, 0, 0, 0]).unwrap();
+    let state = scoped.state();
+    assert_eq!(state["enabled"], false);
+    assert_eq!(rows(&state["records"]).len(), 1);
+
+    board.restore_keyframe(&keyframe).unwrap();
+    let mut legacy = board.memory_watch_begin(legacy_range, 8, maps).unwrap();
+    board.memory_watch_end(&mut legacy).unwrap();
+}
