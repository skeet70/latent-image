+#[test]
+fn malformed_scoped_watches_are_refused_without_disarming_the_board() {
+    let mut board = board();
+    let rule = |cores_: &[usize], access, rule| ConfinementRule {
+        cores: cores(cores_),
+        access,
+        rule,
+    };
+    let write_allow = || rule(&[1], Access::Write, Confinement::Allow(vec![physical(0x13000, 0x13100)]));
+    let counter = || CounterRule {
+        cores: cores(&[1]),
+        cell: PhysicalWord::new(SHARED_PHYSICAL).unwrap(),
+        head: SampleBound::new(1).unwrap(),
+        tail: SampleBound::new(1).unwrap(),
+    };
+    let coverage = |start, end| CoverageRule {
+        cores: cores(&[1]),
+        range: WordRange::new(start, end).unwrap(),
+    };
+    let refused = [
+        rules(vec![]),
+        rules(vec![rule(&[1], Access::Fetch, Confinement::Allow(vec![physical(0x11000, 0x11100)]))]),
+        rules(vec![write_allow(), write_allow()]),
+        rules(vec![rule(
+            &[1],
+            Access::Read,
+            Confinement::Forbid(vec![physical(0x11000, 0x11100), physical(0x110f0, 0x11200)]),
+        )]),
+        rules(vec![rule(&[0], Access::Write, Confinement::Allow(vec![atcm(0, 4)]))]),
+        rules(vec![rule(&[1], Access::Write, Confinement::Allow(vec![atcm(0, 0x1004)]))]),
+        rules(vec![rule(&[1], Access::Write, Confinement::Allow(vec![physical(0x40000, 0x40004)]))]),
+        rules(vec![rule(&[2], Access::Write, Confinement::Allow(vec![physical(0x13000, 0x13100)]))]),
+        ScopedWatch {
+            classes: vec![WatchRange {
+                start: SHARED_PHYSICAL,
+                end: SHARED_PHYSICAL + 4,
+                kinds: WatchKinds::CPU_READ,
+            }],
+            counters: vec![counter()],
+            ..rules(vec![])
+        },
+        ScopedWatch {
+            counters: vec![counter(), counter()],
+            ..rules(vec![])
+        },
+        ScopedWatch {
+            coverage: vec![
+                coverage(SHARED_PHYSICAL, SHARED_PHYSICAL + 8),
+                coverage(SHARED_PHYSICAL + 4, SHARED_PHYSICAL + 12),
+            ],
+            ..rules(vec![])
+        },
+        ScopedWatch {
+            limit: 0,
+            ..rules(vec![write_allow()])
+        },
+    ];
+    for (case, watch) in refused.into_iter().enumerate() {
+        assert!(
+            board.memory_watch_begin_scoped(watch, board.mappings().to_vec()).is_err(),
+            "case {case}"
+        );
+        let mut accepted = begin(&board, host_writes());
+        board.write_physical(SHARED_PHYSICAL, &[1, 2, 3, 4]).unwrap();
+        assert_eq!(rows(&accepted.state()["records"]).len(), 1, "case {case}");
+        accepted.end().unwrap();
+    }
+    assert!(CoreSet::new(&[]).is_err());
+    assert!(CoreSet::new(&[8]).is_err());
+    assert!(TcmRange::new(TcmBank::Btcm, 4, 4).is_err());
+    assert!(PhysicalWord::new(SHARED_PHYSICAL + 2).is_err());
+    assert!(SampleBound::new(65).is_err());
+    assert!(WordRange::new(SHARED_PHYSICAL, SHARED_PHYSICAL + 6).is_err());
+    assert!(WordRange::new(0, (1 << 22) + 4).is_err());
+    board.set_execution_policy(ExecutionPolicy::Interactive).unwrap();
+    assert!(
+        board
+            .memory_watch_begin_scoped(host_writes(), board.mappings().to_vec())
+            .is_err()
+    );
+}
