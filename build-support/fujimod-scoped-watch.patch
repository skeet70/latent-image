+#[test]
+fn zero_fill_coverage_credits_only_whole_zero_words_from_its_cores() {
+    let mut board = board();
+    // mov r0, #0; str r0, [r1, #4]
+    code(&board, 0, &[0xe3a00000, 0xe5810004, B_SELF]);
+    code(
+        &board,
+        1,
+        &[
+            0xe3a00000, // mov r0, #0
+            0xe3a04007, // mov r4, #7
+            0xe3a02000, // mov r2, #0
+            0xe3a03000, // mov r3, #0
+            STR_R0_R1,  // word 0: zero
+            0xe5c10004, // strb r0, [r1, #4]: word 1 partial
+            0xe5814008, // str r4, [r1, #8]: word 2 nonzero
+            0xe1c120fc, // strd r2, r3, [r1, #12]: words 3 and 4 zero
+            0xe5810014, // str r0, [r1, #20]: word 5 zero
+            0xe5814014, // str r4, [r1, #20]: word 5 nonzero afterwards
+            B_SELF,
+        ],
+    );
+    set(&board, 0, 1, SHARED);
+    set(&board, 1, 1, SHARED);
+    let watch = begin(
+        &board,
+        ScopedWatch {
+            coverage: vec![CoverageRule {
+                cores: cores(&[1]),
+                range: WordRange::new(SHARED_PHYSICAL, SHARED_PHYSICAL + 24).unwrap(),
+            }],
+            ..rules(vec![])
+        },
+    );
+    run(&mut board, 30);
+    let state = watch.state();
+    assert_eq!(state["violation"], Value::Null);
+    assert_eq!(
+        (&state["coverage"][0]["covered_words"], &state["coverage"][0]["first_uncovered"]),
+        (&json!(4), &json!(SHARED_PHYSICAL + 4))
+    );
+}
