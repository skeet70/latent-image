+#[test]
+fn moving_a_tcm_window_under_the_watch_is_a_fault() {
+    let mut board = board();
+    code(&board, 0, &[B_SELF]);
+    // mcr p15, 0, r0, c9, c1, 1; str r2, [r3]
+    code(&board, 1, &[0xee090f31, 0xe5832000, B_SELF]);
+    set(&board, 1, 0, 0x40001);
+    set(&board, 1, 3, 0x40000);
+    let watch = begin(
+        &board,
+        rules(vec![confine(
+            1,
+            Access::Write,
+            Confinement::Allow(vec![atcm(0, 0x1000)]),
+        )]),
+    );
+    run(&mut board, 8);
+    let state = watch.state();
+    assert_eq!(state["fault"]["kind"], "tcm-changed");
+    assert_eq!(state["fault"]["bank"], "atcm");
+}
+
+#[test]
+fn a_store_straddling_a_tcm_edge_is_a_fault_even_when_both_sides_are_allowed() {
+    let mut board = board();
+    code(&board, 0, &[B_SELF]);
+    code(&board, 1, &[STR_R0_R1, B_SELF]);
+    set(&board, 1, 1, ATCM + 0xffe);
+    let watch = begin(
+        &board,
+        rules(vec![confine(
+            1,
+            Access::Write,
+            Confinement::Allow(vec![atcm(0, 0x1000), physical(0x13000, 0x14000)]),
+        )]),
+    );
+    run(&mut board, 6);
+    let state = watch.state();
+    assert_eq!(state["fault"]["kind"], "tcm-straddle");
+    assert_eq!(state["fault"]["bank"], "atcm");
+}
+
+#[test]
+fn forbidden_fetch_reports_the_fetching_instruction() {
+    let mut board = board();
+    code(&board, 0, &[B_SELF]);
+    code(&board, 1, &[NOP, NOP, NOP, B_SELF]);
+    let watch = begin(
+        &board,
+        rules(vec![confine(
+            1,
+            Access::Fetch,
+            Confinement::Forbid(vec![physical(CORE1_CODE + 8, CORE1_CODE + 12)]),
+        )]),
+    );
+    run(&mut board, 10);
+    let sample = &watch.state()["fault"]["sample"];
+    assert_eq!(
+        (&sample["source"], &sample["physical"], &sample["pc"]),
+        (&json!("cpu-fetch"), &json!(CORE1_CODE + 8), &json!(0x10008))
+    );
+}
+
+fn poll(board: &mut Board, writer: &[u32], instructions: u64) -> (Value, u64) {
+    code(board, 0, writer);
+    // add r3, r3, #1; ldr r0, [r1]; cmp r0, #0; beq 0x10000
+    code(board, 1, &[0xe2833001, LDR_R0_R1, 0xe3500000, 0x0afffffb, B_SELF]);
+    for core in 0..2 {
+        set(board, core, 1, SHARED);
+    }
+    set(board, 1, 3, 0);
+    let watch = begin(
+        board,
+        ScopedWatch {
+            classes: vec![WatchRange {
+                start: SHARED_PHYSICAL,
+                end: SHARED_PHYSICAL + 4,
+                kinds: WatchKinds::WRITES,
+            }],
+            counters: vec![CounterRule {
+                cores: cores(&[1]),
+                cell: PhysicalWord::new(SHARED_PHYSICAL).unwrap(),
+                head: SampleBound::new(64).unwrap(),
+                tail: SampleBound::new(64).unwrap(),
+            }],
+            ..rules(vec![])
+        },
+    );
+    run(board, instructions);
+    (watch.state(), get(board, 1, 3))
+}
+
+#[test]
+fn completion_counter_counts_every_poll_and_keeps_bounded_head_and_tail() {
+    let mut board = board();
+    // mov r2, #0x400; subs r2, r2, #1; bne 0x10004; mov r0, #1; str r0, [r1]
+    let writer = [0xe3a02b01, 0xe2522001, 0x1afffffd, 0xe3a00001, STR_R0_R1, B_SELF];
+    let (state, polls) = poll(&mut board, &writer, 6000);
+    assert_eq!(state["violation"], Value::Null);
+    let counter = &state["counters"][0];
+    let count = counter["count"].as_u64().unwrap();
+    assert_eq!(count, polls);
+    assert!(count > 128, "{count} polls");
+    assert_eq!(
+        (&counter["zero_count"], &counter["nonzero_count"], &counter["first_nonzero_index"]),
+        (&json!(count - 1), &json!(1), &json!(count - 1))
+    );
+    assert_eq!(counter["first_nonzero"]["value"], 1);
+    let (head, tail) = (rows(&counter["head"]), rows(&counter["tail"]));
+    assert_eq!((head.len(), tail.len()), (64, 64));
+    assert!(head.iter().chain(&tail[..63]).all(|row| row["value"] == 0
+        && row["core"] == 1
+        && row["size"] == 4
+        && row["physical"] == SHARED_PHYSICAL));
+    assert_eq!(tail[63], counter["first_nonzero"]);
+    let instructions =
+        |rows: &[Value]| rows.iter().map(|row| row["instructions"].as_u64().unwrap()).collect::<Vec<_>>();
+    let order = instructions(head).into_iter().chain(instructions(tail)).collect::<Vec<_>>();
+    assert!(order.windows(2).all(|pair| pair[0] < pair[1]));
+    let records = rows(&state["records"]);
+    assert_eq!(records.len(), 1);
+    assert_eq!(
+        (&records[0]["source"], &records[0]["core"], &records[0]["value"], &records[0]["before"]),
+        (&json!("cpu-write"), &json!(0), &json!(1), &json!([0, 0, 0, 0]))
+    );
+    assert!(records[0]["instructions"].as_u64() < counter["first_nonzero"]["instructions"].as_u64());
+}
+
+#[test]
+fn held_completion_counter_has_no_nonzero_read() {
+    let mut board = board();
+    let (state, polls) = poll(&mut board, &[B_SELF], 2000);
+    let counter = &state["counters"][0];
+    assert_eq!(
+        (&counter["count"], &counter["zero_count"], &counter["nonzero_count"]),
+        (&json!(polls), &json!(polls), &json!(0))
+    );
+    assert_eq!((&counter["first_nonzero"], &state["violation"]), (&Value::Null, &Value::Null));
+    assert_eq!(rows(&state["records"]).len(), 0);
+}
+
+#[test]
+fn a_byte_read_of_a_counter_cell_is_a_fault_not_a_count() {
+    let mut board = board();
+    code(&board, 0, &[B_SELF]);
+    // ldrb r0, [r1]
+    code(&board, 1, &[0xe5d10000, B_SELF]);
+    set(&board, 1, 1, SHARED);
+    let watch = begin(
+        &board,
+        ScopedWatch {
+            counters: vec![CounterRule {
+                cores: cores(&[1]),
+                cell: PhysicalWord::new(SHARED_PHYSICAL).unwrap(),
+                head: SampleBound::new(4).unwrap(),
+                tail: SampleBound::new(4).unwrap(),
+            }],
+            ..rules(vec![])
+        },
+    );
+    run(&mut board, 6);
+    let state = watch.state();
+    assert_eq!(state["fault"]["kind"], "counter-access");
+    assert_eq!(state["counters"][0]["count"], 0);
+}
