load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

exports_files([
    "ghc.nix",
    "nixpkgs.nix",
    "repositories.bzl",
    "rules-haskell-nix.patch",
])

platform(
    name = "host",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@rules_nixpkgs_core//constraints:support_nix",
    ],
    visibility = ["//visibility:public"],
)

# FujiMod's reference CLI; its Nix build also runs the vendored Unicorn's unit tests.
sh_binary(
    name = "fujimod-emulator",
    srcs = ["@lab_fujimod//:bin/fujimod-emulator"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
