load("@rules_haskell//haskell:defs.bzl", "haskell_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

exports_files([
    "ghc.nix",
    "ledger-apply.sh",
    "nixpkgs.nix",
    "reclaim-disk.sh",
    "repositories.bzl",
    "rules-haskell-nix.patch",
])

platform(
    name = "host",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@rules_nixpkgs_core//constraints:support_nix",
    ],
    visibility = ["//visibility:public"],
)

# FujiMod's reference CLI; its Nix build also runs the vendored Unicorn's unit tests.
sh_binary(
    name = "fujimod-emulator",
    srcs = ["@lab_fujimod//:bin/fujimod-emulator"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

haskell_binary(
    name = "xm1-decomp-index",
    srcs = ["Xm1DecompIndex.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:cryptohash-sha256",
        "//host:directory",
        "//host:filepath",
        "//host:json",
        "//host:scientific",
        "//host:text",
        "//host:vector",
    ],
)

# Lookup, source view, coverage and boundary check over x70view's X-M1 1.50 decomp (reports/xm1-decomp.md).
sh_binary(
    name = "xm1-decomp",
    srcs = ["xm1-decomp.sh"],
    data = [":xm1-decomp-index"],
    visibility = ["//visibility:public"],
)
