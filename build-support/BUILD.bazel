load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

exports_files([
    "ghc.nix",
    "ledger-apply.sh",
    "nixpkgs.nix",
    "repositories.bzl",
    "rules-haskell-nix.patch",
])

platform(
    name = "host",
    constraint_values = ["@rules_nixpkgs_core//constraints:support_nix"],
    parents = ["@local_config_platform//:host"],
    visibility = ["//visibility:public"],
)

# FujiMod's reference CLI; its Nix build also runs the vendored Unicorn's unit tests.
sh_binary(
    name = "fujimod-emulator",
    srcs = ["@lab_fujimod//:bin/fujimod-emulator"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

haskell_binary(
    name = "xm1-decomp-index",
    srcs = ["Xm1DecompIndex.hs"],
    ghcopts = ["-XGHC2021", "-Wall", "-Werror", "-O2"],
    deps = [
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:cryptohash-sha256",
        "//host:directory",
        "//host:filepath",
        "//host:json",
        "//host:scientific",
        "//host:text",
        "//host:vector",
    ],
)

# Lookup, source view, coverage and boundary check over x70view's X-M1 1.50 decomp (reports/xm1-decomp.md).
sh_binary(
    name = "xm1-decomp",
    srcs = ["xm1-decomp.sh"],
    data = [":xm1-decomp-index"],
    visibility = ["//visibility:public"],
)

# Inspects /proc and calls glibc's euidaccess; its tests run under unshare.
haskell_binary(
    name = "storage-maintenance",
    srcs = ["StorageMaintenance.hs"],
    ghcopts = [
        "-XGHC2021",
        "-Wall",
        "-Werror",
        "-O2",
        "-rtsopts",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [
        "//host:aeson",
        "//host:base",
        "//host:bytestring",
        "//host:containers",
        "//host:cryptohash-sha256",
        "//host:directory",
        "//host:filepath",
        "//host:process",
        "//host:text",
        "//host:time",
        "//host:unix",
    ],
)

