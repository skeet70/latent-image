load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_test")

package(default_visibility = ["//visibility:public"])

_GHCOPTS = [
    "-Wall",
    "-Werror",
    "-O2",
    "-XGHC2021",
    "-threaded",
]

_HOST_DEPS = [
    "//host:aeson",
    "//host:base",
    "//host:bytestring",
    "//host:directory",
    "//host:filepath",
    "//host:host-support",
    "//host:json",
    "//host:unix",
]

haskell_binary(
    name = "f01-source-check",
    srcs = ["F01SourceCheck.hs"],
    ghcopts = _GHCOPTS,
    deps = _HOST_DEPS + ["//third_party:inventory-lib"],
)

haskell_binary(
    name = "f01-firmware-probes",
    srcs = ["F01FirmwareProbes.hs"],
    ghcopts = _GHCOPTS,
    deps = _HOST_DEPS,
)

haskell_test(
    name = "f01-native-probes",
    srcs = ["F01NativeProbes.hs"],
    args = ["$(location //emulation:native-runner)"],
    data = ["//emulation:native-runner"],
    ghcopts = _GHCOPTS,
    deps = _HOST_DEPS,
)

haskell_test(
    name = "f03-critical",
    srcs = ["F03Critical.hs"],
    ghcopts = _GHCOPTS,
    # Reads process state and descriptors from /proc.
    target_compatible_with = ["@platforms//os:linux"],
    deps = _HOST_DEPS + ["//af:simulation"],
)
