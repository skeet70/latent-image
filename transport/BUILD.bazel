]

# The locked Nix libusb's store path, read from the package's store-path file so
# the action's key follows the store path. Nothing opens it outside the live
# camera operations.
genrule(
    name = "libusb-path",
    srcs = ["@lab_libusb_runtime//:share/libusb-runtime/store-path"],
    outs = ["libusb_path.h"],
    cmd = "read -r runtime < $(location @lab_libusb_runtime//:share/libusb-runtime/store-path) && printf '#define FUJI_LIBUSB_PATH \"%s\"\\n' \"$$runtime\" > $@",
)

cc_library(
    name = "native-shim",
    srcs = [
        "native_usb.c",
        ":libusb-path",
    ],
    copts = [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkopts = ["-ldl"],
    deps = ["@lab_libusb//:headers"],
)

