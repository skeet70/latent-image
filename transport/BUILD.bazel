# The rehearsal positives run each operation's full session with its durable
# per-frame journaling, so the large stores cost minutes of fsync work and the
# 1058-slice read-media rehearsal alone can run for minutes on a filesystem
# with slow fsync.
sh_test(
    name = "cli-rejections",
    size = "enormous",
    srcs = ["cli-rejections.sh"],
    args = ["$(location :camera)"],
    data = [":camera"],
)

# The marker-0 read session's five steps against a stub camera, so the
# derivation and the derived form's plan parse run without one.
sh_test(
    name = "marker0-schedule",
    srcs = ["marker0-schedule-test.sh"],
    args = [
        "$(location :camera)",
        "$(location marker0-read-session.sh)",
    ],
    data = [
        ":camera",
        "marker0-read-session.sh",
    ],
)

