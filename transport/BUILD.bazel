load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_haskell//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["native_usb.c"])

_GHCOPTS = [
    "-Wall",
    "-Werror",
    "-O2",
    "-XGHC2021",
]

# The locked Nix libusb, resolved to its store path at build time. Nothing opens
# it outside the live camera operations.
genrule(
    name = "libusb-path",
    srcs = ["@lab_libusb_runtime//:lib/libusb-1.0.so"],
    outs = ["libusb_path.h"],
    cmd = "printf '#define FUJI_LIBUSB_PATH \"%s\"\\n' \"$$(readlink -f $<)\" > $@",
)

cc_library(
    name = "native-shim",
    srcs = [
        "native_usb.c",
        ":libusb-path",
    ],
    copts = [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkopts = ["-ldl"],
    deps = ["@lab_libusb//:headers"],
)

haskell_library(
    name = "camera-core",
    srcs = [
        "FujiAF/Area2.hs",
        "FujiAF/ArmAutoAct.hs",
        "FujiAF/BootRom.hs",
        "FujiAF/CodeProbe.hs",
        "FujiAF/DumpRam.hs",
        "FujiAF/EndSetting.hs",
        "FujiAF/Identify.hs",
        "FujiAF/Log.hs",
        "FujiAF/Ownership.hs",
        "FujiAF/PlanDocument.hs",
        "FujiAF/Probe.hs",
        "FujiAF/Read.hs",
        "FujiAF/ReadMedia.hs",
        "FujiAF/Rehearsal.hs",
        "FujiAF/Routes.hs",
        "FujiAF/Straps.hs",
        "FujiAF/Transport.hs",
    ],
    ghcopts = _GHCOPTS,
    src_strip_prefix = ".",
    visibility = ["//visibility:public"],
    deps = [
        "//host:base",
        "//host:bytestring",
        "//broker:core",
        "//host:directory",
        "//host:filepath",
        "//host:unix",
        "//host:aeson",
        "//host:json",
        "//host:scientific",
        "//host:text",
        "//host:vector",
    ],
)

haskell_library(
    name = "native-provider",
    srcs = ["FujiAF/Native.hs"],
    ghcopts = _GHCOPTS,
    src_strip_prefix = ".",
    deps = [
        ":camera-core",
        ":native-shim",
        "//host:base",
        "//broker:core",
    ],
)

# The one test that builds the native provider and runs the C lister: repeated
# enumeration of the host bus, needing no camera. Every other test injects its
# own UsbApi and cannot fail on the C.
